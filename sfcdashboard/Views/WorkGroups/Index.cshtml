@model IEnumerable<SFCDashboard.Models.WorkGroup>
@{
    ViewData["Title"] = "Work Groups";
    var currentPage = (int)ViewData["CurrentPage"];
    var totalPages = (int)ViewData["TotalPages"];
    var totalItems = (int)ViewData["TotalItems"];
    var searchTerm = (string)ViewData["SearchTerm"];
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold mb-1">Work Groups</h1>
                    <p class="text-muted mb-0">Manage work groups and their assignments</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="ImportFromBackend" class="btn btn-success btn-lg">
                        <i class="bi bi-arrow-clockwise me-2"></i>Refresh
                    </a>
                    <a asp-action="Create" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>Create New
                    </a>
                </div>
            </div>
            <hr class="my-4" />
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light py-3">
            <form asp-action="Index" method="get" class="row align-items-center">
                <div class="col">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="searchTerm" value="@searchTerm" 
                               class="form-control border-start-0" 
                               placeholder="Search groups...">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-2"></i>Search
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted"></i>
                        <p class="h4 mt-3 mb-0">No work groups found</p>
                        <p class="text-muted">Try adjusting your search criteria</p>
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0" id="groupsTable">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="px-4 py-3">
                                    <i class="bi bi-people me-2"></i>
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>
                                <th scope="col" class="px-4 py-3 text-center" style="width: 200px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr class="align-middle">
                                    <td class="px-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <span class="fw-medium">@Html.DisplayFor(modelItem => item.Name)</span>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-outline-primary btn-sm"
                                               data-bs-toggle="tooltip" title="Edit Group">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" 
                                               class="btn btn-outline-info btn-sm"
                                               data-bs-toggle="tooltip" title="View Details">
                                                <i class="bi bi-info-circle"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" 
                                               class="btn btn-outline-danger btn-sm"
                                               data-bs-toggle="tooltip" title="Delete Group">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card-footer bg-light py-3">
            <div class="row align-items-center">
                <div class="col-auto">
                    <small class="text-muted">
                        Showing @(((currentPage - 1) * 10) + 1) to @(Math.Min(currentPage * 10, totalItems)) 
                        of @totalItems work group@(totalItems != 1 ? "s" : "")
                    </small>
                </div>
                <div class="col">
                    <nav aria-label="Work groups navigation">
                        <ul class="pagination pagination-sm justify-content-end mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="1" 
                                   asp-route-searchTerm="@searchTerm" aria-label="First">
                                    <i class="bi bi-chevron-double-left"></i>
                                </a>
                            </li>
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(currentPage - 1)" 
                                   asp-route-searchTerm="@searchTerm" aria-label="Previous">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            
                            @for (var i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" 
                                       asp-route-searchTerm="@searchTerm">@i</a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@(currentPage + 1)" 
                                   asp-route-searchTerm="@searchTerm" aria-label="Next">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@totalPages" 
                                   asp-route-searchTerm="@searchTerm" aria-label="Last">
                                    <i class="bi bi-chevron-double-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Animate table rows
            $('tbody tr').each(function(i) {
                $(this).css('animation-delay', (i * 0.1) + 's');
                $(this).addClass('animate__animated animate__fadeIn');
            });
        });
    </script>
}