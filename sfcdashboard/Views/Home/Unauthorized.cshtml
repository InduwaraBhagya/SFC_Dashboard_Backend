@{
    ViewData["Title"] = "Unauthorized Access";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Unauthorized Access - SLT Fiber</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --pastel-blue: #e0f2fe;
            --pastel-green: #e8f5e8;
            --soft-blue: #bae6fd;
            --soft-green: #bbf7d0;
            --accent-blue: #0ea5e9;
            --accent-green: #10b981;
            --deep-blue: #0c4a6e;
            --deep-green: #065f46;
            --error-color: #f87171;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --bg-card: rgba(255, 255, 255, 0.95);
            --bg-service: #f0f9ff;
            --bg-gradient: linear-gradient(135deg, #e0f2fe 0%, #e8f5e8 50%, #bae6fd 100%);
            --border-radius: 24px;
            --shadow-soft: 0 20px 40px -10px rgba(14, 165, 233, 0.15);
            --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            width: 100%;
            font-family: var(--font-family);
            background: var(--bg-gradient);
            overflow: hidden;
        }

        .background-pattern {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: 
                radial-gradient(circle at 15% 25%, rgba(14, 165, 233, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 85% 75%, rgba(16, 185, 129, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, rgba(56, 189, 248, 0.05) 0%, transparent 50%);
            animation: float 8s ease-in-out infinite;
        }

        .unauthorized-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            z-index: 1;
        }

        .unauthorized-card {
            background: var(--bg-card);
            padding: 3rem;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-soft);
            width: 100%;
            max-width: 480px;
            text-align: center;
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            animation: slideInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        h1 {
            color: var(--deep-blue);
            font-size: 2.25rem;
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: -0.025em;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-green));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .subtitle {
            color: var(--text-secondary);
            font-size: 1.125rem;
            font-weight: 400;
            margin-bottom: 2rem;
            line-height: 1.7;
        }

        .message {
            color: var(--text-primary);
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 1rem;
            font-weight: 400;
        }

        .service-id {
            background: var(--bg-service);
            padding: 1.25rem;
            border-radius: 16px;
            margin: 2rem 0;
            font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
            font-size: 0.875rem;
            color: var(--text-secondary);
            border: 2px solid var(--soft-blue);
            position: relative;
        }

        .service-id::before {
            content: 'Service ID';
            position: absolute;
            top: -8px;
            left: 16px;
            background: var(--bg-service);
            padding: 0 8px;
            font-size: 0.75rem;
            color: var(--accent-blue);
            font-weight: 600;
        }

        .contact-info {
            margin-top: 2rem;
            padding: 1.5rem;
            background: linear-gradient(135deg, var(--pastel-green) 0%, var(--soft-green) 100%);
            border-radius: 16px;
            border-left: 4px solid var(--accent-green);
        }

        .contact-title {
            font-weight: 600;
            color: var(--deep-green);
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .contact-text {
            color: var(--text-secondary);
            font-size: 0.875rem;
            line-height: 1.5;
        }

        @@keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(1deg); }
        }

        @@media (max-width: 640px) {
            .unauthorized-card {
                padding: 2rem;
                margin: 1rem;
            }
            
            h1 { 
                font-size: 1.875rem; 
            }
            
            .subtitle {
                font-size: 1rem;
            }
        }

        @@media (max-width: 480px) {
            .unauthorized-container {
                padding: 1rem;
            }
            
            .unauthorized-card {
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="background-pattern"></div>
    <div class="unauthorized-container">
        <div class="unauthorized-card">
            <h1>Access Denied</h1>
            <p class="subtitle">You don't have permission to view this page</p>
            <p class="message">If you believe this is a mistake, <strong>try clearing your browser cookies and cache</strong>, then refresh the page. If the issue persists, please reach out to your system administrator for assistance.</p>
            <div class="service-id">@ViewData["ServiceId"]</div>
            <div class="contact-info">
                <div class="contact-title">Need Help?</div>
                <div class="contact-text">Contact your IT administrator or support team to request access to this application.</div>
            </div>
        </div>
    </div>
</body>
</html>