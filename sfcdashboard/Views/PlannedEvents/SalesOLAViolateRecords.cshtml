@using SFCDashboard.Models
@model IEnumerable<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "Sales OLA Violation Records";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">
            <i class="bi bi-clock-history text-primary me-3"></i>Sales OLA Violation Records
        </h1>
        <a href="@Url.Action("SalesView")" class="btn btn-primary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Search Records</h5>
        </div>
        <div class="card-body">
            <form id="searchForm" class="row g-3" method="get">
                <div class="col-md-3">
                    <label for="searchPeNumber" class="form-label">PE Number</label>
                    <input type="text" class="form-control" id="searchPeNumber" name="peNumber"
                        value="@ViewData["SearchPeNumber"]">
                </div>
                <div class="col-md-3">
                    <label for="searchReference" class="form-label">Request Reference</label>
                    <input type="text" class="form-control" id="searchReference" name="reference"
                        value="@ViewData["SearchReference"]">
                </div>
                <div class="col-md-3">
                    <label for="searchCustomer" class="form-label">Customer</label>
                    <input type="text" class="form-control" id="searchCustomer" name="customer"
                        value="@ViewData["SearchCustomer"]">
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="btn-group w-100">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a href="@Url.Action("SalesOLAViolateRecords")" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>OLA Violation Records</h5>
                <span class="badge bg-light text-dark" id="recordCount">Showing @Model.Count() of @Model.Count()
                    Records</span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" style="font-size: 0.8rem;">
                    <thead class="table-light" style="font-size: 0.75rem;">
                        <tr>
                            <th style="width: 3%;">#</th>
                            <th style="width: 10%;">PE Number</th>
                            <th style="width: 15%;">Request Reference</th>
                            <th style="width: 12%;">Customer</th>
                            <th style="width: 12%;">Current Task</th>
                            <th style="width: 10%;">Location A</th>
                            <th style="width: 10%;">Location B</th>
                            <th style="width: 8%;">Workgroup</th>
                            <th style="width: 12%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowNumber = 1;
                        }
                        @foreach (var item in Model)
                        {
                            var violationDetails = ViewBag.ViolationDetails[item.PeNumber];
                            <tr style="font-size: 0.8rem;">
                                <td>@(rowNumber++)</td>
                                <td>@item.PeNumber</td>
                                <td>@item.RequestReferenceNo</td>
                                <td>@item.Customer</td>
                                <td>@item.TaskName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.LocationAAddress))
                                    {
                                        @item.LocationAAddress
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.LocationBAddress))
                                    {
                                        @item.LocationBAddress
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@item.TaskWg</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                        <i class="bi bi-eye"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle me-2"></i>
                    No OLA violation records found.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Add search functionality
            const searchForm = document.getElementById('searchForm');
            const searchInputs = searchForm.querySelectorAll('input');
            const tableBody = document.querySelector('table tbody');
            const noRecordsAlert = document.querySelector('.alert-info');
            const recordCountBadge = document.getElementById('recordCount');
            const totalRecords = @Model.Count();

            function filterTable() {
                const peNumber = document.getElementById('searchPeNumber').value.trim().toLowerCase();
                const reference = document.getElementById('searchReference').value.trim().toLowerCase();
                const customer = document.getElementById('searchCustomer').value.trim().toLowerCase();

                let visibleRows = 0;
                const rows = tableBody.getElementsByTagName('tr');

                Array.from(rows).forEach(row => {
                    const cells = row.getElementsByTagName('td');
                    if (cells.length > 0) {
                        const matchPeNumber = !peNumber || cells[1].textContent.trim().toLowerCase().includes(peNumber);
                        const matchReference = !reference || cells[2].textContent.trim().toLowerCase().includes(reference);
                        const matchCustomer = !customer || cells[3].textContent.trim().toLowerCase().includes(customer);

                        if (matchPeNumber && matchReference && matchCustomer) {
                            row.style.display = '';
                            visibleRows++;
                        } else {
                            row.style.display = 'none';
                        }
                    }
                });

                // Update record count
                if (recordCountBadge) {
                    if (peNumber || reference || customer) {
                        // Show filtered results count
                        recordCountBadge.textContent = `Showing ${visibleRows} of ${totalRecords} Records`;
                        recordCountBadge.className = visibleRows > 0 ? 'badge bg-success text-white' : 'badge bg-warning text-dark';
                    } else {
                        // Show total count when no filters applied
                        recordCountBadge.textContent = `Showing ${totalRecords} of ${totalRecords} Records`;
                        recordCountBadge.className = 'badge bg-light text-dark';
                    }
                }

                // Show/hide no records message
                const existingCustomAlert = document.querySelector('.custom-no-results-alert');
                if (existingCustomAlert) {
                    existingCustomAlert.remove();
                }

                if (visibleRows === 0 && rows.length > 0) {
                    const customAlert = document.createElement('div');
                    customAlert.className = 'alert alert-info custom-no-results-alert mt-3';
                    customAlert.innerHTML = '<i class="bi bi-info-circle me-2"></i> No matching OLA violation records found.';
                    tableBody.parentElement.parentElement.appendChild(customAlert);
                }

                // Hide original no records alert if there are actual records
                if (noRecordsAlert && rows.length > 0) {
                    noRecordsAlert.style.display = 'none';
                }
            }

            // Add real-time search
            searchInputs.forEach(input => {
                input.addEventListener('input', filterTable);
            });

            // Prevent form submission (using real-time filter instead)
            searchForm.addEventListener('submit', function (e) {
                e.preventDefault();
                filterTable();
            });

            // Ensure Bootstrap dropdowns are properly initialized
            var dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'));
            var dropdownList = dropdownElementList.map(function (dropdownToggleEl) {
                return new bootstrap.Dropdown(dropdownToggleEl);
            });
        });
    </script>
}