@{
    ViewData["Title"] = "BOQ List - Under Development";
}

<!-- Under Development Section -->
<div class="hero-section">
    <div class="hero-background"></div>
    <div class="hero-content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-10">
                    <div class="workspace-card animate__animated animate__fadeInUp">
                        <div class="card-glow"></div>
                        <div class="card-header-modern text-center">
                            <div class="card-icon-modern" style="background: linear-gradient(135deg, #ff9800, #f57c00);">
                                <i class="bi bi-tools" style="font-size: 2rem;"></i>
                            </div>
                            <div class="card-badge" style="background: linear-gradient(135deg, #ff9800, #f57c00);">Under Development</div>
                        </div>
                        <div class="card-body text-center py-5">
                            <h2 class="card-title-modern mb-4" style="color: #333;">BOQ View</h2>
                            <p class="lead mb-4" style="color: #666;">
                                The Bill of Quantities (BOQ) view is currently under development.
                            </p>
                            <p class="text-muted mb-4">
                                We're working hard to bring you this feature soon. Thank you for your patience!
                            </p>
                            <div class="development-status">
                                <div class="d-flex justify-content-center align-items-center gap-3">
                                    <div class="status-indicator">
                                        <div class="spinner-border spinner-border-sm text-warning" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                    <span class="text-muted">Development in progress...</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-center" style="background: rgba(255, 152, 0, 0.1); border-top: 1px solid rgba(255, 152, 0, 0.2);">
                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>
                                Expected completion: Coming Soon
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .development-status {
        margin-top: 2rem;
        padding: 1rem;
        background: rgba(255, 152, 0, 0.1);
        border-radius: 8px;
        border: 1px solid rgba(255, 152, 0, 0.2);
    }

    .status-indicator {
        display: flex;
        align-items: center;
    }

    .workspace-card {
        box-shadow: 0 10px 30px rgba(255, 152, 0, 0.1);
        border: 1px solid rgba(255, 152, 0, 0.2);
    }

    .card-glow {
        background: radial-gradient(circle at center, rgba(255, 152, 0, 0.1) 0%, transparent 70%);
    }
</style>
