@model SFCDashboard.Models.Escalation

@{
    ViewData["Title"] = "Escalation Details";
}

<div class="container">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4>Escalation Details</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.Title</h5>
            <p class="card-text">@Model.Message</p>
            
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Task ID:</dt>
                        <dd class="col-sm-8">@Model.TaskId</dd>
                        
                        <dt class="col-sm-4">Created At:</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Recipient ID:</dt>
                        <dd class="col-sm-8">@Model.RecipientId</dd>
                        
                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsResolved)
                            {
                                <span class="badge bg-secondary">Resolved</span>
                            }
                            else if (Model.IsRead)
                            {
                                <span class="badge bg-info">Read</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Pending</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
            
            <hr/>
            
            <div class="mt-4">
@if (ViewData["PlannedEventId"] != null)
{
    <a asp-controller="PlannedEvents" asp-action="Details" 
       asp-route-id="@ViewData["PlannedEventId"]"
       asp-route-returnUrl="@Url.Action("Index", "Escalation")"
       class="btn btn-primary btn-sm">
       <i class="bi bi-eye"></i> View PE Details
    </a>
}
else
{
    <button class="btn btn-secondary btn-sm" disabled>
        <i class="bi bi-eye-slash"></i> PE Not Found
    </button>
}              @if (!Model.IsResolved)
                {
                    <button type="button" class="btn btn-warning ml-2" data-bs-toggle="modal" data-bs-target="#ignoreModal">
                        Resolve Escalation
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Resolve Modal -->
<div class="modal fade" id="ignoreModal" tabindex="-1" aria-labelledby="ignoreModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ignoreModalLabel">Resolve Escalation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Resolve" asp-route-id="@Model.Id" method="post">
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label for="reason" class="form-label">Please provide a reason for resolving this escalation:</label>
                        <textarea class="form-control" id="reason" name="reason" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Confirm Resolution</button>
                </div>
            </form>
        </div>
    </div>
</div>

