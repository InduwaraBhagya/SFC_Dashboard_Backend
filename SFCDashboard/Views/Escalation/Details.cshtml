@using SFCDashboard.Models
@model EscalationViewModel
@{
    ViewData["Title"] = "Escalation Details";
}

<div class="container-fluid my-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Escalation Details</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <h4>@Model.Title</h4>
                    <!-- Display task name prominently -->
                    <h5 class="text-muted">Task: @Model.TaskName</h5>
                    <div class="mb-3">
                        @if (Model.IsRead)
                        {
                            <span class="badge bg-info">Read</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unread</span>
                        }
                        <span class="badge bg-secondary">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">Message</h6>
                </div>
                <div class="card-body">
                    <p>@Model.Message</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">Task Details</h6>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">Task Name</dt>
                                <dd class="col-sm-8">@Model.TaskName</dd>

                                <dt class="col-sm-4">PE Number</dt>
                                <dd class="col-sm-8">@Model.PENumber</dd>
                                
                                @if (Model.TaskStatus != null)
                                {
                                    <dt class="col-sm-4">Status</dt>
                                    <dd class="col-sm-8">@Model.TaskStatus</dd>
                                }
                                

                            </dl>
            <div class="mt-4">
@if (ViewData["PlannedEventId"] != null)
{
    <a asp-controller="PlannedEvents" asp-action="Details" 
       asp-route-id="@ViewData["PlannedEventId"]"
       asp-route-returnUrl="@Url.Action("Index", "Escalation")"
       class="btn btn-primary btn-sm">
       <i class="bi bi-eye"></i> View PE Details
    </a>
}
else
{
    <button class="btn btn-secondary btn-sm" disabled>
        <i class="bi bi-eye-slash"></i> PE Not Found
    </button>
} 
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @if (!Model.IsRead)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0">Actions</h6>
                    </div>
                    <div class="card-body">
                        <button type="button" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#markReadModal">
                            <i class="bi bi-check-circle"></i> Mark as Read
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Mark as Read Modal -->
<div class="modal fade" id="markReadModal" tabindex="-1" aria-labelledby="markReadModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="markReadModalLabel">Mark as Read</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Resolve" asp-route-id="@Model.Id" method="post">
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label for="reason" class="form-label">Please provide a reason for marking this escalation as read:</label>
                        <textarea class="form-control" id="reason" name="reason" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Mark as Read</button>
                </div>
            </form>
        </div>
    </div>
</div>

