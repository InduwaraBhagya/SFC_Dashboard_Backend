@using SFCDashboard.Models
@model EscalationViewModel
@{
    ViewData["Title"] = "Escalation Details";
}


<div class="container-fluid my-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Escalation Details</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-8">
                    <h4>@Model.Title</h4>
                    <!-- Display task name prominently -->
                    <h5 class="text-muted">Task: @Model.TaskName</h5>
                    <div class="mb-3">
                        @if (Model.IsRead)
                        {
                            <span class="badge bg-info">Read</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unread</span>
                        }
                        <span class="badge bg-secondary">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>

            <div class="card" id="messageCard">
                <div class="card-header">
                    <h6 class="mb-0">Message</h6>
                </div>
                <div class="card-body">
                    <div>
                        <p id="messageContent">@Model.Message</p>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="card" id="taskDetailsCard">
                        <div class="card-header">
                            <h6 class="mb-0">Task Details</h6>
                        </div>
                        <div class="card-body">
                            <dl class="row" id="taskDetailsList">
                                <dt class="col-sm-4">Task Name</dt>
                                <dd class="col-sm-8" id="taskName">@Model.TaskName</dd>

                                <dt class="col-sm-4">PE Number</dt>
                                <dd class="col-sm-8" id="peNumber">@Model.PENumber</dd>
                                
                                @if (Model.TaskStatus != null)
                                {
                                    <dt class="col-sm-4">Status</dt>
                                    <dd class="col-sm-8" id="taskStatus">@Model.TaskStatus</dd>
                                }
                            </dl>
                            <div class="mt-3">
                                @if (ViewData["PlannedEventId"] != null)
                                {
                                    <a asp-controller="PlannedEvents" asp-action="Details" 
                                       asp-route-id="@ViewData["PlannedEventId"]"
                                       asp-route-returnUrl="@Url.Action("Index", "Escalation")"
                                       class="btn btn-primary">
                                       <i class="bi bi-eye"></i> View PE Details
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled>
                                        <i class="bi bi-eye-slash"></i> PE Not Found
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
