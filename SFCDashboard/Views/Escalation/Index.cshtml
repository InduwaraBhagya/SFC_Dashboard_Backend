@model IEnumerable<SFCDashboard.Models.Escalation>

@{
    ViewData["Title"] = "Escalations";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>OLA Escalations</h4>
            <a href="javascript:void(0)" onclick="refreshEscalations()" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </a>
        </div>
        <div class="card-body">
            <div class="mb-4">
                <ul class="nav nav-tabs" id="escalationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab" aria-controls="pending" aria-selected="true">
                            Pending <span class="badge bg-danger ms-1">@Model.Count(e => !e.IsRead && !e.IsResolved)</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="read-tab" data-bs-toggle="tab" data-bs-target="#read" type="button" role="tab" aria-controls="read" aria-selected="false">
                            Read <span class="badge bg-info ms-1">@Model.Count(e => e.IsRead && !e.IsResolved)</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="resolved-tab" data-bs-toggle="tab" data-bs-target="#resolved" type="button" role="tab" aria-controls="resolved" aria-selected="false">
                            Resolved <span class="badge bg-secondary ms-1">@Model.Count(e => e.IsResolved)</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab" aria-controls="all" aria-selected="false">
                            All <span class="badge bg-dark ms-1">@Model.Count()</span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content mt-3" id="escalationTabsContent">
                    <!-- Pending Escalations Tab -->
                    <div class="tab-pane fade show active" id="pending" role="tabpanel" aria-labelledby="pending-tab">
                        @if (Model.Any(e => !e.IsRead && !e.IsResolved))
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Task ID</th>
                                            <th>Title</th>
                                            <th>Created At</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Where(e => !e.IsRead && !e.IsResolved).OrderByDescending(e => e.CreatedAt))
                                        {
                                            <tr class="table-danger">
                                                <td>@item.TaskId</td>
                                                <td>@item.Title</td>
                                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-primary btn-sm">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                        <button type="button" class="btn btn-warning btn-sm" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#resolveModal" 
                                                                data-id="@item.Id">
                                                            <i class="bi bi-check-circle"></i> Resolve
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i> No pending escalations.
                            </div>
                        }
                    </div>

                    <!-- Read Escalations Tab -->
                    <div class="tab-pane fade" id="read" role="tabpanel" aria-labelledby="read-tab">
                        @if (Model.Any(e => e.IsRead && !e.IsResolved))
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Task ID</th>
                                            <th>Title</th>
                                            <th>Created At</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Where(e => e.IsRead && !e.IsResolved).OrderByDescending(e => e.CreatedAt))
                                        {
                                            <tr>
                                                <td>@item.TaskId</td>
                                                <td>@item.Title</td>
                                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-primary btn-sm">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                        <button type="button" class="btn btn-warning btn-sm" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#resolveModal" 
                                                                data-id="@item.Id">
                                                            <i class="bi bi-check-circle"></i> Resolve
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i> No read escalations.
                            </div>
                        }
                    </div>

                    <!-- Resolved Escalations Tab -->
                    <div class="tab-pane fade" id="resolved" role="tabpanel" aria-labelledby="resolved-tab">
                        @if (Model.Any(e => e.IsResolved))
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Task ID</th>
                                            <th>Title</th>
                                            <th>Created At</th>
                                            <th>Resolved By</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Where(e => e.IsResolved).OrderByDescending(e => e.CreatedAt))
                                        {
                                            <tr class="table-secondary">
                                                <td>@item.TaskId</td>
                                                <td>@item.Title</td>
                                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@item.IgnoredById</td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-primary btn-sm">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i> No resolved escalations.
                            </div>
                        }
                    </div>

                    <!-- All Escalations Tab -->
                    <div class="tab-pane fade" id="all" role="tabpanel" aria-labelledby="all-tab">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Task ID</th>
                                            <th>Title</th>
                                            <th>Status</th>
                                            <th>Created At</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.OrderByDescending(e => e.CreatedAt))
                                        {
                                            string rowClass = item.IsResolved ? "table-secondary" : 
                                                            (!item.IsRead ? "table-danger" : "");
                                            <tr class="@rowClass">
                                                <td>@item.TaskId</td>
                                                <td>@item.Title</td>
                                                <td>
                                                    @if (item.IsResolved)
                                                    {
                                                        <span class="badge bg-secondary">Resolved</span>
                                                    }
                                                    else if (item.IsRead)
                                                    {
                                                        <span class="badge bg-info">Read</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Pending</span>
                                                    }
                                                </td>
                                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-primary btn-sm">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                        @if (!item.IsResolved)
                                                        {
                                                            <button type="button" class="btn btn-warning btn-sm" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#resolveModal" 
                                                                    data-id="@item.Id">
                                                                <i class="bi bi-check-circle"></i> Resolve
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i> No escalations found.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Resolve Modal -->
<div class="modal fade" id="resolveModal" tabindex="-1" aria-labelledby="resolveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="resolveModalLabel">Resolve Escalation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="resolveForm" asp-action="Resolve" method="post">
                <input type="hidden" id="escalationId" name="id" />
                <input type="hidden" name="returnUrl" value="@Url.Action("Index")" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="reason" class="form-label">Please provide a reason for resolving this escalation:</label>
                        <textarea class="form-control" id="reason" name="reason" rows="4" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Confirm Resolution</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Set up the resolve modal
            $('#resolveModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                $('#escalationId').val(id);
            });
        });
        
        // Function to refresh the page
        function refreshEscalations() {
            location.reload();
        }

        // When the resolve button is clicked
        function resolveEscalation(escalationId, taskId) {
            // Update the escalation status to resolved
            updateEscalationStatus(escalationId, true);
            
            // Mark the task to no longer send escalations
            disableEscalationsForTask(taskId);
        }

        function updateEscalationStatus(escalationId, isResolved) {
            // API call or database update to mark escalation as resolved
            return fetch('/api/escalations/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    id: escalationId,
                    resolved: isResolved
                })
            });
        }

        function disableEscalationsForTask(taskId) {
            // API call or database update to stop future escalations for this task
            return fetch('/api/tasks/updateEscalationSettings', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    id: taskId,
                    sendEscalations: false
                })
            });
        }

        function resolveIssue(resolutionId) {
            // Display loading indicator
            $("#resolve-status-" + resolutionId).html("<span class='text-info'>Processing...</span>");
            
            $.ajax({
                url: '@Url.Action("ConfirmResolution", "Issues")',
                type: 'POST',
                data: {
                    resolutionId: resolutionId,
                    isConfirmed: true
                },
                success: function(response) {
                    if (response.success) {
                        // Update UI to show resolved status
                        $("#resolve-button-" + resolutionId).prop('disabled', true).removeClass('btn-primary').addClass('btn-success');
                        $("#resolve-status-" + resolutionId).html("<span class='text-success'>✓ Resolved</span>");
                        
                        // Show success message
                        toastr.success(response.message);
                        
                        // Optionally update any other UI elements
                        $("#issue-row-" + resolutionId).addClass('resolved-item');
                    } else {
                        // Show error
                        $("#resolve-status-" + resolutionId).html("");
                        toastr.error(response.message);
                    }
                },
                error: function() {
                    $("#resolve-status-" + resolutionId).html("");
                    toastr.error("Server error occurred. Please try again.");
                }
            });
            
            return false; // Prevent form submission
        }
    </script>
}