@model IEnumerable<SFCDashboard.Models.Escalation>

@{
    ViewData["Title"] = "Escalations";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>OLA Escalations</h4>
            <a href="javascript:void(0)" onclick="refreshEscalations()" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </a>
        </div>
        <div class="card-body">
            <div class="mb-4">
                <ul class="nav nav-tabs" id="escalationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab" aria-controls="pending" aria-selected="true">
                            Pending <span class="badge bg-danger ms-1">@Model.Count(e => !e.IsRead && !e.IsIgnored)</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="read-tab" data-bs-toggle="tab" data-bs-target="#read" type="button" role="tab" aria-controls="read" aria-selected="false">
                            Read <span class="badge bg-info ms-1">@Model.Count(e => e.IsRead && !e.IsIgnored)</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="ignored-tab" data-bs-toggle="tab" data-bs-target="#ignored" type="button" role="tab" aria-controls="ignored" aria-selected="false">
                            Ignored <span class="badge bg-secondary ms-1">@Model.Count(e => e.IsIgnored)</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="all-tab" data-bs-toggle="tab" data-bs-target="#all" type="button" role="tab" aria-controls="all" aria-selected="false">
                            All <span class="badge bg-dark ms-1">@Model.Count()</span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content mt-3" id="escalationTabsContent">
                    <!-- Pending Escalations Tab -->
                    <div class="tab-pane fade show active" id="pending" role="tabpanel" aria-labelledby="pending-tab">
                        @if (Model.Any(e => !e.IsRead && !e.IsIgnored))
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Task ID</th>
                                            <th>Escalation Level</th>
                                            <th>OLA Violation Time</th>
                                            <th>Created At</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Where(e => !e.IsRead && !e.IsIgnored).OrderByDescending(e => e.CreatedAt))
                                        {
                                            <tr class="table-danger">
                                                <td>@item.TaskId</td>
                                                <td>
                                                    @if (item.Level == SFCDashboard.Models.EscalationLevel.Engineer)
                                                    {
                                                        <span class="badge bg-warning text-dark">Engineer</span>
                                                    }
                                                    else if (item.Level == SFCDashboard.Models.EscalationLevel.DGM)
                                                    {
                                                        <span class="badge bg-danger">DGM</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-dark">GM</span>
                                                    }
                                                </td>
                                                <td>@item.OLAViolationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-primary btn-sm">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                        <button type="button" class="btn btn-warning btn-sm" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#ignoreModal" 
                                                                data-id="@item.Id">
                                                            <i class="bi bi-slash-circle"></i> Ignore
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i> No pending escalations.
                            </div>
                        }
                    </div>

                    <!-- Read Escalations Tab -->
                    <div class="tab-pane fade" id="read" role="tabpanel" aria-labelledby="read-tab">
                        @if (Model.Any(e => e.IsRead && !e.IsIgnored))
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Task ID</th>
                                            <th>Escalation Level</th>
                                            <th>OLA Violation Time</th>
                                            <th>Created At</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Where(e => e.IsRead && !e.IsIgnored).OrderByDescending(e => e.CreatedAt))
                                        {
                                            <tr>
                                                <td>@item.TaskId</td>
                                                <td>
                                                    @if (item.Level == SFCDashboard.Models.EscalationLevel.Engineer)
                                                    {
                                                        <span class="badge bg-warning text-dark">Engineer</span>
                                                    }
                                                    else if (item.Level == SFCDashboard.Models.EscalationLevel.DGM)
                                                    {
                                                        <span class="badge bg-danger">DGM</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-dark">GM</span>
                                                    }
                                                </td>
                                                <td>@item.OLAViolationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-primary btn-sm">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                        <button type="button" class="btn btn-warning btn-sm" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#ignoreModal" 
                                                                data-id="@item.Id">
                                                            <i class="bi bi-slash-circle"></i> Ignore
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i> No read escalations.
                            </div>
                        }
                    </div>

                    <!-- Ignored Escalations Tab -->
                    <div class="tab-pane fade" id="ignored" role="tabpanel" aria-labelledby="ignored-tab">
                        @if (Model.Any(e => e.IsIgnored))
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Task ID</th>
                                            <th>Escalation Level</th>
                                            <th>OLA Violation Time</th>
                                            <th>Ignored By</th>
                                            <th>Ignored At</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Where(e => e.IsIgnored).OrderByDescending(e => e.IgnoredAt))
                                        {
                                            <tr class="table-secondary">
                                                <td>@item.TaskId</td>
                                                <td>
                                                    @if (item.Level == SFCDashboard.Models.EscalationLevel.Engineer)
                                                    {
                                                        <span class="badge bg-warning text-dark">Engineer</span>
                                                    }
                                                    else if (item.Level == SFCDashboard.Models.EscalationLevel.DGM)
                                                    {
                                                        <span class="badge bg-danger">DGM</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-dark">GM</span>
                                                    }
                                                </td>
                                                <td>@item.OLAViolationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@item.IgnoredBy?.Name</td>
                                                <td>@item.IgnoredAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-primary btn-sm">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                        <button type="button" class="btn btn-info btn-sm" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#reasonModal" 
                                                                data-reason="@item.IgnoreReason">
                                                            <i class="bi bi-info-circle"></i> Reason
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i> No ignored escalations.
                            </div>
                        }
                    </div>

                    <!-- All Escalations Tab -->
                    <div class="tab-pane fade" id="all" role="tabpanel" aria-labelledby="all-tab">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Task ID</th>
                                            <th>Escalation Level</th>
                                            <th>Status</th>
                                            <th>OLA Violation Time</th>
                                            <th>Created At</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.OrderByDescending(e => e.CreatedAt))
                                        {
                                            string rowClass = item.IsIgnored ? "table-secondary" : 
                                                             (!item.IsRead ? "table-danger" : "");
                                            <tr class="@rowClass">
                                                <td>@item.TaskId</td>
                                                <td>
                                                    @if (item.Level == SFCDashboard.Models.EscalationLevel.Engineer)
                                                    {
                                                        <span class="badge bg-warning text-dark">Engineer</span>
                                                    }
                                                    else if (item.Level == SFCDashboard.Models.EscalationLevel.DGM)
                                                    {
                                                        <span class="badge bg-danger">DGM</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-dark">GM</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.IsIgnored)
                                                    {
                                                        <span class="badge bg-secondary">Ignored</span>
                                                    }
                                                    else if (item.IsRead)
                                                    {
                                                        <span class="badge bg-info">Read</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Pending</span>
                                                    }
                                                </td>
                                                <td>@item.OLAViolationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-primary btn-sm">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                        @if (!item.IsIgnored)
                                                        {
                                                            <button type="button" class="btn btn-warning btn-sm" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#ignoreModal" 
                                                                    data-id="@item.Id">
                                                                <i class="bi bi-slash-circle"></i> Ignore
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-info btn-sm" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#reasonModal" 
                                                                    data-reason="@item.IgnoreReason">
                                                                <i class="bi bi-info-circle"></i> Reason
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i> No escalations found.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ignore Modal -->
<div class="modal fade" id="ignoreModal" tabindex="-1" aria-labelledby="ignoreModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="ignoreModalLabel">Ignore Escalation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="ignoreForm" asp-action="Ignore" method="post">
                <input type="hidden" id="escalationId" name="id" />
                <input type="hidden" name="returnUrl" value="@Url.Action("Index")" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="reason" class="form-label">Please provide a reason for ignoring this escalation:</label>
                        <textarea class="form-control" id="reason" name="reason" rows="4" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Confirm Ignore</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reason Modal -->
<div class="modal fade" id="reasonModal" tabindex="-1" aria-labelledby="reasonModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info">
                <h5 class="modal-title" id="reasonModalLabel">Ignore Reason</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="p-3 bg-light border rounded">
                    <p id="reasonText"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Set up the ignore modal
            $('#ignoreModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                $('#escalationId').val(id);
            });
            
            // Set up the reason modal
            $('#reasonModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var reason = button.data('reason');
                $('#reasonText').text(reason);
            });
        });
        
        // Function to refresh the page
        function refreshEscalations() {
            location.reload();
        }
    </script>
}