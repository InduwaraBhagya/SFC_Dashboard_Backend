@model SystemUser

@{
    ViewData["Title"] = "Delete User";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient text-white" style="background-color: #dc3545;">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle fs-4 me-2"></i>
                <h5 class="mb-0">Confirm Deletion</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning border-0 shadow-sm">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-circle fs-4 me-3 text-warning"></i>
                    <div>
                        <h6 class="mb-1">Warning</h6>
                        <p class="mb-0">
                            Are you sure you want to delete the user <strong>@Model.Name</strong>? 
                            <br>
                            <small class="text-danger">This action cannot be undone.</small>
                        </p>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3 text-danger">
                        <i class="bi bi-info-circle me-2"></i>User Information
                    </h6>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-person me-2 text-primary"></i>
                                <span>Full Name</span>
                            </div>
                        </dt>
                        <dd class="col-sm-9">
                            <h6 class="mb-0">@Model.Name</h6>
                        </dd>

                        <dt class="col-sm-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-key me-2 text-warning"></i>
                                <span>Service ID</span>
                            </div>
                        </dt>
                        <dd class="col-sm-9">
                            <code class="bg-light px-2 py-1 rounded">@Model.ServiceId</code>
                        </dd>

                        <dt class="col-sm-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-shield-check me-2 text-success"></i>
                                <span>Role</span>
                            </div>
                        </dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-success">
                                <i class="bi bi-shield-fill me-1"></i>
                                @Model.UserRole?.Name
                            </span>
                        </dd>

                        <dt class="col-sm-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-people me-2 text-info"></i>
                                <span>Work Groups</span>
                            </div>
                        </dt>
                        <dd class="col-sm-9">
                            @if (Model.UserWorkGroups?.Any() == true)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var uwg in Model.UserWorkGroups)
                                    {
                                        if (uwg.WorkGroup != null)
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-people-fill me-1"></i>
                                                @uwg.WorkGroup.Name
                                            </span>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-muted fst-italic">
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                    No workgroups assigned
                                </div>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
            
            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger btn-lg px-4" 
                            onclick="return confirm('Are you absolutely sure you want to delete this user?')">
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                    <a asp-action="Index" class="btn btn-light btn-lg px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>