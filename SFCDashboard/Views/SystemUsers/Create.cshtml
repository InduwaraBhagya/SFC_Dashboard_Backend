@model SystemUser

@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-plus fs-4 me-2"></i>
                <h5 class="mb-0">Create New User</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="Name" class="form-control form-control-lg" required />
                            </div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ServiceId" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input asp-for="ServiceId" class="form-control form-control-lg" required />
                            </div>
                            <span asp-validation-for="ServiceId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="UserRoleId" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield"></i></span>
                                <select asp-for="UserRoleId" class="form-select form-select-lg" asp-items="ViewBag.UserRoleId" required>
                                    <option value="">Select a role...</option>
                                </select>
                            </div>
                            <span asp-validation-for="UserRoleId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-semibold">WorkGroups</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-people"></i></span>
                                <select id="WorkGroupIds" name="WorkGroupIds" class="form-select form-select-lg select2" multiple="multiple" style="width:100%;">
                                    @* No static options, Select2 will load via AJAX *@
                                </select>
                            </div>
                            <span class="text-danger field-validation-valid" data-valmsg-for="WorkGroupIds" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-check-circle me-2"></i>Create
                    </button>
                    <a asp-action="Index" class="btn btn-light btn-lg px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#WorkGroupIds').select2({
                placeholder: "Search or select workgroups",
                allowClear: true,
                width: '100%',
                minimumInputLength: 2,
                ajax: {
                    url: '/SystemUsers/SearchWorkgroups',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return {
                                    id: item.id,
                                    text: item.label
                                };
                            })
                        };
                    },
                    cache: true
                }
            });

            // Preselect workgroups if any are already selected (for edit persistence)
            var preselected = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SelectedWorkGroupIds ?? new List<int>()));
            if (preselected.length > 0) {
                $.ajax({
                    type: 'GET',
                    url: '/SystemUsers/GetWorkgroupsByIds',
                    data: { ids: preselected },
                    traditional: true,
                    success: function (data) {
                        var select = $('#WorkGroupIds');
                        $.each(data, function (i, wg) {
                            var option = new Option(wg.label, wg.id, true, true);
                            select.append(option).trigger('change');
                        });
                    }
                });
            }
        });
    </script>
}