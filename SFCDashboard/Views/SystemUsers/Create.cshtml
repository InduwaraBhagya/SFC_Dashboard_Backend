@model SystemUser

@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-plus fs-4 me-2"></i>
                <h5 class="mb-0">Create New User</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="Name" class="form-control form-control-lg" required />
                            </div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ServiceId" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input asp-for="ServiceId" class="form-control form-control-lg" required />
                            </div>
                            <span asp-validation-for="ServiceId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="UserRoleId" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield"></i></span>
                                <select asp-for="UserRoleId" class="form-select form-select-lg" asp-items="ViewBag.UserRoleId" required>
                                    <option value="">Select a role...</option>
                                </select>
                            </div>
                            <span asp-validation-for="UserRoleId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="workgroup-search" class="form-label fw-semibold">WorkGroup</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-people"></i></span>
                                <input id="workgroup-search" class="form-control form-control-lg" 
                                       placeholder="Type to search workgroups" required />
                            </div>
                            <input id="selected-workgroup-id" name="WorkGroupId" type="hidden" />
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-check-circle me-2"></i>Create
                    </button>
                    <a asp-action="Index" class="btn btn-light btn-lg px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>

    <script>
        $(document).ready(function() {
            $("#workgroup-search").autocomplete({
                source: function(request, response) {
                    $.ajax({
                        url: "/SystemUsers/SearchWorkgroups",
                        data: { term: request.term },
                        type: "GET",
                        success: function(data) {
                            let uniqueData = [...new Map(data.map(item => [item.label, item])).values()];
                            response(uniqueData);
                        },
                        error: function(xhr, status, error) {
                            console.error("Error:", status, error);
                        }
                    });
                },
                minLength: 2,
                select: function(event, ui) {
                    $("#workgroup-search").val(ui.item.label);
                    $("#selected-workgroup-id").val(ui.item.id);
                    return false;
                }
            });

            // Modern form validation
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        });
    </script>
}