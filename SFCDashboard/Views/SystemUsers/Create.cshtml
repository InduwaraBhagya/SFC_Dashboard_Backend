@model SystemUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-plus fs-4 me-2"></i>
                <h5 class="mb-0">Create New User</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Name" class="form-label fw-semibold">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="Name" class="form-control form-control-lg" required />
                            </div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ServiceId" class="form-label fw-semibold">Service ID</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input asp-for="ServiceId" class="form-control form-control-lg" required />
                            </div>
                            <span asp-validation-for="ServiceId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="UserRoleId" class="form-label fw-semibold">User Role</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield"></i></span>
                                <select asp-for="UserRoleId" class="form-select form-select-lg" 
                                        asp-items="ViewBag.UserRoleId" required>
                                    <option value="">Select a role...</option>
                                </select>
                            </div>
                            <span asp-validation-for="UserRoleId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="WorkGroupIds" class="form-label fw-semibold">
                                <i class="bi bi-people-fill me-1"></i>Work Groups
                                <small class="text-muted ms-1">(Select multiple)</small>
                            </label>
                            <select asp-for="WorkGroupIds" class="form-select select2" multiple="multiple" style="width:100%;">
                            </select>
                            <small class="text-muted mt-1 d-block">
                                <i class="bi bi-info-circle me-1"></i>Type to search work groups
                            </small>
                            <span asp-validation-for="WorkGroupIds" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-check-circle me-2"></i>Create
                    </button>
                    <a asp-action="Index" class="btn btn-light btn-lg px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/lib/select2/js/select2.min.js" asp-append-version="true"></script>
    
    <style>
        .select2-container .select2-selection--multiple {
            min-height: 45px;
            border: 1px solid #dee2e6;
        }
        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #4361ee;
            border: none;
            color: white;
            padding: 4px 8px;
            margin: 4px;
        }
        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
            color: white;
            margin-right: 5px;
            border-right: 0;
        }
        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
            background: none;
            color: #ff4444;
        }
        .select2-dropdown {
            border-color: #dee2e6;
            box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
        }
        .select2-container--default .select2-results__option--highlighted[aria-selected] {
            background-color: #4361ee;
        }
        .select2-search__field {
            padding: 8px !important;
        }
    </style>

    <script>
        $(document).ready(function() {
            $('.select2').select2({
                theme: 'default',
                width: '100%',
                placeholder: 'Type to search workgroups...',
                allowClear: true,
                minimumInputLength: 2,
                ajax: {
                    url: '/SystemUsers/SearchWorkgroups',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term || ''
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data.map(function(item) {
                                return {
                                    id: item.id,
                                    text: item.label
                                };
                            })
                        };
                    },
                    cache: true
                },
                language: {
                    inputTooShort: function() {
                        return 'Type at least 2 characters to search...';
                    },
                    searching: function() {
                        return 'Searching...';
                    },
                    noResults: function() {
                        return 'No workgroups found';
                    }
                }
            });

            // Form validation
            $('form').on('submit', function(e) {
                var selectedWorkgroups = $('.select2').val();
                if (!selectedWorkgroups || selectedWorkgroups.length === 0) {
                    alert('Please select at least one workgroup');
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}