@model SystemUser

@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-person-badge fs-4 me-2"></i>
                    <h5 class="mb-0">User Details</h5>
                </div>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-light btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-person me-2 text-primary"></i>
                                        <span>Full Name</span>
                                    </div>
                                </dt>
                                <dd class="col-sm-9">
                                    <h5 class="mb-0">@Model.Name</h5>
                                </dd>

                                <dt class="col-sm-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-key me-2 text-warning"></i>
                                        <span>Service ID</span>
                                    </div>
                                </dt>
                                <dd class="col-sm-9">
                                    <code class="bg-light px-2 py-1 rounded">@Model.ServiceId</code>
                                </dd>

                                <dt class="col-sm-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-shield-check me-2 text-success"></i>
                                        <span>Role</span>
                                    </div>
                                </dt>
                                <dd class="col-sm-9">
                                    <span class="badge bg-success text-white">
                                        @Model.UserRole?.Name
                                    </span>
                                </dd>

                                <dt class="col-sm-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-people me-2 text-info"></i>
                                        <span>Work Groups</span>
                                    </div>
                                </dt>
                                <dd class="col-sm-9">
                                    @if (Model.UserWorkGroups?.Any() == true)
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var uwg in Model.UserWorkGroups)
                                            {
                                                if (uwg.WorkGroup != null)
                                                {
                                                    <span class="badge bg-primary">
                                                        <i class="bi bi-people-fill me-1"></i>
                                                        @uwg.WorkGroup.Name
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted fst-italic">
                                            <i class="bi bi-exclamation-circle me-1"></i>
                                            No workgroups assigned
                                        </div>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-light btn-lg">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>