@using SFCDashboard.Models
@model ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.ProjectName;
    // Use controller-provided ViewBag values
    var canManageProjects = ViewBag.CanManageProjects as bool? ?? false;
    var currentUser = ViewBag.CurrentUser;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold mb-1 project-title">@Model.ProjectName</h1>
            <p class="text-muted mb-0 project-meta">Created on @Model.CreatedDate.ToString("MMM dd, yyyy")</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to Projects
        </a>
    </div>

    <!-- PE Search Section -->
    @if (canManageProjects)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Add PEs to Project</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="searchInput" class="form-control"
                                placeholder="Search PE by number or customer...">
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <button id="assignSelectedPEs" class="btn btn-primary" style="display:none">
                            <i class="bi bi-plus-circle me-1"></i>Assign Selected PEs
                        </button>
                    </div>
                </div>
                <div id="searchResults" class="mt-3">
                    <!-- Search results will be displayed here -->
                </div>
            </div>
        </div>
    }

    <!-- Assigned PEs List -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Assigned PEs</h5>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-success btn-sm export-excel-btn" onclick="exportToExcel()">
                    <i class="bi bi-file-earmark-excel me-1"></i>Export Excel
                </button>
                <button type="button" class="btn btn-danger btn-sm export-pdf-btn" onclick="exportToPdf()">
                    <i class="bi bi-file-earmark-pdf me-1"></i>Export PDF
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (Model.ProjectPEs != null && Model.ProjectPEs.Any())
            {
                <div class="fixed-header-table-container">
                    <table class="table table-fixed-header" id="assignedPEsTable">
                        <thead class="table-header-fixed">
                            <tr>
                                <th>Status</th>
                                <th>PE Number</th>
                                <th>Customer</th>
                                <th>Job Reference</th>
                                <th>Required Date</th>
                                <th>Current Task</th> <!-- Add this column -->
                                <th>Current WG</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                    <div class="table-body-scrollable">
                        <table class="table table-body-content">
                            <tbody>
                                @foreach (var pe in Model.ProjectPEs)
                                {



                                    <tr>
                                        <td>
                                            <div class="pe-status-indicator" style="background-color: @pe.StatusColor"
                                                data-bs-toggle="tooltip" data-bs-placement="top" title="@pe.StatusDisplayText">
                                            </div>
                                        </td>
                                        <td>@pe.PlannedEvent.PeNumber</td>
                                        <td>@pe.PlannedEvent.Customer</td>
                                        <td>@pe.PlannedEvent.JobReference</td>
                                        <td>
                                            @if (pe.PlannedEvent.ServiceRequiredDate.HasValue)
                                            {
                                                @pe.PlannedEvent.ServiceRequiredDate.Value.ToString("yyyy-MM-dd")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(pe.CurrentTask))
                                            {
                                                <div class="current-task-text-display">
                                                    <i class="bi bi-gear-fill me-1"></i>
                                                    <span class="task-name">@pe.CurrentTask</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="current-task-text-display task-inactive">
                                                    <i class="bi bi-dash-circle me-1"></i>
                                                    <span class="task-name">No Active Task</span>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(pe.PlannedEvent.TaskWg))
                                            {
                                                <div class="workgroup-text-display" data-wg="@pe.PlannedEvent.TaskWg">
                                                    <i class="bi bi-people-fill me-1"></i>
                                                    <span class="workgroup-name">@pe.PlannedEvent.TaskWg</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="workgroup-text-display workgroup-unassigned">
                                                    <i class="bi bi-dash-circle me-1"></i>
                                                    <span class="workgroup-name">Not Assigned</span>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="@Url.Action("Details", "PlannedEvents", new { id = pe.PlannedEventId })"
                                                    class="btn btn-sm btn-info me-2" target="_blank">
                                                    <i class="bi bi-eye"></i> View Details
                                                </a>
                                                @if (canManageProjects)
                                                {
                                                    <button class="btn btn-sm btn-danger remove-pe" data-pe-id="@pe.PlannedEventId"
                                                        data-pe-number="@pe.PlannedEvent.PeNumber">
                                                        <i class="bi bi-trash"></i> Remove
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>No PEs assigned to this project yet
                </div>
            }
        </div>
    </div>
</div>

<!-- Add this modal HTML at the bottom of your view, before scripts -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to remove <strong id="peName"></strong> from this project?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, Keep it</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Yes, Remove it</button>
            </div>
        </div>
    </div>
</div>

