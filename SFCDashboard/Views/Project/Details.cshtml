@model Project

@{
    ViewData["Title"] = Model.ProjectName;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold mb-1">@Model.ProjectName</h1>
            <p class="text-muted mb-0">Created on @Model.CreatedDate.ToString("MMM dd, yyyy")</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to Projects
        </a>
    </div>

    <!-- PE Search Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Add PEs to Project</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="searchInput" class="form-control"
                            placeholder="Search PE by number or customer...">
                    </div>
                </div>
            </div>
            <div id="searchResults" class="mt-3">
                <!-- Search results will be displayed here -->
            </div>
        </div>
    </div>

    <!-- Assigned PEs List -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Assigned PEs</h5>
        </div>
        <div class="card-body">
            @if (Model.ProjectPEs.Any())
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>PE Number</th>
                                <th>Customer</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pe in Model.ProjectPEs)
                            {
                                <tr>
                                    <td>@pe.PlannedEvent.PeNumber</td>
                                    <td>@pe.PlannedEvent.Customer</td>
                                    <td>
                                        <button class="btn btn-sm btn-danger remove-pe" 
                                                data-pe-id="@pe.PlannedEventId"
                                                data-pe-number="@pe.PlannedEvent.PeNumber">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>No PEs assigned to this project yet
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function () {
    // Search functionality
    $('#searchInput').on('keyup', function () {
        var searchTerm = $(this).val();
        if (searchTerm.length > 2) {
            $.get('/Project/Search', { searchTerm: searchTerm })
                .done(function (data) {
                    var html = '<div class="table-responsive"><table class="table table-hover">';
                    html += '<thead><tr><th>PE Number</th><th>Customer</th><th>Action</th></tr></thead><tbody>';
                    
                    data.forEach(function (pe) {
                        html += `
                            <tr>
                                <td>${pe.peNumber}</td>
                                <td>${pe.customer}</td>
                                <td>
                                    <button class="btn btn-sm btn-primary assign-pe" 
                                            data-pe-id="${pe.id}">
                                        <i class="bi bi-plus-circle me-1"></i>Assign
                                    </button>
                                </td>
                            </tr>`;
                    });
                    
                    html += '</tbody></table></div>';
                    $('#searchResults').html(data.length ? html : '<p class="text-muted">No results found</p>');
                });
        } else {
            $('#searchResults').html('');
        }
    });

    // Assign PE
    $(document).on('click', '.assign-pe', function () {
        var peId = $(this).data('pe-id');
        
        $.post('/Project/AssignPEToProject', {
            plannedEventId: peId,
            projectId: @Model.Id
        })
            .done(function (response) {
                if (response.success) {
                    location.reload();
                }
            })
            .fail(function (error) {
                alert('Error assigning PE to project');
            });
    });

    // Remove PE with confirmation
    $(document).on('click', '.remove-pe', function () {
        var peId = $(this).data('pe-id');
        var peNumber = $(this).data('pe-number');
        
        if (confirm(`Are you sure you want to remove PE ${peNumber} from this project?`)) {
            $.post('/Project/RemovePEFromProject', {
                plannedEventId: peId,
                projectId: @Model.Id
            })
                .done(function (response) {
                    if (response.success) {
                        location.reload();
                    }
                })
                .fail(function (error) {
                    alert('Error removing PE from project');
                });
        }
    });
});
</script>
}