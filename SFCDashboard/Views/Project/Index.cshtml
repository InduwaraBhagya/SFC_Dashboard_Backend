@model IEnumerable<Project>

@{
    ViewData["Title"] = "Projects";
}

<style>
    .project-card {
        transition: all 0.3s ease;
        border: none;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        background: var(--card-bg, #fff);
    }

    .project-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .project-card .card-body {
        padding: 1.5rem;
    }

    .project-card .card-title {
        color: var(--text-color, #2c3e50);
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .project-count {
        background: var(--count-bg, rgba(13, 110, 253, 0.1));
        padding: 0.5rem 1rem;
        border-radius: 20px;
        color: var(--count-color, #0d6efd);
        font-weight: 500;
        display: inline-block;
        margin-bottom: 1rem;
        border: 1px solid var(--count-border, rgba(13, 110, 253, 0.2));
    }

    .btn-view-project {
        background: linear-gradient(135deg, #0d6efd, #0099ff);
        border: none;
        padding: 0.5rem 1rem;
        transition: all 0.3s ease;
        min-width: 120px;
        max-width: 200px;
    }

    .btn-view-project:hover {
        background: linear-gradient(135deg, #0957d0, #0077cc);
        transform: translateY(-2px);
    }

    .btn-delete-project {
        background: var(--delete-bg, #fff);
        border: 2px solid #dc3545;
        color: #dc3545;
        transition: all 0.3s ease;
        padding: 0.5rem;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-delete-project:hover {
        background: #dc3545;
        color: #fff;
        transform: translateY(-2px);
    }

    .project-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
        align-items: center;
    }

    .page-header {
        background: var(--header-bg, linear-gradient(135deg, #f8f9fa, #e9ecef));
        padding: 2rem;
        border-radius: 1rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .project-header {
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .project-title {
        margin-bottom: 0.5rem;
    }

    .project-meta {
        color: var(--text-color, #6c757d);
        font-size: 0.95rem;
    }

    /* Dark mode styles */
    [data-theme="dark"] .project-card {
        --card-bg: #2d2d2d;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    [data-theme="dark"] .card-title {
        --text-color: #fff;
    }

    [data-theme="dark"] .project-count {
        --count-bg: rgba(13, 110, 253, 0.15);
        --count-color: #63a8ff;
        --count-border: rgba(99, 168, 255, 0.2);
    }

    [data-theme="dark"] .btn-delete-project {
        --delete-bg: #2d2d2d;
        color: #ff6b6b;
        border-color: #ff6b6b;
    }

    [data-theme="dark"] .btn-delete-project:hover {
        background: #ff6b6b;
        color: #fff;
    }

    [data-theme="dark"] .page-header {
        --header-bg: linear-gradient(135deg, #2d2d2d, #1a1a1a);
    }

    [data-theme="dark"] .project-details {
        color: rgba(255, 255, 255, 0.9) !important;
    }

    [data-theme="dark"] .display-5 {
        color: var(--text-color, #ffffff) !important;
    }

    [data-theme="dark"] .text-muted {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    [data-theme="dark"] .project-meta {
        --text-color: rgba(255, 255, 255, 0.7);
    }

    [data-theme="dark"] small {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    [data-theme="dark"] .created-date {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .create-project-btn {
        background: linear-gradient(135deg, #28a745, #20c997);
        border: none;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .create-project-btn:hover {
        background: linear-gradient(135deg, #218838, #1ba87e);
        transform: translateY(-2px);
    }

    .search-container .input-group {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .search-container .input-group-text {
        border: 1px solid #dee2e6;
        background: var(--search-bg, #fff);
    }

    .search-container .form-control {
        border: 1px solid #dee2e6;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }

    .search-container .form-control:focus {
        box-shadow: none;
        border-color: #80bdff;
    }

    [data-theme="dark"] .search-container .input-group-text,
    [data-theme="dark"] .search-container .form-control {
        --search-bg: #2d2d2d;
        background: var(--search-bg);
        border-color: #404040;
        color: #fff;
    }
</style>

<div class="container-fluid mt-4">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="display-5 fw-bold mb-1">Projects</h1>
                <p class="text-muted mb-0">Manage your projects and PE assignments</p>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <div class="search-container" style="min-width: 300px;">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="projectSearch" class="form-control border-start-0"
                            placeholder="Search projects...">
                    </div>
                </div>
                <button type="button" class="btn btn-primary create-project-btn" data-bs-toggle="modal"
                    data-bs-target="#createProjectModal">
                    <i class="bi bi-plus-circle me-2"></i>Create New Project
                </button>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var project in Model)
        {
            <div class="col">
                <div class="card project-card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@project.ProjectName</h5>
                        <div class="project-count">
                            <i class="bi bi-diagram-2 me-2"></i>@project.ProjectPEs.Count PEs assigned
                        </div>
                        <div class="project-actions">
                            <a href="@Url.Action("Details", "Project", new { id = project.Id })"
                                class="btn btn-primary btn-view-project">
                                <i class="bi bi-folder2-open me-2"></i>View Project
                            </a>
                            <button type="button" class="btn btn-delete-project delete-project"
                                data-project-id="@project.Id" data-project-name="@project.ProjectName">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Create Project Modal -->
    <partial name="_CreateProjectModal" model="new Project()" />
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

    <script>
        $(document).ready(function () {
            // Delete project functionality
            $('.delete-project').on('click', function () {
                const projectId = $(this).data('project-id');
                const projectName = $(this).data('project-name');

                if (confirm(`Are you sure you want to delete project "${projectName}"? This action cannot be undone.`)) {
                    $.post('/Project/Delete/' + projectId)
                        .done(function (response) {
                            if (response.success) {
                                location.reload();
                            }
                        })
                        .fail(function (error) {
                            alert('Error deleting project');
                        });
                }
            });

            // Project search functionality
            $("#projectSearch").on('input', function () {  // Fixed syntax error here
                var searchTerm = $(this).val().toLowerCase();

                // Show all projects if search is empty
                if (!searchTerm) {
                    $(".project-card").closest('.col').show();
                    return;
                }

                // Filter projects
                $(".project-card").each(function () {
                    var projectName = $(this).find('.card-title').text().toLowerCase();
                    var projectCount = $(this).find('.project-count').text().toLowerCase();

                    if (projectName.includes(searchTerm) || projectCount.includes(searchTerm)) {
                        $(this).closest('.col').show();
                    } else {
                        $(this).closest('.col').hide();
                    }
                });
            });

            // Autocomplete functionality
            $("#projectSearch").autocomplete({
                source: function (request, response) {
                    var matcher = new RegExp($.ui.autocomplete.escapeRegex(request.term), "i");
                    var suggestions = $(".project-card").map(function () {  // Fixed syntax error here
                        var projectName = $(this).find('.card-title').text();
                        if (matcher.test(projectName))
                            return projectName;
                    }).get();

                    response(suggestions);
                },
                minLength: 1,
                select: function (event, ui) {
                    $(this).val(ui.item.value);
                    $(this).trigger('input');
                }
            });
        });
    </script>
}
