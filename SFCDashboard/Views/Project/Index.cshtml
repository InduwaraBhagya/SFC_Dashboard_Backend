@model IEnumerable<Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold mb-1">Projects</h1>
                    <p class="text-muted mb-0">Manage your projects and PE assignments</p>
                </div>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                    data-bs-target="#createProjectModal">
                    <i class="bi bi-plus-circle me-2"></i>Create New Project
                </button>
            </div>
        </div>
    </div>

    <!-- Projects List -->
    <div class="card">
        <div class="card-body">
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var project in Model)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">@project.ProjectName</h5>
                                <p class="text-muted">@project.ProjectPEs.Count PEs assigned</p>
                                <a href="@Url.Action("Details", "Project", new { id = project.Id })"
                                    class="btn btn-primary">
                                    <i class="bi bi-folder2-open me-2"></i>View Project
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Create Project Modal -->
    <partial name="_CreateProjectModal" model="new Project()" />
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
