@model IEnumerable<SFCDashboard.Models.WorkGroup>
@{
    ViewData["Title"] = "Work Groups";
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-4">Work Groups</h1>
                <a asp-action="ImportFromBackend" class="btn btn-success mb-3">Refresh</a>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Create New Work Group
                </a>
            </div>
            <hr class="bg-secondary" />
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="thead-dark bg-dark text-light">
                        <tr>
                            <th scope="col" class="p-3">
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th scope="col" class="p-3 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="p-3 align-middle">
                                    <span class="fw-bold">@Html.DisplayFor(modelItem => item.Name)</span>
                                </td>
                                <td class="p-3 align-middle text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-info-circle me-1"></i> Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
