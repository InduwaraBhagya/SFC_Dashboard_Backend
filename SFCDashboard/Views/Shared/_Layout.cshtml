    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $(document).ready(function () {
            // Load escalations when page is loaded
            loadEscalations();

            // Refresh escalations every 2 minutes
            setInterval(loadEscalations, 2 * 60 * 1000);

            function loadEscalations() {
                $.ajax({
                    url: '/Escalation/GetUserEscalations',
                    type: 'GET',
                    data: { filter: currentFilter || 'unread' },
                    success: function (data) {
                        updateEscalationUI(data);
                    },
                    error: function () {
                        console.error('Failed to load escalations');
                    }
                });
            }

            function updateEscalationUI(data) {
                var $bellIcon = $('.notification-bell');
                var $badge = $('.escalation-badge');
                var $count = $('.escalation-count');
                var $noEscalations = $('.no-escalations');
                var $escalationList = $('.escalation-list');

                // Clear previous escalations
                $escalationList.empty();

                // Update badge and count
                if (data.count > 0) {
                    $badge.text(data.count).show();
                    $count.text(data.count);
                    $bellIcon.addClass('has-notifications');
                    $noEscalations.hide();

                    // Add escalations to dropdown
                    $.each(data.escalations, function (i, escalation) {
                        var escalationClass = '';
                        var levelText = '';

                        switch (escalation.level) {
                            case 1:
                                escalationClass = 'escalation-engineer';
                                levelText = 'Engineer Level';
                                break;
                            case 2:
                                escalationClass = 'escalation-dgm';
                                levelText = 'DGM Level';
                                break;
                            case 3:
                                escalationClass = 'escalation-gm';
                                levelText = 'GM Level';
                                break;
                        }

                        // Format time as relative (e.g., "2 hours ago")
                        var createdAt = new Date(escalation.createdAt);
                        var timeAgo = timeSince(createdAt);

                        var html = `
                    <a href="/Escalation/Details/${escalation.id}" class="dropdown-item escalation-item ${escalationClass}">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="escalation-title">Task #${escalation.taskId} OLA Violation</h6>
                            <span class="escalation-time">${timeAgo}</span>
                        </div>
                        <p class="escalation-message">
                            <span class="badge ${getBadgeClass(escalation.level)}">${levelText}</span>
                            ${truncateText(escalation.taskWorkGroup || 'Unknown workgroup', 25)}
                        </p>
                    </a>
                `;

                        $escalationList.append(html);
                    });
                } else {
                    $badge.hide();
                    $count.text('0');
                    $bellIcon.removeClass('has-notifications');
                    $noEscalations.show();
                }
            }

            function getBadgeClass(level) {
                switch (level) {
                    case 1: return "bg-warning text-dark";
                    case 2: return "bg-orange";
                    case 3: return "bg-danger";
                    default: return "bg-secondary";
                }
            }

            function truncateText(text, maxLength) {
                if (!text) return '';
                return text.length > maxLength ? text.substr(0, maxLength) + '...' : text;
            }

            function timeSince(date) {
                var seconds = Math.floor((new Date() - date) / 1000);

                var interval = Math.floor(seconds / 31536000);
                if (interval >= 1) return interval + " year" + (interval > 1 ? "s" : "") + " ago";

                interval = Math.floor(seconds / 2592000);
                if (interval >= 1) return interval + " month" + (interval > 1 ? "s" : "") + " ago";

                interval = Math.floor(seconds / 86400);
                if (interval >= 1) return interval + " day" + (interval > 1 ? "s" : "") + " ago";

                interval = Math.floor(seconds / 3600);
                if (interval >= 1) return interval + " hour" + (interval > 1 ? "s" : "") + " ago";

                interval = Math.floor(seconds / 60);
                if (interval >= 1) return interval + " minute" + (interval > 1 ? "s" : "") + " ago";

                return "just now";
            }


            // Only select filter buttons inside the notification dropdown
            document.querySelectorAll('.notification-dropdown .btn-group button[data-filter]').forEach(button => {
                button.addEventListener('click', function () {
                    document.querySelectorAll('.notification-dropdown .btn-group button[data-filter]').forEach(btn => {
                        btn.classList.remove('active');
                    });
                    this.classList.add('active');
                    currentFilter = this.getAttribute('data-filter');
                    loadCombinedNotifications();
                });
            });

            document.querySelectorAll('.notification-dropdown .btn-group button[data-type]').forEach(button => {
                button.addEventListener('click', function () {
                    document.querySelectorAll('.notification-dropdown .btn-group button[data-type]').forEach(btn => {
                        btn.classList.remove('active');
                    });
                    this.classList.add('active');
                    currentType = this.getAttribute('data-type');
                    loadCombinedNotifications();
                });
            });
        });
        document.addEventListener('DOMContentLoaded', function () {
            // Search functionality
            var select = document.getElementById('navbarSearchType');
            var input = document.getElementById('navbarSearchInput');
            function updateInputNameAndPlaceholder() {
                input.name = select.value;
                switch (select.value) {
                    case "peNumber":
                        input.placeholder = "Search PE Number";
                        break;
                    case "customer":
                        input.placeholder = "Search Customer";
                        break;
                    case "jobReference":
                        input.placeholder = "Search Job Reference";
                        break;
                    case "soNumber":
                        input.placeholder = "Search SO Number";
                        break;
                }
            }
            select.addEventListener('change', updateInputNameAndPlaceholder);
            updateInputNameAndPlaceholder();


            // Notification functionality
            let currentFilter = 'unread';

            function loadReminders() {
                fetch(`/PlannedEvents/GetReminders?showAll=${currentFilter === 'all'}`)
                    .then(response => response.json())
                    .then(data => {
                        const notificationList = document.getElementById('notificationList');
                        notificationList.innerHTML = '';

                        if (data.length === 0) {
                            notificationList.innerHTML = `
                    <div class="p-3 text-center text-muted">
                        <i class="bi bi-bell-slash me-2"></i>No notifications
                    </div>`;
                        } else {
                            const filteredData = currentFilter === 'unread'
                                ? data.filter(r => !r.isRead)
                                : data;

                            if (filteredData.length === 0) {
                                notificationList.innerHTML = `
                        <div class="p-3 text-center text-muted">
                            <i class="bi bi-bell-slash me-2"></i>No ${currentFilter} notifications
                        </div>`;
                                return;
                            }

                            filteredData.forEach(reminder => {
                                const reminderElement = document.createElement('div');
                                reminderElement.className = `message-item ${!reminder.isRead ? 'unread' : ''} system-reminder p-3 border-bottom`;
                                reminderElement.setAttribute('data-message-id', `reminder-${reminder.id}`);
                                reminderElement.setAttribute('data-pe-id', reminder.plannedEventId);
                                reminderElement.setAttribute('data-reminder-id', reminder.id);
                                reminderElement.onclick = function () {
                                    handleReminderClick(this);
                                };

                                reminderElement.innerHTML = `
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="message-sender mb-1">
                                        <span class="badge bg-warning text-dark me-1">Reminder</span>
                                        Task On Hold
                                    </h6>
                                    <div class="message-subject">
                                        ${reminder.message}
                                    </div>
                                </div>
                                <span class="message-time text-muted small">${formatDate(reminder.createdDate)}</span>
                            </div>
                        </div>`;

                                notificationList.appendChild(reminderElement);
                            });
                        }
                        updateReminderCount();
                    });
            }

            function handleReminderClick(element) {
                const reminderId = element.getAttribute('data-reminder-id');
                const peId = element.getAttribute('data-pe-id');

                // Mark as read
                fetch('/PlannedEvents/MarkReminderAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ id: reminderId })
                }).then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            element.classList.remove('unread');
                            updateReminderCount();
                        }
                    });

                // Navigate to PE details
                if (peId) {
                    window.location.href = `/PlannedEvents/Details/${peId}`;
                }
            }

            function formatDate(dateString) {
                const date = new Date(dateString);
                return date.toLocaleString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                });
            }

            function updateReminderCount() {
                fetch('/PlannedEvents/GetReminderCount')
                    .then(response => response.json())
                    .then(data => {
                        const badge = document.getElementById('reminderCount');
                        badge.textContent = data.count;
                        badge.style.display = data.count > 0 ? 'block' : 'none';
                    });
            }

            // Load reminders initially and set up auto-refresh
            document.addEventListener('DOMContentLoaded', function () {
                loadReminders();

                // Refresh button
                document.getElementById('refreshNotifications').addEventListener('click', function () {
                    loadReminders();
                });

                // Mark all as read button
                document.getElementById('markAllRead').addEventListener('click', function () {
                    fetch('/PlannedEvents/MarkAllRemindersAsRead', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                document.querySelectorAll('.message-item.unread').forEach(item => {
                                    item.classList.remove('unread');
                                });
                                updateReminderCount();
                            }
                        });
                });

                // Auto refresh every 5 minutes
                setInterval(loadReminders, 300000);

                document.querySelectorAll('.btn-group button[data-filter]').forEach(button => {
                    button.addEventListener('click', function () {
                        // Remove active class from all filter buttons
                        document.querySelectorAll('.btn-group button[data-filter]').forEach(btn => {
                            btn.classList.remove('active');
                        });

                        // Add active class to clicked button
                        this.classList.add('active');

                        // Update filter and reload reminders
                        currentFilter = this.getAttribute('data-filter');
                        loadReminders();
                    });
                });
            });
    </script>
    <!-- Combined notification functionality -->
    <script>
            let currentFilter = 'unread';
            let currentType = 'all';

            function loadCombinedNotifications() {
                // Load both reminders and escalations
                Promise.all([
                    fetch(`/PlannedEvents/GetReminders?showAll=${currentFilter === 'all'}`).then(response => response.json()),
                    fetch(`/Escalation/GetUserEscalations?filter=${currentFilter}`).then(response => response.json())
                ])
                    .then(([reminders, escalations]) => {
                        const notificationList = document.getElementById('combinedNotificationList');
                        notificationList.innerHTML = '';

                        // Process reminders data
                        let reminderData = reminders || [];

                        // Process escalations data
                        let escalationData = escalations?.escalations || [];

                        // Filter based on current type
                        if (currentType === 'reminders') {
                            escalationData = [];
                        } else if (currentType === 'escalations') {
                            reminderData = [];
                        }

                        // Filter based on read/unread
                        if (currentFilter === 'unread') {
                            reminderData = reminderData.filter(r => !r.isRead);
                            escalationData = escalationData.filter(e => !e.isRead);
                        }

                        // Combine and sort by date
                        const combined = [
                            ...reminderData.map(r => ({
                                type: 'reminder',
                                id: r.id,
                                peId: r.plannedEventId,
                                message: r.message,
                                date: new Date(r.createdDate),
                                isRead: r.isRead
                            })),
                            ...escalationData.map(e => ({
                                type: 'escalation',
                                id: e.id,
                                peId: e.taskId,
                                level: e.level,
                                message: `Task #${e.taskId} - ${e.taskWorkGroup || 'Unknown workgroup'}`,
                                date: new Date(e.createdAt),
                                isRead: e.isRead
                            }))
                        ].sort((a, b) => b.date - a.date);  // Sort by date, newest first

                        // Check if no notifications
                        if (combined.length === 0) {
                            notificationList.innerHTML = `
                    <div class="p-3 text-center text-muted">
                        <i class="bi bi-bell-slash me-2"></i>No ${currentFilter} ${currentType} notifications
                    </div>
                `;
                            return;
                        }

                        // Add combined notifications to the list
                        combined.forEach(notification => {
                            const notificationElement = document.createElement('div');

                            if (notification.type === 'reminder') {
                                // Add reminder element
                                notificationElement.className = `message-item ${!notification.isRead ? 'unread' : ''} system-reminder p-3 border-bottom`;
                                notificationElement.setAttribute('data-message-id', `reminder-${notification.id}`);
                                notificationElement.setAttribute('data-pe-id', notification.peId);
                                notificationElement.setAttribute('data-reminder-id', notification.id);
                                notificationElement.setAttribute('data-type', 'reminder');
                                notificationElement.onclick = function () {
                                    handleReminderClick(this);
                                };

                                notificationElement.innerHTML = `
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="message-sender mb-1">
                                        <span class="badge bg-warning text-dark me-1">Reminder</span>
                                        Task On Hold
                                    </h6>
                                    <div class="message-subject">
                                        ${notification.message}
                                    </div>
                                </div>
                                <span class="message-time text-muted small">${formatDate(notification.date)}</span>
                            </div>
                        </div>
                    `;
                            } else {
                                // Add escalation element
                                let levelClass = '';
                                let levelBadge = '';

                                switch (notification.level) {
                                    case 1:
                                        levelClass = 'escalation-engineer';
                                        levelBadge = '<span class="badge bg-warning text-dark me-1">Engineer</span>';
                                        break;
                                    case 2:
                                        levelClass = 'escalation-dgm';
                                        levelBadge = '<span class="badge bg-danger me-1">DGM</span>';
                                        break;
                                    case 3:
                                        levelClass = 'escalation-gm';
                                        levelBadge = '<span class="badge bg-dark me-1">GM</span>';
                                        break;
                                }

                                notificationElement.className = `message-item ${!notification.isRead ? 'unread' : ''} ${levelClass} p-3 border-bottom`;
                                notificationElement.setAttribute('data-message-id', `escalation-${notification.id}`);
                                notificationElement.setAttribute('data-escalation-id', notification.id);
                                notificationElement.setAttribute('data-type', 'escalation');
                                notificationElement.onclick = function () {
                                    handleEscalationClick(this);
                                };

                                notificationElement.innerHTML = `
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="message-sender mb-1">
                                        ${levelBadge}
                                        <span class="ms-1">OLA Violation</span>
                                    </h6>
                                    <div class="message-subject">
                                        ${notification.message}
                                    </div>
                                </div>
                                <span class="message-time text-muted small">${formatDate(notification.date)}</span>
                            </div>
                        </div>
                    `;
                            }

                            notificationList.appendChild(notificationElement);
                        });

                        // Update the notification count
                        updateCombinedCount(
                            reminderData.filter(r => !r.isRead).length +
                            escalationData.filter(e => !e.isRead).length
                        );
                    });
            }

            function handleReminderClick(element) {
                const reminderId = element.getAttribute('data-reminder-id');
                const peId = element.getAttribute('data-pe-id');

                // Mark as read
                fetch('/PlannedEvents/MarkReminderAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ id: reminderId })
                }).then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            element.classList.remove('unread');
                            loadCombinedNotifications();
                        }
                    });

                // Navigate to PE details
                if (peId) {
                    window.location.href = `/PlannedEvents/Details/${peId}`;
                }
            }

            function handleEscalationClick(element) {
                const escalationId = element.getAttribute('data-escalation-id');

                // Navigate to escalation details
                if (escalationId) {
                    window.location.href = `/Escalation/Details/${escalationId}`;
                }
            }

            function formatDate(date) {
                return date.toLocaleString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                });
            }

            function updateCombinedCount(count) {
                const badge = document.getElementById('combinedCount');
                badge.textContent = count;
                badge.style.display = count > 0 ? 'block' : 'none';
            }

            // Load notifications initially and set up functionality
            document.addEventListener('DOMContentLoaded', function () {
                loadCombinedNotifications();

                // Refresh button
                document.getElementById('refreshNotifications').addEventListener('click', function () {
                    loadCombinedNotifications();
                });

                // Mark all as read button
                document.getElementById('markAllRead').addEventListener('click', function () {
                    // Mark reminders as read
                    fetch('/PlannedEvents/MarkAllRemindersAsRead', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    // Mark escalations as read (You'll need to implement this endpoint)
                    fetch('/Escalation/MarkAllAsRead', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    // Update UI
                    document.querySelectorAll('.message-item.unread').forEach(item => {
                        item.classList.remove('unread');
                    });

                    // Reload notifications
                    loadCombinedNotifications();
                });

                // Filter buttons
                document.querySelectorAll('.btn-group button[data-filter]').forEach(button => {
                    button.addEventListener('click', function () {
                        // Remove active class from all filter buttons
                        document.querySelectorAll('.btn-group button[data-filter]').forEach(btn => {
                            btn.classList.remove('active');
                        });

                        // Add active class to clicked button
                        this.classList.add('active');

                        // Update filter and reload notifications
                        currentFilter = this.getAttribute('data-filter');
                        loadCombinedNotifications();
                    });
                });

                // Type filter buttons
                document.querySelectorAll('.btn-group button[data-type]').forEach(button => {
                    button.addEventListener('click', function () {
                        // Remove active class from all type buttons
                        document.querySelectorAll('.btn-group button[data-type]').forEach(btn => {
                            btn.classList.remove('active');
                        });

                        // Add active class to clicked button
                        this.classList.add('active');

                        // Update type filter and reload notifications
                        currentType = this.getAttribute('data-type');
                        loadCombinedNotifications();
                    });
                });

                // Auto refresh every 5 minutes
                setInterval(loadCombinedNotifications, 300000);
            });

            document.addEventListener('DOMContentLoaded', function () {
                const toggleSwitch = document.getElementById('darkModeToggle');
                if (!toggleSwitch) return;

                // Set initial state from localStorage
                const savedTheme = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
                document.body.setAttribute('data-theme', savedTheme);
                toggleSwitch.checked = savedTheme === 'dark';

                toggleSwitch.addEventListener('change', function () {
                    const theme = this.checked ? 'dark' : 'light';
                    document.documentElement.setAttribute('data-theme', theme);
                    document.body.setAttribute('data-theme', theme);
                    localStorage.setItem('theme', theme);
                });
            });

    </script>
    <script>
            // Add this to your script section or a shared _Layout.cshtml file
            $.ajaxSetup({
                headers: {
                    'RequestVerificationToken': $('input:hidden[name="__RequestVerificationToken"]').val()
                }
            });
    </script>
</body>

</html>
