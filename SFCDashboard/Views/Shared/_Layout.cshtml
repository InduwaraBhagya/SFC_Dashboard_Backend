<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SFCDashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SFCDashboard.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center app-name" asp-area="" asp-controller="PlannedEvents"
                    asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo" class="logo-img me-2" />
                    <span class="dashboard-name">SFCDashboard</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="WorkGroups" asp-action="Index">
                                <i class="bi bi-people-fill me-1"></i> Add WorkGroup
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="SystemUsers" asp-action="Index">
                                <i class="bi bi-person-plus-fill me-1"></i> Add User
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="UserRoles" asp-action="Index">
                                <i class="bi bi-person-badge-fill me-1"></i> Add Role
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PETaskLists" asp-action="Index">
                                <i class="bi bi-list-task me-1"></i> Add Task
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PERecords" asp-action="ImportExcel">
                                <i class="bi bi-file-earmark-arrow-up-fill me-1"></i> Import Excel
                            </a>
                        </li>
                    </ul>
                    <div class="vr d-none d-lg-block" style="height: 40px;"></div>
                    <form class="d-flex align-items-center me-3" method="get" asp-controller="PlannedEvents"
                        asp-action="GlobalSearch" role="search" style="min-width:320px;">
                        <div class="input-group">
                            <select class="form-select" name="searchType" id="navbarSearchType"
                                style="max-width: 140px;">
                                <option value="peNumber" selected>PE Number</option>
                                <option value="customer">Customer</option>
                                <option value="jobReference">Job Reference</option>
                                <option value="soNumber">SO Number</option>
                            </select>
                            <input class="form-control" type="search" name="peNumber" id="navbarSearchInput"
                                placeholder="Search PE Number" aria-label="Search" />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="bg-dark text-white mt-4">
        <div class="container py-3">
            <div class="row align-items-center">
                <div class="col-md-6 d-flex align-items-center">
                    <img src="~/images/logoRmv.png" alt="Footer Logo" height="30" class="me-2" />
                    <p class="mb-0">&copy; 2025 - SFCDashboard</p>
                </div>
                <div class="col-md-6 text-end">
                    <a class="text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var select = document.getElementById('navbarSearchType');
            var input = document.getElementById('navbarSearchInput');
            function updateInputNameAndPlaceholder() {
                input.name = select.value;
                switch (select.value) {
                    case "peNumber":
                        input.placeholder = "Search PE Number";
                        break;
                    case "customer":
                        input.placeholder = "Search Customer";
                        break;
                    case "jobReference":
                        input.placeholder = "Search Job Reference";
                        break;
                    case "soNumber":
                        input.placeholder = "Search SO Number";
                        break;
                }
            }
            select.addEventListener('change', updateInputNameAndPlaceholder);
            updateInputNameAndPlaceholder();
        });
    </script>
</body>

</html>
