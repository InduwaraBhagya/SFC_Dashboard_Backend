                            </li>
                            @*li class="nav-item">
                                <a class="nav-link" asp-controller="Permissions" asp-action="Index">
                                    <i class="bi bi-shield-check me-1"></i> Manage Permissions
                                </a>
                            </li>*@
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Project" asp-action="Index">
                                    <i class="bi bi-folder-fill me-1"></i> Projects
                                </a>
                            </li>
                            <li class="nav-item">
    <a class="nav-link" asp-controller="Escalation" asp-action="Index">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> Escalations
    </a>
</li>


                        }

                    </ul>
                    <div class="vr d-none d-lg-block" style="height: 40px;"></div>
                    <form class="d-flex align-items-center me-3" method="get" asp-controller="PlannedEvents"
                        asp-action="GlobalSearch" role="search" style="min-width:320px;">
                        <div class="input-group">
                            <select class="form-select" name="searchType" id="navbarSearchType"
                                style="max-width: 140px;">
                                <option value="peNumber" selected>PE Number</option>
                                <option value="customer">Customer</option>
                                <option value="jobReference">Job Reference</option>
                                <option value="soNumber">SO Number</option>
                            </select>
                            <input class="form-control" type="search" name="peNumber" id="navbarSearchInput"
                                placeholder="Search PE Number" aria-label="Search" />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Dark Mode Toggle Button -->
                    <div class="theme-switch-wrapper me-3">
                        <label class="theme-switch" for="darkModeToggle">
                            <input type="checkbox" id="darkModeToggle" />
                            <div class="slider round">
                                <i class="bi bi-moon-fill moon-icon"></i>
                                <i class="bi bi-sun-fill sun-icon"></i>
