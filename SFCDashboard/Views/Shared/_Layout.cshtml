@using Microsoft.EntityFrameworkCore
@using SFCDashboard.Data
@using Microsoft.AspNetCore.Http
@inject ApplicationDbContext Context
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userName = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
    var serviceId = !string.IsNullOrEmpty(userName) && userName.Length >= 6
    ? userName.Substring(0, 6)
    : null;

    var currentUser = !string.IsNullOrEmpty(serviceId)
    ? await Context.Users
    .Include(u => u.UserRole)
    .ThenInclude(r => r.RolePermissions)
    .ThenInclude(rp => rp.Permission)
    .FirstOrDefaultAsync(u => u.ServiceId == serviceId)
    : null;

    var isAdmin = currentUser?.UserRole?.HasPermission("Admin") == true;
    var isHomePage = ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
    ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}
<!DOCTYPE html>
<html lang="en">


<head>
    <!-- Add this script before any other content in head -->
    <script>
        // Immediately set the theme before page loads
        (function () {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
            document.body.setAttribute('data-theme', theme);
        })();
    </script>


    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SFCDashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/escalation.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @if (!isHomePage)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="container-fluid">
                    <a class="navbar-brand d-flex align-items-center app-name" asp-area="" asp-controller="Home"
                        asp-action="Index">
                        <img src="~/images/logo.png" alt="SFCDashboard" height="40" class="logo-img" />
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="PlannedEvents" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminMenuDropdown" role="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-fill me-1"></i> Admin Menu
                                    </a>
                                    <ul class="dropdown-menu modern-dropdown" aria-labelledby="adminMenuDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="WorkGroups" asp-action="Index">
                                                <i class="bi bi-people-fill me-2"></i> <span>Add WorkGroup</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="SystemUsers"
                                                asp-action="Index">
                                                <i class="bi bi-person-plus-fill me-2"></i> <span>Add User</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="UserRoles" asp-action="Index">
                                                <i class="bi bi-person-badge-fill me-2"></i> <span>Add Role</span>
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="PERecords"
                                                asp-action="ImportExcel">
                                                <i class="bi bi-file-earmark-arrow-up-fill me-2"></i> <span>Import Excel</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Project" asp-action="Index">
                                                <i class="bi bi-folder-fill me-2"></i> <span>Projects</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Escalation" asp-action="Index">
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i> <span>Escalations</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="ContractorView"
                                                asp-action="ContractorRecords">
                                                <i class="bi bi-building me-2"></i> <span>Contractor View</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="NetworkEngineer"
                                                asp-action="ImportExcel">
                                                <i class="bi bi-person-lines-fill me-2"></i> <span>Network Engineers</span>
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="CustomerUserAssignment"
                                                asp-action="Index">
                                                <i class="bi bi-person-check-fill me-2"></i> <span>Customer Assignments</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                        </ul>

                        <form class="d-flex align-items-center me-3" method="get" asp-controller="PlannedEvents"
                            asp-action="GlobalSearch" role="search" style="min-width:320px;">
                            <div class="input-group">
                                <select class="form-select" name="searchType" id="navbarSearchType"
                                    style="max-width: 140px;">
                                    <option value="peNumber" selected>PE Number</option>
                                    <option value="customer">Customer</option>
                                    <option value="jobReference">Job Reference</option>
                                    <option value="soNumber">SO Number</option>
                                </select>
                                <input class="form-control" type="search" name="peNumber" id="navbarSearchInput"
                                    placeholder="Search PE Number" aria-label="Search" />
                                <button class="btn btn-primary" type="submit">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </form>

                        <!-- Dark Mode Toggle Button -->
                        <div class="theme-switch-wrapper me-3">
                            <label class="theme-switch" for="darkModeToggle">
                                <input type="checkbox" id="darkModeToggle" />
                                <div class="slider round">
                                    <i class="bi bi-moon-fill moon-icon"></i>
                                    <i class="bi bi-sun-fill sun-icon"></i>
                                </div>
                            </label>
                        </div>

                        <!-- Compact Reminders Notification Bell -->
                        <div class="dropdown me-3">
                            <button class="btn btn-outline-light position-relative" type="button" id="reminderDropdown"
                                data-bs-toggle="dropdown" aria-expanded="false" style="border: none; padding: 0.5rem;">
                                <i class="bi bi-bell" style="font-size: 1.2rem;"></i>
                                <span
                                    class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                    id="reminderCount" style="display:none; font-size: 0.6rem;">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="reminderDropdown"
                                style="width: 350px; max-height: 400px; overflow-y: auto;">
                                <div class="dropdown-header bg-primary text-white p-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0">
                                            <i class="bi bi-bell me-2"></i>Reminders
                                        </h6>
                                        <div>
                                            <button class="btn btn-sm btn-light me-1" id="markAllRemindersRead"
                                                title="Mark all as read">
                                                <i class="bi bi-check-all"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light" id="refreshReminders" title="Refresh">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="btn-group btn-group-sm w-100 mt-2">
                                        <button type="button" class="btn btn-outline-light active"
                                            data-filter="unread">Unread</button>
                                        <button type="button" class="btn btn-outline-light" data-filter="all">All</button>
                                    </div>
                                </div>
                                <div id="reminderNotificationList" class="notification-list">
                                    <!-- Reminders will be loaded here -->
                                </div>
                            </div>
                        </div>

                        <span class="nav-link text-white" style="pointer-events:none;">
                            @currentUser.Name
                        </span>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="@(isHomePage ? "" : "container mt-4")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (!isHomePage)
    {
        <footer class="bg-dark text-white mt-4">
            <div class="container py-3">
                <div class="row align-items-center">
                    <div class="col-md-6 d-flex align-items-center">
                        <img src="~/images/logoRmv.png" alt="Footer Logo" height="30" class="me-2" />
                        <p class="mb-0">&copy; 2025 - SFCDashboard</p>
                    </div>
                    <div class="col-md-6 text-end">
                        <a class="text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </div>
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $(document).ready(function () {
            // Load escalations when page is loaded
            loadEscalations();

            // Refresh escalations every 2 minutes
            setInterval(loadEscalations, 2 * 60 * 1000);

            function loadEscalations() {
                $.ajax({
                    url: '/Escalation/GetUserEscalations',
                    type: 'GET',
                    data: { filter: currentFilter || 'unread' },
                    success: function (data) {
                        updateEscalationUI(data);
                    },
                    error: function () {
                        console.error('Failed to load escalations');
                    }
                });
            }

            function updateEscalationUI(data) {
                var $bellIcon = $('.notification-bell');
                var $badge = $('.escalation-badge');
                var $count = $('.escalation-count');
                var $noEscalations = $('.no-escalations');
                var $escalationList = $('.escalation-list');

                // Clear previous escalations
                $escalationList.empty();

                // Update badge and count
                if (data.count > 0) {
                    $badge.text(data.count).show();
                    $count.text(data.count);
                    $bellIcon.addClass('has-notifications');
                    $noEscalations.hide();

                    // Add escalations to dropdown
                    $.each(data.escalations, function (i, escalation) {
                        var escalationClass = '';
                        var levelText = '';

                        switch (escalation.level) {
                            case 1:
                                escalationClass = 'escalation-engineer';
                                levelText = 'Engineer Level';
                                break;
                            case 2:
                                escalationClass = 'escalation-dgm';
                                levelText = 'DGM Level';
                                break;
                            case 3:
                                escalationClass = 'escalation-gm';
                                levelText = 'GM Level';
                                break;
                        }

                        // Format time as relative (e.g., "2 hours ago")
                        var createdAt = new Date(escalation.createdAt);
                        var timeAgo = timeSince(createdAt);

                        var html = `
                    <a href="/Escalation/Details/${escalation.id}" class="dropdown-item escalation-item ${escalationClass}">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="escalation-title">Task #${escalation.taskId} OLA Violation</h6>
                            <span class="escalation-time">${timeAgo}</span>
                        </div>
                        <p class="escalation-message">
                            <span class="badge ${getBadgeClass(escalation.level)}">${levelText}</span>
                            ${truncateText(escalation.taskWorkGroup || 'Unknown workgroup', 25)}
                        </p>
                    </a>
                `;

                        $escalationList.append(html);
                    });
                } else {
                    $badge.hide();
                    $count.text('0');
                    $bellIcon.removeClass('has-notifications');
                    $noEscalations.show();
                }
            }

            function getBadgeClass(level) {
                switch (level) {
                    case 1: return "bg-warning text-dark";
                    case 2: return "bg-orange";
                    case 3: return "bg-danger";
                    default: return "bg-secondary";
                }
            }

            function truncateText(text, maxLength) {
                if (!text) return '';
                return text.length > maxLength ? text.substr(0, maxLength) + '...' : text;
            }

            function timeSince(date) {
                var seconds = Math.floor((new Date() - date) / 1000);

                var interval = Math.floor(seconds / 31536000);
                if (interval >= 1) return interval + " year" + (interval > 1 ? "s" : "") + " ago";

                interval = Math.floor(seconds / 2592000);
                if (interval >= 1) return interval + " month" + (interval > 1 ? "s" : "") + " ago";

                interval = Math.floor(seconds / 86400);
                if (interval >= 1) return interval + " day" + (interval > 1 ? "s" : "") + " ago";

                interval = Math.floor(seconds / 3600);
                if (interval >= 1) return interval + " hour" + (interval > 1 ? "s" : "") + " ago";

                interval = Math.floor(seconds / 60);
                if (interval >= 1) return interval + " minute" + (interval > 1 ? "s" : "") + " ago";

                return "just now";
            }


            // Only select filter buttons inside the notification dropdown
            document.querySelectorAll('.notification-dropdown .btn-group button[data-filter]').forEach(button => {
                button.addEventListener('click', function () {
                    document.querySelectorAll('.notification-dropdown .btn-group button[data-filter]').forEach(btn => {
                        btn.classList.remove('active');
                    });
                    this.classList.add('active');
                    currentFilter = this.getAttribute('data-filter');
                    loadCombinedNotifications();
                });
            });

            document.querySelectorAll('.notification-dropdown .btn-group button[data-type]').forEach(button => {
                button.addEventListener('click', function () {
                    document.querySelectorAll('.notification-dropdown .btn-group button[data-type]').forEach(btn => {
                        btn.classList.remove('active');
                    });
                    this.classList.add('active');
                    currentType = this.getAttribute('data-type');
                    loadCombinedNotifications();
                });
            });
        });
        document.addEventListener('DOMContentLoaded', function () {
            // Search functionality
            var select = document.getElementById('navbarSearchType');
            var input = document.getElementById('navbarSearchInput');
            function updateInputNameAndPlaceholder() {
                input.name = select.value;
                switch (select.value) {
                    case "peNumber":
                        input.placeholder = "Search PE Number";
                        break;
                    case "customer":
                        input.placeholder = "Search Customer";
                        break;
                    case "jobReference":
                        input.placeholder = "Search Job Reference";
                        break;
                    case "soNumber":
                        input.placeholder = "Search SO Number";
                        break;
                }
            }
            select.addEventListener('change', updateInputNameAndPlaceholder);
            updateInputNameAndPlaceholder();


            // Notification functionality
            let currentFilter = 'unread';

            function loadReminders() {
                fetch(`/PlannedEvents/GetReminders?showAll=${currentReminderFilter === 'all'}`)
                    .then(response => response.json())
                    .then(data => {
                        // Filter to ensure only reminders are processed (extra safety)
                        const reminderData = data.filter(item => item.isReminder !== false);

                        const reminderList = document.getElementById('reminderNotificationList');
                        const reminderBadge = document.getElementById('reminderCount');

                        if (!reminderList) return;

                        reminderList.innerHTML = '';

                        // Filter data based on current filter
                        const filteredData = currentReminderFilter === 'unread'
                            ? reminderData.filter(r => !r.isRead)
                            : reminderData;

                        // Update badge count (always show unread count)
                        const unreadCount = reminderData.filter(r => !r.isRead).length;
                        if (unreadCount > 0) {
                            reminderBadge.textContent = unreadCount;
                            reminderBadge.style.display = 'block';
                        } else {
                            reminderBadge.style.display = 'none';
                        }

                        if (filteredData.length === 0) {
                            reminderList.innerHTML = `
                                <div class="p-3 text-center text-muted">
                                    <i class="bi bi-bell-slash me-2"></i>No ${currentReminderFilter} reminders
                                </div>`;
                            return;
                        }

                        filteredData.forEach(reminder => {
                            const reminderElement = document.createElement('div');
                            reminderElement.className = `dropdown-item reminder-item ${!reminder.isRead ? 'unread' : 'read'}`;
                            reminderElement.style.cursor = 'pointer';
                            reminderElement.style.borderBottom = '1px solid #eee';
                            reminderElement.setAttribute('data-reminder-id', reminder.id);
                            reminderElement.setAttribute('data-pe-id', reminder.plannedEventId);

                            reminderElement.innerHTML = `
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-1">
                                            <span class="badge bg-warning text-dark me-2">Hold Reminder</span>
                                            ${!reminder.isRead ? '<i class="bi bi-circle-fill text-primary me-1" style="font-size: 0.5rem;"></i>' : ''}
                                        </div>
                                        <p class="mb-1 small">${reminder.message}</p>
                                        <small class="text-muted">${formatDate(new Date(reminder.createdDate))}</small>
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" onclick="event.stopPropagation();">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); viewPEDetails(${reminder.plannedEventId})">
                                                <i class="bi bi-eye me-2"></i>View PE Details</a></li>
                                            ${!reminder.isRead ?
                                    `<li><a class="dropdown-item" href="#" onclick="event.stopPropagation(); markReminderAsRead(${reminder.id})">
                                                    <i class="bi bi-check me-2"></i>Mark as Read</a></li>` : ''
                                }
                                        </ul>
                                    </div>
                                </div>`;

                            // Add click event to show details modal
                            reminderElement.addEventListener('click', function () {
                                showReminderDetails(reminder);
                            });

                            reminderList.appendChild(reminderElement);
                        });
                    })
                    .catch(error => {
                        console.error('Error loading reminders:', error);
                    });
            }

            function showReminderDetails(reminder) {
                // Mark as read if unread
                if (!reminder.isRead) {
                    markReminderAsRead(reminder.id);
                }

                // Build reminder details content
                const detailsContent = `
                <div class="alert alert-warning">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle me-2"></i>Hold Reminder
                    </h6>
                    <p class="mb-0">${reminder.message}</p>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <strong>Created:</strong> ${formatDate(new Date(reminder.createdDate))}
                    </div>
                    <div class="col-md-6">
                        <strong>Status:</strong> 
                        <span class="badge ${reminder.isRead ? 'bg-success' : 'bg-warning text-dark'}">
                            ${reminder.isRead ? 'Read' : 'Unread'}
                        </span>
                    </div>
                </div>
                <hr>
                <div class="text-center">
                    <h6 class="fw-bold mb-3">Related PE Information</h6>
                    <p class="mb-2"><strong>PE Number:</strong> ${reminder.peNumber || extractPENumber(reminder.message)}</p>
                    <p class="mb-0"><strong>Customer:</strong> ${reminder.customer || extractCustomer(reminder.message)}</p>
                </div>
            `;

                document.getElementById('reminderDetailsContent').innerHTML = detailsContent;
                document.getElementById('viewPEDetailsBtn').href = `/PlannedEvents/Details/${reminder.plannedEventId}`;

                // Show the modal
                const modal = new bootstrap.Modal(document.getElementById('reminderDetailsModal'));
                modal.show();
            }

            // Helper functions to extract PE number and customer from reminder message
            function extractPENumber(message) {
                const match = message.match(/PE\s+([A-Z0-9]+)/i);
                return match ? match[1] : 'N/A';
            }

            function extractCustomer(message) {
                const match = message.match(/Customer:\s*([^.]+)/i);
                return match ? match[1].trim() : 'N/A';
            }

            function markReminderAsRead(reminderId) {
                fetch('/PlannedEvents/MarkReminderAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ id: reminderId })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            loadReminders(); // Reload to update the list
                        }
                    });
            }

            function markAllRemindersAsRead() {
                fetch('/PlannedEvents/MarkAllRemindersAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            loadReminders(); // Reload to update the list
                        }
                    });
            }

            function viewPEDetails(peId) {
                window.open(`/PlannedEvents/Details/${peId}`, '_blank');
            }

            function formatDate(date) {
                return date.toLocaleString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                });
            }

            // Event listeners
            document.getElementById('refreshReminders')?.addEventListener('click', function (e) {
                e.stopPropagation();
                loadReminders();
            });

            document.getElementById('markAllRemindersRead')?.addEventListener('click', function (e) {
                e.stopPropagation();
                markAllRemindersAsRead();
            });

            // Filter buttons
            document.querySelectorAll('#reminderDropdown + .dropdown-menu .btn-group button[data-filter]').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.stopPropagation();

                    // Remove active class from all filter buttons
                    document.querySelectorAll('#reminderDropdown + .dropdown-menu .btn-group button[data-filter]').forEach(btn => {
                        btn.classList.remove('active');
                    });

                    // Add active class to clicked button
                    this.classList.add('active');

                    // Update filter and reload
                    currentReminderFilter = this.getAttribute('data-filter');
                    loadReminders();
                });
            });

            // Make functions globally accessible
            window.markReminderAsRead = markReminderAsRead;
            window.viewPEDetails = viewPEDetails;
            window.showReminderDetails = showReminderDetails;
        });
    </script>

    <!-- Reminder Details Modal -->
    <div class="modal fade" id="reminderDetailsModal" tabindex="-1" aria-labelledby="reminderDetailsModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title" id="reminderDetailsModalLabel">
                        <i class="bi bi-bell me-2"></i>Reminder Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="reminderDetailsContent">
                        <!-- Reminder details will be loaded here -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <a id="viewPEDetailsBtn" href="#" class="btn btn-primary" target="_blank">
                        <i class="bi bi-eye me-1"></i>View PE Details
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Initialize theme from localStorage or default to light
            const savedTheme = localStorage.getItem('theme') || 'light';
            applyTheme(savedTheme);
            updateToggleState(savedTheme);

            // Dark mode toggle functionality
            $('#darkModeToggle').on('change', function () {
                const isChecked = this.checked;
                const newTheme = isChecked ? 'dark' : 'light';

                applyTheme(newTheme);
                localStorage.setItem('theme', newTheme);
            });

            function applyTheme(theme) {
                // Remove existing theme classes
                document.documentElement.removeAttribute('data-theme');
                document.body.removeAttribute('data-theme');

                // Apply new theme
                document.documentElement.setAttribute('data-theme', theme);
                document.body.setAttribute('data-theme', theme);

                // Update CSS custom properties for smooth transition
                if (theme === 'dark') {
                    document.documentElement.style.setProperty('--bg-color', '#1a1a1a');
                    document.documentElement.style.setProperty('--text-color', '#ffffff');
                    document.documentElement.style.setProperty('--card-bg', '#2d2d2d');
                    document.documentElement.style.setProperty('--border-color', '#404040');
                    document.documentElement.style.setProperty('--input-bg', '#333333');
                } else {
                    document.documentElement.style.setProperty('--bg-color', '#ffffff');
                    document.documentElement.style.setProperty('--text-color', '#212529');
                    document.documentElement.style.setProperty('--card-bg', '#ffffff');
                    document.documentElement.style.setProperty('--border-color', '#dee2e6');
                    document.documentElement.style.setProperty('--input-bg', '#ffffff');
                }
            }

            function updateToggleState(theme) {
                const toggle = document.getElementById('darkModeToggle');
                if (toggle) {
                    toggle.checked = theme === 'dark';
                }
            }

            // Listen for system theme changes
            if (window.matchMedia) {
                const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
                mediaQuery.addEventListener('change', function (e) {
                    // Only auto-switch if user hasn't manually set a preference
                    if (!localStorage.getItem('theme')) {
                        const newTheme = e.matches ? 'dark' : 'light';
                        applyTheme(newTheme);
                        updateToggleState(newTheme);
                    }
                });
            }
        });
    </script>
</body>

</html>
