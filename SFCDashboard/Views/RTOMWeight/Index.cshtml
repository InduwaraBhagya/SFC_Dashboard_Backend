@model IEnumerable<SFCDashboard.Models.RTOMWeight>
@{
    ViewData["Title"] = "Manage RTOM Weights";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-calculator fs-4 me-2"></i>
                    <h5 class="mb-0">RTOM Weight Management</h5>
                </div>
                <a href="javascript:history.back()" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">
                RTOM (Regional Telecom Operation & Maintenance) weights are used to adjust unit prices for BOQ items based on the region.
            </p>
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row">
                <div class="col-md-5">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Add New RTOM Weight</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="Create" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label for="RTOM" class="form-label">RTOM Name</label>
                                    <input type="text" class="form-control" id="RTOM" name="RTOM" required 
                                           placeholder="Enter RTOM name (e.g., Western Region, Colombo)">
                                </div>
                                
                                <div class="mb-3">
                                    <label for="Weight" class="form-label">Weight Factor</label>
                                    <input type="number" class="form-control" id="Weight" name="Weight" required 
                                           placeholder="Enter weight factor (e.g., 1.2)" step="0.01" min="0.01">
                                    <small class="text-muted">This value will multiply the base unit price</small>
                                </div>
                                
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-plus-circle me-1"></i>Add RTOM Weight
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-7">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">RTOM Weight List</h5>
                        </div>
                        <div class="card-body p-0">
                            @if (Model.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>RTOM</th>
                                                <th>Weight Factor</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr data-id="@item.Id">
                                                    <td>@item.RTOM</td>
                                                    <td>@item.Weight.ToString("N2")</td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" class="btn btn-outline-primary edit-rtom-weight"
                                                                    data-id="@item.Id" data-rtom="@item.RTOM" data-weight="@item.Weight">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-outline-danger delete-rtom-weight" data-id="@item.Id">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-info-circle fs-1 text-muted"></i>
                                    <p class="mt-3 text-muted">No RTOM Weights defined yet.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editRTOMModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit RTOM Weight</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editId" name="Id">
                    
                    <div class="mb-3">
                        <label for="editRTOM" class="form-label">RTOM Name</label>
                        <input type="text" class="form-control" id="editRTOM" name="RTOM" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="editWeight" class="form-label">Weight Factor</label>
                        <input type="number" class="form-control" id="editWeight" name="Weight" required step="0.01" min="0.01">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Form (Hidden) -->
<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteId" name="id">
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Edit RTOM Weight
            $('.edit-rtom-weight').click(function() {
                var id = $(this).data('id');
                var rtom = $(this).data('rtom');
                var weight = $(this).data('weight');
                
                $('#editId').val(id);
                $('#editRTOM').val(rtom);
                $('#editWeight').val(weight);
                
                var modal = new bootstrap.Modal(document.getElementById('editRTOMModal'));
                modal.show();
            });
            
            // Delete RTOM Weight
            $('.delete-rtom-weight').click(function() {
                var id = $(this).data('id');
                var rtom = $(this).closest('tr').find('td:first').text();
                
                if (confirm('Are you sure you want to delete the RTOM Weight for "' + rtom + '"?')) {
                    $('#deleteId').val(id);
                    $('#deleteForm').submit();
                }
            });
        });
    </script>
}