@{
    ViewData["Title"] = "Unauthorized Access";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Unauthorized Access - SLT Fiber</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            width: 100%;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, rgba(1, 86, 166, 1),rgba(77, 183, 73, 1));
        }

        .unauthorized-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            animation: fadeInUp 0.8s ease;
        }

        .unauthorized-card {
            background: rgba(255, 255, 255, 0.95);
            padding: 2.5rem;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 500px;
            text-align: center;
            backdrop-filter: blur(10px);
        }

        h1 {
            color: #dc3545;
            font-size: 2rem;
            margin-bottom: 1.5rem;
        }

        .message {
            color: #666;
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .service-id {
            background: #f8f9fa;
            padding: 1rem;
            border-radius: 10px;
            margin: 1.5rem 0;
            font-family: monospace;
            font-size: 1.2rem;
            color: #666;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 576px) {
            .unauthorized-card {
                padding: 1.5rem;
            }
            h1 { font-size: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="unauthorized-container">
        <div class="unauthorized-card">
            <h1>Unauthorized Access</h1>
            <p class="message">You do not have permission to access this application.</p>
            <p class="message">Please contact your administrator for assistance.</p>
            <div class="service-id">
                Service ID: @ViewData["ServiceId"]
            </div>
        </div>
    </div>
</body>
</html>