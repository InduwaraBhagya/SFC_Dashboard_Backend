@{
    ViewData["Title"] = "Home";
}

<!-- Modern Hero Section -->
<div class="hero-section">
    <div class="hero-background"></div>
    <div class="hero-content">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-12 col-xl-10"> <!-- Increased width -->
                    <div class="hero-inner-content">
                        <div class="hero-badge animate__animated animate__fadeInDown">
                            <i class="bi bi-shield-check me-2"></i>
                            Enterprise Solution
                        </div>
                        <h1 class="hero-title animate__animated animate__fadeInUp animate__delay-1s">
                            Welcome to <span class="text-gradient">SFC Dashboard</span>
                        </h1>
                        <p class="hero-subtitle animate__animated animate__fadeInUp animate__delay-2s">
                            Streamline your operations with our comprehensive Service Orders and Planned Events
                            management platform
                        </p>
                        <div class="hero-actions animate__animated animate__fadeInUp animate__delay-3s">
                            <a href="#dashboard-cards" class="btn-modern btn-primary-modern">
                                <span>Get Started</span>
                                <i class="bi bi-arrow-down"></i>
                            </a>
                            <a href="#features" class="btn-modern btn-outline-modern">
                                <span>Learn More</span>
                                <i class="bi bi-play-circle"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-wave">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path
                d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z"
                opacity=".25" class="shape-fill"></path>
            <path
                d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z"
                opacity=".5" class="shape-fill"></path>
            <path
                d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z"
                class="shape-fill"></path>
        </svg>
    </div>
</div>

<!-- Dashboard Cards Section -->
<div class="dashboard-section" id="dashboard-cards">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">Choose Your Workspace</h2>
            <p class="section-subtitle">Access powerful tools to manage your operations efficiently</p>
        </div>

        <div class="row justify-content-center g-4">
            <!-- Service Orders Card -->
            <div class="col-lg-5 col-md-6">
                <div class="workspace-card so-card animate__animated animate__fadeInLeft">
                    <div class="card-glow"></div>
                    <div class="card-header-modern">
                        <div class="card-icon-modern so-icon">
                            <i class="bi bi-list-check"></i>
                        </div>
                        <div class="card-badge">Coming Soon</div>
                    </div>
                    <div class="card-content-modern">
                        <h3 class="card-title-modern">Service Orders</h3>
                        <p class="card-description-modern">
                            Comprehensive service order management with real-time tracking, automated workflows, and
                            detailed analytics
                        </p>

                        <div class="card-features">
                            <div class="feature-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Real-time Tracking</span>
                            </div>
                            <div class="feature-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Automated Workflows</span>
                            </div>
                            <div class="feature-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Advanced Reports</span>
                            </div>
                        </div>

                        <button class="workspace-btn so-btn" disabled>
                            <span>Coming Soon</span>
                            <i class="bi bi-hourglass-split"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Planned Events Card -->
            <div class="col-lg-5 col-md-6">
                <div class="workspace-card pe-card animate__animated animate__fadeInRight">
                    <div class="card-glow"></div>
                    <div class="card-header-modern">
                        <div class="card-icon-modern pe-icon">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                        <div class="card-badge active">Active</div>
                    </div>
                    <div class="card-content-modern">
                        <h3 class="card-title-modern">Planned Events</h3>
                        <p class="card-description-modern">
                            Advanced event planning and execution with workflow management, task tracking, and team
                            collaboration
                        </p>

                        <div class="card-features">
                            <div class="feature-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Event Scheduling</span>
                            </div>
                            <div class="feature-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Task Management</span>
                            </div>
                            <div class="feature-item">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Team Collaboration</span>
                            </div>
                        </div>

                        <a asp-controller="PlannedEvents" asp-action="Index" class="workspace-btn pe-btn">
                            <span>Access Dashboard</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="features-section" id="features">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h2 class="section-title">Powerful Features</h2>
            <p class="section-subtitle">Everything you need to manage your operations effectively</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="feature-card-modern animate__animated animate__fadeInUp">
                    <div class="feature-icon-modern">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <h4>Real-time Updates</h4>
                    <p>Get instant notifications and live updates on all your operations</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card-modern animate__animated animate__fadeInUp animate__delay-1s">
                    <div class="feature-icon-modern">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h4>Enterprise Security</h4>
                    <p>Bank-level security with advanced encryption and access controls</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card-modern animate__animated animate__fadeInUp animate__delay-2s">
                    <div class="feature-icon-modern">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h4>Analytics Dashboard</h4>
                    <p>Comprehensive insights and reports for data-driven decisions</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card-modern animate__animated animate__fadeInUp animate__delay-3s">
                    <div class="feature-icon-modern">
                        <i class="bi bi-people"></i>
                    </div>
                    <h4>Team Collaboration</h4>
                    <p>Seamless collaboration tools for enhanced productivity</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card-modern animate__animated animate__fadeInUp animate__delay-4s">
                    <div class="feature-icon-modern">
                        <i class="bi bi-gear"></i>
                    </div>
                    <h4>Workflow Automation</h4>
                    <p>Automate repetitive tasks and streamline your processes</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card-modern animate__animated animate__fadeInUp animate__delay-5s">
                    <div class="feature-icon-modern">
                        <i class="bi bi-phone"></i>
                    </div>
                    <h4>Mobile Ready</h4>
                    <p>Access your dashboard anywhere with our responsive design</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS Variables for Blue-White-Dark Blue Theme */
    :root {
        --primary-gradient: linear-gradient(135deg, #0d6efd 0%, #1a365d 100%);
        /* Blue to Dark Blue */
        --secondary-gradient: linear-gradient(135deg, #0dcaf0 0%, #4a90e2 100%);
        /* Light Blue to Medium Blue */
        --success-gradient: linear-gradient(135deg, #3b82f6 0%, #1e3a8a 100%);
        /* Blue to Navy */
        --accent-blue: #0d6efd;
        --accent-dark-blue: #1a365d;
        --accent-light-blue: #60a5fa;
        --light-blue: #e0f2fe;
        --light-ash: #f1f5f9;
        --ash-blue: #64748b;
        --card-bg: var(--bs-body-bg, #ffffff);
        --text-primary: var(--bs-body-color, #212529);
        --text-secondary: var(--bs-secondary-color, #6c757d);
        --border-color: var(--bs-border-color, rgba(0, 0, 0, .125));
        --shadow-color: rgba(0, 0, 0, 0.1);
    }

    [data-theme="dark"] {
        --card-bg: #1e293b;
        --text-primary: #ffffff;
        --text-secondary: #cbd5e1;
        --border-color: rgba(255, 255, 255, .125);
        --shadow-color: rgba(0, 0, 0, 0.4);
        --light-blue: rgba(13, 110, 253, 0.1);
        --light-ash: rgba(71, 85, 105, 0.1);
        --ash-blue: #94a3b8;
    }

    /* Hero Section with Blue-Green Theme */
    .hero-section {
        min-height: 90vh;
        position: relative;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding: 4rem 0;
    }

    .hero-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--primary-gradient);
        z-index: -2;
    }

    .hero-background::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="75" cy="75" r="1" fill="rgba(255,255,255,0.1)"/><circle cx="50" cy="10" r="1" fill="rgba(255,255,255,0.05)"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.3;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        width: 100%;
        padding: 4rem 0;
    }

    .hero-inner-content {
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
        border-radius: 30px;
        padding: 3rem 2rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        padding: 1rem 2rem;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50px;
        color: white;
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 2.5rem;
    }

    .hero-title {
        font-size: 4rem;
        font-weight: 700;
        color: white;
        margin-bottom: 2rem;
        line-height: 1.1;
        padding: 0 1rem;
    }

    .text-gradient {
        background: linear-gradient(135deg, #00cc66, #0066cc, #20c997);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-subtitle {
        font-size: 1.3rem;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 3rem;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
        padding: 0 2rem;
    }

    .hero-actions {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
        padding: 0 1rem;
    }

    .btn-modern {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.25rem 2.5rem;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        min-width: 200px;
        justify-content: center;
    }

    .btn-primary-modern {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
    }

    .btn-primary-modern:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        color: white;
    }

    .btn-outline-modern {
        background: transparent;
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.5);
    }

    .btn-outline-modern:hover {
        background: white;
        color: var(--accent-blue);
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(255, 255, 255, 0.2);
    }

    .hero-wave {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
        transform: rotate(180deg);
    }

    .hero-wave svg {
        position: relative;
        display: block;
        width: calc(100% + 1.3px);
        height: 120px;
    }

    .hero-wave .shape-fill {
        fill: var(--card-bg);
    }

    /* Dashboard Section */
    .dashboard-section {
        padding: 80px 0;
        background: var(--card-bg);
    }

    .section-header {
        margin-bottom: 3rem;
    }

    .section-title {
        font-size: 2.25rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 1rem;
    }

    .section-subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary);
        max-width: 600px;
        margin: 0 auto;
    }

    .workspace-card {
        background: var(--card-bg);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 40px var(--shadow-color);
        transition: all 0.4s ease;
        position: relative;
        height: 100%;
        border: 1px solid var(--border-color);
    }

    .workspace-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 30px 60px var(--shadow-color);
    }

    .card-glow {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        border-radius: 24px;
    }

    .so-card .card-glow {
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.1), rgba(25, 135, 84, 0.1));
    }

    .pe-card .card-glow {
        background: linear-gradient(135deg, rgba(0, 102, 204, 0.1), rgba(0, 204, 102, 0.1));
    }

    .workspace-card:hover .card-glow {
        opacity: 1;
    }

    .card-header-modern {
        padding: 2rem 2rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .card-icon-modern {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .so-icon {
        background: var(--primary-gradient);
    }

    .pe-icon {
        background: var(--success-gradient);
    }

    .card-badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card-badge.active {
        background: linear-gradient(135deg, var(--accent-green), #20c997);
        color: white;
    }

    .card-badge:not(.active) {
        background: rgba(108, 117, 125, 0.1);
        color: var(--text-secondary);
    }

    .card-content-modern {
        padding: 1rem 2rem 2rem;
    }

    .card-title-modern {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 1rem;
    }

    .card-description-modern {
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .card-features {
        margin-bottom: 2rem;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        color: var(--text-primary);
    }

    .feature-item i {
        color: var(--accent-green);
        font-size: 1.1rem;
    }

    .workspace-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 1rem 1.5rem;
        border: none;
        border-radius: 16px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .workspace-btn:not(:disabled) {
        color: white;
    }

    .so-btn:not(:disabled) {
        background: var(--primary-gradient);
    }

    .pe-btn:not(:disabled) {
        background: var(--success-gradient);
    }

    .workspace-btn:not(:disabled):hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        color: white;
    }

    .workspace-btn:disabled {
        background: rgba(108, 117, 125, 0.2);
        color: var(--text-secondary);
        cursor: not-allowed;
    }

    /* Features Section with Blue-Green Theme */
    .features-section {
        padding: 80px 0;
        background: linear-gradient(135deg, var(--light-blue) 0%, var(--light-green) 100%);
        position: relative;
        overflow: hidden;
    }

    [data-theme="dark"] .features-section {
        background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    }

    .feature-card-modern {
        background: var(--card-bg);
        padding: 2rem 1.5rem;
        border-radius: 20px;
        text-align: center;
        border: 1px solid var(--border-color);
        box-shadow: 0 8px 25px var(--shadow-color);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .feature-card-modern::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(13, 110, 253, 0.1), transparent);
        transition: left 0.6s ease;
        z-index: 1;
    }

    .feature-card-modern:hover::before {
        left: 100%;
    }

    .feature-card-modern:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 25px 50px var(--shadow-color);
        border-color: var(--accent-blue);
    }

    [data-theme="dark"] .feature-card-modern:hover {
        border-color: var(--accent-green);
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
    }

    .feature-icon-modern {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 1.8rem;
        color: white;
        background: var(--primary-gradient);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        z-index: 2;
    }

    .feature-card-modern:hover .feature-icon-modern {
        transform: scale(1.1) rotate(5deg);
        background: var(--success-gradient);
        box-shadow: 0 10px 30px rgba(0, 102, 204, 0.4);
    }

    .feature-card-modern h4 {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        position: relative;
        z-index: 2;
    }

    .feature-card-modern:hover h4 {
        color: var(--accent-blue);
        transform: translateY(-2px);
    }

    [data-theme="dark"] .feature-card-modern:hover h4 {
        color: var(--accent-green);
    }

    .feature-card-modern p {
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 0;
        transition: all 0.3s ease;
        position: relative;
        z-index: 2;
    }

    .feature-card-modern:hover p {
        color: var(--text-primary);
        transform: translateY(-1px);
    }

    /* Background animation for features section with blue-green theme */
    .features-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at 20% 80%, rgba(13, 110, 253, 0.05) 0%, transparent 50%),
            radial-gradient(circle at 80% 20%, rgba(25, 135, 84, 0.05) 0%, transparent 50%);
        animation: backgroundFloat 20s ease-in-out infinite;
        z-index: 0;
    }

    @@keyframes backgroundFloat {

        0%,
        100% {
            transform: translateY(0px) rotate(0deg);
        }

        50% {
            transform: translateY(-10px) rotate(1deg);
        }
    }

    .features-section .container {
        position: relative;
        z-index: 1;
    }

    /* Add floating animation to feature cards */
    @@keyframes float {

        0%,
        100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    .feature-card-modern:nth-child(odd) {
        animation: float 6s ease-in-out infinite;
    }

    .feature-card-modern:nth-child(even) {
        animation: float 6s ease-in-out infinite reverse;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero-section {
            min-height: 80vh;
            padding: 2rem 0;
        }

        .hero-content {
            padding: 2rem 0;
        }

        .hero-inner-content {
            padding: 2rem 1rem;
            border-radius: 20px;
        }

        .hero-title {
            font-size: 2.5rem;
            padding: 0;
        }

        .hero-subtitle {
            font-size: 1.1rem;
            padding: 0;
            margin-bottom: 2rem;
        }

        .hero-actions {
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            padding: 0;
        }

        .btn-modern {
            width: 100%;
            max-width: 300px;
            padding: 1rem 2rem;
        }
    }

    @@media (max-width: 576px) {
        .hero-title {
            font-size: 2rem;
        }

        .hero-badge {
            padding: 0.75rem 1.5rem;
            font-size: 0.9rem;
        }

        .hero-inner-content {
            padding: 1.5rem 1rem;
        }
    }

    /* Animation on scroll */
    .animate__animated {
        animation-duration: 1s;
        animation-fill-mode: both;
    }

    /* Smooth scrolling */
    html {
        scroll-behavior: smooth;
    }

    /* Enhanced Badge Animations - Coming Soon and Active only */
    .card-badge {
        position: relative;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Coming Soon Badge Animation */
    .card-badge:not(.active) {
        background: linear-gradient(135deg, #ffc107, #fd7e14);
        color: #212529;
        animation: comingSoonGlow 3s ease-in-out infinite;
        box-shadow: 0 0 15px rgba(255, 193, 7, 0.3);
    }

    .card-badge:not(.active)::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
        animation: slideAcross 2s linear infinite;
    }

    .card-badge:not(.active)::after {
        content: '⏳';
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.7rem;
        animation: hourglassRotate 2s ease-in-out infinite;
    }

    /* Active Badge Animation */
    .card-badge.active {
        background: linear-gradient(135deg, #198754, #20c997);
        color: white;
        animation: activePulse 2s ease-in-out infinite;
        box-shadow: 0 0 20px rgba(25, 135, 84, 0.4);
    }

    .card-badge.active::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transform: rotate(45deg);
        animation: shimmerActive 3s linear infinite;
    }

    .card-badge.active::after {
        content: '✓';
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.7rem;
        animation: checkBounce 2s ease-in-out infinite;
    }

    /* Keyframe Animations */
    @@keyframes comingSoonGlow {

        0%,
        100% {
            box-shadow: 0 0 15px rgba(255, 193, 7, 0.3);
            filter: brightness(1);
        }

        50% {
            box-shadow: 0 0 25px rgba(255, 193, 7, 0.6);
            filter: brightness(1.1);
        }
    }

    @@keyframes slideAcross {
        0% {
            left: -100%;
        }

        100% {
            left: 100%;
        }
    }

    @@keyframes hourglassRotate {

        0%,
        100% {
            transform: translateY(-50%) rotate(0deg);
        }

        50% {
            transform: translateY(-50%) rotate(180deg);
        }
    }

    @@keyframes activePulse {

        0%,
        100% {
            transform: scale(1);
            box-shadow: 0 0 20px rgba(25, 135, 84, 0.4);
        }

        50% {
            transform: scale(1.05);
            box-shadow: 0 0 30px rgba(25, 135, 84, 0.6);
        }
    }

    @@keyframes shimmerActive {
        0% {
            transform: translateX(-100%) translateY(-100%) rotate(45deg);
        }

        100% {
            transform: translateX(100%) translateY(100%) rotate(45deg);
        }
    }

    @@keyframes checkBounce {

        0%,
        80%,
        100% {
            transform: translateY(-50%) scale(1);
        }

        40% {
            transform: translateY(-50%) scale(1.2);
        }
    }

    /* Enhanced hover effects for badges */
    .workspace-card:hover .card-badge.active {
        animation: activePulse 1s ease-in-out infinite;
        transform: scale(1.1);
    }

    .workspace-card:hover .card-badge:not(.active) {
        animation: comingSoonGlow 1.5s ease-in-out infinite;
        transform: scale(1.1);
    }

    /* Dark Theme Support */
    [data-theme="dark"] .card-badge.active {
        box-shadow: 0 0 20px rgba(25, 135, 84, 0.6);
    }

    [data-theme="dark"] .card-badge:not(.active) {
        box-shadow: 0 0 15px rgba(255, 193, 7, 0.5);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add parallax effect to hero background
        window.addEventListener('scroll', function () {
            const scrolled = window.pageYOffset;
            const heroBackground = document.querySelector('.hero-background');
            if (heroBackground) {
                heroBackground.style.transform = `translateY(${scrolled * 0.5}px)`;
            }
        });

        // Animate cards on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver(function (entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate__fadeInUp');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.workspace-card, .feature-card-modern').forEach(card => {
            observer.observe(card);
        });

        // Enhanced badge interactions
        const badges = document.querySelectorAll('.card-badge');

        badges.forEach(badge => {
            // Add click animation
            badge.addEventListener('click', function () {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 150);

                // Add ripple effect
                const ripple = document.createElement('span');
                ripple.style.cssText = `
                position: absolute;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.6);
                transform: scale(0);
                animation: ripple 0.6s linear;
                pointer-events: none;
                z-index: 1;
            `;

                const rect = this.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);
                ripple.style.width = ripple.style.height = size + 'px';
                ripple.style.left = (rect.width / 2 - size / 2) + 'px';
                ripple.style.top = (rect.height / 2 - size / 2) + 'px';

                this.appendChild(ripple);

                setTimeout(() => {
                    ripple.remove();
                }, 600);
            });

            // Add random sparkle effect for active badges
            if (badge.classList.contains('active')) {
                setInterval(() => {
                    if (Math.random() > 0.8) { // 20% chance
                        addSparkle(badge);
                    }
                }, 3000);
            }
        });

        function addSparkle(element) {
            const sparkle = document.createElement('span');
            sparkle.innerHTML = '✨';
            sparkle.style.cssText = `
            position: absolute;
            top: ${Math.random() * 100}%;
            left: ${Math.random() * 100}%;
            font-size: 0.8rem;
            pointer-events: none;
            animation: sparkleFloat 1.5s ease-out forwards;
            z-index: 5;
        `;

            element.appendChild(sparkle);

            setTimeout(() => {
                sparkle.remove();
            }, 1500);
        }

        // Add CSS for additional animations
        const additionalStyle = document.createElement('style');
        additionalStyle.textContent = `
        @@keyframes sparkleFloat {
            0% {
                opacity: 0;
                transform: translateY(0) scale(0);
            }
            50% {
                opacity: 1;
                transform: translateY(-10px) scale(1);
            }
            100% {
                opacity: 0;
                transform: translateY(-20px) scale(0);
            }
        }
        
        @@keyframes ripple {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }
    `;
        document.head.appendChild(additionalStyle);
    });
</script>