@{
    ViewData["Title"] = "Home Page";
    Layout = null; /* Important: This removes the default layout which is causing the white space */
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SLT Fiber Dashboard</title>
    <style>
        /* Reset all margins and padding */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            height: 100%;
            width: 100%;
            font-family: Arial, sans-serif;
        }

        /* Fullscreen hero section */
        .hero-section {
            position: relative;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            color: white;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
        }

        .video-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }

            .video-background video {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(76, 0, 130, 0.7), rgba(0, 0, 255, 0.5), rgba(0, 128, 128, 0.6));
            z-index: -1;
        }

        /* Header area */
        .header {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
        }

        .logo {
            color: white;
            text-decoration: none;
            font-size: 1.5rem;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
        }

            .nav-links a {
                color: white;
                text-decoration: none;
                padding: 8px 15px;
                font-weight: bold;
                transition: all 0.3s ease;
            }

                .nav-links a:hover {
                    text-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
                }

        /* Content area */
        .content {
            position: relative;
            z-index: 1;
            padding: 20px;
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100%;
        }

        h1 {
            font-size: 4rem;
            margin-bottom: 1.5rem;
            animation: fadeInUp 1s ease;
            color: #ffffff;
        }

        p {
            font-size: 1.5rem;
            margin-bottom: 2rem;
            animation: fadeInUp 1.2s ease;
        }

        .btn-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 40px;
            animation: fadeInUp 1.4s ease;
        }

        .btn {
            display: inline-block;
            padding: 12px 30px;
            background: linear-gradient(45deg, #ff6b6b, #ffb347);
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            font-size: 1.2rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

            .btn:hover {
                transform: translateY(-5px);
                box-shadow: 0 7px 20px rgba(0, 0, 0, 0.3);
                background: linear-gradient(45deg, #ff8e8e, #ffcc7a);
            }

        .features {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            width: 100%;
            gap: 20px;
            animation: fadeInUp 1.6s ease;
        }

        .feature-box {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            padding: 1.5rem;
            border-radius: 15px;
            flex: 1 1 250px;
            max-width: 300px;
            transition: all 0.3s ease;
        }

            .feature-box:hover {
                transform: translateY(-10px);
                background: rgba(255, 255, 255, 0.3);
            }

            .feature-box h3 {
                font-size: 1.5rem;
                margin-bottom: 1rem;
                color: #ffffff;
            }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            h1 {
                font-size: 2.5rem;
            }

            p {
                font-size: 1.2rem;
            }

            .feature-box {
                flex: 1 1 100%;
                margin-bottom: 20px;
            }

            .features {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
</head>
<body>
    <div class="hero-section">
        <div class="header">
            <a href="#" class="logo" id="logo">SLT FIBER</a>
            <div class="nav-links">
                <a href="/PERecords/Index">Home</a>
            </div>
        </div>

        <div class="video-background">
            <video autoplay muted loop id="backgroundVideo">
                <source src="~/video/sltFiber.mp4" type="video/mp4">
                Your browser does not support the video tag.
            </video>
        </div>
        <div class="overlay"></div>

        <div class="content">
            <h1>SLT Fiber Dashboard</h1>
            <p>Manage fiber connections efficiently with our comprehensive tracking system</p>

            <div class="btn-container">
                <a href="/Account/Register" class="btn">Sign Up</a>
                <a href="/Account/Login" class="btn">Login</a>
            </div>

            <div class="features">
                <div class="feature-box">
                    <h3>Real-time Monitoring</h3>
                    <p>Track the status of fiber connections in real-time across the network</p>
                </div>
                <div class="feature-box">
                    <h3>Smart Notifications</h3>
                    <p>Receive instant alerts and escalation notifications to improve response time</p>
                </div>
                <div class="feature-box">
                    <h3>Enhanced Efficiency</h3>
                    <p>Streamlined processes to speed up service delivery and boost customer satisfaction</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Get the video element
            const video = document.getElementById('backgroundVideo');

            // Add click event to logo
            const logo = document.getElementById('logo');
            if (logo) {
                logo.addEventListener('click', function(e) {
                    e.preventDefault();

                    // Play or restart the video
                    video.currentTime = 0;
                    video.play();
                });
            }
        });
    </script>
</body>
</html>