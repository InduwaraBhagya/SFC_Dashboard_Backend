@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4 mb-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h2 class="card-title">SO</h2>
                    <p class="card-text">Service Order Dashboard</p>
                    <a href="#" class="btn btn-primary stretched-link">Access SO</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card text-center h-100">
                <a asp-controller="PlannedEvents" asp-action="Index" class="text-decoration-none">
                    <div class="card-body">
                        <h2 class="card-title">PE</h2>
                        <p class="card-text">Planned Events Dashboard</p>
                        <div class="btn btn-primary">Access PE</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s;
        cursor: pointer;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .card-body {
        padding: 2rem;
    }
</style>      