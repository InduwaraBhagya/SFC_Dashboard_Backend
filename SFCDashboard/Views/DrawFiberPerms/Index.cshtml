@model List<SFCDashboard.Controllers.DrawFiberPermsViewModel>

@{
    ViewData["Title"] = "Draw Fiber Permissions Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/drawfiberperms.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="container-fluid draw-fiber-perms-container">
    <div class="row">
        <div class="col-12">
            <div class="card draw-fiber-perms-card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-key-fill me-2"></i>
                        Draw Fiber Permissions Management
                    </h3>
                    <p class="mb-0 mt-2">
                        <small>Manage permissions for users in NET-PROJ-ACC-CABLE workgroup</small>
                    </p>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="mb-2">
                            <button id="refreshPermissionsBtn" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Permissions
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col">User Name</th>
                                        <th scope="col">Service ID</th>
                                        <th scope="col">Role</th>
                                        <th scope="col" class="text-center">
                                            <i class="bi bi-folder-fill me-1"></i>
                                            Manage Projects
                                        </th>
                                        <th scope="col" class="text-center">
                                            <i class="bi bi-clock-fill me-1"></i>
                                            Manage Estimated Time
                                        </th>
                                        <th scope="col" class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr id="user-row-@user.UserId">
                                            <td class="fw-bold">@user.UserName</td>
                                            <td>
                                                <span class="badge bg-secondary">@user.ServiceId</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@user.RoleName</span>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-inline-block">
                                                    <input class="form-check-input permission-toggle" 
                                                           type="checkbox" 
                                                           id="manageProjects-@user.UserId"
                                                           data-user-id="@user.UserId"
                                                           data-permission="manageProjects"
                                                           @(user.HasManageProjects ? "checked" : "")>
                                                    <label class="form-check-label" for="manageProjects-@user.UserId">
                                                        <i class="bi bi-@(user.HasManageProjects ? "check-circle-fill text-success" : "x-circle-fill text-danger")"></i>
                                                    </label>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="form-check form-switch d-inline-block">
                                                    <input class="form-check-input permission-toggle" 
                                                           type="checkbox" 
                                                           id="canManageEstimatedTime-@user.UserId"
                                                           data-user-id="@user.UserId"
                                                           data-permission="canManageEstimatedTime"
                                                           @(user.HasCanManageEstimatedTime ? "checked" : "")>
                                                    <label class="form-check-label" for="canManageEstimatedTime-@user.UserId">
                                                        <i class="bi bi-@(user.HasCanManageEstimatedTime ? "check-circle-fill text-success" : "x-circle-fill text-danger")"></i>
                                                    </label>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" 
                                                        class="btn btn-sm btn-success update-permissions-btn"
                                                        data-user-id="@user.UserId"
                                                        data-user-name="@user.UserName">
                                                    <i class="bi bi-floppy-fill me-1"></i>
                                                    Update
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <div class="alert alert-info">
                                <h6 class="alert-heading">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    Permission Information
                                </h6>
                                <ul class="mb-0">
                                    <li><strong>Manage Projects:</strong> Allows users to create, edit, and manage projects</li>
                                    <li><strong>Manage Estimated Time:</strong> Allows users to modify estimated time for tasks</li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            No users found in the NET-PROJ-ACC-CABLE workgroup.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Modal -->
<div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" id="modalHeader">
                <h5 class="modal-title" id="resultModalLabel">Update Result</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Message will be inserted here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Handle permission updates
            $('.update-permissions-btn').click(function() {
                var userId = $(this).data('user-id');
                var userName = $(this).data('user-name');
                var row = $('#user-row-' + userId);
                
                var manageProjects = row.find('input[data-permission="manageProjects"]').is(':checked');
                var canManageEstimatedTime = row.find('input[data-permission="canManageEstimatedTime"]').is(':checked');
                
                // Show loading state
                var originalText = $(this).html();
                $(this).html('<i class="bi bi-arrow-repeat spin me-1"></i>Updating...').prop('disabled', true);
                
                $.ajax({
                    url: '@Url.Action("UpdatePermissions", "DrawFiberPerms")',
                    type: 'POST',
                    data: {
                        userId: userId,
                        manageProjects: manageProjects,
                        canManageEstimatedTime: canManageEstimatedTime,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            showResultModal('Success', response.message, 'success');
                            updatePermissionIcons(userId, manageProjects, canManageEstimatedTime);
                            // Auto-refresh after short delay to ensure UI matches backend
                            setTimeout(function() { window.location.reload(); }, 1200);
                        } else {
                            showResultModal('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        showResultModal('Error', 'An unexpected error occurred while updating permissions.', 'error');
                    },
                    complete: function() {
                        // Restore button state
                        $('.update-permissions-btn[data-user-id="' + userId + '"]')
                            .html(originalText)
                            .prop('disabled', false);
                    }
                });
            });
            
            // Refresh Permissions button handler
            $('#refreshPermissionsBtn').click(function() {
                window.location.reload();
            });
            
            function updatePermissionIcons(userId, manageProjects, canManageEstimatedTime) {
                var row = $('#user-row-' + userId);
                
                // Update Manage Projects icon
                var manageProjectsLabel = row.find('label[for="manageProjects-' + userId + '"] i');
                if (manageProjects) {
                    manageProjectsLabel.removeClass('bi-x-circle-fill text-danger')
                                      .addClass('bi-check-circle-fill text-success');
                } else {
                    manageProjectsLabel.removeClass('bi-check-circle-fill text-success')
                                      .addClass('bi-x-circle-fill text-danger');
                }
                
                // Update Can Manage Estimated Time icon
                var canManageEstimatedTimeLabel = row.find('label[for="canManageEstimatedTime-' + userId + '"] i');
                if (canManageEstimatedTime) {
                    canManageEstimatedTimeLabel.removeClass('bi-x-circle-fill text-danger')
                                              .addClass('bi-check-circle-fill text-success');
                } else {
                    canManageEstimatedTimeLabel.removeClass('bi-check-circle-fill text-success')
                                              .addClass('bi-x-circle-fill text-danger');
                }
            }
            
            function showResultModal(title, message, type) {
                var modal = $('#resultModal');
                var header = $('#modalHeader');
                var body = $('#modalBody');
                
                // Set modal style based on type
                header.removeClass('bg-success bg-danger text-white');
                if (type === 'success') {
                    header.addClass('bg-success text-white');
                    body.html('<div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>' + message + '</div>');
                } else {
                    header.addClass('bg-danger text-white');
                    body.html('<div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>' + message + '</div>');
                }
                
                $('#resultModalLabel').text(title);
                modal.modal('show');
            }
        });
    </script>
    

}
