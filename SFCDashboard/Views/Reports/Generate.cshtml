@model List<SFCDB.Models.PERecord>
@{
    ViewData["Title"] = "Report Generator";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h3 class="card-title text-white mb-0">
                        <i class="bi bi-file-earmark-bar-graph me-2"></i>PE Records Report Generator
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Filters Section -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h5><i class="bi bi-funnel me-2"></i>Filters</h5>
                            <form id="filterForm" class="row g-3">
                                <div class="col-md-2">
                                    <label for="provinceFilter" class="form-label">Province</label>
                                    <select class="form-select" id="provinceFilter" name="province">
                                        <option value="">All Provinces</option>
                                        @foreach (var province in ViewBag.Provinces as List<string>)
                                        {
                                            <option value="@province">@province</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label for="regionFilter" class="form-label">Region</label>
                                    <select class="form-select" id="regionFilter" name="region">
                                        <option value="">All Regions</option>
                                        @foreach (var region in ViewBag.Regions as List<string>)
                                        {
                                            <option value="@region">@region</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label for="rtomFilter" class="form-label">RTOM</label>
                                    <select class="form-select" id="rtomFilter" name="rtom">
                                        <option value="">All RTOMs</option>
                                        @foreach (var rtom in ViewBag.RTOMs as List<string>)
                                        {
                                            <option value="@rtom">@rtom</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label for="contractorFilter" class="form-label">Contractor</label>
                                    <select class="form-select" id="contractorFilter" name="contractorName">
                                        <option value="">All Contractors</option>
                                        @foreach (var contractor in ViewBag.ContractorNames as List<string>)
                                        {
                                            <option value="@contractor">@contractor</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label for="soNumberFilter" class="form-label">SO Number</label>
                                    <select class="form-select" id="soNumberFilter" name="soNumber">
                                        <option value="">All SO Numbers</option>
                                        @foreach (var soNumber in ViewBag.SONumbers as List<string>)
                                        {
                                            <option value="@soNumber">@soNumber</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label for="customerFilter" class="form-label">Customer</label>
                                    <select class="form-select" id="customerFilter" name="customer">
                                        <option value="">All Customers</option>
                                        @foreach (var customer in ViewBag.Customers as List<string>)
                                        {
                                            <option value="@customer">@customer</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <button type="button" class="btn btn-primary" onclick="applyFilters()">
                                        <i class="bi bi-search me-1"></i>Apply Filters
                                    </button>
                                    <button type="button" class="btn btn-secondary" onclick="clearFilters()">
                                        <i class="bi bi-arrow-clockwise me-1"></i>Clear Filters
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Export Buttons -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <h5><i class="bi bi-download me-2"></i>Export Options</h5>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-success" onclick="exportData('excel')">
                                    <i class="bi bi-file-excel me-1"></i>Export to Excel
                                </button>
                                <button type="button" class="btn btn-danger" onclick="exportData('pdf')">
                                    <i class="bi bi-file-pdf me-1"></i>Export to PDF
                                </button>
                                <button type="button" class="btn btn-info" onclick="exportData('png')">
                                    <i class="bi bi-image me-1"></i>Export to PNG
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Records Count -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                <span id="recordsCount">Total Records: @Model.Count</span>
                            </div>
                        </div>
                    </div>

                    <!-- Data Table -->
                    <div class="row">
                        <div class="col-12">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover" id="recordsTable">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>ID</th>
                                            <th>Province</th>
                                            <th>Region</th>
                                            <th>RTOM</th>
                                            <th>Contractor Name</th>
                                            <th>SO Number</th>
                                            <th>Customer</th>
                                            <th>PE Number</th>
                                            <th>PE Title</th>
                                            <th>PE Activity</th>
                                            <th>PE Nature</th>
                                        </tr>
                                    </thead>
                                    <tbody id="recordsTableBody">
                                        @foreach (var record in Model)
                                        {
                                            <tr>
                                                <td>@record.ID</td>
                                                <td>@(record.PROVINCE ?? "")</td>
                                                <td>@(record.REGION ?? "")</td>
                                                <td>@(record.RTOM ?? "")</td>
                                                <td>@(record.CONTRACTOR_NAME ?? "")</td>
                                                <td>@(record.SO_NUMBER ?? "")</td>
                                                <td>@(record.CUSTOMER ?? "")</td>
                                                <td>@(record.PE_NUMBER ?? "")</td>
                                                <td>@(record.PE_TITLE ?? "")</td>
                                                <td>@(record.PE_ACTIVITY ?? "")</td>
                                                <td>@(record.PE_NATURE ?? "")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Modal -->
<div class="modal fade" id="loadingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static"
    data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5>Processing...</h5>
                <p>Please wait while we process your request.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Store all data for fast client-side filtering
        let allRecords = [];
        let filteredRecords = [];

        // Initialize data from the table
        document.addEventListener('DOMContentLoaded', function () {
            initializeData();
            setupRealTimeFiltering();
            console.log('Reports page loaded with @Model.Count records');
        });

        function initializeData() {
            const tbody = document.getElementById('recordsTableBody');
            const rows = tbody.querySelectorAll('tr');

            allRecords = Array.from(rows).map(row => {
                const cells = row.querySelectorAll('td');
                return {
                    id: cells[0].textContent.trim(),
                    province: cells[1].textContent.trim(),
                    region: cells[2].textContent.trim(),
                    rtom: cells[3].textContent.trim(),
                    contractor_name: cells[4].textContent.trim(),
                    so_number: cells[5].textContent.trim(),
                    customer: cells[6].textContent.trim(),
                    pe_number: cells[7].textContent.trim(),
                    pe_title: cells[8].textContent.trim(),
                    pe_activity: cells[9].textContent.trim(),
                    pe_nature: cells[10].textContent.trim(),
                    element: row // Keep reference to DOM element for fast manipulation
                };
            });

            filteredRecords = [...allRecords];
        }

        function setupRealTimeFiltering() {
            // Add event listeners for real-time filtering
            const filterInputs = document.querySelectorAll('#filterForm select, #filterForm input');
            filterInputs.forEach(input => {
                input.addEventListener('change', applyFiltersInstant);
                if (input.type === 'text') {
                    input.addEventListener('input', debounce(applyFiltersInstant, 300));
                }
            });
        }

        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        function applyFilters() {
            // This function is called by the Apply Filters button
            applyFiltersInstant();
        }

        function applyFiltersInstant() {
            // Show minimal loading for visual feedback
            const button = document.querySelector('button[onclick="applyFilters()"]');
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i> Filtering...';
            button.disabled = true;

            // Small delay to show the feedback, then filter instantly
            setTimeout(() => {
                performClientSideFilter();
                button.innerHTML = originalText;
                button.disabled = false;
            }, 100);
        }

        function performClientSideFilter() {
            const filters = {
                province: document.getElementById('provinceFilter').value.toLowerCase(),
                region: document.getElementById('regionFilter').value.toLowerCase(),
                rtom: document.getElementById('rtomFilter').value.toLowerCase(),
                contractor: document.getElementById('contractorFilter')?.value.toLowerCase() || '',
                soNumber: document.getElementById('soNumberFilter')?.value.toLowerCase() || '',
                customer: document.getElementById('customerFilter')?.value.toLowerCase() || '',
                peNumber: document.getElementById('peNumberFilter')?.value.toLowerCase() || ''
            };

            // Filter records instantly
            filteredRecords = allRecords.filter(record => {
                return (!filters.province || record.province.toLowerCase().includes(filters.province)) &&
                    (!filters.region || record.region.toLowerCase().includes(filters.region)) &&
                    (!filters.rtom || record.rtom.toLowerCase().includes(filters.rtom)) &&
                    (!filters.contractor || record.contractor_name.toLowerCase().includes(filters.contractor)) &&
                    (!filters.soNumber || record.so_number.toLowerCase().includes(filters.soNumber)) &&
                    (!filters.customer || record.customer.toLowerCase().includes(filters.customer)) &&
                    (!filters.peNumber || record.pe_number.toLowerCase().includes(filters.peNumber));
            });

            updateTableInstant();
            updateRecordsCount(filteredRecords.length);
        }

        function updateTableInstant() {
            const tbody = document.getElementById('recordsTableBody');

            // Hide all rows first
            allRecords.forEach(record => {
                record.element.style.display = 'none';
            });

            // Show only filtered rows
            filteredRecords.forEach(record => {
                record.element.style.display = '';
            });
        }

        function clearFilters() {
            document.getElementById('filterForm').reset();
            filteredRecords = [...allRecords];
            updateTableInstant();
            updateRecordsCount(allRecords.length);
        }

        function updateRecordsCount(count) {
            document.getElementById('recordsCount').textContent = `Total Records: ${count}`;
        }

        function exportData(format) {
            showLoading();

            const formData = new FormData(document.getElementById('filterForm'));
            const params = new URLSearchParams(formData).toString();

            let url = '';
            switch (format) {
                case 'excel':
                    url = '/Reports/ExportExcel';
                    break;
                case 'pdf':
                    url = '/Reports/ExportPDF';
                    break;
                case 'png':
                    url = '/Reports/ExportPNG';
                    break;
                default:
                    hideLoading();
                    alert('Invalid export format');
                    return;
            }

            if (params) {
                url += '?' + params;
            }

            // Create a temporary link to download the file
            const link = document.createElement('a');
            link.href = url;
            link.download = '';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            setTimeout(() => {
                hideLoading();
            }, 2000);
        }

        function showLoading() {
            const modal = new bootstrap.Modal(document.getElementById('loadingModal'));
            modal.show();
        }

        function hideLoading() {
            const modal = bootstrap.Modal.getInstance(document.getElementById('loadingModal'));
            if (modal) {
                modal.hide();
            }
        }
    </script>

    <style>
        .spin {
            animation: spin 1s linear infinite;
        }

        /* CSS keyframes for spin animation */
        @@keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }
    </style>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
