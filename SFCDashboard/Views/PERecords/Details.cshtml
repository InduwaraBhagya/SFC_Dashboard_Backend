@model SFCDB.Models.PERecord

@{
    ViewData["Title"] = "PE Record Details";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">PE Record Details</h2>
            <div>
                <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-sm btn-light me-2">
                    <i class="bi bi-pencil-square"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-sm btn-light">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <tbody>
                        <tr>
                            <th class="bg-light text-primary" style="width: 25%">PE Number (PK)</th>
                            <td>@Html.DisplayFor(model => model.PE_NUMBER)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Job Reference Number</th>
                            <td>@Html.DisplayFor(model => model.JOB_REFERENCE)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">SO Number</th>
                            <td>@Html.DisplayFor(model => model.SO_NUMBER)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Region</th>
                            <td>@Html.DisplayFor(model => model.REGION)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Area</th>
                            <td>@Html.DisplayFor(model => model.PE_AREA)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Task</th>
                            <td>@Html.DisplayFor(model => model.TASK_NAME)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Status</th>
                            <td>
                                @{
                                    string statusClass = Model.WO_STATUS?.ToLower() switch
                                    {
                                        "completed" => "badge bg-success",
                                        "in progress" => "badge bg-warning text-dark",
                                        "pending" => "badge bg-info",
                                        _ => "badge bg-secondary"
                                    };
                                }
                                <span class="@statusClass">@Html.DisplayFor(model => model.WO_STATUS)</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Start Time</th>
                            <td>@Html.DisplayFor(model => model.WO_START_DATE)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">End Time</th>
                            <td>@Html.DisplayFor(model => model.WO_ACTUAL_START_DATE)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Is Urgent</th>
                            <td>
                                @{
                                    string urgentText = Model.SERVICE_SPEED?.ToLower()?.Contains("urgent") == true ? "Yes" : "No";
                                    string urgentClass = urgentText == "Yes" ? "text-danger fw-bold" : "";
                                }
                                <span class="@urgentClass">@urgentText</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">RTOM</th>
                            <td>@Html.DisplayFor(model => model.RTOM)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Contractor Name</th>
                            <td>@Html.DisplayFor(model => model.CONTRACTOR_NAME)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">PE Objective</th>
                            <td>@Html.DisplayFor(model => model.PE_OBJECTIVE)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Order Type</th>
                            <td>@Html.DisplayFor(model => model.ORDER_TYPE)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Pending Task Name</th>
                            <td>@Html.DisplayFor(model => model.PENDING_TASK_NAME)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Pending Workgroup</th>
                            <td>@Html.DisplayFor(model => model.PENDING_WG)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Account Manager</th>
                            <td>@Html.DisplayFor(model => model.ACCOUNT_MANAGER)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Section Handled By</th>
                            <td>@Html.DisplayFor(model => model.SECTION_HANDLED_BY)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Service Required Date</th>
                            <td>@Html.DisplayFor(model => model.SERVICE_REQUIRED_DATE)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Fiber PE Task Workgroup</th>
                            <td>@Html.DisplayFor(model => model.FIBER_PE_TASK_WG)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        
    </div>
</div>