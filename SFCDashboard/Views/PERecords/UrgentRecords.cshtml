@model IEnumerable<SFCDB.Models.PERecord>

@{
    ViewData["Title"] = "Urgent Records";
}

<h1>Urgent Records</h1>

<table class="table table-striped">
    <thead class="thead-dark">
        <tr>
            <th>PE Number</th>
            <th>Customer</th>
            <th>Job Reference</th>
            <th>RTOM</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.PE_NUMBER)</td>
                <td>@Html.DisplayFor(modelItem => item.CUSTOMER)</td>
                <td>@Html.DisplayFor(modelItem => item.JOB_REFERENCE)</td>
                <td>@Html.DisplayFor(modelItem => item.RTOM)</td>
                <td>@Html.DisplayFor(modelItem => item.WO_STATUS)</td>
                <td>
                    @if (item.WO_COMMENTS != null && item.WO_COMMENTS.Contains("Priority 1"))
                    {
                        <span class="badge bg-danger">Priority 1</span>
                    }
                    else if (item.WO_COMMENTS != null && item.WO_COMMENTS.Contains("Priority 2"))
                    {
                        <span class="badge bg-warning text-dark">Priority 2</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Standard</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-info btn-sm">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>