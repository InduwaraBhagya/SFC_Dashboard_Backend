// Load categories for edit form
function loadEditCategories(selectedCategoryId, callback) {
    $.ajax({
        url: '@Url.Action("GetCategories", "BOQ")',
        type: 'GET',
        success: function(data) {
            $('#editCategoryId').empty().append('<option value="">-- Select Category --</option>');
            $.each(data, function(i, item) {
                $('#editCategoryId').append($('<option>', {
                    value: item.id,
                    text: item.category,
                    selected: item.id == selectedCategoryId
                }));
            });
            
            if (callback) callback();
        }
    });
}

// Load subcategories for edit form
function loadEditSubCategories(categoryId, selectedSubCategoryId, callback) {
    if (!categoryId) return;
    
    $.ajax({
        url: '@Url.Action("GetSubCategories", "BOQ")',
        type: 'GET',
        data: { categoryId: categoryId },
        success: function(data) {
            $('#editSubCategoryId').empty().append('<option value="">-- Select Sub-Category --</option>');
            $.each(data, function(i, item) {
                $('#editSubCategoryId').append($('<option>', {
                    value: item.id,
                    text: item.name,
                    selected: item.id == selectedSubCategoryId
                }));
            });
            
            if (callback) callback();
        }
    });
}

// Load UD names for edit form
function loadEditUDNames(categoryId, subCategoryId, selectedUDNameId) {
    if (!categoryId || !subCategoryId) return;
    
    $.ajax({
        url: '@Url.Action("GetUDNames", "BOQ")',
        type: 'GET',
        data: { categoryId: categoryId, subCategoryId: subCategoryId },
        success: function(data) {
            $('#editUDNameId').empty().append('<option value="">-- Select UD Name --</option>');
            $.each(data, function(i, item) {
                $('#editUDNameId').append($('<option>', {
                    value: item.id,
                    text: item.name,
                    'data-unit': item.unit,
                    'data-price': item.unitPrice,
                    selected: item.id == selectedUDNameId
                }));
            });
            
            // Update unit and price based on selected UD name
            updateEditUnitAndPrice();
        }
    });
}

// Category change in edit form
$('#editCategoryId').on('change', function() {
    var categoryId = $(this).val();
    $('#editSubCategoryId').empty().append('<option value="">-- Select Sub-Category --</option>');
    $('#editUDNameId').empty().append('<option value="">-- Select UD Name --</option>');
    $('#editUnit').val('');
    $('#editUnitPrice').val('');
    
    if (categoryId) {
        loadEditSubCategories(categoryId);
    }
    
    calculateEditAmount();
});

// SubCategory change in edit form
$('#editSubCategoryId').on('change', function() {
    var categoryId = $('#editCategoryId').val();
    var subCategoryId = $(this).val();
    $('#editUDNameId').empty().append('<option value="">-- Select UD Name --</option>');
    $('#editUnit').val('');
    $('#editUnitPrice').val('');
    
    if (categoryId && subCategoryId) {
        loadEditUDNames(categoryId, subCategoryId);
    }
    
    calculateEditAmount();
});

// UD Name change in edit form - autofill unit and price
$('#editUDNameId').on('change', function() {
    updateEditUnitAndPrice();
    calculateEditAmount();
});

// Update unit and price based on selected UD name
function updateEditUnitAndPrice() {
    var selected = $('#editUDNameId option:selected');
    var unit = selected.data('unit');
    var price = selected.data('price');
    
    $('#editUnit').val(unit || '');
    $('#editUnitPrice').val(price || '');
}

// Calculate amount in edit form
$('#editQuantity').on('input', function() {
    calculateEditAmount();
});

function calculateEditAmount() {
    var quantity = parseFloat($('#editQuantity').val()) || 0;
    var unitPrice = parseFloat($('#editUnitPrice').val()) || 0;
    
    // Get rates
    var mainMaterialRate = parseFloat($('#editMainMaterialRate').val()) || 0;
    var accessoriesRate = parseFloat($('#editAccessoriesRate').val()) || 0;
    var servicesRate = parseFloat($('#editServicesOverheadRate').val()) || 0;
    
    // Calculate totals
    var mainMaterialTotal = mainMaterialRate * quantity;
    var accessoriesTotal = accessoriesRate * quantity;
    var servicesTotal = servicesRate * quantity;
    
    // Calculate approval amounts
    var p0Amount = mainMaterialTotal + accessoriesTotal + servicesTotal;
    var p1Amount = accessoriesTotal + servicesTotal;
    var p2Amount = servicesTotal;
    
    // Update fields
    $('#editMainMaterialTotal').val(mainMaterialTotal.toFixed(2));
    $('#editAccessoriesTotal').val(accessoriesTotal.toFixed(2));
    $('#editServicesOHTotal').val(servicesTotal.toFixed(2));
    
    $('#editP0Amount').val(p0Amount.toFixed(2));
    $('#editP1Amount').val(p1Amount.toFixed(2));
    $('#editP2Amount').val(p2Amount.toFixed(2));
    
    // Original calculations
    var rtomWeight = @Json.Serialize(ViewBag.RTOMWeight ?? 1.0);
    var adjustedUnitPrice = unitPrice * rtomWeight;
    var amount = adjustedUnitPrice * quantity;
    
    $('#editAdjustedUnitPrice').val(adjustedUnitPrice.toFixed(2));
    $('#editAmount').val(amount.toFixed(2));
}

// Add event listeners for the rate fields
$('#MainMaterialRate, #AccessoriesRate, #ServicesOverheadRate').on('input', function() {
    calculateAmount();
});

// Add event listeners for the edit form rate fields
$('#editMainMaterialRate, #editAccessoriesRate, #editServicesOverheadRate').on('input', function() {
    calculateEditAmount();
});
        
