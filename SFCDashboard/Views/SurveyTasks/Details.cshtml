@model SFCDashboard.Models.SurveyTaskViewModel
@{
    ViewData["Title"] = "Survey Fiber Route Details";
}

<div class="container-fluid mt-4">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-map fs-4 me-2"></i>
                    <h5 class="mb-0">Survey Fiber Route Details</h5>
                </div>
                <a href="javascript:history.back()" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <dl class="row">
                            <dt class="col-sm-4">PE Number:</dt>
                            <dd class="col-sm-8">@Model.Task.PlannedEvent.PeNumber</dd>
                            <dt class="col-sm-4">Contractor Name:</dt>
                            <dd class="col-sm-8">@Model.Task.PlannedEvent.ContractorName</dd>
                            <dt class="col-sm-4">Objective:</dt>
                            <dd class="col-sm-8">@Model.Task.PlannedEvent.PeObjective</dd>
                        </dl>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <dl class="row">
                            <dt class="col-sm-4">PE Title:</dt>
                            <dd class="col-sm-8">@Model.Task.PlannedEvent.PeTitle</dd>
                            <dt class="col-sm-4">Rtom Description:</dt>
                            <dd class="col-sm-8">@Model.Task.PlannedEvent.RtomDescription</dd>
                            <dt class="col-sm-4">Region:</dt>
                            <dd class="col-sm-8">@Model.Task.PlannedEvent.Region</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Replace the existing BOQ header section with this updated one -->
    <div class="card shadow-sm border-0 mt-4 mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Bill of Quantities (BOQ)</h5>
            <div>
                <a href="@Url.Action("Index", "RTOMWeight")" class="btn btn-secondary btn-sm me-2">
                    <i class="bi bi-calculator me-1"></i>Manage RTOM Weights
                </a>
                <a href="@Url.Action("Index", "UDManager")" class="btn btn-info btn-sm me-2">
                    <i class="bi bi-database-fill-gear me-1"></i>Manage UD Items
                </a>
                <button type="button" class="btn btn-primary btn-sm me-2" id="toggleBoqForm">
                    <i class="bi bi-plus-circle me-1"></i>Add BOQ Item
                </button>
                <button type="button" class="btn btn-success btn-sm" id="exportBoqBtn">
                    <i class="bi bi-file-earmark-excel me-1"></i>Export to Excel
                </button>
            </div>
        </div>
        
        <!-- Add this new inline form section -->
        <div class="card-body p-3 bg-light border-bottom" id="boqFormSection" style="display: none;">
            <form id="inlineBoqForm" method="post" action="javascript:void(0);">
                @Html.AntiForgeryToken()
                <input type="hidden" id="TaskId" name="TaskId" value="@Model.Task.Id" />
                
                <!-- First row - categories and quantity -->
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label for="CategoryId" class="form-label">Category</label>
                        <select class="form-select" id="CategoryId" name="CategoryId" required>
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="SubCategoryId" class="form-label">Sub-Category</label>
                        <select class="form-select" id="SubCategoryId" name="SubCategoryId" required disabled>
                            <option value="">-- Select Sub-Category --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="UDNameId" class="form-label">UD Name</label>
                        <select class="form-select" id="UDNameId" name="UDNameId" required disabled>
                            <option value="">-- Select UD Name --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="Quantity" class="form-label">Quantity</label>
                        <input type="number" class="form-control" id="Quantity" name="Quantity" step="0.01" min="0.01" required>
                    </div>
                </div>
                
                <!-- Second row - Unit Rate fields -->
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <h6 class="text-muted">Unit Rate</h6>
                    </div>
                    <div class="col-md-4">
                        <label for="MainMaterialRate" class="form-label">Main Material Rate</label>
                        <input type="number" class="form-control" id="MainMaterialRate" name="MainMaterialRate" step="0.01" min="0">
                    </div>
                    <div class="col-md-4">
                        <label for="AccessoriesRate" class="form-label">Accessories Rate</label>
                        <input type="number" class="form-control" id="AccessoriesRate" name="AccessoriesRate" step="0.01" min="0">
                    </div>
                    <div class="col-md-4">
                        <label for="ServicesOverheadRate" class="form-label">Services + Overhead Rate</label>
                        <input type="number" class="form-control" id="ServicesOverheadRate" name="ServicesOverheadRate" step="0.01" min="0">
                    </div>
                </div>
                
                <!-- Third row - Total Rate fields (read-only, auto-calculated) -->
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <h6 class="text-muted">Total Estimated Amount</h6>
                    </div>
                    <div class="col-md-4">
                        <label for="MainMaterialTotal" class="form-label">Main Material Total (a)</label>
                        <input type="number" class="form-control" id="MainMaterialTotal" name="MainMaterialTotal" readonly>
                    </div>
                    <div class="col-md-4">
                        <label for="AccessoriesTotal" class="form-label">Accessories Total (b)</label>
                        <input type="number" class="form-control" id="AccessoriesTotal" name="AccessoriesTotal" readonly>
                    </div>
                    <div class="col-md-4">
                        <label for="ServicesOHTotal" class="form-label">Services+OH Total (c)</label>
                        <input type="number" class="form-control" id="ServicesOHTotal" name="ServicesOHTotal" readonly>
                    </div>
                </div>
                
                <!-- Fourth row - Approval Amounts (read-only, auto-calculated) -->
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <h6 class="text-muted">Total Approved Amount</h6>
                    </div>
                    <div class="col-md-4">
                        <label for="P0Amount" class="form-label">P0 Amount (a+b+c)</label>
                        <input type="number" class="form-control" id="P0Amount" name="P0Amount" readonly>
                    </div>
                    <div class="col-md-4">
                        <label for="P1Amount" class="form-label">P1 Amount (b+c)</label>
                        <input type="number" class="form-control" id="P1Amount" name="P1Amount" readonly>
                    </div>
                    <div class="col-md-4">
                        <label for="P2Amount" class="form-label">P2 Amount (c)</label>
                        <input type="number" class="form-control" id="P2Amount" name="P2Amount" readonly>
                    </div>
                </div>
                
                <!-- Fifth row - Other fields and buttons -->
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="Unit" class="form-label">Unit</label>
                        <input type="text" class="form-control" id="Unit" name="Unit" readonly>
                    </div>
                    <div class="col-md-3">
                        <label for="UnitPrice" class="form-label">Base Unit Price</label>
                        <input type="number" class="form-control" id="UnitPrice" name="UnitPrice" step="0.01" readonly>
                    </div>
                    <div class="col-md-3">
                        <label for="AdjustedUnitPrice" class="form-label">Adjusted Unit Price</label>
                        <input type="number" class="form-control" id="AdjustedUnitPrice" name="AdjustedUnitPrice" readonly>
                    </div>
                    <div class="col-md-3">
                        <label for="Amount" class="form-label">Total Amount</label>
                        <input type="number" class="form-control" id="Amount" name="Amount" readonly>
                    </div>
                    <div class="col-12">
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-secondary me-2" id="cancelBoq">Cancel</button>
                            <button type="submit" class="btn btn-success" id="saveBoq">Save BOQ Item</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="boqTable">
                    <thead>
                        <tr class="bg-light">
                            <th>Category</th>
                            <th>Sub-Category</th>
                            <th>UD Name</th>
                            <th>Quantity</th>
                            <th>Unit</th>
                            <th>Material Rate</th>
                            <th>Accessories Rate</th>
                            <th>Services Rate</th>
                            <th>P0 (a+b+c)</th>
                            <th>P1 (b+c)</th>
                            <th>P2 (c)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.BOQItems != null && Model.BOQItems.Any())
                        {
                            foreach (var item in Model.BOQItems)
                            {
                                <tr data-id="@item.Id">
                                    <td>@item.Category.Category</td>
                                    <td>@item.SubCategory.SubCategory</td>
                                    <td>@item.UDName.Name</td>
                                    <td>@item.Quantity.ToString("N2")</td>
                                    <td>@item.Unit</td>
                                    <td>@item.MainMaterialRate.ToString("N2")</td>
                                    <td>@item.AccessoriesRate.ToString("N2")</td>
                                    <td>@item.ServicesOverheadRate.ToString("N2")</td>
                                    <td>@item.P0Amount.ToString("N2")</td>
                                    <td>@item.P1Amount.ToString("N2")</td>
                                    <td>@item.P2Amount.ToString("N2")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-primary edit-boq" data-id="@item.Id">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger delete-boq" data-id="@item.Id">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="12" class="text-center py-4">
                                    <i class="bi bi-info-circle me-2"></i>No BOQ items added yet
                                </td>
                            </tr>
                        }
                    </tbody>
                    <!-- Modify the existing tfoot section -->
                    @if (Model.BOQItems != null && Model.BOQItems.Any())
                    {
                        <tfoot>
                            <tr class="fw-bold bg-light">
                                <td colspan="7" class="text-end">Total Amount:</td>
                                <td id="totalAmountCell">@Model.BOQItems.Sum(x => x.Amount).ToString("N2")</td>
                                <td>
                                    <button type="button" id="submitBoqTotalBtn" class="btn btn-success btn-sm" 
                                            data-task-id="@Model.Task.Id" 
                                            data-total-amount="@Model.BOQItems.Sum(x => x.Amount)">
                                        <i class="bi bi-check2-circle me-1"></i>Submit BOQ
                                    </button>
                                </td>
                            </tr>
                        </tfoot>
                    }
                    else
                    {
                        <tfoot style="display: none;">
                            <tr class="fw-bold bg-light">
                                <td colspan="7" class="text-end">Total Amount:</td>
                                <td id="totalAmountCell">0.00</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Activity History</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Attachment</th>
                                    <th>User</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Activities.Any())
                                {
                                    foreach (var activity in Model.Activities)
                                    {
                                        <tr>
                                            <td>@activity.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@activity.Description</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(activity.FileName) && !string.IsNullOrEmpty(activity.FilePath))
                                                {
                                                    <a href="@Url.Action("DownloadFile", "SurveyTasks", new { id = activity.Id })" class="btn btn-sm btn-primary">
                                                        <i class="bi bi-download"></i> Download
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>@activity.User.Name</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4">
                                            <i class="bi bi-info-circle me-2"></i>No activities recorded yet
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Add New Activity</h5>
                </div>
                <div class="card-body">
<form method="post" action="/SurveyTasks/AddActivity" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" name="TaskId" value="@Model.NewActivity.TaskId" />
    <input type="hidden" name="PENumber" value="@Model.Task.PENumber" />
    
    <div class="mb-3">
        <label for="Description" class="form-label">Description</label>
        <textarea name="Description" id="Description" class="form-control" rows="3" required></textarea>
    </div>
    
    <div class="mb-3">
        <label for="File" class="form-label">
            Attachment <span class="text-muted">(Optional)</span>
        </label>
        <input id="File" name="File" class="form-control" type="file" />
        <small class="form-text text-muted">
            <i class="bi bi-info-circle"></i> You can optionally upload documents or images related to this activity.
        </small>
    </div>
    
    <div class="d-grid">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Add Activity
        </button>
    </div>
</form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BOQ Edit Modal -->
<div class="modal fade" id="editBoqModal" tabindex="-1" aria-labelledby="editBoqModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editBoqModalLabel">Edit BOQ Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editBoqForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editId" name="Id">
                    <input type="hidden" id="editTaskId" name="TaskId" value="@Model.Task.Id">
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editCategoryId" class="form-label">Category</label>
                            <select class="form-select" id="editCategoryId" name="CategoryId" required>
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editSubCategoryId" class="form-label">Sub-Category</label>
                            <select class="form-select" id="editSubCategoryId" name="SubCategoryId" required>
                                <option value="">-- Select Sub-Category --</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editUDNameId" class="form-label">UD Name</label>
                            <select class="form-select" id="editUDNameId" name="UDNameId" required>
                                <option value="">-- Select UD Name --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editQuantity" class="form-label">Quantity</label>
                            <input type="number" class="form-control" id="editQuantity" name="Quantity" step="0.01" min="0.01" required>
                        </div>
                    </div>
                    
                    <!-- Unit Rate Fields -->
                    <h6 class="text-muted mb-3">Unit Rate</h6>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="editMainMaterialRate" class="form-label">Main Material Rate</label>
                            <input type="number" class="form-control" id="editMainMaterialRate" name="MainMaterialRate" step="0.01" min="0">
                        </div>
                        <div class="col-md-4">
                            <label for="editAccessoriesRate" class="form-label">Accessories Rate</label>
                            <input type="number" class="form-control" id="editAccessoriesRate" name="AccessoriesRate" step="0.01" min="0">
                        </div>
                        <div class="col-md-4">
                            <label for="editServicesOverheadRate" class="form-label">Services + Overhead Rate</label>
                            <input type="number" class="form-control" id="editServicesOverheadRate" name="ServicesOverheadRate" step="0.01" min="0">
                        </div>
                    </div>
                    
                    <!-- Total Estimated Amount Fields -->
                    <h6 class="text-muted mb-3">Total Estimated Amount</h6>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="editMainMaterialTotal" class="form-label">Main Material Total (a)</label>
                            <input type="number" class="form-control" id="editMainMaterialTotal" name="MainMaterialTotal" readonly>
                        </div>
                        <div class="col-md-4">
                            <label for="editAccessoriesTotal" class="form-label">Accessories Total (b)</label>
                            <input type="number" class="form-control" id="editAccessoriesTotal" name="AccessoriesTotal" readonly>
                        </div>
                        <div class="col-md-4">
                            <label for="editServicesOHTotal" class="form-label">Services+OH Total (c)</label>
                            <input type="number" class="form-control" id="editServicesOHTotal" name="ServicesOHTotal" readonly>
                        </div>
                    </div>
                    
                    <!-- Total Approved Amount Fields -->
                    <h6 class="text-muted mb-3">Total Approved Amount</h6>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="editP0Amount" class="form-label">P0 Amount (a+b+c)</label>
                            <input type="number" class="form-control" id="editP0Amount" name="P0Amount" readonly>
                        </div>
                        <div class="col-md-4">
                            <label for="editP1Amount" class="form-label">P1 Amount (b+c)</label>
                            <input type="number" class="form-control" id="editP1Amount" name="P1Amount" readonly>
                        </div>
                        <div class="col-md-4">
                            <label for="editP2Amount" class="form-label">P2 Amount (c)</label>
                            <input type="number" class="form-control" id="editP2Amount" name="P2Amount" readonly>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="editUnit" class="form-label">Unit</label>
                            <input type="text" class="form-control" id="editUnit" name="Unit" readonly>
                        </div>
                        <div class="col-md-4">
                            <label for="editUnitPrice" class="form-label">Base Unit Price</label>
                            <input type="number" class="form-control" id="editUnitPrice" name="UnitPrice" step="0.01" readonly>
                        </div>
                        <div class="col-md-4">
                            <label for="editAmount" class="form-label">Total Amount</label>
                            <input type="number" class="form-control" id="editAmount" name="Amount" readonly>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveBoqEdit">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- SheetJS library for Excel export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script>
    $(document).ready(function () {
        // Load categories when page loads
        loadCategories();
        
        // Toggle BOQ form
        $('#toggleBoqForm').on('click', function() {
            $('#boqFormSection').slideToggle();
        });
        
        // Handle export to Excel button click
        $('#exportBoqBtn').on('click', function() {
            // Check if there are BOQ items to export
            if ($('#boqTable tbody tr').length > 0 && !$('#boqTable tbody tr:first').find('td:first').hasClass('text-center')) {
                exportBOQToExcel();
            } else {
                alert('There are no BOQ items to export.');
            }
        });
        
        // Cancel BOQ form
        $('#cancelBoq').on('click', function() {
            $('#boqFormSection').slideUp();
            resetBoqForm();
        });
        
        // Handle category change
        $('#CategoryId').on('change', function() {
            var categoryId = $(this).val();
            if (categoryId) {
                $('#SubCategoryId').prop('disabled', false);
                $('#SubCategoryId').empty().append('<option value="">-- Select Sub-Category --</option>');
                $('#UDNameId').prop('disabled', true).empty().append('<option value="">-- Select UD Name --</option>');
                $('#Unit').val('');
                $('#UnitPrice').val('');
                
                // Load sub-categories
                $.ajax({
                    url: '@Url.Action("GetSubCategories", "BOQ")',
                    type: 'GET',
                    data: { categoryId: categoryId },
                    success: function(data) {
                        $.each(data, function(i, item) {
                            $('#SubCategoryId').append($('<option>', {
                                value: item.id,
                                text: item.name
                            }));
                        });
                    }
                });
            } else {
                $('#SubCategoryId').prop('disabled', true).empty().append('<option value="">-- Select Sub-Category --</option>');
                $('#UDNameId').prop('disabled', true).empty().append('<option value="">-- Select UD Name --</option>');
                $('#Unit').val('');
                $('#UnitPrice').val('');
            }
            calculateAmount();
        });
        
        // Handle sub-category change
        // Handle sub-category change
$('#SubCategoryId').on('change', function() {
    var categoryId = $('#CategoryId').val();
    var subCategoryId = $(this).val();
    
    if (subCategoryId) {
        $('#UDNameId').prop('disabled', false);
        $('#UDNameId').empty().append('<option value="">-- Select UD Name --</option>');
        $('#Unit').val('');
        $('#UnitPrice').val('');
        
        // Load UD names filtered by BOTH category and subcategory
        $.ajax({
            url: '@Url.Action("GetUDNames", "BOQ")',
            type: 'GET',
            data: { categoryId: categoryId, subCategoryId: subCategoryId },
            success: function(data) {
                $.each(data, function(i, item) {
                    $('#UDNameId').append($('<option>', {
                        value: item.id,
                        text: item.name,
                        'data-unit': item.unit,
                        'data-price': item.unitPrice
                    }));
                });
            },
            error: function(xhr, status, error) {
                console.error("Error loading UD Names:", error);
                alert("Failed to load UD Names. Please try again.");
            }
        });
    } else {
        $('#UDNameId').prop('disabled', true).empty().append('<option value="">-- Select UD Name --</option>');
        $('#Unit').val('');
        $('#UnitPrice').val('');
    }
    calculateAmount();
});
        // Handle UD Name change - autofill unit and price
        $('#UDNameId').on('change', function() {
            var selected = $(this).find(':selected');
            var unit = selected.data('unit');
            var price = selected.data('price');
            
            $('#Unit').val(unit || '');
            $('#UnitPrice').val(price || '');
            
            calculateAmount();
        });
        
        // Calculate adjusted price and amount when quantity changes
        $('#Quantity').on('input', function() {
            calculateAmount();
        });
        
        // Add BOQ item
        $('#inlineBoqForm').on('submit', function(e) {
            e.preventDefault();
            
            // Validate required fields
            if (!$('#CategoryId').val() || !$('#SubCategoryId').val() || !$('#UDNameId').val() || !$('#Quantity').val()) {
                alert('Please fill in all required fields');
                return;
            }
            
            var formData = {
                TaskId: $('#TaskId').val(),
                CategoryId: $('#CategoryId').val(),
                SubCategoryId: $('#SubCategoryId').val(),
                UDNameId: $('#UDNameId').val(),
                Quantity: parseFloat($('#Quantity').val()) || 0,
                Unit: $('#Unit').val(),
                UnitPrice: parseFloat($('#UnitPrice').val()) || 0,
                AdjustedUnitPrice: parseFloat($('#AdjustedUnitPrice').val()) || 0,
                Amount: parseFloat($('#Amount').val()) || 0,
                
                // Add the new fields
                MainMaterialRate: parseFloat($('#MainMaterialRate').val()) || 0,
                AccessoriesRate: parseFloat($('#AccessoriesRate').val()) || 0,
                ServicesOverheadRate: parseFloat($('#ServicesOverheadRate').val()) || 0,
                MainMaterialTotal: parseFloat($('#MainMaterialTotal').val()) || 0,
                AccessoriesTotal: parseFloat($('#AccessoriesTotal').val()) || 0,
                ServicesOHTotal: parseFloat($('#ServicesOHTotal').val()) || 0,
                P0Amount: parseFloat($('#P0Amount').val()) || 0,
                P1Amount: parseFloat($('#P1Amount').val()) || 0,
                P2Amount: parseFloat($('#P2Amount').val()) || 0,
                
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
            };
            
            $.ajax({
                url: '@Url.Action("Create", "BOQ")',
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error adding BOQ item: ' + (response.message || 'Unknown error'));
                    }
                },
                error: function(xhr, status, error) {
                    console.error("AJAX Error:", xhr.responseText);
                    alert('An error occurred while adding the BOQ item. See console for details.');
                }
            });
        });
        
        // Handle BOQ deletion (existing code)
        $('.delete-boq').on('click', function () {
            var id = $(this).data('id');
            if (confirm('Are you sure you want to delete this BOQ item?')) {
                $.ajax({
                    url: '@Url.Action("Delete", "BOQ")/' + id,
                    type: 'POST',
                    data: { 
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        if (result.success) {
                            // Remove the row from the table
                            $('tr[data-id="' + id + '"]').fadeOut(function () {
                                $(this).remove();
                                // Check if there are any rows left
                                if ($('#boqTable tbody tr').length === 0) {
                                    $('#boqTable tbody').append('<tr><td colspan="9" class="text-center py-4"><i class="bi bi-info-circle me-2"></i>No BOQ items added yet</td></tr>');
                                    $('#boqTable tfoot').hide();
                                } else {
                                    // Recalculate total
                                    updateTotalAmount();
                                }
                            });
                        } else {
                            alert('Error deleting BOQ item: ' + result.message);
                        }
                    },
                    error: function () {
                        alert('An error occurred while deleting the BOQ item.');
                    }
                });
            }
        });
        
        // Handle BOQ total submission
        $('#submitBoqTotalBtn').on('click', function() {
    var taskId = $(this).data('task-id');
    var totalAmount = $(this).data('total-amount');
    
