        // Export BOQ table to Excel
        function exportBOQToExcel() {
            // Get the table data
            var tableData = [];
            var headers = [];
            
            // Get headers
            $('#boqTable thead tr th').each(function() {
                // Skip the Actions column
                if ($(this).text() !== 'Actions') {
                    headers.push($(this).text());
                }
            });
            
            tableData.push(headers);
            
            // Get table data
            $('#boqTable tbody tr').each(function() {
                var rowData = [];
                $(this).find('td').each(function(index) {
                    // Skip the last column (Actions)
                    if (index < headers.length) {
                        // Get the text content without commas for amounts
                        var cellText = $(this).text().trim().replace(/,/g, '');
                        rowData.push(cellText);
                    }
                });
                
                // Only add rows that have data (not empty rows)
                if (rowData.length > 0 && rowData[0] !== '') {
                    tableData.push(rowData);
                }
            });
            
            // Add total row if available
            if ($('#boqTable tfoot').is(':visible')) {
                var totalRow = ['', '', '', '', '', '', '', 'Total Amount:', $('#totalAmountCell').text()];
                // Pad the total row to match header length
                while (totalRow.length < headers.length) {
                    totalRow.push('');
                }
                tableData.push(totalRow);
            }
            
            // Create workbook and worksheet
            var wb = XLSX.utils.book_new();
            var ws = XLSX.utils.aoa_to_sheet(tableData);
            
            // Add worksheet to workbook
            XLSX.utils.book_append_sheet(wb, ws, 'BOQ Data');
            
            // Get current date for filename
            var now = new Date();
            var dateStr = now.getFullYear() + '-' + 
                         String(now.getMonth() + 1).padStart(2, '0') + '-' + 
                         String(now.getDate()).padStart(2, '0');
            
            // Generate filename with task ID and PE number if available
            var taskId = '@Model.Task.Id';
            var peNumber = '@Model.Task.PENumber';
            var fileName = 'BOQ_' + (peNumber || taskId) + '_' + dateStr + '.xlsx';
            
            // Export to Excel
            XLSX.writeFile(wb, fileName);
        }
        
        function updateTotalAmount() {
            var total = 0;
            $('#boqTable tbody tr').each(function () {
                // Update this to use the right column index for the total amount
                var amount = parseFloat($(this).find('td:eq(8)').text().replace(/,/g, ''));
                if (!isNaN(amount)) {
                    total += amount;
                }
            });
            
            $('#totalAmountCell').text(total.toLocaleString('en-US', { 
                minimumFractionDigits: 2, 
                maximumFractionDigits: 2 
            }));
            
            // Update the data attribute for the submit button
            $('#submitBoqTotalBtn').data('total-amount', total);
            
            // Show footer if hidden
            if (total > 0 && $('#boqTable tfoot').is(':hidden')) {
                $('#boqTable tfoot').show();
            }
        }
    });
</script>
