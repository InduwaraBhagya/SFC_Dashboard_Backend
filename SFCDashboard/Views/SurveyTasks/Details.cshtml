        function calculateAmount() {
            var quantity = parseFloat($('#Quantity').val()) || 0;
            var unitPrice = parseFloat($('#UnitPrice').val()) || 0;
            
            // Get rates
            var mainMaterialRate = parseFloat($('#MainMaterialRate').val()) || 0;
            var accessoriesRate = parseFloat($('#AccessoriesRate').val()) || 0;
            var servicesRate = parseFloat($('#ServicesOverheadRate').val()) || 0;
            
            // Calculate totals
            var mainMaterialTotal = mainMaterialRate * quantity;
            var accessoriesTotal = accessoriesRate * quantity;
            var servicesTotal = servicesRate * quantity;
            
            // Calculate approval amounts
            var p0Amount = mainMaterialTotal + accessoriesTotal + servicesTotal;
            var p1Amount = accessoriesTotal + servicesTotal;
            var p2Amount = servicesTotal;
            
            // Update fields
            $('#MainMaterialTotal').val(mainMaterialTotal.toFixed(2));
            $('#AccessoriesTotal').val(accessoriesTotal.toFixed(2));
            $('#ServicesOHTotal').val(servicesTotal.toFixed(2));
            
            $('#P0Amount').val(p0Amount.toFixed(2));
            $('#P1Amount').val(p1Amount.toFixed(2));
            $('#P2Amount').val(p2Amount.toFixed(2));
            
            // Original calculations
            var rtomWeight = @Json.Serialize(ViewBag.RTOMWeight ?? 1.0);
            var adjustedUnitPrice = unitPrice * rtomWeight;
            var amount = adjustedUnitPrice * quantity;
            
            $('#AdjustedUnitPrice').val(adjustedUnitPrice.toFixed(2));
            $('#Amount').val(amount.toFixed(2));
        }
        
