@model AreaNetworkEngineer
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Mapping" : "Edit Mapping";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@ViewData["Title"]</h5>
        </div>
        <div class="card-body">
            <form asp-action="@ViewContext.RouteData.Values["action"]" method="post">
                @if (Model.Id != 0)
                {
                    <input type="hidden" asp-for="Id" />
                }
                <div class="mb-3">
                    <label asp-for="Area" class="form-label"></label>
                    <input asp-for="Area" class="form-control" required />
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="EngineerName" class="form-label"></label>
                    <input asp-for="EngineerName" class="form-control" required />
                    <span asp-validation-for="EngineerName" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Save
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </form>
        </div>
    </div>
</div>