@model IEnumerable<AreaNetworkEngineer>
@{
    ViewData["Title"] = "Network Engineer Area Mapping";
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold mb-1">Network Engineer Area Mapping</h1>
                    <p class="text-muted mb-0">Manage mappings between areas and network engineers</p>
                </div>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>Add New Mapping
                </a>
            </div>
            <hr class="my-4" />
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light py-3">
            <div class="row align-items-center">
                <div class="col">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="mappingSearch" class="form-control border-start-0" placeholder="Search mappings...">
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                @if (!(Model?.Any() ?? false))
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted"></i>
                        <p class="h4 mt-3 mb-0">No mappings found</p>
                        <p class="text-muted">Use the button above to add your first mapping</p>
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0" id="mappingsTable">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="px-4 py-3">
                                    <i class="bi bi-geo-alt me-2"></i>Area
                                </th>
                                <th scope="col" class="px-4 py-3">
                                    <i class="bi bi-person me-2"></i>Engineer Name
                                </th>
                                <th scope="col" class="px-4 py-3 text-center" style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="px-4 py-3">@item.Area</td>
                                <td class="px-4 py-3"><span class="fw-medium">@item.EngineerName</span></td>
                                <td class="px-4 py-3 text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm"
                                           data-bs-toggle="tooltip" title="Edit Mapping">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) { return new bootstrap.Tooltip(tooltipTriggerEl); });

            // Client-side search filter
            $("#mappingSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#mappingsTable tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            // Subtle row animation on load
            $('tbody tr').each(function (i) {
                $(this).css('animation-delay', (i * 0.05) + 's');
                $(this).addClass('animate__animated animate__fadeIn');
            });
        });
    </script>
}