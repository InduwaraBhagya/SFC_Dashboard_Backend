@model AreaNetworkEngineer
@{
    ViewData["Title"] = "Edit Network Engineer Mapping";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="bi bi-pencil-square"></i> Edit Network Engineer Mapping
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3">
                    <label asp-for="Area" class="form-label">Area</label>
                    <input asp-for="Area" class="form-control" required />
                    <span asp-validation-for="Area" class="text-danger"></span>
                    <div class="form-text">Enter the area code or name for this mapping.</div>
                </div>
                
                <div class="mb-3">
                    <label asp-for="EngineerName" class="form-label">Engineer Name</label>
                    <input asp-for="EngineerName" class="form-control" required />
                    <span asp-validation-for="EngineerName" class="text-danger"></span>
                    <div class="form-text">Enter the full name of the network engineer.</div>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <div>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-circle"></i> Update Mapping
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                    </div>
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i> Changes will be saved immediately upon clicking Update.
                    </small>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
