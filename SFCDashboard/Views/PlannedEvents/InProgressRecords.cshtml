@model IEnumerable<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "In Progress Records";
}

<h1>In Progress Records</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Region)</th>
            <th>@Html.DisplayNameFor(model => model.Province)</th>            
            <th>@Html.DisplayNameFor(model => model.RequestReferenceNo)</th>
            <th>@Html.DisplayNameFor(model => model.PeNumber)</th>
            <th>@Html.DisplayNameFor(model => model.PEStatus)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <th>@Html.DisplayFor(modelItem => item.Region)</th>
                <td>@Html.DisplayFor(modelItem => item.Province)</td>
                <td>@Html.DisplayFor(modelItem => item.RequestReferenceNo)</td>
                <td>@Html.DisplayFor(modelItem => item.PeNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.PEStatus)</td>
                <td>
                    <!-- Replace form with button that triggers modal -->
                    <button type="button" class="btn btn-danger urgent-request-btn" 
                            data-pe-id="@item.Id" 
                            data-pe-number="@item.PeNumber" 
                            data-customer="@item.Customer">
                        <i class="bi bi-exclamation-triangle"></i> Urgent Request
                    </button>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Add this modal at the bottom of your page -->
<div class="modal fade" id="urgentPEModal" tabindex="-1" aria-labelledby="urgentPEModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="urgentPEModalLabel">Request Urgent Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <strong>PE Number:</strong> <span id="modalPeNumberValue"></span><br>
                    <strong>Customer:</strong> <span id="modalCustomerValue"></span>
                </div>
                <form id="urgentPERequestForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="peIdField" />
                    
                    <div class="form-group mb-4">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="urgentReason" id="openingCeremony" value="OpeningCeremony" required />
                            <label class="form-check-label" for="openingCeremony">
                                <strong>Opening Ceremony</strong> [Priority 1]
                            </label>
                            <small class="form-text text-muted d-block">Highest priority for events that will receive public attention</small>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="urgentReason" id="criticalCustomer" value="CriticalCustomer" />
                            <label class="form-check-label" for="criticalCustomer">
                                <strong>Critical Customer</strong> [Priority 2]
                            </label>
                            <small class="form-text text-muted d-block">High priority for key business customers</small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmPEUrgentRequest">Submit Request</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            console.log('DOM loaded, setting up modal handlers');
            
            // Ensure Bootstrap is loaded
            if (typeof bootstrap !== 'undefined') {
                console.log('Bootstrap is loaded properly');
            } else {
                console.error('Bootstrap is not loaded!');
            }
            
            // Handle showing the PE urgent modal - use a more specific class
            const buttons = document.querySelectorAll('.urgent-request-btn');
            console.log('Found ' + buttons.length + ' urgent request buttons');
            
            buttons.forEach(function (button) {
                button.addEventListener('click', function (event) {
                    console.log('Button clicked!');
                    event.preventDefault();
                    
                    const peId = this.getAttribute('data-pe-id');
                    const peNumber = this.getAttribute('data-pe-number');
                    const customer = this.getAttribute('data-customer');
                    
                    console.log('PE ID: ' + peId + ', Number: ' + peNumber + ', Customer: ' + customer);
                    
                    document.getElementById('peIdField').value = peId;
                    document.getElementById('modalPeNumberValue').textContent = peNumber;
                    document.getElementById('modalCustomerValue').textContent = customer || 'Not specified';
                    
                    // Try direct DOM method first
                    try {
                        const modalElement = document.getElementById('urgentPEModal');
                        const modal = new bootstrap.Modal(modalElement);
                        modal.show();
                        console.log('Modal shown with bootstrap.Modal');
                    } catch (e) {
                        console.error('Error showing modal: ', e);
                        // Fallback to jQuery if available
                        if (typeof $ !== 'undefined') {
                            $('#urgentPEModal').modal('show');
                            console.log('Modal shown with jQuery fallback');
                        }
                    }
                });
            });
            
            // Handle form submission from the modal
            document.getElementById('confirmPEUrgentRequest').addEventListener('click', function () {
                // Check if a radio button is selected
                const selectedReason = document.querySelector('input[name="urgentReason"]:checked');
                if (!selectedReason) {
                    alert('Please select a reason for the urgent request.');
                    return;
                }
                
                // Hide the modal immediately
                const modalElement = document.getElementById('urgentPEModal');
                const modalInstance = bootstrap.Modal.getInstance(modalElement);
                modalInstance.hide();
                
                // Submit the form with a slight delay to allow modal to close
                setTimeout(function() {
                    const form = document.getElementById('urgentPERequestForm');
                    form.action = '@Url.Action("RequestUrgentWithReason", "PlannedEvents")';
                    form.submit();
                }, 300);
            });
        });
    </script>
}


