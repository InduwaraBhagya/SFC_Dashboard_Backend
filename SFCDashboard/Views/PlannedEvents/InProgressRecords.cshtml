@using SFCDashboard.Models
@model IEnumerable<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "Regular Records";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">
            <i class="bi bi-list-task text-success me-3"></i>Regular Records
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- Add the workgroup filter here, before other content -->
    @if (ViewData["Workgroups"] != null)
    {
        <div class="workgroup-filter-section mb-3">
            <form id="workgroupFilterForm" method="get" asp-action="InProgressRecords">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <label for="workgroupFilter" class="form-label mb-0"><i class="bi bi-filter"></i> Filter by
                            Workgroup:</label>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="workgroupFilter" name="workgroupId" onchange="this.form.submit()">
                            <option value="">All Workgroups</option>
                            @foreach (var workgroup in (IEnumerable<WorkGroup>)ViewData["Workgroups"])
                            {
                                <option value="@workgroup.Id"
                                    selected="@(ViewData["SelectedWorkgroupId"]?.ToString() == workgroup.Id.ToString())">
                                    @workgroup.Name
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewData["FilteredWorkgroup"] != null)
    {
        <div class="alert alert-info">
            <i class="bi bi-funnel-fill me-2"></i>
            Filtered by Workgroup: <strong>@ViewData["FilteredWorkgroup"]</strong>
            <a href="@Url.Action("UrgentRecords")" class="btn btn-sm btn-outline-secondary ms-3">
                <i class="bi bi-x-circle me-1"></i> Clear Filter
            </a>
        </div>
    }

    <div class="card">
        <div class="card-header bg-success text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Regular Records</h5>
                <span class="badge bg-light text-dark">@Model.Count() Records</span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 10%;">PE Number</th>
                            <th style="width: 10%;">Region</th>
                            <th style="width: 15%;">Request Reference</th>
                            <th style="width: 15%;">Customer</th>
                            <th style="width: 15%;">Required Date</th>
                            <th style="width: 15%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowNumber = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(rowNumber++)</td>
                                <td>@Html.DisplayFor(modelItem => item.PeNumber)</td>
                                <td>@Html.DisplayFor(modelItem => item.Region)</td>
                                <td>@Html.DisplayFor(modelItem => item.RequestReferenceNo)</td>
                                <td>@Html.DisplayFor(modelItem => item.Customer)</td>
                                <td>
                                    @if (item.ServiceRequiredDate.HasValue)
                                    {
                                        @item.ServiceRequiredDate.Value.ToString("yyyy-MM-dd")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                            asp-route-returnUrl="@Url.Action("InProgressRecords")"
                                            class="btn btn-primary btn-sm">
                                            <i class="bi bi-eye"></i> View Details
                                        </a>
                                        <button type="button" class="btn btn-danger btn-sm urgent-request-btn"
                                            data-pe-id="@item.Id" data-pe-number="@item.PeNumber"
                                            data-customer="@item.Customer">
                                            <i class="bi bi-exclamation-triangle"></i> Urgent
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle me-2"></i> No regular records found.
                </div>
            }
        </div>
    </div>
</div>

