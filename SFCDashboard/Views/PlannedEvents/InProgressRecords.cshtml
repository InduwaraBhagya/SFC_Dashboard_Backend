@using SFCDashboard.Models
@model IEnumerable<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "Regular Records";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">
            <i class="bi bi-list-task text-success me-3"></i>Regular Records
        </h1>
        <a href="@Url.Action("Index", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="btn btn-success">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form id="searchForm" class="row g-3" method="get">
                <div class="col-md-3">
                    <label for="searchPeNumber" class="form-label">PE Number</label>
                    <input type="text" class="form-control" id="searchPeNumber" name="peNumber"
                        value="@ViewData["SearchPeNumber"]">
                </div>
                <div class="col-md-3">
                    <label for="searchReference" class="form-label">Request Reference</label>
                    <input type="text" class="form-control" id="searchReference" name="reference"
                        value="@ViewData["SearchReference"]">
                </div>
                <div class="col-md-3">
                    <label for="searchCustomer" class="form-label">Customer</label>
                    <input type="text" class="form-control" id="searchCustomer" name="customer"
                        value="@ViewData["SearchCustomer"]">
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="btn-group w-100">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a href="@Url.Action("InProgressRecords")" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }



    <div class="card">
        <div class="card-header bg-success text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Regular Records</h5>
                <span class="badge bg-light text-dark">@Model.Count() Records</span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" style="font-size: 0.8rem;">
                    <thead class="table-light" style="font-size: 0.75rem;">
                        <tr>
                            <th style="width: 3%;">#</th>
                            <th style="width: 8%;">PE Number</th>
                            <th style="width: 6%;">Region</th>
                            <th style="width: 12%;">Request Reference</th>
                            <th style="width: 10%;">Job Reference</th>
                            <th style="width: 12%;">Customer</th>
                            <th style="width: 10%;">Required Date</th>
                            <th style="width: 18%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowNumber = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr style="font-size: 0.8rem;">
                                <td>@(rowNumber++)</td>
                                <td>@Html.DisplayFor(modelItem => item.PeNumber)</td>
                                <td>@Html.DisplayFor(modelItem => item.Region)</td>
                                <td>@Html.DisplayFor(modelItem => item.RequestReferenceNo)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.JobReference))
                                    {
                                        @item.JobReference
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.Customer)</td>
                                <td>
                                    @if (item.ServiceRequiredDate.HasValue)
                                    {
                                        @item.ServiceRequiredDate.Value.ToString("yyyy-MM-dd")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                            asp-route-returnUrl="@Url.Action("InProgressRecords")"
                                            class="btn btn-primary btn-sm">
                                            <i class="bi bi-eye"></i> View Details
                                        </a>
                                        @if (ViewData["CanSendUrgentRequests"] as bool? == true)
                                        {
                                            @if (item.HasPendingUrgentRequest)
                                            {
                                                <button type="button" class="btn btn-secondary btn-sm" disabled>
                                                    <i class="bi bi-clock"></i> Urgent Request Pending
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-danger btn-sm urgent-request-btn"
                                                    data-pe-id="@item.Id" data-pe-number="@item.PeNumber"
                                                    data-customer="@item.Customer">
                                                    <i class="bi bi-exclamation-triangle"></i> Urgent
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle me-2"></i> No regular records found.
                </div>
            }
        </div>
    </div>
</div>


