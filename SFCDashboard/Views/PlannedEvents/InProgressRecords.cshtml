            document.addEventListener('DOMContentLoaded', function () {
                console.log('DOM loaded, setting up modal handlers');

                // Ensure Bootstrap is loaded
                if (typeof bootstrap !== 'undefined') {
                    console.log('Bootstrap is loaded properly');
                } else {
                    console.error('Bootstrap is not loaded!');
                }

                // Handle showing the PE urgent modal - use a more specific class
                const buttons = document.querySelectorAll('.urgent-request-btn');
                console.log('Found ' + buttons.length + ' urgent request buttons');

                buttons.forEach(function (button) {
                    button.addEventListener('click', function (event) {
                        console.log('Button clicked!');
                        event.preventDefault();

                        const peId = this.getAttribute('data-pe-id');
                        const peNumber = this.getAttribute('data-pe-number');
                        const customer = this.getAttribute('data-customer');

                        console.log('PE ID: ' + peId + ', Number: ' + peNumber + ', Customer: ' + customer);

                        document.getElementById('peIdField').value = peId;
                        document.getElementById('modalPeNumberValue').textContent = peNumber;
                        document.getElementById('modalCustomerValue').textContent = customer || 'Not specified';

                        // Try direct DOM method first
                        try {
                            const modalElement = document.getElementById('urgentPEModal');
                            const modal = new bootstrap.Modal(modalElement);
                            modal.show();
                            console.log('Modal shown with bootstrap.Modal');
                        } catch (e) {
                            console.error('Error showing modal: ', e);
                            // Fallback to jQuery if available
                            if (typeof $ !== 'undefined') {
                                $('#urgentPEModal').modal('show');
                                console.log('Modal shown with jQuery fallback');
                            }
                        }
                    });
                });

                // Handle form submission from the modal
                document.getElementById('confirmPEUrgentRequest').addEventListener('click', function () {
                    // Check if a radio button is selected
                    const selectedReason = document.querySelector('input[name="urgentReason"]:checked');
                    if (!selectedReason) {
                        alert('Please select a reason for the urgent request.');
                        return;
                    }

                    // Hide the modal immediately
                    const modalElement = document.getElementById('urgentPEModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalElement);
                    modalInstance.hide();

                    // Submit the form with a slight delay to allow modal to close
                    setTimeout(function () {
                        const form = document.getElementById('urgentPERequestForm');
                        form.action = '@Url.Action("RequestUrgentWithReason", "PlannedEvents")';
                        form.submit();
                    }, 300);
                });

                // Add search functionality
                const searchForm = document.getElementById('searchForm');
                const searchInputs = searchForm.querySelectorAll('input');
                const tableBody = document.querySelector('table tbody');
                const noRecordsAlert = document.querySelector('.alert-info');

                function filterTable() {
                    const peNumber = document.getElementById('searchPeNumber').value.trim().toLowerCase();
                    const reference = document.getElementById('searchReference').value.trim().toLowerCase();
                    const customer = document.getElementById('searchCustomer').value.trim().toLowerCase();

                    let visibleRows = 0;
                    const rows = tableBody.getElementsByTagName('tr');

                    Array.from(rows).forEach(row => {
                        const cells = row.getElementsByTagName('td');
                        const matchPeNumber = cells[1].textContent.trim().toLowerCase().includes(peNumber);
                        const matchReference = cells[3].textContent.trim().toLowerCase().includes(reference);
                        const matchCustomer = cells[4].textContent.trim().toLowerCase().includes(customer);

                        if (matchPeNumber && matchReference && matchCustomer) {
                            row.style.display = '';
                            visibleRows++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    // Update record count
                    document.querySelector('.badge').textContent = visibleRows + ' Records';

                    // Show/hide no records message
                    if (noRecordsAlert) {
                        noRecordsAlert.style.display = visibleRows === 0 ? 'block' : 'none';
                    }
                }

                // Add real-time search
                searchInputs.forEach(input => {
                    input.addEventListener('input', filterTable);
                });

                // Prevent form submission (using real-time filter instead)
                searchForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    filterTable();
                });

            });
    </script>
}
