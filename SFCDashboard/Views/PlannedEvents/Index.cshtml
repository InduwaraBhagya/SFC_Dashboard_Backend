@model PaginatedList<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "PE Records";
    bool isSearchPerformed = !string.IsNullOrEmpty(ViewData["PENumberFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["CustomerFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["JobReferenceFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["SONumberFilter"]?.ToString());
}

<div class="container-fluid mt-4">
    <div class="row">
        <!-- Left Column - Existing Content -->
        <div class="col-lg-8">
            <div class="search-section mb-4">
                <form method="get" asp-action="Index">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="searchType" class="form-label">Search By:</label>
                                <select class="form-select" id="searchType" name="searchType" onchange="toggleSearchFields()">
                                    <option value="peNumber" selected="@(ViewData["SearchType"]?.ToString() == "peNumber")">PE Number</option>
                                    <option value="customer" selected="@(ViewData["SearchType"]?.ToString() == "customer")">Customer</option>
                                    <option value="jobReference" selected="@(ViewData["SearchType"]?.ToString() == "jobReference")">Job Reference</option>
                                    <option value="soNumber" selected="@(ViewData["SearchType"]?.ToString() == "soNumber")">SO Number</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <!-- PE Number Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "peNumber" ? "" : "d-none")" id="peNumberField">
                                <label for="peNumber" class="form-label">PE Number:</label>
                                <input type="text" name="peNumber" class="form-control" id="peNumber" placeholder="Enter PE Number" value="@ViewData["PENumberFilter"]" />
                            </div>

                            <!-- Customer Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "customer" ? "" : "d-none")" id="customerField">
                                <label for="customer" class="form-label">Customer:</label>
                                <input type="text" name="customer" class="form-control" id="customer" placeholder="Enter Customer Name" value="@ViewData["CustomerFilter"]" />
                            </div>

                            <!-- Job Reference Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "jobReference" ? "" : "d-none")" id="jobReferenceField">
                                <label for="jobReference" class="form-label">Job Reference:</label>
                                <input type="text" name="jobReference" class="form-control" id="jobReference" placeholder="Enter Job Reference" value="@ViewData["JobReferenceFilter"]" />
                            </div>

                            <!-- SO Number Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "soNumber" ? "" : "d-none")" id="soNumberField">
                                <label for="soNumber" class="form-label">SO Number:</label>
                                <input type="text" name="soNumber" class="form-control" id="soNumber" placeholder="Enter SO Number" value="@ViewData["SONumberFilter"]" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary btn-ripple w-100">Search</button>
                        </div>
                    </div>
                </form>
            </div>

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">PE Number: @item.PeNumber</h5>
                            <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.PeNumber" aria-expanded="false">
                                Show Details
                            </button>
                        </div>
                        <div id="@item.PeNumber">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Status</dt>
                                            <dd class="col-sm-8">@item.PEStatus</dd>
                                            <dt class="col-sm-4">Customer</dt>
                                            <dd class="col-sm-8">@item.Customer</dd>
                                            <dt class="col-sm-4">Service Type</dt>
                                            <dd class="col-sm-8">@item.ServiceType</dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Start Date</dt>
                                            <dd class="col-sm-8">@item.PECreatedDate.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">Required Date</dt>
                                            <dd class="col-sm-8">@item.ServiceRequiredDate?.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">SO Number</dt>
                                            <dd class="col-sm-8">@item.SoNumber</dd>
                                        </dl>
                                    </div>
                                </div>

                                <div class="collapse" id="collapse-@item.PeNumber">
                                    <hr />
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6 class="section-title">Location Details</h6>
                                            <dl class="row">
                                                <dt class="col-sm-4">Province</dt>
                                                <dd class="col-sm-8">@item.Province</dd>
                                                <dt class="col-sm-4">Region</dt>
                                                <dd class="col-sm-8">@item.Region</dd>
                                                <dt class="col-sm-4">RTOM</dt>
                                                <dd class="col-sm-8">@item.Rtom</dd>
                                                <dt class="col-sm-4">RTOM Description</dt>
                                                <dd class="col-sm-8">@item.RtomDescription</dd>
                                            </dl>

                                            <h6 class="section-title">Project Details</h6>
                                            <dl class="row">
                                                <dt class="col-sm-4">Job Reference</dt>
                                                <dd class="col-sm-8">@item.JobReference</dd>
                                                <dt class="col-sm-4">Contractor</dt>
                                                <dd class="col-sm-8">@item.ContractorName</dd>
                                                <dt class="col-sm-4">PE Activity</dt>
                                                <dd class="col-sm-8">@item.PeActivity</dd>
                                                <dt class="col-sm-4">PE Nature</dt>
                                                <dd class="col-sm-8">@item.PeNature</dd>
                                                <dt class="col-sm-4">PE Title</dt>
                                                <dd class="col-sm-8">@item.PeTitle</dd>
                                                <dt class="col-sm-4">PE Objective</dt>
                                                <dd class="col-sm-8">@item.PeObjective</dd>
                                                <dt class="col-sm-4">PE Area</dt>
                                                <dd class="col-sm-8">@item.PeArea</dd>
                                            </dl>
                                        </div>

                                        <div class="col-md-6">
                                            <h6 class="section-title">Task Information</h6>
                                            <dl class="row">
                                                <dt class="col-sm-4">Task Sequence</dt>
                                                <dd class="col-sm-8">@item.TaskSeq</dd>
                                                <dt class="col-sm-4">Task Name</dt>
                                                <dd class="col-sm-8">@item.TaskName</dd>
                                                <dt class="col-sm-4">Task WG</dt>
                                                <dd class="col-sm-8">@item.TaskWg</dd>
                                                <dt class="col-sm-4">Actual Start Date</dt>
                                                <dd class="col-sm-8">@item.WoActualStartDate</dd>
                                            </dl>

                                            <h6 class="section-title">Service Details</h6>
                                            <dl class="row">
                                                <dt class="col-sm-4">Service Category</dt>
                                                <dd class="col-sm-8">@item.ServiceCategory</dd>
                                                <dt class="col-sm-4">Service Speed</dt>
                                                <dd class="col-sm-8">@item.ServiceSpeed</dd>
                                                <dt class="col-sm-4">Order Type</dt>
                                                <dd class="col-sm-8">@item.OrderType</dd>
                                                <dt class="col-sm-4">CRM Order</dt>
                                                <dd class="col-sm-8">@item.CrmOrder</dd>
                                            </dl>

                                            <h6 class="section-title">Customer Information</h6>
                                            <dl class="row">
                                                <dt class="col-sm-4">Customer Type</dt>
                                                <dd class="col-sm-8">@item.CusType</dd>
                                                <dt class="col-sm-4">Account Manager</dt>
                                                <dd class="col-sm-8">@item.AccountManager</dd>
                                                <dt class="col-sm-4">Section Handled By</dt>
                                                <dd class="col-sm-8">@item.SectionHandledBy</dd>
                                            </dl>
                                        </div>
                                    </div>

                                    <div class="row mt-4">
                                        <div class="col-12">
                                            <h6 class="section-title">Location Information</h6>
                                            <dl class="row">
                                                <dt class="col-sm-2">Location A</dt>
                                                <dd class="col-sm-10">@item.LocationAAddress</dd>
                                                <dt class="col-sm-2">Location B</dt>
                                                <dd class="col-sm-10">@item.LocationBAddress</dd>
                                            </dl>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(item.PeWoComments) || !string.IsNullOrEmpty(item.WoComments))
                                    {
                                        <div class="row mt-4">
                                            <div class="col-12">
                                                <h6 class="section-title">Comments</h6>
                                                @if (!string.IsNullOrEmpty(item.PeWoComments))
                                                {
                                                    <div class="mb-3">
                                                        <strong>PE Work Order Comments:</strong>
                                                        <p class="mb-2">@item.PeWoComments</p>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(item.WoComments))
                                                {
                                                    <div>
                                                        <strong>Work Order Comments:</strong>
                                                        <p class="mb-0">@item.WoComments</p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (isSearchPerformed)
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No records found.
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <!-- Pagination Controls -->
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=1&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">First</a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex - 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">@Model.PageIndex</span>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex + 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Next</a>
                        </li>
                        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=@Model.TotalPages&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Last</a>
                        </li>
                    </ul>
                </nav>
            }

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <a asp-action="UrgentRecords" class="dashboard-card urgent-card">
                        <div class="card-content">
                            <h4>Urgent Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-danger" style="font-size: 1.2rem;">@ViewData["UrgentCount"] Tasks</span>
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/urgent.png" alt="Urgent" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a asp-action="InProgressRecords" class="dashboard-card inprogress-card">
                        <div class="card-content">
                            <h4>In Progress Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-success" style="font-size: 1.2rem;">@ViewData["InProgressCount"] Tasks</span>
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/work-in-progress.png" alt="In Progress" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a asp-action="OLAViolateRecords" class="dashboard-card ola-card">
                        <div class="card-content">
                            <h4>OLA Violate Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-dark" style="font-size: 1.2rem;">@ViewData["OLAViolateCount"] Tasks</span>
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/ola _Validate.png" alt="OLA Violate" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a asp-action="HoldRecords" class="dashboard-card hold-card">
                        <div class="card-content">
                            <h4>Hold Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-warning" style="font-size: 1.2rem;">0 Tasks</span>
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/hold.png" alt="Hold" class="dashboard-img" />
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Column - Message Inbox -->
        <div class="col-lg-4">
            <div class="message-inbox-container">
                <div class="inbox-header">
                    <h3>
                        <i class="fas fa-inbox me-2"></i>Message Inbox
                        <span class="badge bg-primary rounded-pill ms-2">12</span>
                    </h3>

                    <!-- Message search bar -->
                    <div class="inbox-search-container mt-3">
                        <div class="input-group">
                            <input type="text" class="form-control inbox-search" placeholder="Search messages..." aria-label="Search messages">
                            <button class="btn btn-outline-primary" type="button" id="inbox-search-button">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="inbox-filters mt-3">
                    <div class="btn-group w-100" role="group" aria-label="Message filters">
                        <button type="button" class="btn btn-outline-primary active" data-filter="all">All</button>
                        <button type="button" class="btn btn-outline-primary" data-filter="unread">Unread</button>
                        <button type="button" class="btn btn-outline-primary" data-filter="important">Important</button>
                    </div>
                </div>

                <div class="messages-container mt-3">
                    <!-- Unread message -->
                    <div class="message-item unread" data-message-id="1">
                        <div class="message-indicator"></div>
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="message-sender">ATNC Service Team</h6>
                                <span class="message-time">10:45 AM</span>
                            </div>
                            <div class="message-subject">New Urgent PE Record Added</div>
                            <div class="message-preview">A new urgent PE record has been added that requires your attention...</div>
                        </div>
                    </div>

                    <!-- Unread Important message -->
                    <div class="message-item unread important" data-message-id="2">
                        <div class="message-indicator"></div>
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="message-sender">System Admin</h6>
                                <span class="message-time">Yesterday</span>
                            </div>
                            <div class="message-subject">OLA Violation Alert</div>
                            <div class="message-preview">Multiple records are approaching OLA violation status. Please review...</div>
                        </div>
                    </div>

                    <!-- Read message -->
                    <div class="message-item" data-message-id="3">
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="message-sender">Customer Support</h6>
                                <span class="message-time">Apr 19</span>
                            </div>
                            <div class="message-subject">Customer Feedback: XYZ Corporation</div>
                            <div class="message-preview">Customer XYZ Corporation has provided feedback on their recent service...</div>
                        </div>
                    </div>

                    <!-- Important read message -->
                    <div class="message-item important" data-message-id="4">
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="message-sender">Project Manager</h6>
                                <span class="message-time">Apr 18</span>
                            </div>
                            <div class="message-subject">Project Status Update</div>
                            <div class="message-preview">The status of the current project has been updated. Please review the...</div>
                        </div>
                    </div>

                    <!-- Read message -->
                    <div class="message-item" data-message-id="5">
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="message-sender">Technical Support</h6>
                                <span class="message-time">Apr 17</span>
                            </div>
                            <div class="message-subject">System Maintenance Notice</div>
                            <div class="message-preview">The system will be undergoing scheduled maintenance on Sunday...</div>
                        </div>
                    </div>

                    <!-- Multiple more messages -->
                    <div class="message-item" data-message-id="6">
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="message-sender">Operations Team</h6>
                                <span class="message-time">Apr 16</span>
                            </div>
                            <div class="message-subject">Weekly Report Available</div>
                            <div class="message-preview">The weekly operations report is now available for review in...</div>
                        </div>
                    </div>

                    <div class="message-item" data-message-id="7">
                        <div class="message-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="message-sender">HR Department</h6>
                                <span class="message-time">Apr 15</span>
                            </div>
                            <div class="message-subject">New Training Modules</div>
                            <div class="message-preview">New training modules have been added to the system...</div>
                        </div>
                    </div>
                </div>

                <div class="inbox-footer mt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <button class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-sync-alt me-1"></i> Refresh
                        </button>
                        <a href="#" class="view-all-link">View All Messages <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>

                <!-- Message detail modal -->
                <div class="modal fade" id="messageDetailModal" tabindex="-1" aria-labelledby="messageDetailModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="messageDetailModalLabel">Message Details</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body" id="messageDetailContent">
                                <!-- Message details will be loaded here -->
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                <button type="button" class="btn btn-primary" id="replyMessageBtn">Reply</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Original search fields toggle function
        function toggleSearchFields() {
            const searchType = document.getElementById('searchType').value;
            const searchFields = document.querySelectorAll('.search-field');

            // Hide all search fields with animation
            searchFields.forEach(field => {
                if (!field.classList.contains('d-none')) {
                    field.style.opacity = '0';
                    field.style.maxHeight = '0';

                    setTimeout(() => {
                        field.classList.add('d-none');

                        // Clear the input when hiding
                        const input = field.querySelector('input');
                        if (input && field.id !== searchType + 'Field') {
                            input.value = '';
                        }
                    }, 300);
                }
            });

            // Show selected search field with animation
            setTimeout(() => {
                const selectedField = document.getElementById(searchType + 'Field');
                selectedField.classList.remove('d-none');

                // Trigger reflow
                void selectedField.offsetWidth;

                // Animate in
                selectedField.style.opacity = '1';
                selectedField.style.maxHeight = '100px';

                // Focus on the input after animation
                setTimeout(() => {
                    const input = selectedField.querySelector('input');
                    if (input) input.focus();
                }, 300);
            }, 350);
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize the search field toggle
            toggleSearchFields();

            // Add ripple effect to search button
            const searchButton = document.querySelector('.search-section .btn-primary');

            if (searchButton) {
                searchButton.addEventListener('mousedown', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;

                    this.style.setProperty('--ripple-x', x + 'px');
                    this.style.setProperty('--ripple-y', y + 'px');

                    this.classList.remove('btn-ripple');
                    void this.offsetWidth; 
                    this.classList.add('btn-ripple');
                });
            }

            // Add animation for form controls
            const formControls = document.querySelectorAll('.search-section .form-control, .search-section .form-select');

            formControls.forEach(control => {
                control.addEventListener('focus', function() {
                    const label = this.parentElement.querySelector('.form-label');
                    if (label) {
                        label.style.color = '#4a89dc';
                    }
                });

                control.addEventListener('blur', function() {
                    const label = this.parentElement.querySelector('.form-label');
                    if (label) {
                        label.style.color = '#495057';
                    }
                });
            });

            // Message inbox functionality
            const messageItems = document.querySelectorAll('.message-item');
            const filterButtons = document.querySelectorAll('.inbox-filters button');
            const inboxSearch = document.querySelector('.inbox-search');

            // Message filtering
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Remove active class from all buttons
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    // Add active class to clicked button
                    this.classList.add('active');

                    const filter = this.getAttribute('data-filter');

                    // Show/hide messages based on filter
                    messageItems.forEach(item => {
                        if (filter === 'all') {
                            item.style.display = 'flex';
                        } else if (filter === 'unread' && item.classList.contains('unread')) {
                            item.style.display = 'flex';
                        } else if (filter === 'important' && item.classList.contains('important')) {
                            item.style.display = 'flex';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            });

            // Message search functionality
            inboxSearch.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();

                messageItems.forEach(item => {
                    const sender = item.querySelector('.message-sender').textContent.toLowerCase();
                    const subject = item.querySelector('.message-subject').textContent.toLowerCase();
                    const preview = item.querySelector('.message-preview').textContent.toLowerCase();

                    if (sender.includes(searchTerm) || subject.includes(searchTerm) || preview.includes(searchTerm)) {
                        item.style.display = 'flex';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });

            // Message click to view details
            messageItems.forEach(item => {
                item.addEventListener('click', function() {
                    const messageId = this.getAttribute('data-message-id');
                    const sender = this.querySelector('.message-sender').textContent;
                    const subject = this.querySelector('.message-subject').textContent;
                    const preview = this.querySelector('.message-preview').textContent;

                    // Create full message content for demo purposes
                    let fullContent = `
                        <div class="message-detail-header">
                            <h5>${subject}</h5>
                            <div class="message-info d-flex justify-content-between align-items-center">
                                <span class="sender-info">From: <strong>${sender}</strong></span>
                                <span class="message-date">${this.querySelector('.message-time').textContent}</span>
                            </div>
                        </div>
                        <div class="message-detail-body mt-4">
                            <p>${preview}</p>
                            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Proin euismod, nunc in tempor eleifend, nisi purus tincidunt lectus, vitae ultrices nulla eros at risus.</p>
                            <p>Best regards,<br>${sender}</p>
                        </div>
                    `;

                    // Update modal content and show it
                    document.getElementById('messageDetailContent').innerHTML = fullContent;
                    const messageModal = new bootstrap.Modal(document.getElementById('messageDetailModal'));
                    messageModal.show();

                    // Mark as read
                    this.classList.remove('unread');
                });
            });
        });
    </script>
}

