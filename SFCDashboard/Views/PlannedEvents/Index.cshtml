@functions {
    private string GetResolutionDetails(int issueId)
    {
        var resolution = ViewBag.ResolutionsByIssueId?[issueId];
        return resolution?.ResolutionDetails ?? "";
    }

    private int GetResolutionId(int issueId)
    {
        var resolution = ViewBag.ResolutionsByIssueId?[issueId];
        return resolution?.Id ?? 0;
    }
}