@model PaginatedList<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "PE Records";
    bool isSearchPerformed = !string.IsNullOrEmpty(ViewData["PENumberFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["CustomerFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["JobReferenceFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["SONumberFilter"]?.ToString());
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid mt-4">
    <!-- Add this workgroup filter section above your search form -->
<div class="workgroup-filter-section mb-3">
    <form id="workgroupFilterForm" method="get" asp-action="Index">
        <div class="row align-items-center">
            <div class="col-auto">
                <label for="workgroupFilter" class="form-label mb-0"><i class="bi bi-filter"></i> Filter by Workgroup:</label>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="workgroupFilter" name="workgroupId" onchange="this.form.submit()">
                    <option value="">All Workgroups</option>
                    @if (ViewData["Workgroups"] != null)
                    {
                        foreach (var workgroup in (IEnumerable<WorkGroup>)ViewData["Workgroups"])
                        {
                            <option value="@workgroup.Id" @@(ViewData["SelectedWorkgroupId"]?.ToString() == workgroup.Id.ToString() ? "selected" : "")>
                                @workgroup.Name
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-funnel-fill me-1"></i> Apply Filter
                </button>
            </div>
            <div class="col-auto">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i> Clear Filter
                </a>
            </div>
        </div>
    </form>
</div>
    <!-- Your existing search form -->
    <div class="row">
        <!-- Left Column - Existing Content -->
        <div class="col-lg-8">
            <div class="search-section mb-4">
                <form method="get" asp-action="Index">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="searchType" class="form-label">Search By:</label>
                                <select class="form-select" id="searchType" name="searchType" onchange="toggleSearchFields()">
                                    <option value="peNumber" selected="@(ViewData["SearchType"]?.ToString() == "peNumber")">PE Number</option>
                                    <option value="customer" selected="@(ViewData["SearchType"]?.ToString() == "customer")">Customer</option>
                                    <option value="jobReference" selected="@(ViewData["SearchType"]?.ToString() == "jobReference")">Job Reference</option>
                                    <option value="soNumber" selected="@(ViewData["SearchType"]?.ToString() == "soNumber")">SO Number</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <!-- PE Number Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "peNumber" ? "" : "d-none")" id="peNumberField">
                                <label for="peNumber" class="form-label">PE Number:</label>
                                <input type="text" name="peNumber" class="form-control" id="peNumber" placeholder="Enter PE Number" value="@ViewData["PENumberFilter"]" />
                            </div>

                            <!-- Customer Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "customer" ? "" : "d-none")" id="customerField">
                                <label for="customer" class="form-label">Customer:</label>
                                <input type="text" name="customer" class="form-control" id="customer" placeholder="Enter Customer Name" value="@ViewData["CustomerFilter"]" />
                            </div>

                            <!-- Job Reference Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "jobReference" ? "" : "d-none")" id="jobReferenceField">
                                <label for="jobReference" class="form-label">Job Reference:</label>
                                <input type="text" name="jobReference" class="form-control" id="jobReference" placeholder="Enter Job Reference" value="@ViewData["JobReferenceFilter"]" />
                            </div>

                            <!-- SO Number Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "soNumber" ? "" : "d-none")" id="soNumberField">
                                <label for="soNumber" class="form-label">SO Number:</label>
                                <input type="text" name="soNumber" class="form-control" id="soNumber" placeholder="Enter SO Number" value="@ViewData["SONumberFilter"]" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary btn-ripple w-100">Search</button>
                        </div>
                    </div>
                </form>
            </div>

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">PE Number: @item.PeNumber</h5>
                            <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.PeNumber" aria-expanded="false">
                                Show Details
                            </button>
                        </div>
                        <div id="@item.PeNumber">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Status</dt>
                                            <dd class="col-sm-8">@item.PEStatus</dd>
                                            <dt class="col-sm-4">Customer</dt>
                                            <dd class="col-sm-8">@item.Customer</dd>
                                            <dt class="col-sm-4">Service Type</dt>
                                            <dd class="col-sm-8">@item.ServiceType</dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Start Date</dt>
                                            <dd class="col-sm-8">@item.PECreatedDate.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">Required Date</dt>
                                            <dd class="col-sm-8">@item.ServiceRequiredDate?.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">SO Number</dt>
                                            <dd class="col-sm-8">@item.SoNumber</dd>
                                        </dl>
                                    </div>
                                </div>

                                <!-- Replace the existing collapse section with this improved version -->
                                <div class="collapse" id="collapse-@item.PeNumber">
                                    <hr class="details-divider" />
                                    
                                    <!-- Details Header -->
                                    <div class="details-header mb-3">
                                        <h5 class="details-title">PE Details: @item.PeNumber</h5>
                                    </div>
                                    
                                    <!-- Details Content -->
                                    <div class="details-content">
                                        <div class="row g-4">
                                            <!-- Location Details Card -->
                                            <div class="col-md-6">
                                                <div class="details-card">
                                                    <div class="details-card-header">
                                                        <i class="bi bi-geo-alt me-2"></i>
                                                        <h6>Location Details</h6>
                                                    </div>
                                                    <div class="details-card-body">
                                                        <div class="detail-item">
                                                            <span class="detail-label">Province:</span>
                                                            <span class="detail-value">@item.Province</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">Region:</span>
                                                            <span class="detail-value">@item.Region</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">RTOM:</span>
                                                            <span class="detail-value">@item.Rtom</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">RTOM Description:</span>
                                                            <span class="detail-value">@item.RtomDescription</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Project Details Card -->
                                                <div class="details-card mt-3">
                                                    <div class="details-card-header">
                                                        <i class="bi bi-clipboard-data me-2"></i>
                                                        <h6>Project Details</h6>
                                                    </div>
                                                    <div class="details-card-body">
                                                        <div class="detail-item">
                                                            <span class="detail-label">Job Reference:</span>
                                                            <span class="detail-value">@item.JobReference</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">Contractor:</span>
                                                            <span class="detail-value">@item.ContractorName</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">PE Activity:</span>
                                                            <span class="detail-value">@item.PeActivity</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">PE Nature:</span>
                                                            <span class="detail-value">@item.PeNature</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">PE Title:</span>
                                                            <span class="detail-value">@item.PeTitle</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">PE Objective:</span>
                                                            <span class="detail-value">@item.PeObjective</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">PE Area:</span>
                                                            <span class="detail-value">@item.PeArea</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <!-- Task Information Card -->
                                                <div class="details-card">
                                                    <div class="details-card-header">
                                                        <i class="bi bi-list-task me-2"></i>
                                                        <h6>Task Information</h6>
                                                    </div>
                                                    <div class="details-card-body">
                                                        <div class="detail-item">
                                                            <span class="detail-label">Task Sequence:</span>
                                                            <span class="detail-value">@item.TaskSeq</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">Task Name:</span>
                                                            <span class="detail-value">@item.TaskName</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">Task Workgroup:</span>
                                                            <span class="detail-value">@item.TaskWg</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">Actual Start Date:</span>
                                                            <span class="detail-value">@item.WoActualStartDate</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Service Details Card -->
                                                <div class="details-card mt-3">
                                                    <div class="details-card-header">
                                                        <i class="bi bi-gear-fill me-2"></i>
                                                        <h6>Service Details</h6>
                                                    </div>
                                                    <div class="details-card-body">
                                                        <div class="detail-item">
                                                            <span class="detail-label">Service Category:</span>
                                                            <span class="detail-value">@item.ServiceCategory</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">Service Speed:</span>
                                                            <span class="detail-value">@item.ServiceSpeed</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">Order Type:</span>
                                                            <span class="detail-value">@item.OrderType</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">CRM Order:</span>
                                                            <span class="detail-value">@item.CrmOrder</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Customer Information Card -->
                                                <div class="details-card mt-3">
                                                    <div class="details-card-header">
                                                        <i class="bi bi-person me-2"></i>
                                                        <h6>Customer Information</h6>
                                                    </div>
                                                    <div class="details-card-body">
                                                        <div class="detail-item">
                                                            <span class="detail-label">Customer Type:</span>
                                                            <span class="detail-value">@item.CusType</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">Account Manager:</span>
                                                            <span class="detail-value">@item.AccountManager</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <span class="detail-label">Section Handled By:</span>
                                                            <span class="detail-value">@item.SectionHandledBy</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Location Information Section -->
                                        <div class="details-card mt-3">
                                            <div class="details-card-header">
                                                <i class="bi bi-pin-map me-2"></i>
                                                <h6>Location Information</h6>
                                            </div>
                                            <div class="details-card-body">
                                                <div class="detail-item">
                                                    <span class="detail-label">Location A:</span>
                                                    <span class="detail-value">@item.LocationAAddress</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-label">Location B:</span>
                                                    <span class="detail-value">@item.LocationBAddress</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Comments Section (Only Show if Comments Exist) -->
                                        @if (!string.IsNullOrEmpty(item.PeWoComments) || !string.IsNullOrEmpty(item.WoComments))
                                        {
                                            <div class="details-card mt-3">
                                                <div class="details-card-header">
                                                    <i class="bi bi-chat-left-text me-2"></i>
                                                    <h6>Comments</h6>
                                                </div>
                                                <div class="details-card-body">
                                                    @if (!string.IsNullOrEmpty(item.PeWoComments))
                                                    {
                                                        <div class="comment-block">
                                                            <div class="comment-header">PE Work Order Comments:</div>
                                                            <div class="comment-content">@item.PeWoComments</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.WoComments))
                                                    {
                                                        <div class="comment-block @(string.IsNullOrEmpty(item.PeWoComments) ? "" : "mt-3")">
                                                            <div class="comment-header">Work Order Comments:</div>
                                                            <div class="comment-content">@item.WoComments</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (isSearchPerformed)
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No records found.
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <!-- Pagination Controls -->
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=1&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">First</a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex - 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">@Model.PageIndex</span>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex + 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Next</a>
                        </li>
                        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=@Model.TotalPages&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Last</a>
                        </li>
                    </ul>
                </nav>
            }

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("UrgentRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card urgent-card">
                        <div class="card-content">
                            <h4>Urgent Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-danger" style="font-size: 1.2rem;">
                                    @ViewData["UrgentCount"] Tasks
                                </span>
                                @if (ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-danger text-white">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/urgent.png" alt="Urgent" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("InProgressRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card inprogress-card">
                        <div class="card-content">
                            <h4>Regular Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-success" style="font-size: 1.2rem;">
                                    @ViewData["InProgressCount"] Tasks
                                </span>
                                @if (ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-success text-white">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/work-in-progress.png" alt="Regular Records" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("OLAViolateRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card ola-card">
                        <div class="card-content">
                            <h4>OLA Violate Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-dark" style="font-size: 1.2rem;">
                                    @ViewData["OLAViolateCount"] Tasks
                                </span>
                                @if (ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-dark text-white">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/ola _Validate.png" alt="OLA Violate" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("HoldRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card hold-card">
                        <div class="card-content">
                            <h4>Hold Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-warning" style="font-size: 1.2rem;">
                                    @(ViewData["HoldCount"] != null ? ViewData["HoldCount"] : 0) Tasks
                                </span>
                                @if (ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/hold.png" alt="Hold Records" class="dashboard-img" />
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Column - Message Inbox -->
        <div class="col-lg-4">
            <div class="message-inbox-container">
                <div class="inbox-header">
                    <h3>
                        <i class="fas fa-inbox me-2"></i>Message Inbox
                        <span class="badge bg-primary rounded-pill ms-2">@ViewData["TotalMessages"]</span>
                    </h3>

                    <!-- Message search bar -->
                    <div class="inbox-search-container mt-3">
                        <div class="input-group">
                            <input type="text" class="form-control inbox-search" placeholder="Search messages..." aria-label="Search messages">
                            <button class="btn btn-outline-primary" type="button" id="inbox-search-button">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="inbox-filters mt-3">
                    <div class="btn-group w-100" role="group" aria-label="Message filters">
                        <button type="button" class="btn btn-outline-primary active" data-filter="all">All</button>
                        <button type="button" class="btn btn-outline-primary" data-filter="urgent">Urgent Requests</button>
                        <button type="button" class="btn btn-outline-primary" data-filter="system">System</button>
                    </div>
                </div>

                <div class="messages-container mt-3">
                    <!-- Urgent Request Confirmation Messages -->
                    @if (ViewData["PendingUrgentRequests"] != null)
                    {
                        foreach (var request in (IEnumerable<PlannedEvent>)ViewData["PendingUrgentRequests"])
                        {
                            <div class="message-item unread important urgent-request" data-message-id="urgent-pe-@request.Id">
                                <div class="message-indicator"></div>
                                <div class="message-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="message-sender">Urgent Request: @request.PeNumber</h6>
                                        <span class="message-time">@(request.PECreatedDate.ToString("MMM dd"))</span>
                                    </div>
                                    <div class="message-subject">
                                        <span class="badge bg-danger me-1">Action Required</span>
                                        Confirm Urgent Status
                                    </div>
                                    <div class="message-preview">
                                        Customer: @request.Customer - @(string.IsNullOrEmpty(request.Priority) ? "No reason provided" : request.Priority)
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    
                    <!-- Task Urgent Requests -->
                    @if (ViewData["PendingTaskRequests"] != null)
                    {
                        foreach (var task in (IEnumerable<PETask>)ViewData["PendingTaskRequests"])
                        {
                            <div class="message-item unread important task-urgent-request" data-message-id="urgent-task-@task.Id">
                                <div class="message-indicator"></div>
                                <div class="message-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="message-sender">Task Urgent Request: @task.PENumber</h6>
                                        <span class="message-time">@(task.TaskCreatedDate.ToString("MMM dd"))</span>
                                    </div>
                                    <div class="message-subject">
                                        <span class="badge bg-warning text-dark me-1">Task</span>
                                        @task.Task Needs Priority
                                    </div>
                                    <div class="message-preview">
                                        @(string.IsNullOrEmpty(task.Priority) ? "No reason provided" : task.Priority)
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <!-- Issue Messages -->
                    @if (ViewData["InboxIssues"] != null)
                    {
                        foreach (var issue in (IEnumerable<SFCDashboard.Models.PEIssue>)ViewData["InboxIssues"])
                        {
                            <div class="message-item unread" data-message-id="issue-@issue.Id">
                                <div class="message-indicator"></div>
                                <div class="message-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="message-sender">From: @issue.SenderId</h6>
                                        <span class="message-time">@issue.CreatedAt.ToString("MMM dd")</span>
                                    </div>
                                    <div class="message-subject">
                                        <span class="badge bg-info me-1">Issue</span>
                                        @issue.IssueText
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    @if (ViewData["InboxIssues"] != null)
{
