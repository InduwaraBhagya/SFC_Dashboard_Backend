@using System.Linq
@using SFCDashboard.Models
@model PaginatedList<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "PE Records";
    bool isSearchPerformed = !string.IsNullOrEmpty(ViewData["PENumberFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["CustomerFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["JobReferenceFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["SONumberFilter"]?.ToString());
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{var selectedName = ViewData["SelectedWorkgroupName"] as string;}

<div class="container-fluid mt-2">
@{
    var nextTask = ViewBag.NextTask as List<TaskQueueItem>;
    var hasNextTask = ViewBag.HasNextTask;
}

@{
    bool shouldShowNextTask = 
        (ViewData["CanViewAll"] as bool? != true) && 
        ((ViewData["UserWorkGroups"] as List<WorkGroup>)?.Count <= 1);
}

<!-- Top Section: Dynamic Layout Based on Permissions -->
@if (ViewData["CanViewAll"] as bool? == true)
{
    <!-- For ViewAll Users: Workgroup Filter and Search PE Side by Side -->
    <div class="row mb-2">
        <!-- Workgroup Filter Card -->
        <div class="col-lg-6 mb-2">
            <div class="card border-primary h-100 shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-funnel-fill me-2"></i> Filter by Workgroups
                    </h5>
                    <button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="collapse" data-bs-target="#filterContent" aria-expanded="false" aria-controls="filterContent">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                
                <div class="collapse" id="filterContent">
                    <div class="card-body">
                        <form method="get" asp-action="Index">
                            <div class="mb-2">
                                <label class="form-label" for="workgroupFilter">
                                    <i class="bi bi-people-fill"></i>
                                    Select Workgroups
                                    <span class="info-tooltip" data-tooltip="You can select multiple workgroups to view combined data">
                                        <i class="bi bi-info-circle"></i>
                                    </span>
                                </label>
                                <div class="filter-row">
                                    <div class="filter-select-container mb-2">
                                        <select class="form-select" name="workgroupId" id="workgroupFilter" multiple>
                                            @if (ViewData["UserWorkGroups"] is List<WorkGroup> workgroups)
                                            {
                                                foreach (var workgroup in workgroups)
                                                {
                                                    bool isSelected = ViewData["SelectedWorkgroupId"] != null &&
                                                                    ViewData["SelectedWorkgroupId"]?.Equals(workgroup.Id) == true;
                                                    <option value="@workgroup.Id" selected="@isSelected">@workgroup.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="filter-actions d-flex gap-2">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-funnel-fill"></i>
                                            Apply Filter
                                        </button>
                                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                            <i class="bi bi-x-circle"></i>
                                            Clear Filter
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </form>
                        
                        @if (ViewData["SelectedWorkgroupId"] != null && ViewData["SelectedWorkgroupName"] != null)
                        {
                            <div class="alert alert-info mb-0">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                Active filter: <strong>@ViewData["SelectedWorkgroupName"]</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>                <!-- Search PE Records Card -->
                <div class="col-lg-6 mb-2">
                    <div class="card border-info h-100 shadow-sm">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-search"></i> Search PE Records
                            </h5>
                            <button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="collapse" data-bs-target="#searchFormCollapse" aria-expanded="false" aria-controls="searchFormCollapse">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                        
                        <div class="collapse" id="searchFormCollapse">
                            <div class="card-body">
                                <form method="get" asp-action="Index">
                                <div class="search-form-row">
                                    <div class="search-type-selector mb-3">
                                        <label class="form-label" for="searchType">
                                            <i class="bi bi-funnel"></i> Search By
                                        </label>
                                        <select class="form-select" name="searchType" id="searchType" onchange="toggleSearchFields()">
                                            <option value="peNumber" selected="@(ViewData["SearchType"]?.ToString() == "peNumber")">
                                                PE Number
                                            </option>
                                            <option value="customer" selected="@(ViewData["SearchType"]?.ToString() == "customer")">
                                                Customer
                                            </option>
                                            <option value="jobReference" selected="@(ViewData["SearchType"]?.ToString() == "jobReference")">
                                                Job Reference
                                            </option>
                                            <option value="soNumber" selected="@(ViewData["SearchType"]?.ToString() == "soNumber")">
                                                SO Number
                                            </option>
                                        </select>
                                    </div>
                                    
                                    <div class="search-input-container mb-3">
                                        <label class="form-label" id="searchLabel">
                                            <i class="bi bi-hash"></i> PE Number
                                        </label>
                                        <div class="position-relative">
                                            <input type="text" class="form-control" 
                                                   name="@(ViewData["SearchType"]?.ToString() ?? "peNumber")" 
                                                   id="searchInput" 
                                                   placeholder="Enter PE Number" 
                                                   value="@(
                                                       ViewData["SearchType"]?.ToString() == "customer" ? ViewData["CustomerFilter"] :
                                                       ViewData["SearchType"]?.ToString() == "jobReference" ? ViewData["JobReferenceFilter"] :
                                                       ViewData["SearchType"]?.ToString() == "soNumber" ? ViewData["SONumberFilter"] :
                                                       ViewData["PENumberFilter"]
                                                   )"
                                                   autocomplete="off">
                                            <div class="input-icon position-absolute top-50 end-0 translate-middle-y me-3">
                                                <i class="bi bi-search text-muted"></i>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="search-button-container d-flex gap-2">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-search"></i> Search
                                        </button>
                                        @if (isSearchPerformed)
                                        {
                                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                                <i class="bi bi-x-circle"></i> Clear Search
                                            </a>
                                        }
                                    </div>
                                </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
    </div>
}
else
{
    <!-- For Regular Users: Next Task and Search PE Side by Side -->
    <div class="row mb-2">
        @if (shouldShowNextTask)
        {
            <!-- Next Task Card -->
            <div class="col-lg-6 mb-3">
                <div class="card border-info h-100 shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-arrow-right-circle-fill me-2"></i> Next Task
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="PlannedEvents" asp-action="TaskQueue" class="btn btn-sm btn-light">
                                <i class="bi bi-list-task me-1"></i> View All Tasks
                            </a>
                            <button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="collapse" data-bs-target="#nextTaskContent" aria-expanded="false" aria-controls="nextTaskContent">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="collapse" id="nextTaskContent">
                        <div class="card-body">
                        @if (hasNextTask && nextTask?.Count > 0)
                        {
                                var task = nextTask![0];
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    @{
                                        string badgeClass = task.PriorityLevel switch
                                        {
                                            "URGENT P0" => "bg-danger fw-bold",
                                            "URGENT P1" => "bg-danger",
                                            "URGENT P2" => "bg-danger",
                                            "URGENT" => "bg-danger",
                                            "OLA VIOLATION" => "bg-warning text-dark",
                                            "APPROACHING DEADLINE" => "bg-info text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass p-3">
                                        <i class="bi bi-lightning-charge-fill"></i>
                                    </span>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h5 class="card-title mb-1">@task.Task.Task</h5>
                                    <p class="card-text mb-1 text-muted">
                                        <small>
                                            <i class="bi bi-file-earmark-text me-1"></i> PE: @task.Task.PENumber 
                                            <i class="bi bi-person ms-2 me-1"></i> @task.Task.PlannedEvent?.Customer
                                        </small>
                                    </p>
                                    <p class="mb-0">
                                        @{
                                            string daysClass = task.IsOverdue ? "text-danger fw-bold" : 
                                                (task.DaysUntilDue <= 2) ? "text-warning fw-bold" : "text-success";
                                        }
                                        <span class="@daysClass">
                                            <i class="bi bi-calendar-check me-1"></i>
                                            @task.DueStatus
                                        </span>
                                    </p>
                                </div>
                                <div class="flex-shrink-0 ms-3">
                                    <a href="@Url.Action("Details", "PlannedEvents", new { id = task.Task.PlannedEvent?.Id })" 
                                       class="btn btn-primary">
                                        <i class="bi bi-arrow-right"></i> View Details
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                                <p class="mt-3 mb-0">No pending tasks in your queue!</p>
                            </div>
                        }
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- Search PE Records Card -->
        <div class="@(shouldShowNextTask ? "col-lg-6" : "col-lg-12") mb-2">
            <div class="card border-info h-100 shadow-sm">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-search"></i> Search PE Records
                    </h5>
                    <button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="collapse" data-bs-target="#searchFormCollapse" aria-expanded="false" aria-controls="searchFormCollapse">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                
                <div class="collapse" id="searchFormCollapse">
                    <div class="card-body">
                        <form method="get" asp-action="Index">
                        <div class="search-form-row">
                            <div class="search-type-selector mb-3">
                                <label class="form-label" for="searchType">
                                    <i class="bi bi-funnel"></i> Search By
                                </label>
                                <select class="form-select" name="searchType" id="searchType" onchange="toggleSearchFields()">
                                    <option value="peNumber" selected="@(ViewData["SearchType"]?.ToString() == "peNumber")">
                                        PE Number
                                    </option>
                                    <option value="customer" selected="@(ViewData["SearchType"]?.ToString() == "customer")">
                                        Customer
                                    </option>
                                    <option value="jobReference" selected="@(ViewData["SearchType"]?.ToString() == "jobReference")">
                                        Job Reference
                                    </option>
                                    <option value="soNumber" selected="@(ViewData["SearchType"]?.ToString() == "soNumber")">
                                        SO Number
                                    </option>
                                </select>
                            </div>
                            
                            <div class="search-input-container mb-3">
                                <label class="form-label" id="searchLabel">
                                    <i class="bi bi-hash"></i> PE Number
                                </label>
                                <div class="position-relative">
                                    <input type="text" class="form-control" 
                                           name="@(ViewData["SearchType"]?.ToString() ?? "peNumber")" 
                                           id="searchInput" 
                                           placeholder="Enter PE Number" 
                                           value="@(
                                               ViewData["SearchType"]?.ToString() == "customer" ? ViewData["CustomerFilter"] :
                                               ViewData["SearchType"]?.ToString() == "jobReference" ? ViewData["JobReferenceFilter"] :
                                               ViewData["SearchType"]?.ToString() == "soNumber" ? ViewData["SONumberFilter"] :
                                               ViewData["PENumberFilter"]
                                           )"
                                           autocomplete="off">
                                    <div class="input-icon position-absolute top-50 end-0 translate-middle-y me-3">
                                        <i class="bi bi-search text-muted"></i>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="search-button-container d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-search"></i> Search
                                </button>
                                @if (isSearchPerformed)
                                {
                                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle"></i> Clear Search
                                    </a>
                                }
                            </div>
                        </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

    <div class="row">
        <!-- Left Column - Existing Content -->
        <div class="col-lg-8">
            <div class="container-fluid mt-4"></div>

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="card mb-2">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">PE Number: @item.PeNumber</h5>
                            <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.PeNumber" aria-expanded="false">
                                Show Details
                            </button>
                        </div>
                        <div id="@item.PeNumber">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Status</dt>
                                            <dd class="col-sm-8">@item.PEStatus</dd>
                                            <dt class="col-sm-4">Customer</dt>
                                            <dd class="col-sm-8">@item.Customer</dd>
                                            <dt class="col-sm-4">Service Type</dt>
                                            <dd class="col-sm-8">@item.ServiceType</dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Start Date</dt>
                                            <dd class="col-sm-8">@item.PECreatedDate.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">Required Date</dt>
                                            <dd class="col-sm-8">@item.ServiceRequiredDate?.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">SO Number</dt>
                                            <dd class="col-sm-8">@item.SoNumber</dd>
                                        </dl>
                                    </div>
                                </div>

                                <div class="collapse" id="collapse-@item.PeNumber">
                                    <hr class="details-divider" />

                                    <div class="details-header mb-3">
                                        <h5 class="details-title text-primary">
                                            <i class="bi bi-file-earmark-text me-2"></i>
                                            PE Details: <span class="text-dark">@item.PeNumber</span>
                                        </h5>
                                    </div>

                                    <div class="details-content">
                                        <div class="row g-4">
                                            <!-- Location Details Card -->
                                            <div class="col-md-6">
                                                <div class="details-card shadow-sm border-start border-4 border-info bg-light mb-3">
                                                    <div class="details-card-header bg-info text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-geo-alt me-2"></i>
                                                        <span>Location Details</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Province:</span> <span class="detail-value fw-semibold">@item.Province</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Region:</span> <span class="detail-value fw-semibold">@item.Region</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">RTOM:</span> <span class="detail-value fw-semibold">@item.Rtom</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">RTOM Description:</span> <span class="detail-value">@item.RtomDescription</span></div>
                                                    </div>
                                                </div>
                                                <div class="details-card shadow-sm border-start border-4 border-success bg-light mb-3">
                                                    <div class="details-card-header bg-success text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-clipboard-data me-2"></i>
                                                        <span>Project Details</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Job Reference:</span> <span class="detail-value">@item.JobReference</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Contractor:</span> <span class="detail-value">@item.ContractorName</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Activity:</span> <span class="detail-value">@item.PeActivity</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Nature:</span> <span class="detail-value">@item.PeNature</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Title:</span> <span class="detail-value">@item.PeTitle</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Objective:</span> <span class="detail-value">@item.PeObjective</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Area:</span> <span class="detail-value">@item.PeArea</span></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="details-card shadow-sm border-start border-4 border-warning bg-light mb-3">
                                                    <div class="details-card-header bg-warning text-dark rounded-top px-3 py-2">
                                                        <i class="bi bi-list-task me-2"></i>
                                                        <span>Task Information</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Task Sequence:</span> <span class="detail-value">@item.TaskSeq</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Task Name:</span> <span class="detail-value">@item.TaskName</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Task Workgroup:</span> <span class="detail-value">@item.TaskWg</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Actual Start Date:</span> <span class="detail-value">@item.WoActualStartDate</span></div>
                                                    </div>
                                                </div>
                                                <div class="details-card shadow-sm border-start border-4 border-primary bg-light mb-3">
                                                    <div class="details-card-header bg-primary text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-gear-fill me-2"></i>
                                                        <span>Service Details</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Service Category:</span> <span class="detail-value">@item.ServiceCategory</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Service Speed:</span> <span class="detail-value">@item.ServiceSpeed</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Order Type:</span> <span class="detail-value">@item.OrderType</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">CRM Order:</span> <span class="detail-value">@item.CrmOrder</span></div>
                                                    </div>
                                                </div>
                                                <div class="details-card shadow-sm border-start border-4 border-secondary bg-light mb-3">
                                                    <div class="details-card-header bg-secondary text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-person me-2"></i>
                                                        <span>Customer Information</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Customer Type:</span> <span class="detail-value">@item.CusType</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Account Manager:</span> <span class="detail-value">@item.AccountManager</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Section Handled By:</span> <span class="detail-value">@item.SectionHandledBy</span></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Location Information Section -->
                                        <div class="details-card shadow-sm border-start border-4 border-info bg-light mt-3">
                                            <div class="details-card-header bg-info text-white rounded-top px-3 py-2">
                                                <i class="bi bi-pin-map me-2"></i>
                                                <span>Location Information</span>
                                            </div>
                                            <div class="details-card-body px-3 py-2">
                                                <div class="detail-item"><span class="detail-label text-secondary">Location A:</span> <span class="detail-value">@item.LocationAAddress</span></div>
                                                <div class="detail-item"><span class="detail-label text-secondary">Location B:</span> <span class="detail-value">@item.LocationBAddress</span></div>
                                            </div>
                                        </div>

                                        <!-- Comments Section (Only Show if Comments Exist) -->
                                        @if (!string.IsNullOrEmpty(item.PeWoComments) || !string.IsNullOrEmpty(item.WoComments))
                                        {
                                            <div class="details-card mt-3">
                                                <div class="details-card-header">
                                                    <i class="bi bi-chat-left-text me-2"></i>
                                                    <h6>Comments</h6>
                                                </div>
                                                <div class="details-card-body">
                                                    @if (!string.IsNullOrEmpty(item.PeWoComments))
                                                    {
                                                        <div class="comment-block">
                                                            <div class="comment-header">PE Work Order Comments:</div>
                                                            <div class="comment-content">@item.PeWoComments</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.WoComments))
                                                    {
                                                        <div class="comment-block @(string.IsNullOrEmpty(item.PeWoComments) ? "" : "mt-3")">
                                                            <div class="comment-header">Work Order Comments:</div>
                                                            <div class="comment-content">@item.WoComments</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- PE Tasks Table -->
                                        <div class="card mt-4">
                                            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0">PE Tasks</h6>
                                                @{
                                                    var peTasks = ViewBag.PETasksByPeNumber != null && ViewBag.PETasksByPeNumber.ContainsKey(item.PeNumber)
                                                    ? (IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasksByPeNumber[item.PeNumber]
                                                    : null;
                                                }
                                                @if (peTasks == null || !peTasks.Any())
                                                {
                                                    <span class="badge bg-warning text-dark">No tasks found</span>
                                                }
                                            </div>
                                            <div class="card-body">
                                                @if (peTasks != null && peTasks.Any())
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-hover task-table">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Seq</th>
                                                                    <th>Task</th>
                                                                    <th>Workgroup</th>
                                                                    <th>OLA</th>
                                                                    <th>Status</th>
                                                                    <th>Created Date</th>
                                                                    <th>Target Date</th>
                                                                    <th>Actual Date</th>
                                                                    <th>Priority</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var task in peTasks)
                                                                {
                                                                    <tr class="@(task.IsUrgent ? "table-warning" :
                                                                       task.TaskStatus?.ToLower() == "ongoing" ? "table-primary" :
                                                                       task.TaskStatus?.ToLower() == "completed" ? "table-success" :
                                                                       task.TaskStatus?.ToLower() == "waiting" ? "table-secondary" : "")">
                                                                        <td>@task.TaskSeq</td>
                                                                        <td>@task.Task</td>
                                                                        <td>@(task.TaskWorkGroup == "NULL" ? "" : task.TaskWorkGroup)</td>
                                                                        <td>@task.OLA days</td>
                                                                        <td>
                                                                            @{
                                                                                string taskStatusClass = task.TaskStatus?.ToLower() switch
                                                                                {
                                                                                    "completed" => "badge bg-success",
                                                                                    "inprogress" => "badge bg-warning text-dark",
                                                                                    _ => "badge bg-secondary"
                                                                                };
                                                                            }
                                                                            <span class="@taskStatusClass">@task.TaskStatus</span>
                                                                        </td>
                                                                        <td>@task.TaskCreatedDate.ToString("yyyy-MM-dd")</td>
                                                                        <td>@task.TaskCompleteDate.ToString("yyyy-MM-dd")</td>
                                                                        <td>@(task.ACtualTaskCompleteDate != null ? task.ACtualTaskCompleteDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                                                                        <td>
                                                                            @if (task.IsUrgent)
                                                                            {
                                                                                <span class="badge bg-danger">URGENT</span>
                                                                            }
                                                                            @if (task.UrgentRequested && !task.IsUrgent)
                                                                            {
                                                                                <span class="badge bg-warning">URGENT REQUESTED</span>
                                                                            }
                                                                            @if (!string.IsNullOrEmpty(task.Priority))
                                                                            {
                                                                                <small class="d-block text-muted mt-1">@task.Priority</small>
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-info">
                                                        <i class="bi bi-info-circle me-2"></i>
                                                        No tasks have been assigned to this PE record yet.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <!-- End PE Tasks Table -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (isSearchPerformed)
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No records found.
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <!-- Pagination Controls -->
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=1&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">First</a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex - 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">@Model.PageIndex</span>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex + 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Next</a>
                        </li>
                        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=@Model.TotalPages&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Last</a>
                        </li>
                    </ul>
                </nav>
            }

            <div class="row mb-2">
                <div class="col-md-6 mb-2">
                    <a href="@Url.Action("UrgentRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card urgent-card">
                        <div class="card-content">
                            <h4>Urgent Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-danger" style="font-size: 1.2rem;">
                                    @ViewData["UrgentCount"] Tasks
                                </span>
                                @if (ViewData["CanViewAll"] as bool? == true && ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-danger text-white">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/urgent.png" alt="Urgent" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-2">
                    <a href="@Url.Action("InProgressRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card inprogress-card">
                        <div class="card-content">
                            <h4>Regular Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-success" style="font-size: 1.2rem;">
                                    @ViewData["InProgressCount"] Tasks
                                </span>
                                @if (ViewData["CanViewAll"] as bool? == true && ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-success text-white">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/work-in-progress.png" alt="Regular Records" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-2">
                    <a href="@Url.Action("OLAViolateRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card ola-card">
                        <div class="card-content">
                            <h4>OLA Violate Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-dark" style="font-size: 1.2rem;">
                                    @ViewData["OLAViolateCount"] Tasks
                                </span>
                                @if (ViewData["CanViewAll"] as bool? == true && ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-dark text-white">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/ola _Validate.png" alt="OLA Violate" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-2">
                    <a href="@Url.Action("HoldRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card hold-card">
                        <div class="card-content">
                            <h4>Hold Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-warning" style="font-size: 1.2rem;">
                                    @(ViewData["HoldCount"] != null ? ViewData["HoldCount"] : 0) Tasks
                                </span>
                                @if (ViewData["CanViewAll"] as bool? == true && ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/hold.png" alt="Hold Records" class="dashboard-img" />
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Column - Message Inbox -->
        <div class="col-lg-4">
            <div class="message-inbox-container">
                <div class="inbox-header">
                    <h3>
                        <i class="fas fa-inbox me-2"></i>Message Inbox
                        @{
                            var unreadCount = 0;
                            
                            // Count unread issues
                            if (ViewData["InboxIssues"] is IEnumerable<PEIssueViewModel> inboxIssues)
                            {
                                unreadCount += inboxIssues.Count(i => !i.IsRead);
                            }
                            
                            // Count pending urgent PE requests
                            if (ViewData["PendingUrgentRequests"] is IEnumerable<PlannedEvent> urgentRequests)
                            {
                                unreadCount += urgentRequests.Count();
                            }
                            
                            // Count pending urgent task requests
                            if (ViewData["PendingTaskRequests"] is IEnumerable<PETask> taskRequests)
                            {
                                unreadCount += taskRequests.Count();
                            }
                            
                            if (unreadCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill ms-2">@unreadCount Unread</span>
                            }
                        }
                    </h3>

                                <!-- Message search bar -->
                                <div class="inbox-search-container mt-3">
                                    <div class="input-group">
                                        <input type="text" class="form-control inbox-search" placeholder="Search messages..." aria-label="Search messages">
                                    </div>
                                </div>

                                <!-- Add this section after the inbox-search-container -->
                                <div class="inbox-filters mt-3">
                                    <div class="btn-group w-100" role="group" aria-label="Message filters">
                                        <button type="button" class="btn btn-outline-primary active" data-filter="unread">Unread</button>
                                        <button type="button" class="btn btn-outline-primary" data-filter="read">Read</button>
                                        <button type="button" class="btn btn-outline-primary" data-filter="all">All</button>
                                    </div>
                                </div>

                                <div class="messages-container mt-3">
                                    @if (ViewData["CanAcceptUrgentRequests"] as bool? == true)
                                    {<!-- Urgent Request Confirmation Messages -->
                                    @if (ViewData["PendingUrgentRequests"] is IEnumerable<PlannedEvent> pendingRequests)
                                    {
                                        foreach (var request in pendingRequests)
                                        {
                                            <div class="message-item unread important urgent-request" data-message-id="urgent-pe-@request.Id">
                                                <div class="message-indicator"></div>
                                                <div class="message-content">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <h6 class="message-sender"><span class="badge bg-danger me-1">Urgent</span>
                    From @request.UrgentRequestedByName
                </h6>
                                                        <span class="message-time">@(request.PECreatedDate.ToString("MMM dd"))</span>
                                                    </div>
                                                    <div class="message-subject">
                                                        <span class="badge bg-danger me-1">Action Required</span>
                                                        Confirm Urgent Status
                                                    </div>
                                                    <div class="message-preview">
                                                        Customer: @request.Customer - @(string.IsNullOrEmpty(request.Priority) ? "No reason provided" : request.Priority)
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    
                                    <!-- Task Urgent Requests -->
                                    @if (ViewData["PendingTaskRequests"] is IEnumerable<PETask> pendingTasks)
                                    {
                                        foreach (var task in pendingTasks)
                                        {
                                            <div class="message-item unread important task-urgent-request" data-message-id="urgent-task-@task.Id">
                                                <div class="message-indicator"></div>
                                                <div class="message-content">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <h6 class="message-sender">Task Urgent Request: @task.PENumber</h6>
                                                        <span class="message-time">@(task.TaskCreatedDate.ToString("MMM dd"))</span>
                                                    </div>
                                                    <div class="message-subject">
                                                        <span class="badge bg-warning text-dark me-1">Task</span>
                                                        @task.Task Needs Priority
                                                    </div>
                                                    <div class="message-preview">
                                                        @(string.IsNullOrEmpty(task.Priority) ? "No reason provided" : task.Priority)
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                    
                                    <!-- Issue Messages -->
                    @if (ViewData["InboxIssues"] is IEnumerable<PEIssueViewModel> inboxIssuesList)
                        {
                            foreach (var issue in inboxIssuesList)
                        {
                        
                                        
                                            <div class="message-item @(issue.IsRead ? "" : "unread") @(issue.IsResolutionRequest ? "resolution-request" : issue.IsReply ? "reply" : "issue-message")"
                                                data-message-id="issue-@issue.CreatedAt.Ticks"
                                                data-issue-id="@issue.Id"
                                                data-pe-id="@issue.PlannedEventId"
                                                data-sender="@issue.SenderName"
                                                data-sender-id="@issue.SenderId"
                                                data-issue-text="@issue.IssueText"
                                                data-attachment="@issue.AttachmentPath"
                                                data-date="@issue.CreatedAt.ToString("MMM dd, yyyy HH:mm")"
                                                data-is-read="@issue.IsRead.ToString().ToLower()"
                                                data-is-reply="@issue.IsReply.ToString().ToLower()"
                                                data-is-resolution-request="@issue.IsResolutionRequest.ToString().ToLower()"
                                                data-original-issue-id="@issue.OriginalIssueId"
                                                @if (issue.IsResolutionRequest)
                                                {
                                                    <text>
                                                    data-resolution-details="@(GetResolutionDetails(issue.OriginalIssueId ?? issue.Id))"
                                                    data-resolution-id="@(GetResolutionId(issue.OriginalIssueId ?? issue.Id))"
                                                    onclick="showResolutionConfirm(this)"
                                                    </text>
                                                }
                                                else
                                                {
                                                    <text>onclick="showIssueDetails(this)"</text>
                                                }>
                                                <div class="message-indicator"></div>
                                                <div class="message-content">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <h6 class="message-sender">
                                                            @if (issue.IsResolutionRequest)
                                                            {
                                                                <span class="badge bg-success me-1">Resolution</span>
                                                            }
                                                            From @issue.SenderName 
                                                        </h6>
                                                        <span class="message-time">@issue.CreatedAt.ToString("MMM dd")</span>
                                                    </div>
                                                    <div class="message-subject">
                                                        @if (issue.IsResolutionRequest)
                                                        {
                                                            <span class="badge bg-success text-white me-1">Issue Fixed</span>
                                                        }
                                                        else if (issue.IsReply)
                                                        {
                                                            <span class="badge bg-info text-dark me-1">Reply</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger text-white me-1">Issue</span>
                                                        }
                                                        @issue.IssueText
                                                    </div>
                                                    <div class="message-preview">
                                                        @if (!string.IsNullOrEmpty(issue.AttachmentPath))
                                                        {
                                                            <span><i class="bi bi-paperclip me-1"></i>Has attachment</span>
                                                        }
                                                        else
                                                        {
                                                            <span>No attachment</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }           
                            </div>
                        </div>
                    </div>
                </div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/jquery-ui/themes/base/jquery-ui.css" asp-append-version="true">
    <script src="~/lib/jquery-ui/jquery-ui.min.js" asp-append-version="true"></script>
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/lib/select2/js/select2.min.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Initialize Select2 with enhanced styling
            $('#workgroupFilter').select2({
                placeholder: "Select workgroups...",
                allowClear: true,
                width: '100%',
                closeOnSelect: false,
                templateResult: function(option) {
                    if (!option.id) return option.text;
                    return $('<span><i class="bi bi-people me-2"></i>' + option.text + '</span>');
                },
                templateSelection: function(option) {
                    if (!option.id) return option.text;
                    return $('<span><i class="bi bi-check-circle me-1"></i>' + option.text + '</span>');
                }
            });
            
            // Animated toggle for filter section
            $('.filter-toggle-btn').on('click', function() {
                const icon = $(this).find('i');
                const target = $(this).data('bs-target');
                
                setTimeout(() => {
                    if ($(target).hasClass('show')) {
                        icon.removeClass('bi-chevron-down').addClass('bi-chevron-up');
                    } else {
                        icon.removeClass('bi-chevron-up').addClass('bi-chevron-down');
                    }
                }, 150);
            });
            
            // Enhanced search type toggle
            function toggleSearchFields() {
                const searchType = $('#searchType').val();
                const inputField = $('#searchInput');
                const label = $('#searchLabel');
                
                // Add loading animation
                inputField.addClass('loading-shimmer');
                
                setTimeout(() => {
                    switch (searchType) {
                        case 'customer':
                            label.html('<i class="bi bi-person"></i> Customer Name');
                            inputField.attr('name', 'customer');
                            inputField.attr('placeholder', 'Enter customer name');
                            break;
                        case 'jobReference':
                            label.html('<i class="bi bi-briefcase"></i> Job Reference');
                            inputField.attr('name', 'jobReference');
                            inputField.attr('placeholder', 'Enter job reference');
                            break;
                        case 'soNumber':
                            label.html('<i class="bi bi-receipt"></i> SO Number');
                            inputField.attr('name', 'soNumber');
                            inputField.attr('placeholder', 'Enter SO number');
                            break;
                        default:
                            label.html('<i class="bi bi-hash"></i> PE Number');
                            inputField.attr('name', 'peNumber');
                            inputField.attr('placeholder', 'Enter PE number');
                    }
                    
                    inputField.removeClass('loading-shimmer');
                    inputField.focus();
                }, 300);
            }
            
            // Make toggleSearchFields available globally
            window.toggleSearchFields = toggleSearchFields;
            
            // Add success animation when filter is applied
            if (window.location.search.includes('workgroupId')) {
                $('.workgroup-filter-section').addClass('filter-success');
                setTimeout(() => {
                    $('.workgroup-filter-section').removeClass('filter-success');
                }, 600);
            }
            
            // Enhanced form validation
            $('.btn-filter-apply').on('click', function(e) {
                const selectedOptions = $('#workgroupFilter').val();
                if (!selectedOptions || selectedOptions.length === 0) {
                    e.preventDefault();
                    
                    // Show elegant error message
                    const errorMsg = $('<div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">' +
                        '<i class="bi bi-exclamation-triangle me-2"></i>' +
                        'Please select at least one workgroup to apply the filter.' +
                        '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                        '</div>');
                    
                    $('.filter-actions').parent().append(errorMsg);
                    
                    // Auto-dismiss after 5 seconds
                    setTimeout(() => {
                        errorMsg.fadeOut();
                    }, 5000);
                }
            });
            
            // Add keyboard shortcuts
            $(document).on('keydown', function(e) {
                // Alt + F to focus on filter
                if (e.altKey && e.key === 'f') {
                    e.preventDefault();
                    $('#workgroupFilter').select2('open');
                }
                
                // Alt + S to focus on search
                if (e.altKey && e.key === 's') {
                    e.preventDefault();
                    $('#searchInput').focus();
                }
            });
            
            // Add smooth scrolling to results
            $('.btn-search, .btn-filter-apply').on('click', function() {
                setTimeout(() => {
                    $('html, body').animate({
                        scrollTop: $('.search-section').offset().top + $('.search-section').outerHeight() + 20
                    }, 500);
                }, 100);
            });
        });
        
        // Synchronized card collapse/expand functionality
        const searchCollapse = document.getElementById('searchFormCollapse');
        const searchToggleButton = document.querySelector('[data-bs-target="#searchFormCollapse"]');
        const nextTaskCollapse = document.getElementById('nextTaskContent');
        const nextTaskToggleButton = document.querySelector('[data-bs-target="#nextTaskContent"]');
        const filterCollapse = document.getElementById('filterContent');
        const filterToggleButton = document.querySelector('[data-bs-target="#filterContent"]');
        
        // Track which button was clicked to avoid infinite loops
        let isManualToggle = false;
        
        // Function to update chevron icons for two cards
        function updateChevronIcons(isExpanded, button1, button2) {
            const icon1 = button1?.querySelector('i');
            const icon2 = button2?.querySelector('i');
            
            if (icon1) {
                icon1.className = isExpanded ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
            }
            if (icon2) {
                icon2.className = isExpanded ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
            }
        }
        
        // Scenario 1: ViewAll users - Sync workgroup filter and search cards
        if (filterCollapse && searchCollapse && filterToggleButton && searchToggleButton) {
            // When filter card is shown, show search card
            filterCollapse.addEventListener('show.bs.collapse', function() {
                if (!isManualToggle) {
                    isManualToggle = true;
                    const searchBsCollapse = bootstrap.Collapse.getOrCreateInstance(searchCollapse);
                    searchBsCollapse.show();
                }
                updateChevronIcons(true, filterToggleButton, searchToggleButton);
            });
            
            // When filter card is hidden, hide search card
            filterCollapse.addEventListener('hide.bs.collapse', function() {
                if (!isManualToggle) {
                    isManualToggle = true;
                    const searchBsCollapse = bootstrap.Collapse.getOrCreateInstance(searchCollapse);
                    searchBsCollapse.hide();
                }
                updateChevronIcons(false, filterToggleButton, searchToggleButton);
            });
            
            // When search card is shown, show filter card
            searchCollapse.addEventListener('show.bs.collapse', function() {
                if (!isManualToggle) {
                    isManualToggle = true;
                    const filterBsCollapse = bootstrap.Collapse.getOrCreateInstance(filterCollapse);
                    filterBsCollapse.show();
                }
                updateChevronIcons(true, filterToggleButton, searchToggleButton);
            });
            
            // When search card is hidden, hide filter card
            searchCollapse.addEventListener('hide.bs.collapse', function() {
                if (!isManualToggle) {
                    isManualToggle = true;
                    const filterBsCollapse = bootstrap.Collapse.getOrCreateInstance(filterCollapse);
                    filterBsCollapse.hide();
                }
                updateChevronIcons(false, filterToggleButton, searchToggleButton);
            });
            
            // Reset the manual toggle flag after animations complete
            filterCollapse.addEventListener('shown.bs.collapse', function() {
                setTimeout(() => { isManualToggle = false; }, 50);
            });
            
            filterCollapse.addEventListener('hidden.bs.collapse', function() {
                setTimeout(() => { isManualToggle = false; }, 50);
            });
            
            searchCollapse.addEventListener('shown.bs.collapse', function() {
                setTimeout(() => { isManualToggle = false; }, 50);
            });
            
            searchCollapse.addEventListener('hidden.bs.collapse', function() {
                setTimeout(() => { isManualToggle = false; }, 50);
            });
        }
        // Scenario 2: Regular users - Sync next task and search cards
        else if (nextTaskCollapse && searchCollapse && nextTaskToggleButton && searchToggleButton) {
            // When search card is shown, show next task card
            searchCollapse.addEventListener('show.bs.collapse', function() {
                if (!isManualToggle) {
                    isManualToggle = true;
                    const nextTaskBsCollapse = bootstrap.Collapse.getOrCreateInstance(nextTaskCollapse);
                    nextTaskBsCollapse.show();
                }
                updateChevronIcons(true, searchToggleButton, nextTaskToggleButton);
            });
            
            // When search card is hidden, hide next task card
            searchCollapse.addEventListener('hide.bs.collapse', function() {
                if (!isManualToggle) {
                    isManualToggle = true;
                    const nextTaskBsCollapse = bootstrap.Collapse.getOrCreateInstance(nextTaskCollapse);
                    nextTaskBsCollapse.hide();
                }
                updateChevronIcons(false, searchToggleButton, nextTaskToggleButton);
            });
            
            // When next task card is shown, show search card
            nextTaskCollapse.addEventListener('show.bs.collapse', function() {
                if (!isManualToggle) {
                    isManualToggle = true;
                    const searchBsCollapse = bootstrap.Collapse.getOrCreateInstance(searchCollapse);
                    searchBsCollapse.show();
                }
                updateChevronIcons(true, filterToggleButton, searchToggleButton);
            });
            
            // When next task card is hidden, hide search card
            nextTaskCollapse.addEventListener('hide.bs.collapse', function() {
                if (!isManualToggle) {
                    isManualToggle = true;
                    const searchBsCollapse = bootstrap.Collapse.getOrCreateInstance(searchCollapse);
                    searchBsCollapse.hide();
                }
                updateChevronIcons(false, filterToggleButton, searchToggleButton);
            });
            
            // Reset the manual toggle flag after animations complete
            searchCollapse.addEventListener('shown.bs.collapse', function() {
                setTimeout(() => { isManualToggle = false; }, 50);
            });
            
            searchCollapse.addEventListener('hidden.bs.collapse', function() {
                setTimeout(() => { isManualToggle = false; }, 50);
            });
            
            nextTaskCollapse.addEventListener('shown.bs.collapse', function() {
                setTimeout(() => { isManualToggle = false; }, 50);
            });
            
            nextTaskCollapse.addEventListener('hidden.bs.collapse', function() {
                setTimeout(() => { isManualToggle = false; }, 50);
            });
        }
    </script>
    <script src="~/js/index.js"></script>
}


