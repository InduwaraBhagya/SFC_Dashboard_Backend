@using SFCDashboard.Models
@model PaginatedList<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "PE Records";
    bool isSearchPerformed = !string.IsNullOrEmpty(ViewData["PENumberFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["CustomerFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["JobReferenceFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["SONumberFilter"]?.ToString());
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid mt-4">
    <!--workgroup filter section -->
<div class="workgroup-filter-section mb-3">
    @if (ViewData["CanViewAll"] as bool? == true)
    {
        <form id="workgroupFilterForm" method="get" asp-action="Index">
            <div class="row align-items-center">
                <div class="col-auto">
                    <label for="workgroupFilter" class="form-label mb-0">
                        <i class="bi bi-filter"></i> Filter by Workgroup:
                    </label>
                </div>
                <div class="col-md-3">
                    <input type="text" id="workgroup-search" class="form-control" 
                           placeholder="Type to search workgroups" 
                           value="@ViewData["SelectedWorkgroupName"]" />
                    <input type="hidden" id="selected-workgroup-id" name="workgroupId" 
                           value="@ViewData["SelectedWorkgroupId"]" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-funnel-fill me-1"></i> Apply Filter
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Clear Filter
                    </a>
                </div>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Showing records for your workgroup: @ViewData["FilteredWorkgroup"]
        </div>
    }
</div>
    <!-- Your existing search form -->
    <div class="row">
        <!-- Left Column - Existing Content -->
        <div class="col-lg-8">
            <div class="search-section mb-4">
                <form method="get" asp-action="Index">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="searchType" class="form-label">Search By:</label>
                                <select class="form-select" id="searchType" name="searchType" onchange="toggleSearchFields()">
                                    <option value="peNumber" selected="@(ViewData["SearchType"]?.ToString() == "peNumber")">PE Number</option>
                                    <option value="customer" selected="@(ViewData["SearchType"]?.ToString() == "customer")">Customer</option>
                                    <option value="jobReference" selected="@(ViewData["SearchType"]?.ToString() == "jobReference")">Job Reference</option>
                                    <option value="soNumber" selected="@(ViewData["SearchType"]?.ToString() == "soNumber")">SO Number</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <!-- PE Number Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "peNumber" ? "" : "d-none")" id="peNumberField">
                                <label for="peNumber" class="form-label">PE Number:</label>
                                <input type="text" name="peNumber" class="form-control" id="peNumber" placeholder="Enter PE Number" value="@ViewData["PENumberFilter"]" />
                            </div>

                            <!-- Customer Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "customer" ? "" : "d-none")" id="customerField">
                                <label for="customer" class="form-label">Customer:</label>
                                <input type="text" name="customer" class="form-control" id="customer" placeholder="Enter Customer Name" value="@ViewData["CustomerFilter"]" />
                            </div>

                            <!-- Job Reference Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "jobReference" ? "" : "d-none")" id="jobReferenceField">
                                <label for="jobReference" class="form-label">Job Reference:</label>
                                <input type="text" name="jobReference" class="form-control" id="jobReference" placeholder="Enter Job Reference" value="@ViewData["JobReferenceFilter"]" />
                            </div>

                            <!-- SO Number Search -->
                            <div class="search-field @(ViewData["SearchType"]?.ToString() == "soNumber" ? "" : "d-none")" id="soNumberField">
                                <label for="soNumber" class="form-label">SO Number:</label>
                                <input type="text" name="soNumber" class="form-control" id="soNumber" placeholder="Enter SO Number" value="@ViewData["SONumberFilter"]" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary btn-ripple w-100">Search</button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="container-fluid mt-4"></div>

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">PE Number: @item.PeNumber</h5>
                            <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.PeNumber" aria-expanded="false">
                                Show Details
                            </button>
                        </div>
                        <div id="@item.PeNumber">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Status</dt>
                                            <dd class="col-sm-8">@item.PEStatus</dd>
                                            <dt class="col-sm-4">Customer</dt>
                                            <dd class="col-sm-8">@item.Customer</dd>
                                            <dt class="col-sm-4">Service Type</dt>
                                            <dd class="col-sm-8">@item.ServiceType</dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Start Date</dt>
                                            <dd class="col-sm-8">@item.PECreatedDate.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">Required Date</dt>
                                            <dd class="col-sm-8">@item.ServiceRequiredDate?.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">SO Number</dt>
                                            <dd class="col-sm-8">@item.SoNumber</dd>
                                        </dl>
                                    </div>
                                </div>

                                <div class="collapse" id="collapse-@item.PeNumber">
                                    <hr class="details-divider" />

                                    <div class="details-header mb-3">
                                        <h5 class="details-title text-primary">
                                            <i class="bi bi-file-earmark-text me-2"></i>
                                            PE Details: <span class="text-dark">@item.PeNumber</span>
                                        </h5>
                                    </div>

                                    <div class="details-content">
                                        <div class="row g-4">
                                            <!-- Location Details Card -->
                                            <div class="col-md-6">
                                                <div class="details-card shadow-sm border-start border-4 border-info bg-light mb-3">
                                                    <div class="details-card-header bg-info text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-geo-alt me-2"></i>
                                                        <span>Location Details</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Province:</span> <span class="detail-value fw-semibold">@item.Province</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Region:</span> <span class="detail-value fw-semibold">@item.Region</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">RTOM:</span> <span class="detail-value fw-semibold">@item.Rtom</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">RTOM Description:</span> <span class="detail-value">@item.RtomDescription</span></div>
                                                    </div>
                                                </div>
                                                <div class="details-card shadow-sm border-start border-4 border-success bg-light mb-3">
                                                    <div class="details-card-header bg-success text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-clipboard-data me-2"></i>
                                                        <span>Project Details</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Job Reference:</span> <span class="detail-value">@item.JobReference</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Contractor:</span> <span class="detail-value">@item.ContractorName</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Activity:</span> <span class="detail-value">@item.PeActivity</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Nature:</span> <span class="detail-value">@item.PeNature</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Title:</span> <span class="detail-value">@item.PeTitle</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Objective:</span> <span class="detail-value">@item.PeObjective</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Area:</span> <span class="detail-value">@item.PeArea</span></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="details-card shadow-sm border-start border-4 border-warning bg-light mb-3">
                                                    <div class="details-card-header bg-warning text-dark rounded-top px-3 py-2">
                                                        <i class="bi bi-list-task me-2"></i>
                                                        <span>Task Information</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Task Sequence:</span> <span class="detail-value">@item.TaskSeq</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Task Name:</span> <span class="detail-value">@item.TaskName</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Task Workgroup:</span> <span class="detail-value">@item.TaskWg</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Actual Start Date:</span> <span class="detail-value">@item.WoActualStartDate</span></div>
                                                    </div>
                                                </div>
                                                <div class="details-card shadow-sm border-start border-4 border-primary bg-light mb-3">
                                                    <div class="details-card-header bg-primary text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-gear-fill me-2"></i>
                                                        <span>Service Details</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Service Category:</span> <span class="detail-value">@item.ServiceCategory</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Service Speed:</span> <span class="detail-value">@item.ServiceSpeed</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Order Type:</span> <span class="detail-value">@item.OrderType</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">CRM Order:</span> <span class="detail-value">@item.CrmOrder</span></div>
                                                    </div>
                                                </div>
                                                <div class="details-card shadow-sm border-start border-4 border-secondary bg-light mb-3">
                                                    <div class="details-card-header bg-secondary text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-person me-2"></i>
                                                        <span>Customer Information</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Customer Type:</span> <span class="detail-value">@item.CusType</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Account Manager:</span> <span class="detail-value">@item.AccountManager</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Section Handled By:</span> <span class="detail-value">@item.SectionHandledBy</span></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Location Information Section -->
                                        <div class="details-card shadow-sm border-start border-4 border-info bg-light mt-3">
                                            <div class="details-card-header bg-info text-white rounded-top px-3 py-2">
                                                <i class="bi bi-pin-map me-2"></i>
                                                <span>Location Information</span>
                                            </div>
                                            <div class="details-card-body px-3 py-2">
                                                <div class="detail-item"><span class="detail-label text-secondary">Location A:</span> <span class="detail-value">@item.LocationAAddress</span></div>
                                                <div class="detail-item"><span class="detail-label text-secondary">Location B:</span> <span class="detail-value">@item.LocationBAddress</span></div>
                                            </div>
                                        </div>

                                        <!-- Comments Section (Only Show if Comments Exist) -->
                                        @if (!string.IsNullOrEmpty(item.PeWoComments) || !string.IsNullOrEmpty(item.WoComments))
                                        {
                                            <div class="details-card mt-3">
                                                <div class="details-card-header">
                                                    <i class="bi bi-chat-left-text me-2"></i>
                                                    <h6>Comments</h6>
                                                </div>
                                                <div class="details-card-body">
                                                    @if (!string.IsNullOrEmpty(item.PeWoComments))
                                                    {
                                                        <div class="comment-block">
                                                            <div class="comment-header">PE Work Order Comments:</div>
                                                            <div class="comment-content">@item.PeWoComments</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.WoComments))
                                                    {
                                                        <div class="comment-block @(string.IsNullOrEmpty(item.PeWoComments) ? "" : "mt-3")">
                                                            <div class="comment-header">Work Order Comments:</div>
                                                            <div class="comment-content">@item.WoComments</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- PE Tasks Table -->
                                        <div class="card mt-4">
                                            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0">PE Tasks</h6>
                                                @{
                                                    var peTasks = ViewBag.PETasksByPeNumber != null && ViewBag.PETasksByPeNumber.ContainsKey(item.PeNumber)
                                                    ? (IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasksByPeNumber[item.PeNumber]
                                                    : null;
                                                }
                                                @if (peTasks == null || !peTasks.Any())
                                                {
                                                    <span class="badge bg-warning text-dark">No tasks found</span>
                                                }
                                            </div>
                                            <div class="card-body">
                                                @if (peTasks != null && peTasks.Any())
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-hover task-table">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Seq</th>
                                                                    <th>Task</th>
                                                                    <th>Workgroup</th>
                                                                    <th>OLA</th>
                                                                    <th>Status</th>
                                                                    <th>Created Date</th>
                                                                    <th>Target Date</th>
                                                                    <th>Actual Date</th>
                                                                    <th>Priority</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var task in peTasks)
                                                                {
                                                                    <tr class="@(task.IsUrgent ? "table-warning" :
                                                                       task.TaskStatus?.ToLower() == "ongoing" ? "table-primary" :
                                                                       task.TaskStatus?.ToLower() == "completed" ? "table-success" :
                                                                       task.TaskStatus?.ToLower() == "waiting" ? "table-secondary" : "")">
                                                                        <td>@task.TaskSeq</td>
                                                                        <td>@task.Task</td>
                                                                        <td>@(task.TaskWorkGroup == "NULL" ? "" : task.TaskWorkGroup)</td>
                                                                        <td>@task.OLA days</td>
                                                                        <td>
                                                                            @{
                                                                                string taskStatusClass = task.TaskStatus?.ToLower() switch
                                                                                {
                                                                                    "completed" => "badge bg-success",
                                                                                    "inprogress" => "badge bg-warning text-dark",
                                                                                    _ => "badge bg-secondary"
                                                                                };
                                                                            }
                                                                            <span class="@taskStatusClass">@task.TaskStatus</span>
                                                                        </td>
                                                                        <td>@task.TaskCreatedDate.ToString("yyyy-MM-dd")</td>
                                                                        <td>@task.TaskCompleteDate.ToString("yyyy-MM-dd")</td>
                                                                        <td>@(task.ACtualTaskCompleteDate != null ? task.ACtualTaskCompleteDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                                                                        <td>
                                                                            @if (task.IsUrgent)
                                                                            {
                                                                                <span class="badge bg-danger">URGENT</span>
                                                                            }
                                                                            @if (task.UrgentRequested && !task.IsUrgent)
                                                                            {
                                                                                <span class="badge bg-warning">URGENT REQUESTED</span>
                                                                            }
                                                                            @if (!string.IsNullOrEmpty(task.Priority))
                                                                            {
                                                                                <small class="d-block text-muted mt-1">@task.Priority</small>
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-info">
                                                        <i class="bi bi-info-circle me-2"></i>
                                                        No tasks have been assigned to this PE record yet.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <!-- End PE Tasks Table -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (isSearchPerformed)
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No records found.
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <!-- Pagination Controls -->
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=1&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">First</a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex - 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">@Model.PageIndex</span>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex + 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Next</a>
                        </li>
                        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=@Model.TotalPages&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Last</a>
                        </li>
                    </ul>
                </nav>
            }

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("UrgentRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card urgent-card">
                        <div class="card-content">
                            <h4>Urgent Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-danger" style="font-size: 1.2rem;">
                                    @ViewData["UrgentCount"] Tasks
                                </span>
                                @if (ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-danger text-white">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/urgent.png" alt="Urgent" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("InProgressRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card inprogress-card">
                        <div class="card-content">
                            <h4>Regular Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-success" style="font-size: 1.2rem;">
                                    @ViewData["InProgressCount"] Tasks
                                </span>
                                @if (ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-success text-white">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/work-in-progress.png" alt="Regular Records" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("OLAViolateRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card ola-card">
                        <div class="card-content">
                            <h4>OLA Violate Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-dark" style="font-size: 1.2rem;">
                                    @ViewData["OLAViolateCount"] Tasks
                                </span>
                                @if (ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-dark text-white">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/ola _Validate.png" alt="OLA Violate" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("HoldRecords", new { workgroupId = ViewData["SelectedWorkgroupId"] })" class="dashboard-card hold-card">
                        <div class="card-content">
                            <h4>Hold Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-warning" style="font-size: 1.2rem;">
                                    @(ViewData["HoldCount"] != null ? ViewData["HoldCount"] : 0) Tasks
                                </span>
                                @if (ViewData["SelectedWorkgroupName"] != null)
                                {
                                    <div class="mt-1 filter-badge">
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-funnel-fill"></i> @ViewData["SelectedWorkgroupName"]
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/hold.png" alt="Hold Records" class="dashboard-img" />
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Column - Message Inbox -->
        <div class="col-lg-4">
            <div class="message-inbox-container">
                <div class="inbox-header">
                    <h3>
                        <i class="fas fa-inbox me-2"></i>Message Inbox
                        <span class="badge bg-primary rounded-pill ms-2">@ViewData["TotalMessages"]</span>
                        @if (ViewData["UnreadMessages"] != null && (int)ViewData["UnreadMessages"] > 0)
                        {
                            <span class="badge bg-danger rounded-pill ms-2">@ViewData["UnreadMessages"] New</span>
                        }
                    </h3>

                    <!-- Message search bar -->
                    <div class="inbox-search-container mt-3">
                        <div class="input-group">
                            <input type="text" class="form-control inbox-search" placeholder="Search messages..." aria-label="Search messages">
                            <button class="btn btn-outline-primary" type="button" id="inbox-search-button">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="inbox-filters mt-3">
                    <div class="btn-group w-100" role="group" aria-label="Message filters">
                        <button type="button" class="btn btn-outline-primary active" data-filter="all">All</button>
                        <button type="button" class="btn btn-outline-primary" data-filter="urgent">Urgent Requests</button>
                        <button type="button" class="btn btn-outline-primary" data-filter="system">System</button>
                    </div>
                </div>

                <div class="messages-container mt-3">
                    <!-- Urgent Request Confirmation Messages -->
                    @if (ViewData["PendingUrgentRequests"] != null)
                    {
                        foreach (var request in (IEnumerable<PlannedEvent>)ViewData["PendingUrgentRequests"])
                        {
                            <div class="message-item unread important urgent-request" data-message-id="urgent-pe-@request.Id">
                                <div class="message-indicator"></div>
                                <div class="message-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="message-sender">Urgent Request: @request.PeNumber</h6>
                                        <span class="message-time">@(request.PECreatedDate.ToString("MMM dd"))</span>
                                    </div>
                                    <div class="message-subject">
                                        <span class="badge bg-danger me-1">Action Required</span>
                                        Confirm Urgent Status
                                    </div>
                                    <div class="message-preview">
                                        Customer: @request.Customer - @(string.IsNullOrEmpty(request.Priority) ? "No reason provided" : request.Priority)
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    
                    <!-- Task Urgent Requests -->
                    @if (ViewData["PendingTaskRequests"] != null)
                    {
                        foreach (var task in (IEnumerable<PETask>)ViewData["PendingTaskRequests"])
                        {
                            <div class="message-item unread important task-urgent-request" data-message-id="urgent-task-@task.Id">
                                <div class="message-indicator"></div>
                                <div class="message-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="message-sender">Task Urgent Request: @task.PENumber</h6>
                                        <span class="message-time">@(task.TaskCreatedDate.ToString("MMM dd"))</span>
                                    </div>
                                    <div class="message-subject">
                                        <span class="badge bg-warning text-dark me-1">Task</span>
                                        @task.Task Needs Priority
                                    </div>
                                    <div class="message-preview">
                                        @(string.IsNullOrEmpty(task.Priority) ? "No reason provided" : task.Priority)
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <!-- Issue Messages -->
                    @if (ViewData["InboxIssues"] != null)
                    {
                        foreach (var issue in (IEnumerable<SFCDashboard.Models.PEIssueViewModel>)ViewData["InboxIssues"])
                        {
                            <div class="message-item @(issue.IsRead ? "" : "unread") @(issue.IsResolutionRequest ? "resolution-request" : issue.IsReply ? "reply" : "issue-message")"
                                 data-message-id="issue-@issue.CreatedAt.Ticks"
                                 data-issue-id="@issue.Id"
                                 data-pe-id="@issue.PlannedEventId"
                                 data-sender="@issue.SenderName"
                                 data-sender-id="@issue.SenderId"
                                 data-issue-text="@issue.IssueText"
                                 data-attachment="@issue.AttachmentPath"
                                 data-date="@issue.CreatedAt.ToString("MMM dd, yyyy HH:mm")"
                                 data-is-read="@issue.IsRead.ToString().ToLower()"
                                 data-is-reply="@issue.IsReply.ToString().ToLower()"
                                 data-is-resolution-request="@issue.IsResolutionRequest.ToString().ToLower()"
                                 data-original-issue-id="@issue.OriginalIssueId"
                                 @if (issue.IsResolutionRequest)
                                 {
                                     <text>
                                     data-resolution-details="@GetResolutionDetails(issue.OriginalIssueId ?? issue.Id)"
                                     data-resolution-id="@GetResolutionId(issue.OriginalIssueId ?? issue.Id)"
                                     onclick="showResolutionConfirm(this)"
                                     </text>
                                 }
                                 else
                                 {
                                     <text>onclick="showIssueDetails(this)"</text>
                                 }>
                                <div class="message-indicator"></div>
                                <div class="message-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="message-sender">
                                            @if (issue.IsResolutionRequest)
                                            {
                                                <span class="badge bg-success me-1">Resolution</span>
                                            }
                                            From @issue.SenderName
                                        </h6>
                                        <span class="message-time">@issue.CreatedAt.ToString("MMM dd")</span>
                                    </div>
                                    <div class="message-subject">
                                        @if (issue.IsResolutionRequest)
                                        {
                                            <span class="badge bg-success text-white me-1">Issue Fixed</span>
                                        }
                                        else if (issue.IsReply)
                                        {
                                            <span class="badge bg-info text-dark me-1">Reply</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white me-1">Issue</span>
                                        }
                                        @issue.IssueText
                                    </div>
                                    <div class="message-preview">
                                        @if (!string.IsNullOrEmpty(issue.AttachmentPath))
                                        {
                                            <span><i class="bi bi-paperclip me-1"></i>Has attachment</span>
                                        }
                                        else
                                        {
                                            <span>No attachment</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="inbox-footer mt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <button class="btn btn-outline-secondary btn-sm" id="refreshInbox">
                            <i class="fas fa-sync-alt me-1"></i> Refresh
                        </button>
                        <a href="#" class="view-all-link">View All Messages <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>

    <script>

        $(document).ready(function() {
            $("#workgroup-search").autocomplete({
                source: function(request, response) {
                    $.ajax({
                        url: "/SystemUsers/SearchWorkgroups",
                        data: { term: request.term },
                        type: "GET",
                        success: function(data) {
                            // Remove duplicates from the response
                            let uniqueData = [...new Map(data.map(item => 
                                [item.label, item])).values()];
                            response(uniqueData);
                        },
                        error: function(xhr, status, error) {
                            console.error("Error searching workgroups:", status, error);
                        }
                    });
                },
                minLength: 2,
                select: function(event, ui) {
                    $("#workgroup-search").val(ui.item.label);
                    $("#selected-workgroup-id").val(ui.item.id);
                    $("#workgroupFilterForm").submit();
                    return false;
                }
            }).autocomplete("instance")._renderItem = function(ul, item) {
                return $("<li>")
                    .append(`<div>${item.label}</div>`)
                    .appendTo(ul);
            };
        });

        document.addEventListener('DOMContentLoaded', function () {
            // Initialize message inbox
            initializeMessageInbox();
            
            // Refresh inbox button
            document.getElementById('refreshInbox').addEventListener('click', function() {
                window.location.reload();
            });
            
            // Accept button handler
            document.getElementById('acceptUrgentRequestBtn').addEventListener('click', function() {
                const requestType = document.getElementById('urgentRequestType').value;
                const requestId = document.getElementById('urgentRequestId').value;
                
                // Submit the form to the appropriate endpoint
                const form = document.getElementById('urgentRequestForm');
                
                // Create hidden field for urgentReason
                const reasonField = document.createElement('input');
                reasonField.type = 'hidden';
                reasonField.name = 'urgentReason';
                
                // Default to OpeningCeremony 
                // (backend will use the original reason from the request)
                reasonField.value = 'OpeningCeremony';
                
                form.appendChild(reasonField);
                
                if (requestType === 'pe') {
                    form.action = '/PlannedEvents/ProcessUrgentRequest';
                } else {
                    form.action = '/PETasks/ProcessUrgentRequest';
                }
                
                form.submit();
            });
            
            // Reject button handler
            document.getElementById('rejectUrgentRequestBtn').addEventListener('click', function() {
                const requestType = document.getElementById('urgentRequestType').value;
                const requestId = document.getElementById('urgentRequestId').value;
                
                // Submit the form to the appropriate endpoint
                const form = document.getElementById('urgentRequestForm');
                
                // Create hidden field for urgentReason with Reject value
                const reasonField = document.createElement('input');
                reasonField.type = 'hidden';
                reasonField.name = 'urgentReason';
                reasonField.value = 'Reject';
                
                form.appendChild(reasonField);
                
                if (requestType === 'pe') {
                    form.action = '/PlannedEvents/ProcessUrgentRequest';
                } else {
                    form.action = '/PETasks/ProcessUrgentRequest';
                }
                
                form.submit();
            });
        });
        
        function initializeMessageInbox() {
            const messageItems = document.querySelectorAll('.message-item');
            const filterButtons = document.querySelectorAll('.inbox-filters button');
            const inboxSearch = document.querySelector('.inbox-search');
            
            // Ensure all messages are visible on first load
            messageItems.forEach(item => {
                item.style.display = 'flex';
            });

            // Message filtering
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Remove active class from all buttons
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    // Add active class to clicked button
                    this.classList.add('active');

                    const filter = this.getAttribute('data-filter');

                    // Show/hide messages based on filter
                    messageItems.forEach(item => {
                        if (filter === 'all') {
                            item.style.display = 'flex';
                        } else if (filter === 'urgent' && (item.classList.contains('urgent-request') || item.classList.contains('task-urgent-request'))) {
                            item.style.display = 'flex';
                        } else if (filter === 'system' && item.classList.contains('system')) {
                            item.style.display = 'flex';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            });
            
            // Handle search functionality
            if (inboxSearch) {
                inboxSearch.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    
                    messageItems.forEach(item => {
                        const content = item.textContent.toLowerCase();
                        if (content.includes(searchTerm)) {
                            item.style.display = 'flex';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            }

            // Handle message clicks for urgent requests
            document.querySelectorAll('.urgent-request').forEach(item => {
                item.addEventListener('click', function() {
                    // Extract the ID from data-message-id attribute
                    const messageId = this.getAttribute('data-message-id');
                    const peId = messageId.replace('urgent-pe-', '');
                    
                    // Show PE urgent confirmation modal with details
                    showUrgentRequestModal('pe', peId);
                });
            });

            // Handle task urgent request clicks
            document.querySelectorAll('.task-urgent-request').forEach(item => {
                item.addEventListener('click', function() {
                    // Extract the ID from data-message-id attribute
                    const messageId = this.getAttribute('data-message-id');
                    const taskId = messageId.replace('urgent-task-', '');
                    
                    // Show task urgent confirmation modal
                    showUrgentRequestModal('task', taskId);
                });
            });
        }
        
        // Add function to show urgent request details modal
        function showUrgentRequestModal(type, id) {
            // Set the form values
            document.getElementById('urgentRequestType').value = type;
            document.getElementById('urgentRequestId').value = id;
            
            // Fetch record details based on type (PE or Task)
            let url = '';
            if (type === 'pe') {
                url = '/PlannedEvents/GetUrgentRequestDetails/' + id;
            } else {
                url = '/PETasks/GetUrgentRequestDetails/' + id;
            }
            
            // Show loading indicator
            document.getElementById('urgentRequestDetails').innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Loading details...</p></div>';
            
            // Show the modal while fetching details
            const modal = new bootstrap.Modal(document.getElementById('urgentRequestModal'));
            modal.show();
            
            // Fetch details from server
            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    // Update the modal with details
                    let detailsHtml = `
                        <div class="alert alert-info mb-3">
                            <div class="row">
                                <div class="col-sm-4 fw-bold">PE Number:</div>
                                <div class="col-sm-8">${data.peNumber}</div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-4 fw-bold">Customer:</div>
                                <div class="col-sm-8">${data.customer || 'Not specified'}</div>
                            </div>`;
                            
                    if (type === 'task') {
                        detailsHtml += `
                            <div class="row mt-2">
                                <div class="col-sm-4 fw-bold">Task:</div>
                                <div class="col-sm-8">${data.taskName}</div>
                            </div>`;
                    }
                    
                    detailsHtml += `
                        <div class="row mt-2">
                            <div class="col-sm-4 fw-bold">Priority:</div>
                            <div class="col-sm-8">${data.priority || 'Not specified'}</div>
                        </div>
                    </div>`;
                    
                    // Show request reason if available
                    if (data.urgentRequestReason) {
                        detailsHtml += `
                        <div class="alert alert-warning">
                            <h6 class="fw-bold">Request Reason:</h6>
                            <p>${data.urgentRequestReason}</p>
                        </div>`;
                    }
                    
                    document.getElementById('urgentRequestDetails').innerHTML = detailsHtml;
                })
                .catch(error => {
                    console.error('Error fetching urgent request details:', error);
                    document.getElementById('urgentRequestDetails').innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Failed to load request details. Please try again.
                        </div>`;
                });
        }

        function showIssueDetails(element) {
            // Extract issue data from the element's data attributes
            const issueId = $(element).data('issue-id');
            const peId = $(element).data('pe-id');
            const sender = $(element).data('sender');
            const senderId = $(element).data('sender-id');
            const issueText = $(element).data('issue-text');
            const attachment = $(element).data('attachment');
            const date = $(element).data('date');
            const isRead = $(element).data('is-read') === 'true';
            const isResolutionRequest = $(element).data('is-resolution-request') === 'true';
            const originalIssueId = $(element).data('original-issue-id');
            
            // Build the issue details content
            let detailsHtml = `
                <div class="message-detail-header">
                    <h5>${isResolutionRequest ? '<span class="badge bg-success">Resolution Request</span> ' : ''}${issueText}</h5>
                    <div class="message-info">
                        <span class="fw-bold">From:</span> ${sender} · 
                        <span class="fw-bold">Date:</span> ${date}
                    </div>
                </div>
                <div class="message-detail-body my-3">
                    <p>${issueText}</p>
                    ${attachment ? `<div class="attachment-section mt-3">
                        <h6 class="fw-bold">Attachment:</h6>
                        <a href="${attachment}" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-paperclip me-2"></i>View Attachment
                        </a>
                    </div>` : ''}
                </div>`;
            
            // Update the modal content
            $('#issueDetailsContent').html(detailsHtml);
            $('#viewPEDetailsBtn').attr('href', `/PlannedEvents/Details/${peId}`);
            
            // Set up the reply button data
            $('#replyIssueBtn').data('issue-id', issueId);
            $('#replyIssueBtn').data('pe-id', peId);
            $('#replyIssueBtn').data('sender-id', senderId);
            $('#replyIssueBtn').data('original-issue-id', originalIssueId);
            
            // Set up the resolve button data
            $('#resolveIssueBtn').data('issue-id', issueId);
            $('#resolveIssueBtn').data('pe-id', peId);
            
            // Handle resolution request specific UI
            if (isResolutionRequest) {
                $('#replyIssueBtn').addClass('d-none');
                $('#resolveIssueBtn').addClass('d-none');
                
                // Check if there's a resolution record for this issue
                $.get(`/PEIssues/GetResolution/${originalIssueId || issueId}`, function(resolution) {
                    if (resolution && resolution.id) {
                        // Show resolution confirmation section
                        $('#resolutionConfirmationSection').removeClass('d-none');
                        $('#resolutionId').val(resolution.id);
                    }
                });
            } else {
                $('#replyIssueBtn').removeClass('d-none');
                $('#resolveIssueBtn').removeClass('d-none');
                $('#resolutionConfirmationSection').addClass('d-none');
            }
            
            // Fetch PE record details
            fetchPEDetails(peId);
            
            // Mark as read if not already read
            if (!isRead) {
                markIssueAsRead(issueId);
                $(element).removeClass('unread');
                $(element).data('is-read', 'true');
                
                // Update unread count in the header
                updateUnreadCount();
            }
            
            // Show the modal
            const modal = new bootstrap.Modal(document.getElementById('issueDetailsModal'));
            modal.show();
        }

