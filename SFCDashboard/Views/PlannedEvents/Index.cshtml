<!-- Issue Resolution Confirmation Modal (for direct confirmation from inbox) -->
<div class="modal fade" id="resolutionConfirmModal" tabindex="-1" aria-labelledby="resolutionConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="resolutionConfirmModalLabel">Confirm Issue Resolution</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">The issue has been marked as resolved with the following notes:</p>
                <div class="border p-3 bg-light mb-3 resolution-details-container" id="resolutionDetailsText">
                    <!-- Resolution details will be shown here -->
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2">Loading resolution details...</span>
                </div>
                <p class="mb-0">If you confirm this resolution:</p>
                <ul>
                    <li>The issue will be marked as resolved</li>
                    <li>The PE status will be changed back to "ongoing"</li>
                </ul>
                
                <div class="alert alert-warning">
                    <i class="fas fa-question-circle me-2"></i>
                    Has this issue been fixed satisfactorily?
                </div>
            </div>
            <div class="modal-footer">
                <form id="confirmResolutionForm" method="post" asp-controller="Issues" asp-action="ConfirmResolution">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="directResolutionId" name="resolutionId" />
                    <input type="hidden" id="directIsConfirmed" name="isConfirmed" value="false" />
                    
                    <a id="viewPEDetailsLink" href="#" class="btn btn-info me-auto" target="_blank">
                        <i class="fas fa-external-link-alt me-2"></i>View PE Details
                    </a>
                    
                    <button type="button" class="btn btn-outline-danger" onclick="submitResolutionForm(false)">
                        <i class="fas fa-times me-2"></i>No, Still an Issue
                    </button>
                    <button type="button" class="btn btn-success" onclick="submitResolutionForm(true)">
                        <i class="fas fa-check me-2"></i>Yes, Issue Fixed
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Issue Reply Modal -->
<div class="modal fade" id="issueReplyModal" tabindex="-1" aria-labelledby="issueReplyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-dark">
                <h5 class="modal-title" id="issueReplyModalLabel">Reply to Issue</h5>
