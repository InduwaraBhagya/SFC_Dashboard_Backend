        // Update the showResolutionConfirm function
        function showResolutionConfirm(element) {
            const resolutionId = $(element).data('resolution-id');
            const resolutionDetails = $(element).data('resolution-details');
            const peId = $(element).data('pe-id'); // Get the PE ID
            
            $('#directResolutionId').val(resolutionId);
            
            // Check if there are resolution details before displaying them
            if (resolutionDetails && resolutionDetails.trim() !== "") {
                $('#resolutionDetailsText').text(resolutionDetails);
            } else {
                // If no resolution details are available, fetch them from the server
                fetch(`/PEIssues/GetResolution/${$(element).data('original-issue-id') || $(element).data('issue-id')}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data && data.details) {
                            $('#resolutionDetailsText').text(data.details);
                        } else {
                            $('#resolutionDetailsText').html('<em>No details provided</em>');
                        }
                    })
                    .catch(err => {
                        $('#resolutionDetailsText').html('<em>Could not load resolution details</em>');
                        console.error('Error loading resolution details:', err);
                    });
            }
            
            // Add a View Details button to the modal
            $('#viewPEDetailsLink').attr('href', `/PlannedEvents/Details/${peId}`);
            $('#viewPEDetailsLink').removeClass('d-none');
            
            const modal = new bootstrap.Modal(document.getElementById('resolutionConfirmModal'));
            modal.show();
            
            // Mark the message as read
            const issueId = $(element).data('issue-id');
            if (issueId) {
                markIssueAsRead(issueId);
                $(element).removeClass('unread');
                $(element).data('is-read', 'true');
                updateUnreadCount();
            }
        }

        // Helper function to submit resolution confirmation
        function submitResolutionForm(isConfirmed) {
            // Set the hidden field value based on the button clicked
            $('#directIsConfirmed').val(isConfirmed);
            
            // Log the resolution ID to check its value
            console.log('Resolution ID:', $('#directResolutionId').val());
            
