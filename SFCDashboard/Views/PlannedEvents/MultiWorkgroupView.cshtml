<div class="modal fade" id="urgentRequestModal" tabindex="-1" aria-labelledby="urgentRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="urgentRequestModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Urgent Request Confirmation
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="urgentRequestDetails">
                    <!-- Details will be loaded here -->
                </div>

                <form id="urgentRequestForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="urgentRequestId" name="id" />
                    <input type="hidden" id="urgentRequestType" name="requestType" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="acceptUrgentRequestBtn">
                    <i class="fas fa-check-circle me-2"></i>Accept
                </button>
                <button type="button" class="btn btn-danger" id="rejectUrgentRequestBtn">
                    <i class="fas fa-times-circle me-2"></i>Reject
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Issue Details Modal (update the modal to have specialized view for resolution requests) -->
<div class="modal fade" id="issueDetailsModal" tabindex="-1" aria-labelledby="issueDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-dark">
                <h5 class="modal-title" id="issueDetailsModalLabel">
                    <i class="fas fa-exclamation-circle me-2"></i>Issue Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="issueDetailsContent">
                    <!-- Details will be loaded here -->
                </div>

                <div class="pe-details-section mt-4 border-top pt-3">
                    <h6 class="fw-bold">Related PE Record</h6>
                    <div id="relatedPEDetails" class="bg-light p-3 rounded">
                        <!-- PE Details will be loaded here -->
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2">Loading PE details...</p>
                        </div>
                    </div>
                </div>
                
                <!-- Resolution confirmation section (only shown for resolution requests) -->
                <div id="resolutionConfirmationSection" class="d-none mt-4 border-top pt-3">
                    <div class="alert alert-warning">
                        <i class="fas fa-question-circle me-2"></i>
                        <strong>Resolution Request:</strong> Has this issue been resolved?
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="#" id="viewPEDetailsBtn" class="btn btn-primary" target="_blank">
                    <i class="fas fa-external-link-alt me-2"></i>View PE Details
                </a>
                <button type="button" class="btn btn-info" id="replyIssueBtn">
                    <i class="fas fa-reply me-2"></i>Reply
                </button>
                <button type="button" class="btn btn-success" id="resolveIssueBtn">
                    <i class="fas fa-check-circle me-2"></i>Mark as Fixed
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Issue Resolution Confirmation Modal (for direct confirmation from inbox) -->
<div class="modal fade" id="resolutionConfirmModal" tabindex="-1" aria-labelledby="resolutionConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="resolutionConfirmModalLabel">Confirm Issue Resolution</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">The issue has been marked as resolved with the following notes:</p>
                <div class="border p-3 bg-light mb-3 resolution-details-container" id="resolutionDetailsText">
                    <!-- Resolution details will be shown here -->
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2">Loading resolution details...</span>
                </div>
                <p class="mb-0">If you confirm this resolution:</p>
                <ul>
                    <li>The issue will be marked as resolved</li>
                    <li>The PE status will be changed back to "ongoing"</li>
                </ul>
                
                <div class="alert alert-warning">
                    <i class="fas fa-question-circle me-2"></i>
                    Has this issue been fixed satisfactorily?
                </div>
            </div>
            <div class="modal-footer">
                <form id="confirmResolutionForm" method="post" asp-controller="Issues" asp-action="ConfirmResolution">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="directResolutionId" name="resolutionId" />
                    <input type="hidden" id="directIsConfirmed" name="isConfirmed" value="false" />
                    
                    <a id="viewPEDetailsLink" href="#" class="btn btn-info me-auto" target="_blank">
                        <i class="fas fa-external-link-alt me-2"></i>View PE Details
                    </a>
                    
                    <button type="button" class="btn btn-outline-danger" onclick="submitResolutionForm(false)">
                        <i class="fas fa-times me-2"></i>No, Still an Issue
                    </button>
                    <button type="button" class="btn btn-success" onclick="submitResolutionForm(true)">
                        <i class="fas fa-check me-2"></i>Yes, Issue Fixed
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Issue Reply Modal -->
<div class="modal fade" id="issueReplyModal" tabindex="-1" aria-labelledby="issueReplyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-dark">
                <h5 class="modal-title" id="issueReplyModalLabel">Reply to Issue</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
                <form id="issueReplyForm" enctype="multipart/form-data" method="post" asp-controller="Issues" asp-action="Reply">
                    <div class="modal-body">
                        <input type="hidden" id="replyIssueId" name="issueId" />
                        <input type="hidden" id="replyPlannedEventId" name="plannedEventId" />
                        <input type="hidden" id="replyReceiverId" name="receiverId" />
                        
                        <div class="mb-3">
                            <label for="replyText" class="form-label">Reply</label>
                            <textarea class="form-control" id="replyText" name="replyText" rows="4" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="replyAttachment" class="form-label">Attachment (Optional)</label>
                            <input type="file" class="form-control" id="replyAttachment" name="attachment" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Send Reply</button>
                    </div>
                </form>
        </div>
    </div>
</div>

<!-- Issue Resolution Modal -->
<div class="modal fade" id="issueResolveModal" tabindex="-1" aria-labelledby="issueResolveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="issueResolveModalLabel">Mark Issue as Fixed</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="issueResolveForm" method="post" asp-controller="Issues" asp-action="MarkAsFixed">
                <div class="modal-body">
                    <input type="hidden" id="resolveIssueId" name="IssueId" />
                    <input type="hidden" id="resolvePlannedEventId" name="PlannedEventId" />
                    
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Marking this issue as fixed will send a confirmation request to the reporter.
                        If confirmed, the PE record status will be changed back to "ongoing".
                    </div>
                    
                    <div class="mb-3">
                        <label for="resolutionDetails" class="form-label">Resolution Details</label>
                        <textarea class="form-control" id="resolutionDetails" name="ResolutionDetails" rows="4" required
                                  placeholder="Describe how the issue was fixed..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check-circle me-2"></i>Confirm Resolution
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    private string GetResolutionDetails(int issueId)
    {
        try
        {
            if (ViewBag.ResolutionsByIssueId == null)
                return "";
                
            var dictionary = ViewBag.ResolutionsByIssueId as Dictionary<int, PEIssueResolution>;
            if (dictionary == null)
                return "";
                
            if (dictionary.ContainsKey(issueId))
                return dictionary[issueId]?.ResolutionDetails ?? "";
                
            return "";
        }
        catch (Exception)
        {
            // Log error if needed
            return "";
        }
    }

    private int GetResolutionId(int issueId)
    {
        try
        {
            if (ViewBag.ResolutionsByIssueId == null)
                return 0;
                
            var dictionary = ViewBag.ResolutionsByIssueId as Dictionary<int, PEIssueResolution>;
            if (dictionary == null)
                return 0;
                
            if (dictionary.ContainsKey(issueId))
                return dictionary[issueId]?.Id ?? 0;
                
            return 0;
        }
        catch (Exception)
        {
            // Log error if needed
            return 0;
        }
    }
}