                                        }

                                        <div class="card mt-4">
                                            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0">PE Tasks</h6>
                                                @{
                                                    var peTasks = ViewBag.PETasksByPeNumber != null && ViewBag.PETasksByPeNumber.ContainsKey(item.PeNumber)
                                                    ? (IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasksByPeNumber[item.PeNumber]
                                                    : null;
                                                }
                                                @if (peTasks == null || !peTasks.Any())
                                                {
                                                    <span class="badge bg-warning text-dark">No tasks found</span>
                                                }
                                            </div>
                                            <div class="card-body">
                                                @if (peTasks != null && peTasks.Any())
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-hover task-table">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Seq</th>
                                                                    <th>Task</th>
                                                                    <th>Workgroup</th>
                                                                    <th>OLA</th>
                                                                    <th>Status</th>
                                                                    <th>Created Date</th>
                                                                    <th>Target Date</th>
                                                                    <th>Actual Date</th>
                                                                    <th>Priority</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var task in peTasks)
                                                                {
                                                                    <tr class="@(task.IsUrgent ? "table-warning" :
                                                                       task.TaskStatus?.ToLower() == "ongoing" ? "table-primary" :
                                                                       task.TaskStatus?.ToLower() == "completed" ? "table-success" :
                                                                       task.TaskStatus?.ToLower() == "waiting" ? "table-secondary" : "")">
                                                                        <td>@task.TaskSeq</td>
                                                                        <td>@task.Task</td>
                                                                        <td>@(task.TaskWorkGroup == "NULL" ? "" : task.TaskWorkGroup)</td>
                                                                        <td>@task.OLA days</td>
                                                                        <td>
                                                                            @{
                                                                                string taskStatusClass = task.TaskStatus?.ToLower() switch
                                                                                {
                                                                                    "completed" => "badge bg-success",
                                                                                    "inprogress" => "badge bg-warning text-dark",
                                                                                    _ => "badge bg-secondary"
                                                                                };
                                                                            }
                                                                            <span class="@taskStatusClass">@task.TaskStatus</span>
                                                                        </td>
                                                                        <td>@task.TaskCreatedDate.ToString("yyyy-MM-dd")</td>
                                                                        <td>@task.TaskCompleteDate.ToString("yyyy-MM-dd")</td>
                                                                        <td>@(task.ACtualTaskCompleteDate != null ? task.ACtualTaskCompleteDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                                                                        <td>
                                                                            @if (task.IsUrgent)
                                                                            {
                                                                                <span class="badge bg-danger">URGENT</span>
                                                                            }
                                                                            @if (task.UrgentRequested && !task.IsUrgent)
                                                                            {
                                                                                <span class="badge bg-warning">URGENT REQUESTED</span>
                                                                            }
                                                                            @if (!string.IsNullOrEmpty(task.Priority))
                                                                            {
                                                                                <small class="d-block text-muted mt-1">@task.Priority</small>
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-info">
                                                        <i class="bi bi-info-circle me-2"></i>
                                                        No tasks have been assigned to this PE record yet.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (isSearchPerformed)
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No records found.
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        @{
                            var routeValues = new Dictionary<string, object>
                            {
                                { "pageIndex", 1 }
                            };
                            routeValues["searchType"] = ViewData["SearchType"] ?? string.Empty;
                            routeValues["peNumber"] = ViewData["PENumberFilter"] ?? string.Empty;
                            routeValues["customer"] = ViewData["CustomerFilter"] ?? string.Empty;
                            routeValues["jobReference"] = ViewData["JobReferenceFilter"] ?? string.Empty;
                            routeValues["soNumber"] = ViewData["SONumberFilter"] ?? string.Empty;
                            if (ViewData["SelectedWorkgroupIds"] is List<int> wgIds && wgIds.Any())
                            {
                                routeValues["workgroupIds"] = wgIds;
                            }
                        }
                        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("MultiWorkgroupView", routeValues)">First</a>
                        </li>
                        @{
                            routeValues["pageIndex"] = Model.PageIndex - 1;
                        }
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="@Url.Action("MultiWorkgroupView", routeValues)">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">@Model.PageIndex</span>
                        </li>
                        @{
                            routeValues["pageIndex"] = Model.PageIndex + 1;
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="@Url.Action("MultiWorkgroupView", routeValues)">Next</a>
                        </li>
                        @{
                            routeValues["pageIndex"] = Model.TotalPages;
                        }
                        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("MultiWorkgroupView", routeValues)">Last</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/jquery-ui/themes/base/jquery-ui.css" asp-append-version="true">
    <script src="~/lib/jquery-ui/jquery-ui.min.js" asp-append-version="true"></script>
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/lib/select2/js/select2.min.js" asp-append-version="true"></script>
    <link href="~/css/theme-toggle.css" rel="stylesheet" asp-append-version="true" />
    <script>
        $(document).ready(function() {
            // Initialize Select2 for workgroup filter with multiple selection
            $('#workgroupsFilter').select2({
                placeholder: "Select workgroups",
                allowClear: true,
                width: '100%'
            });
            
            // In-page search removed; no additional initialization needed
            
            // Add message filtering logic
            $('.inbox-filters button').click(function() {
                $('.inbox-filters button').removeClass('active');
                $(this).addClass('active');
                
                var filter = $(this).data('filter');
                
                if (filter === 'unread') {
                    $('.message-item.unread').show();
                    $('.message-item:not(.unread)').hide();
                } else if (filter === 'read') {
                    $('.message-item:not(.unread)').show();
                    $('.message-item.unread').hide();
                } else {
                    $('.message-item').show();
                }
            });
            
            // Inbox search filtering (live) combined with current filter
            function applyInboxFilter() {
                var filter = $('.inbox-filters button.active').data('filter');
                var searchText = ($('.inbox-search').val() || '').toString().toLowerCase();

                $('.message-item').each(function() {
                    var $item = $(this);
                    var matchesFilter =
                        filter === 'all' ? true :
                        (filter === 'unread' ? $item.hasClass('unread') : !$item.hasClass('unread'));
                    var matchesSearch = searchText === '' ? true : ($item.text().toLowerCase().indexOf(searchText) > -1);
                    $item.toggle(matchesFilter && matchesSearch);
                });
            }

            // Reapply filter when filter buttons change
            $('.inbox-filters button').on('click', function() { setTimeout(applyInboxFilter, 0); });

            // Live search on input and Enter key
            $('.inbox-search').on('input', applyInboxFilter).on('keypress', function(e) {
                if (e.which === 13) { e.preventDefault(); applyInboxFilter(); }
            });
        });
    // No collapsible filter/search toggles on this view
    </script>
        <script src="~/js/index.js"></script>
}

<script>
    // Reminder dropdown helpers (ported from Index for header bell)
    // Use a namespaced fallback to avoid re-declaration conflicts
    window.__reminderFilter = window.__reminderFilter || 'unread';
    document.getElementById('reminderDropdown')?.addEventListener('show.bs.dropdown', function () {
        loadReminders();
        setTimeout(() => {
            const dropdown = document.querySelector('#reminderDropdown + .dropdown-menu');
            if (dropdown && dropdown.parentElement !== document.body) {
                document.body.appendChild(dropdown);
            }
        }, 1);
    });
    document.getElementById('reminderDropdown')?.addEventListener('hide.bs.dropdown', function () {
        const dropdown = document.querySelector('.dropdown-menu[aria-labelledby="reminderDropdown"]');
        const originalParent = document.querySelector('.dropdown:has(#reminderDropdown)');
        if (dropdown && originalParent && dropdown.parentElement === document.body) {
            originalParent.appendChild(dropdown);
        }
    });

    function loadReminders() {
        fetch(`${APP_BASE}PlannedEvents/GetReminders`)
            .then(response => response.json())
            .then(data => {
                const reminderData = data.filter(item => item.isReminder !== false);
                const reminderList = document.getElementById('reminderNotificationList');
                const reminderBadge = document.getElementById('reminderCount');
                if (!reminderList) return;
                reminderList.innerHTML = '';
                const activeFilter = (typeof currentReminderFilter !== 'undefined') ? currentReminderFilter : window.__reminderFilter;
                const filteredData = activeFilter === 'unread' ? reminderData.filter(r => !r.isRead) : reminderData;
                const unreadCount = reminderData.filter(r => !r.isRead).length;
                if (unreadCount > 0) { reminderBadge.textContent = unreadCount; reminderBadge.style.display = 'block'; } else { reminderBadge.style.display = 'none'; }
                if (filteredData.length === 0) {
                    reminderList.innerHTML = `<div class="p-3 text-center text-muted"><i class="bi bi-bell-slash me-2"></i>No ${activeFilter} reminders</div>`;
                    return;
                }
                filteredData.forEach(reminder => {
                    const el = document.createElement('div');
                    el.className = `dropdown-item reminder-item ${!reminder.isRead ? 'unread' : 'read'}`;
                    el.style.cursor = 'pointer';
                    el.style.borderBottom = '1px solid #eee';
                    el.setAttribute('data-reminder-id', reminder.id);
                    el.setAttribute('data-pe-id', reminder.plannedEventId);
                    el.innerHTML = `
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="badge bg-warning text-dark me-2">Hold Reminder</span>
                                    ${!reminder.isRead ? '<i class="bi bi-circle-fill text-primary me-1" style="font-size: 0.5rem;"></i>' : ''}
                                </div>
                                <p class="mb-1 small">${reminder.message}</p>
                            </div>
                        </div>`;
                    el.addEventListener('click', function () { showReminderDetails(reminder); });
                    reminderList.appendChild(el);
                });
            })
            .catch(() => {});
    }
</script>

<script>
    // Lightweight Notice Board loader (read-only)
    (function() {
        function refreshNoticeBoard() {
            $.ajax({
                url: '@Url.Action("GetNotices", "PlannedEvents")',
                method: 'GET'
            }).done(function(response) {
                const data = (response && (response.data || response.Data)) ? (response.data || response.Data) : response;
                updateNoticeBoardContent(data);
            }).fail(function() {
                // Keep silent; panel will show empty state
            });
        }

        function updateNoticeBoardContent(notices) {
            const $container = $('#noticeContent');
            if (!$container.length) return;
            $container.empty();

            if (!Array.isArray(notices) || notices.length === 0) {
                $container.html(
                    '<div class="text-center py-4">' +
                        '<i class="bi bi-journal-x text-muted" style="font-size: 2rem;"></i>' +
                        '<p class="mt-3 mb-0 text-muted" style="font-size: 0.8rem;">No notices available at the moment</p>' +
                    '</div>'
                );
                return;
            }

            notices.slice(0, 5).forEach(function(n) {
                // Support both "description"-based and Title/Content based shapes
                let title = n.title || n.Title || '';
                let content = n.content || n.Content || '';
                if (!title && typeof n.description === 'string') {
                    const lines = n.description.split('\n');
                    title = lines[0] || 'Notice';
                    content = lines.slice(2).join('\n') || n.description;
                }
                const createdBy = n.createdUserName || n.CreatedBy || n.createdBy || '';
                const dateRaw = n.createdDate || n.Date || n.date || '';
                const isPinned = !!(n.isPinned || n.IsPinned);

                const pinIcon = isPinned ? '<i class="bi bi-pin-fill text-warning me-1" title="Pinned"></i>' : '';
                const safe = function(s) { return $('<div>').text(s || '').html(); };
                const dateText = dateRaw ? new Date(dateRaw).toLocaleDateString() : '';

                const html = `
                    <div class="notice-item mb-2 p-2 border rounded" style="border-left: 4px solid #ffc107 !important;">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="notice-title mb-1" style="font-size: 0.8rem; font-weight: bold;">${pinIcon}${safe(title)}</h6>
                            <small class="text-muted" style="font-size: 0.65rem;">${safe(dateText)}</small>
                        </div>
                        <p class="notice-content mb-1" style="font-size: 0.75rem; line-height: 1.2;">${safe(content)}</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted" style="font-size: 0.65rem;">${createdBy ? 'By: ' + safe(createdBy) : ''}</small>
                        </div>
                    </div>`;
                $container.append(html);
            });
        }

        $(function(){ refreshNoticeBoard(); });
    })();
</script>

