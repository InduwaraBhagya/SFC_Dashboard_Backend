@using System.Linq
@using SFCDashboard.Models
@model PaginatedList<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "PE Records";
    bool isSearchPerformed = !string.IsNullOrEmpty(ViewData["PENumberFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["CustomerFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["JobReferenceFilter"]?.ToString()) ||
                             !string.IsNullOrEmpty(ViewData["SONumberFilter"]?.ToString());
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{var selectedName = ViewData[""] as string;}

<div class="container-fluid mt-4">
    <!-- Update header section -->
    <div class="dashboard-header mb-4">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="display-5 mb-0">Sales PE Records</h1>
                <p class="text-muted mt-2">Filtered for section: @ViewData["SalesWorkgroup"]</p>
            </div>
            <div class="col-auto">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-primary" onclick="refreshDashboard()">
                        <i class="bi bi-arrow-clockwise me-2"></i>Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Update search section -->
    <div class="search-section mb-4">
        <form method="get" asp-action="SalesView">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="searchType" class="form-label">Search By:</label>
                        <select class="form-select shadow-sm" id="searchType" name="searchType" onchange="toggleSearchFields()">
                            <option value="peNumber" selected="@(ViewData["SearchType"]?.ToString() == "peNumber")">PE Number</option>
                            <option value="customer" selected="@(ViewData["SearchType"]?.ToString() == "customer")">Customer</option>
                            <option value="jobReference" selected="@(ViewData["SearchType"]?.ToString() == "jobReference")">Job Reference</option>
                            <option value="soNumber" selected="@(ViewData["SearchType"]?.ToString() == "soNumber")">SO Number</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="form-group">
                        <label for="indexSearchInput" class="form-label" id="indexSearchLabel">Search Term:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control shadow-sm" id="indexSearchInput" 
                                   name="@ViewData["SearchType"]" 
                                   placeholder="Enter search term..."
                                   value="@(ViewData[ViewData["SearchType"]?.ToString() + "Filter"])" required />
                            <button class="btn btn-primary" type="submit">Search</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <a href="@Url.Action("SalesView")" class="btn btn-secondary w-100">
                        <i class="bi bi-x-circle me-2"></i>Clear
                    </a>
                </div>
            </div>
        </form>
    </div>

            <div class="container-fluid mt-4">

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">PE Number: @item.PeNumber</h5>
                            <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.PeNumber" aria-expanded="false">
                                Show Details
                            </button>
                        </div>
                        <div id="@item.PeNumber">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Status</dt>
                                            <dd class="col-sm-8">@item.PEStatus</dd>
                                            <dt class="col-sm-4">Customer</dt>
                                            <dd class="col-sm-8">@item.Customer</dd>
                                            <dt class="col-sm-4">Service Type</dt>
                                            <dd class="col-sm-8">@item.ServiceType</dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="row">
                                            <dt class="col-sm-4">Start Date</dt>
                                            <dd class="col-sm-8">@item.PECreatedDate.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">Required Date</dt>
                                            <dd class="col-sm-8">@item.ServiceRequiredDate?.ToString("dd/MM/yyyy")</dd>
                                            <dt class="col-sm-4">SO Number</dt>
                                            <dd class="col-sm-8">@item.SoNumber</dd>
                                        </dl>
                                    </div>
                                </div>

                                <div class="collapse" id="collapse-@item.PeNumber">
                                    <hr class="details-divider" />

                                    <div class="details-header mb-3">
                                        <h5 class="details-title text-primary">
                                            <i class="bi bi-file-earmark-text me-2"></i>
                                            PE Details: <span class="text-dark">@item.PeNumber</span>
                                        </h5>
                                    </div>

                                    <div class="details-content">
                                        <div class="row g-4">
                                            <!-- Location Details Card -->
                                            <div class="col-md-6">
                                                <div class="details-card shadow-sm border-start border-4 border-info bg-light mb-3">
                                                    <div class="details-card-header bg-info text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-geo-alt me-2"></i>
                                                        <span>Location Details</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Province:</span> <span class="detail-value fw-semibold">@item.Province</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Region:</span> <span class="detail-value fw-semibold">@item.Region</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">RTOM:</span> <span class="detail-value fw-semibold">@item.Rtom</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">RTOM Description:</span> <span class="detail-value">@item.RtomDescription</span></div>
                                                    </div>
                                                </div>
                                                <div class="details-card shadow-sm border-start border-4 border-success bg-light mb-3">
                                                    <div class="details-card-header bg-success text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-clipboard-data me-2"></i>
                                                        <span>Project Details</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Job Reference:</span> <span class="detail-value">@item.JobReference</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Contractor:</span> <span class="detail-value">@item.ContractorName</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Activity:</span> <span class="detail-value">@item.PeActivity</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Nature:</span> <span class="detail-value">@item.PeNature</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Title:</span> <span class="detail-value">@item.PeTitle</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Objective:</span> <span class="detail-value">@item.PeObjective</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">PE Area:</span> <span class="detail-value">@item.PeArea</span></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="details-card shadow-sm border-start border-4 border-warning bg-light mb-3">
                                                    <div class="details-card-header bg-warning text-dark rounded-top px-3 py-2">
                                                        <i class="bi bi-list-task me-2"></i>
                                                        <span>Task Information</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Task Sequence:</span> <span class="detail-value">@item.TaskSeq</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Task Name:</span> <span class="detail-value">@item.TaskName</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Task Workgroup:</span> <span class="detail-value">@item.TaskWg</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Actual Start Date:</span> <span class="detail-value">@item.WoActualStartDate</span></div>
                                                    </div>
                                                </div>
                                                <div class="details-card shadow-sm border-start border-4 border-primary bg-light mb-3">
                                                    <div class="details-card-header bg-primary text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-gear-fill me-2"></i>
                                                        <span>Service Details</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Service Category:</span> <span class="detail-value">@item.ServiceCategory</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Service Speed:</span> <span class="detail-value">@item.ServiceSpeed</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Order Type:</span> <span class="detail-value">@item.OrderType</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">CRM Order:</span> <span class="detail-value">@item.CrmOrder</span></div>
                                                    </div>
                                                </div>
                                                <div class="details-card shadow-sm border-start border-4 border-secondary bg-light mb-3">
                                                    <div class="details-card-header bg-secondary text-white rounded-top px-3 py-2">
                                                        <i class="bi bi-person me-2"></i>
                                                        <span>Customer Information</span>
                                                    </div>
                                                    <div class="details-card-body px-3 py-2">
                                                        <div class="detail-item"><span class="detail-label text-secondary">Customer Type:</span> <span class="detail-value">@item.CusType</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Account Manager:</span> <span class="detail-value">@item.AccountManager</span></div>
                                                        <div class="detail-item"><span class="detail-label text-secondary">Section Handled By:</span> <span class="detail-value">@item.SectionHandledBy</span></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Location Information Section -->
                                        <div class="details-card shadow-sm border-start border-4 border-info bg-light mt-3">
                                            <div class="details-card-header bg-info text-white rounded-top px-3 py-2">
                                                <i class="bi bi-pin-map me-2"></i>
                                                <span>Location Information</span>
                                            </div>
                                            <div class="details-card-body px-3 py-2">
                                                <div class="detail-item"><span class="detail-label text-secondary">Location A:</span> <span class="detail-value">@item.LocationAAddress</span></div>
                                                <div class="detail-item"><span class="detail-label text-secondary">Location B:</span> <span class="detail-value">@item.LocationBAddress</span></div>
                                            </div>
                                        </div>

                                        <!-- Comments Section (Only Show if Comments Exist) -->
                                        @if (!string.IsNullOrEmpty(item.PeWoComments) || !string.IsNullOrEmpty(item.WoComments))
                                        {
                                            <div class="details-card mt-3">
                                                <div class="details-card-header">
                                                    <i class="bi bi-chat-left-text me-2"></i>
                                                    <h6>Comments</h6>
                                                </div>
                                                <div class="details-card-body">
                                                    @if (!string.IsNullOrEmpty(item.PeWoComments))
                                                    {
                                                        <div class="comment-block">
                                                            <div class="comment-header">PE Work Order Comments:</div>
                                                            <div class="comment-content">@item.PeWoComments</div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.WoComments))
                                                    {
                                                        <div class="comment-block @(string.IsNullOrEmpty(item.PeWoComments) ? "" : "mt-3")">
                                                            <div class="comment-header">Work Order Comments:</div>
                                                            <div class="comment-content">@item.WoComments</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- PE Tasks Table -->
                                        <div class="card mt-4">
                                            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                                                <h6 class="mb-0">PE Tasks</h6>
                                                @{
                                                    var peTasks = ViewBag.PETasksByPeNumber != null && ViewBag.PETasksByPeNumber.ContainsKey(item.PeNumber)
                                                    ? (IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasksByPeNumber[item.PeNumber]
                                                    : null;
                                                }
                                                @if (peTasks == null || !peTasks.Any())
                                                {
                                                    <span class="badge bg-warning text-dark">No tasks found</span>
                                                }
                                            </div>
                                            <div class="card-body">
                                                @if (peTasks != null && peTasks.Any())
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-hover task-table">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Seq</th>
                                                                    <th>Task</th>
                                                                    <th>Workgroup</th>
                                                                    <th>OLA</th>
                                                                    <th>Status</th>
                                                                    <th>Created Date</th>
                                                                    <th>Target Date</th>
                                                                    <th>Actual Date</th>
                                                                    <th>Priority</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var task in peTasks)
                                                                {
                                                                    <tr class="@(task.IsUrgent ? "table-warning" :
                                                                       task.TaskStatus?.ToLower() == "ongoing" ? "table-primary" :
                                                                       task.TaskStatus?.ToLower() == "completed" ? "table-success" :
                                                                       task.TaskStatus?.ToLower() == "waiting" ? "table-secondary" : "")">
                                                                        <td>@task.TaskSeq</td>
                                                                        <td>@task.Task</td>
                                                                        <td>@(task.TaskWorkGroup == "NULL" ? "" : task.TaskWorkGroup)</td>
                                                                        <td>@task.OLA days</td>
                                                                        <td>
                                                                            @{
                                                                                string taskStatusClass = task.TaskStatus?.ToLower() switch
                                                                                {
                                                                                    "completed" => "badge bg-success",
                                                                                    "inprogress" => "badge bg-warning text-dark",
                                                                                    _ => "badge bg-secondary"
                                                                                };
                                                                            }
                                                                            <span class="@taskStatusClass">@task.TaskStatus</span>
                                                                        </td>
                                                                        <td>@task.TaskCreatedDate.ToString("yyyy-MM-dd")</td>
                                                                        <td>@task.TaskCompleteDate.ToString("yyyy-MM-dd")</td>
                                                                        <td>@(task.ACtualTaskCompleteDate != null ? task.ACtualTaskCompleteDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                                                                        <td>
                                                                            @if (task.IsUrgent)
                                                                            {
                                                                                <span class="badge bg-danger">URGENT</span>
                                                                            }
                                                                            @if (task.UrgentRequested && !task.IsUrgent)
                                                                            {
                                                                                <span class="badge bg-warning">URGENT REQUESTED</span>
                                                                            }
                                                                            @if (!string.IsNullOrEmpty(task.Priority))
                                                                            {
                                                                                <small class="d-block text-muted mt-1">@task.Priority</small>
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-info">
                                                        <i class="bi bi-info-circle me-2"></i>
                                                        No tasks have been assigned to this PE record yet.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <!-- End PE Tasks Table -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (isSearchPerformed)
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No records found.
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <!-- Pagination Controls -->
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=1&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">First</a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex - 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">@Model.PageIndex</span>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="?pageIndex=@(Model.PageIndex + 1)&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Next</a>
                        </li>
                        <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?pageIndex=@Model.TotalPages&searchType=@ViewData["SearchType"]&peNumber=@ViewData["PENumberFilter"]&customer=@ViewData["CustomerFilter"]&jobReference=@ViewData["JobReferenceFilter"]&soNumber=@ViewData["SONumberFilter"]">Last</a>
                        </li>
                    </ul>
                </nav>
            }

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("SalesUrgentRecords")" class="dashboard-card urgent-card">
                        <div class="card-content">
                            <h4>Sales Urgent Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-danger" style="font-size: 1.2rem;">
                                    @ViewData["UrgentCount"] Tasks
                                </span>
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/urgent.png" alt="Urgent" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("SalesInProgressRecords")" class="dashboard-card inprogress-card">
                        <div class="card-content">
                            <h4>Sales Regular Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-success" style="font-size: 1.2rem;">
                                    @ViewData["InProgressCount"] Tasks
                                </span>
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/work-in-progress.png" alt="Regular Records" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("SalesOLAViolateRecords")" class="dashboard-card ola-card">
                        <div class="card-content">
                            <h4>Sales OLA Violations</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-dark" style="font-size: 1.2rem;">
                                    @ViewData["OLAViolateCount"] Tasks
                                </span>
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/ola _Validate.png" alt="OLA Violate" class="dashboard-img" />
                        </div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="@Url.Action("SalesHoldRecords")" class="dashboard-card hold-card">
                        <div class="card-content">
                            <h4>Sales Hold Records</h4>
                            <div class="mt-2">
                                <span class="badge bg-light text-warning" style="font-size: 1.2rem;">
                                    @ViewData["HoldCount"] Tasks
                                </span>
                            </div>
                        </div>
                        <div class="img-container">
                            <img src="~/images/hold.png" alt="Hold Records" class="dashboard-img" />
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Column - Message Inbox -->
        <div class="col-lg-4">
            <div class="message-inbox-container">
                <div class="inbox-header">
                    <h3>
                        <i class="fas fa-inbox me-2"></i>Message Inbox
                        @{
                            var unreadCount = 0;
                            
                            // Count unread issues
                            if (ViewData["InboxIssues"] != null)
                            {
                                unreadCount += ((IEnumerable<PEIssueViewModel>)ViewData["InboxIssues"]).Count(i => !i.IsRead);
                            }
                            
                            // Count pending urgent PE requests
                            if (ViewData["PendingUrgentRequests"] != null)
                            {
                                unreadCount += ((IEnumerable<PlannedEvent>)ViewData["PendingUrgentRequests"]).Count();
                            }
                            
                            // Count pending urgent task requests
                            if (ViewData["PendingTaskRequests"] != null)
                            {
                                unreadCount += ((IEnumerable<PETask>)ViewData["PendingTaskRequests"]).Count();
                            }
                            
                            if (unreadCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill ms-2">@unreadCount Unread</span>
                            }
                        }
                    </h3>

                                <!-- Message search bar -->
                                <div class="inbox-search-container mt-3">
                                    <div class="input-group">
                                        <input type="text" class="form-control inbox-search" placeholder="Search messages..." aria-label="Search messages">
                                        <button class="btn btn-outline-primary" type="button" id="inbox-search-button">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>

                <!-- Add this section after the inbox-search-container -->
                <div class="inbox-filters mt-3">
                    <div class="btn-group w-100" role="group" aria-label="Message filters">
                        <button type="button" class="btn btn-outline-primary active" data-filter="unread">Unread</button>
                        <button type="button" class="btn btn-outline-primary" data-filter="read">Read</button>
                        <button type="button" class="btn btn-outline-primary" data-filter="all">All</button>
                    </div>
                </div>

                <div class="messages-container mt-3">
                    @if (ViewData["CanAcceptUrgentRequests"] as bool? == true)
                    {<!-- Urgent Request Confirmation Messages -->
                    @if (ViewData["PendingUrgentRequests"] != null)
                    {
                        foreach (var request in (IEnumerable<PlannedEvent>)ViewData["PendingUrgentRequests"])
                        {
                            <div class="message-item unread important urgent-request" data-message-id="urgent-pe-@request.Id">
                                <div class="message-indicator"></div>
                                <div class="message-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="message-sender">Urgent Request: @request.PeNumber</h6>
                                        <span class="message-time">@(request.PECreatedDate.ToString("MMM dd"))</span>
                                    </div>
                                    <div class="message-subject">
                                        <span class="badge bg-danger me-1">Action Required</span>
                                        Confirm Urgent Status
                                    </div>
                                    <div class="message-preview">
                                        Customer: @request.Customer - @(string.IsNullOrEmpty(request.Priority) ? "No reason provided" : request.Priority)
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    
                    <!-- Task Urgent Requests -->
                    @if (ViewData["PendingTaskRequests"] != null)
                    {
                        foreach (var task in (IEnumerable<PETask>)ViewData["PendingTaskRequests"])
                        {
                            <div class="message-item unread important task-urgent-request" data-message-id="urgent-task-@task.Id">
                                <div class="message-indicator"></div>
                                <div class="message-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="message-sender">Task Urgent Request: @task.PENumber</h6>
                                        <span class="message-time">@(task.TaskCreatedDate.ToString("MMM dd"))</span>
                                    </div>
                                    <div class="message-subject">
                                        <span class="badge bg-warning text-dark me-1">Task</span>
                                        @task.Task Needs Priority
                                    </div>
                                    <div class="message-preview">
                                        @(string.IsNullOrEmpty(task.Priority) ? "No reason provided" : task.Priority)
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
                    
                    <!-- Issue Messages -->
     @if (ViewData["InboxIssues"] != null)
        {
              foreach (var issue in (IEnumerable<PEIssueViewModel>)ViewData["InboxIssues"])
        {
           
                        
                            <div class="message-item @(issue.IsRead ? "" : "unread") @(issue.IsResolutionRequest ? "resolution-request" : issue.IsReply ? "reply" : "issue-message")"
                                 data-message-id="issue-@issue.CreatedAt.Ticks"
                                 data-issue-id="@issue.Id"
                                 data-pe-id="@issue.PlannedEventId"
                                 data-sender="@issue.SenderName"
                                 data-sender-id="@issue.SenderId"
                                 data-issue-text="@issue.IssueText"
                                 data-attachment="@issue.AttachmentPath"
                                 data-date="@issue.CreatedAt.ToString("MMM dd, yyyy HH:mm")"
                                 data-is-read="@issue.IsRead.ToString().ToLower()"
                                 data-is-reply="@issue.IsReply.ToString().ToLower()"
                                 data-is-resolution-request="@issue.IsResolutionRequest.ToString().ToLower()"
                                 data-original-issue-id="@issue.OriginalIssueId"
                                 @if (issue.IsResolutionRequest)
                                 {
                                     <text>
                                     data-resolution-details="@GetResolutionDetails(issue.OriginalIssueId ?? issue.Id)"
                                     data-resolution-id="@GetResolutionId(issue.OriginalIssueId ?? issue.Id)"
                                     onclick="showResolutionConfirm(this)"
                                     </text>
                                 }
                                 else
                                 {
                                     <text>onclick="showIssueDetails(this)"</text>
                                 }>
                                <div class="message-indicator"></div>
                                <div class="message-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="message-sender">
                                            @if (issue.IsResolutionRequest)
                                            {
                                                <span class="badge bg-success me-1">Resolution</span>
                                            }
                                            From @issue.SenderName
                                        </h6>
                                        <span class="message-time">@issue.CreatedAt.ToString("MMM dd")</span>
                                    </div>
                                    <div class="message-subject">
                                        @if (issue.IsResolutionRequest)
                                        {
                                            <span class="badge bg-success text-white me-1">Issue Fixed</span>
                                        }
                                        else if (issue.IsReply)
                                        {
                                            <span class="badge bg-info text-dark me-1">Reply</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white me-1">Issue</span>
                                        }
                                        @issue.IssueText
                                    </div>
                                    <div class="message-preview">
                                        @if (!string.IsNullOrEmpty(issue.AttachmentPath))
                                        {
                                            <span><i class="bi bi-paperclip me-1"></i>Has attachment</span>
                                        }
                                        else
                                        {
                                            <span>No attachment</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                

                <div class="inbox-footer mt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <button class="btn btn-outline-secondary btn-sm" id="refreshInbox">
                            <i class="fas fa-sync-alt me-1"></i> Refresh
                        </button>
                        <a href="#" class="view-all-link">View All Messages <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
           
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#workgroup-ids').select2({
            theme: 'default',
            width: '100%',
            placeholder: 'Select workgroup...',
            allowClear: true,
            ajax: {
                url: '/PlannedEvents/GetWorkgroups',
                dataType: 'json',
                delay: 250,
                data: function(params) {
                    return {
                        search: params.term || '',
                        page: params.page || 1
                    };
                },
                processResults: function(data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.items.map(function(item) {
                            return {
                                id: item.id,
                                text: item.name
                            };
                        }),
                        pagination: {
                            more: data.hasMore
                        }
                    };
                },
                cache: true
            }
        });

                    // Load pre-selected workgroups
            var preselectedIds = @Html.Raw(Json.Serialize(ViewData["SelectedWorkgroupIds"] ?? new List<int>()));
            if (preselectedIds && preselectedIds.length > 0) {
            $.ajax({
                url: '/PlannedEvents/GetSelectedWorkgroups',
                type: 'GET',
                data: { ids: [preselectedId] },
                success: function(data) {
                    data.forEach(function(item) {
                        var option = new Option(item.name, item.id, true, true);
                        $('#workgroup-ids').append(option);
                    });
                    $('#workgroup-ids').trigger('change');
                }
            });
            }
        });
    </script>

    <script src="~/js/index.js"></script>    
}


