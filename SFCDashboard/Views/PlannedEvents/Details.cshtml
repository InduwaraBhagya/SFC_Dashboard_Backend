@model SFCDashboard.Models.PlannedEvent

@{
    ViewData["Title"] = "PE Record Details";
    // Find the ongoing task (first one if multiple)
    var ongoingTask = ((IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasks)
    .FirstOrDefault(t => t.TaskStatus?.Trim().ToLower() == "ongoing");

    var startDate = ongoingTask?.TaskCreatedDate ?? Model.PECreatedDate;
    var targetDate = ongoingTask?.TaskCompleteDate ?? (Model.ServiceRequiredDate ?? Model.PECreatedDate.AddDays(7));
    var today = DateTime.Now.Date;

    var totalDays = (targetDate - startDate).TotalDays;
    var daysPassed = (today - startDate).TotalDays;
    var daysLeft = (targetDate - today).TotalDays;
    var isViolated = today > targetDate;
    var daysExceeded = isViolated ? (today - targetDate).TotalDays : 0;

    // Clamp progress between 0 and 100
    var progressPercent = totalDays > 0 ? Math.Min(100, Math.Max(0, Math.Round((daysPassed / totalDays) * 100))) : 0;
}

<!-- Estimated Time Section (Moved to Top) -->
@{
    var drawFiberTasks = ((IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasks)
    .Where(t => t.Task?.Trim().ToLower() == "draw fiber")
    .ToList();
}
@if (drawFiberTasks.Any())
{
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <strong>Add or Update Estimated Time for a Task</strong>
        </div>
        <div class="card-body">
            <form id="estimatedTimeForm" asp-controller="PETasks" asp-action="UpdateEstimatedTime" method="post"
                class="row g-3 align-items-center">
                <input type="hidden" name="taskId" value="@drawFiberTasks.First().Id" />

                <div class="col-auto">
                    <label for="estimatedTime" class="col-form-label">Estimated Date:</label>
                </div>
                <div class="col-auto">
                    <input type="date" name="estimatedTime" id="estimatedTime" class="form-control" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Timeline/Gantt Chart Section (Updated) -->
<div class="timeline-container mb-4">
    <div class="timeline-labels d-flex justify-content-between mb-1">
        <span>
            <i class="bi bi-flag-fill text-success"></i>
            Start: @startDate.ToString("yyyy-MM-dd")
        </span>
        <span>
            <i class="bi bi-calendar-event text-primary"></i>
            Today: @today.ToString("yyyy-MM-dd")
        </span>
        <span>
            <i class="bi bi-flag-fill text-danger"></i>
            Target: @targetDate.ToString("yyyy-MM-dd")
        </span>
    </div>
    <div class="timeline-bar position-relative" style="height: 32px;">
        <!-- Background bar -->
        <div style="position:absolute;left:0;top:12px;width:100%;height:8px;background:#e9ecef;border-radius:4px;">
        </div>
        <!-- Progress bar -->
        <div style="position:absolute;left:0;top:12px;height:8px;
            background:@(isViolated ? "#dc3545" : "#198754");
            border-radius:4px;
            width:@progressPercent%;"></div>
        <!-- Today marker -->
        <div style="position:absolute;top:0;left:@progressPercent%;transform:translateX(-50%);">
            <span class="badge bg-primary">Today</span>
        </div>
        <!-- Target marker -->
        <div style="position:absolute;top:24px;left:100%;transform:translateX(-50%);">
            <span class="badge bg-danger">Deadline</span>
        </div>
        <!-- Start marker -->
        <div style="position:absolute;top:24px;left:0;">
            <span class="badge bg-success">Start</span>
        </div>
    </div>
    <div class="timeline-info mt-3">
        @if (!isViolated)
        {
            <span class="text-success">
                <i class="bi bi-hourglass-split"></i>
                @if (daysPassed < 1)
                {
                    <strong>Just started!</strong>
                }
                else
                {
                    <strong>@daysPassed.ToString("0") days passed</strong>
                }
                &nbsp;|&nbsp;
                <strong>@daysLeft.ToString("0") days left</strong> until deadline.
            </span>
        }
        else
        {
            <span class="text-danger fw-bold">
                <i class="bi bi-exclamation-triangle"></i>
                Unable to complete task within deadline, exceeded by <strong>@daysExceeded.ToString("0") days</strong>.
            </span>
        }
    </div>
</div>
<style>
    .timeline-container {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 1.5rem 1rem 1rem 1rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .timeline-labels span {
        font-size: 0.95rem;
        font-weight: 500;
    }

    .timeline-bar {
        min-width: 250px;
        margin-bottom: 0.5rem;
    }

    .timeline-info {
        font-size: 1.1rem;
    }
</style>

<div class="container mt-4">
    <div class="card mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">PE Record Details</h2>
            <div>
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("InProgressRecords"))" class="btn btn-sm btn-light">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <tbody>
                        <tr>
                            <th class="bg-light text-primary" style="width: 25%">PE Number (PK)</th>
                            <td>@Html.DisplayFor(model => model.PeNumber)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Job Reference Number</th>
                            <td>@Html.DisplayFor(model => model.JobReference)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">SO Number</th>
                            <td>@Html.DisplayFor(model => model.SoNumber)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Region</th>
                            <td>@Html.DisplayFor(model => model.Region)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Area</th>
                            <td>@Html.DisplayFor(model => model.PeArea)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Task</th>
                            <td>@Html.DisplayFor(model => model.TaskName)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Status</th>
                            <td>
                                @{
                                    string statusClass;
                                    string displayStatus;

                                    if (Model.IsHold)
                                    {
                                        // If IsHold is true, always show "Hold" status with warning class
                                        statusClass = "badge bg-warning text-dark";
                                        displayStatus = "Hold";
                                    }
                                    else
                                    {
                                        // Otherwise show the actual PEStatus from database with appropriate styling
                                        statusClass = Model.PEStatus?.ToLower() switch
                                        {
                                            "completed" => "badge bg-success",
                                            "in progress" => "badge bg-warning text-dark",
                                            "ongoing" => "badge bg-info",
                                            "pending" => "badge bg-secondary",
                                            _ => "badge bg-secondary"
                                        };
                                        displayStatus = Model.PEStatus;
                                    }
                                }
                                <span class="@statusClass">@displayStatus</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Start Time</th>
                            <td>@Html.DisplayFor(model => model.WoStartDate)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">End Time</th>
                            <td>@Html.DisplayFor(model => model.WoActualStartDate)</td>
                        </tr>

                        <tr>
                            <th class="bg-light text-primary">RTOM</th>
                            <td>@Html.DisplayFor(model => model.Rtom)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Contractor Name</th>
                            <td>@Html.DisplayFor(model => model.ContractorName)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">PE Objective</th>
                            <td>@Html.DisplayFor(model => model.PeObjective)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Order Type</th>
                            <td>@Html.DisplayFor(model => model.OrderType)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Pending Task Name</th>
                            <td>@Html.DisplayFor(model => model.PendingTaskName)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Pending Workgroup</th>
                            <td>@Html.DisplayFor(model => model.PendingWg)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Account Manager</th>
                            <td>@Html.DisplayFor(model => model.AccountManager)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Section Handled By</th>
                            <td>@Html.DisplayFor(model => model.SectionHandledBy)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Service Required Date</th>
                            <td>@Html.DisplayFor(model => model.ServiceRequiredDate)</td>
                        </tr>
                        <tr>
                            <th class="bg-light text-primary">Fiber PE Task Workgroup</th>
                            <td>@Html.DisplayFor(model => model.FiberPeTaskWg)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PE Tasks Section -->
    <div class="card">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">PE Tasks</h3>
            @if (ViewBag.PETasks == null || ((IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasks).Count() == 0)
            {
                <span class="badge bg-warning text-dark">No tasks found</span>
            }
        </div>
        <div class="card-body">

            @* Show estimated time summary for "Draw Fiber" task(s) *@
            @{
                var drawFiberTasksWithEstimate = ((IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasks)
                .Where(t => t.Task?.Trim().ToLower() == "draw fiber" && t.EstimatedTime.HasValue)
                .ToList();
            }
            @if (drawFiberTasksWithEstimate.Any())
            {
                <div class="alert alert-secondary mb-3">
                    <strong>Estimated Time for "Draw Fiber":</strong>
                    @foreach (var t in drawFiberTasksWithEstimate)
                    {
                        <span class="badge bg-primary mx-1">@t.EstimatedTime.Value.ToString("yyyy-MM-dd")</span>
                    }
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            @if (ViewBag.PETasks != null && ((IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasks).Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover task-table">
                        <thead class="table-light">
                            <tr>
                                <th>Seq</th>
                                <th>Task</th>
                                <th>Priority</th> <!-- Moved Priority here -->
                                <th>Workgroup</th>
                                <th>OLA</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th>Target Date</th>
                                <th>Actual Start Date</th>
                                <th>Actual End Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in (IEnumerable<SFCDashboard.Models.PETask>)ViewBag.PETasks)
                            {
                                <tr class="@(task.IsUrgent ? "table-warning" : 
                                   task.TaskStatus?.ToLower() == "ongoing" ? "table-primary" : 
                                   task.TaskStatus?.ToLower() == "completed" ? "table-success" : 
                                   task.TaskStatus?.ToLower() == "waiting" ? "table-secondary" : "")">
                            <td>@task.TaskSeq</td>
                            <td>@task.Task</td>
                            <td> <!-- Priority column moved here -->
                                @if (task.IsUrgent)
                                {
                                    <span class="badge bg-danger">URGENT</span>
                                }
                                @if (task.UrgentRequested && !task.IsUrgent)
                                {
                                    <span class="badge bg-warning">URGENT REQUESTED</span>
                                }
                                @if (!string.IsNullOrEmpty(task.Priority))
                                {
                                    <small class="d-block text-muted mt-1">@task.Priority</small>
                                }
                            </td>
                            <td>@(task.TaskWorkGroup == "NULL" ? "" : task.TaskWorkGroup)</td>
                            <td>@task.OLA days</td>
                            <td>
                                @{
                                    string taskStatusClass = task.TaskStatus?.ToLower() switch
                                    {
                                        "completed" => "badge bg-success",
                                        "inprogress" => "badge bg-warning text-dark",
                                        "ongoing" => "badge bg-primary", // Ongoing is now blue
                                        _ => "badge bg-secondary"
                                    };

                                    // OLA color logic for completed tasks
                                    if (task.TaskStatus?.ToLower() == "completed" && task.ActualTaskCreatedDate.HasValue && task.ACtualTaskCompleteDate.HasValue)
                                    {
                                        int olaDays = 0;
                                        int.TryParse(task.OLA, out olaDays);
                                        var actualDays = (task.ACtualTaskCompleteDate.Value.Date - task.ActualTaskCreatedDate.Value.Date).TotalDays;
                                        if (actualDays > olaDays)
                                        {
                                            // Completed but OLA violated
                                            taskStatusClass = "badge bg-danger";
                                        }
                                        else
                                        {
                                            // Completed within OLA
                                            taskStatusClass = "badge bg-success";
                                        }
                                    }
                                }
                                <span class="@taskStatusClass">@task.TaskStatus</span>
                            </td>
                            <td>@task.TaskCreatedDate.ToString("yyyy-MM-dd")</td>
                            <td>@task.TaskCompleteDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @(task.ActualTaskCreatedDate != null
                                    ? task.ActualTaskCreatedDate.Value.ToString("yyyy-MM-dd")
                                    : "-")
                            </td>
                            <td>
                                @(task.ACtualTaskCompleteDate != null
                                    ? task.ACtualTaskCompleteDate.Value.ToString("yyyy-MM-dd")
                                    : "-")
                            </td>
                            <td>
                                @if (task.UrgentRequested && !task.IsUrgent)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-hourglass-split"></i> Awaiting Approval
                                    </span>
                                }
                                else if (task.TaskStatus?.ToUpper() == "ONGOING" && !task.IsUrgent)
                                {
                                    <form asp-controller="PETasks" asp-action="MarkAsUrgent" method="post">
                                        <input type="hidden" name="id" value="@task.Id" />
                                        <button type="submit" class="btn btn-warning btn-sm w-100">
                                            <i class="bi bi-exclamation-triangle"></i> Mark as Urgent
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    No tasks have been assigned to this PE record yet.
                </div>
            }
        </div>
    </div>

    <!-- Reported Issues Section -->
    @if (ViewBag.PEReportedIssues != null &&
        ((IEnumerable<SFCDashboard.Models.PEIssueViewModel>)ViewBag.PEReportedIssues).Any())
    {
        <div class="card mt-4">
            <div class="card-header bg-warning text-dark">
                <i class="bi bi-exclamation-triangle me-2"></i> Reported Issues (Subtasks)
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Reported By</th>
                            <th>Receiver</th>
                            <th>Issue</th>
                            <th>Attachment</th>
                            <th>Date</th>
                            <th>Status</th>  <!-- Add this new column -->
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var issue in (IEnumerable<SFCDashboard.Models.PEIssueViewModel>)ViewBag.PEReportedIssues)
                    {
                        <tr>
                            <td>@issue.SenderName</td>
                            <td>@issue.ReceiverName</td>
                            <td>@issue.IssueText</td>
                            <td>
                                @if (!string.IsNullOrEmpty(issue.AttachmentPath))
                                {
                                    <a href="@issue.AttachmentPath" target="_blank">View</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@issue.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (issue.IsResolved || issue.IsHiddenFromInbox)
                                {
                                    <span class="badge bg-success">Fixed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Open</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4">
            <i class="bi bi-info-circle me-2"></i> No issues reported for this PE.
        </div>
    }
</div>

<!-- Urgent Request Modal for Planned Event -->
<div class="modal fade" id="urgentPEModal" tabindex="-1" aria-labelledby="urgentPEModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="urgentPEModalLabel">Request Urgent Status for Planned Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <strong>PE Number:</strong> <span id="modalPeNumberValue"></span><br>
                    <strong>Customer:</strong> <span id="modalCustomerValue"></span>
                </div>
                <form id="urgentPERequestForm" method="post">
                    <input type="hidden" name="id" id="peIdField" />

                    <div class="form-group mb-4">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="urgentReason" id="openingCeremony"
                                value="OpeningCeremony" required />
                            <label class="form-check-label" for="openingCeremony">
                                <strong>Opening Ceremony</strong> [Priority 1]
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="urgentReason" id="criticalCustomer"
                                value="CriticalCustomer" />
                            <label class="form-check-label" for="criticalCustomer">
                                <strong>Critical Customer</strong> [Priority 2]
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmPEUrgentRequest">Submit Request</button>
            </div>
        </div>
    </div>
</div>

<!-- Report Issue Button -->
@if (!Model.IsHold)
{
    <button class="btn btn-danger my-3"
            data-bs-toggle="modal"
            data-bs-target="#reportIssueModal">
        <i class="bi bi-flag"></i> Report Issue
    </button>
}
<!-- Report Issue Modal -->
<div class="modal fade" id="reportIssueModal" tabindex="-1" aria-labelledby="reportIssueModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="reportIssueForm" enctype="multipart/form-data" method="post" asp-controller="Issues" asp-action="CreateForPE">
                <div class="modal-header">
                    <h5 class="modal-title" id="reportIssueModalLabel">Report Issue</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="PlannedEventId" value="@Model.Id" />

                    <!-- Add Sender Info -->
                    <div class="mb-3">
                        <label class="form-label">Sender</label>
                        <input type="text" class="form-control" id="senderName" readonly />
                        <input type="hidden" id="senderId" name="SenderId" />
                    </div>

                    <div class="mb-3">
                        <label for="receiverId" class="form-label">Receiver</label>
                        <select class="form-select" id="receiverId" name="ReceiverId" required>
                            <option value="">Select User</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="issueText" class="form-label">Issue</label>
                        <input type="text" class="form-control" id="issueText" name="IssueText" list="issueSuggestions"
                            autocomplete="off" required />
                        <datalist id="issueSuggestions"></datalist>
                    </div>
<div class="mb-3">
    <label for="attachment" class="form-label">Attachment (Optional)</label>
    <input type="file" class="form-control" id="attachment" name="Attachment" />
    <small class="text-muted">Supported formats: PDF, Word, Excel, Images</small>
</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Send</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Urgent Request Modal for Task *@
<div class="modal fade" id="urgentTaskModal" tabindex="-1" aria-labelledby="urgentTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="urgentTaskModalLabel">Request Urgent Status for Task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <strong>PE Number:</strong> <span id="modalTaskPeNumberValue"></span><br>
                    <strong>Task Name:</strong> <span id="modalTaskNameValue"></span>
                </div>
                <form id="urgentTaskRequestForm" method="post">
                    <input type="hidden" name="id" id="taskIdField" />
                    <div class="form-group mb-4">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="urgentReason" id="taskOpeningCeremony"
                                value="OpeningCeremony" required />
                            <label class="form-check-label" for="taskOpeningCeremony">
                                <strong>Opening Ceremony</strong> [Priority 1]
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="urgentReason" id="taskCriticalCustomer"
                                value="CriticalCustomer" />
                            <label class="form-check-label" for="taskCriticalCustomer">
                                <strong>Critical Customer</strong> [Priority 2]
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmTaskUrgentRequest">Submit Request</button>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Handle showing the PE urgent modal (for the whole Planned Event)
            document.querySelectorAll('.show-pe-urgent-modal').forEach(function (button) {
                button.addEventListener('click', function () {
                    const peId = this.getAttribute('data-pe-id');
                    const peNumber = this.getAttribute('data-pe-number');
                    const customer = this.getAttribute('data-customer');

                    document.getElementById('peIdField').value = peId;
                    document.getElementById('modalPeNumberValue').textContent = peNumber;
                    document.getElementById('modalCustomerValue').textContent = customer;

                    const modal = new bootstrap.Modal(document.getElementById('urgentPEModal'));
                    modal.show();
                });
            });

            // Handle showing the Task urgent modal (for individual tasks)
            document.querySelectorAll('.show-urgent-modal').forEach(function (button) {
                button.addEventListener('click', function () {
                    const taskId = this.getAttribute('data-task-id');
                    const peNumber = this.getAttribute('data-pe-number');
                    const taskName = this.getAttribute('data-task-name');

                    document.getElementById('taskIdField').value = taskId;
                    document.getElementById('modalTaskPeNumberValue').textContent = peNumber;
                    document.getElementById('modalTaskNameValue').textContent = taskName;

                    const modal = new bootstrap.Modal(document.getElementById('urgentTaskModal'));
                    modal.show();
                });
            });

            // Handle form submission from the PE modal
            document.getElementById('confirmPEUrgentRequest').addEventListener('click', function () {
                // Check if a radio button is selected
                const selectedReason = document.querySelector('#urgentPERequestForm input[name="urgentReason"]:checked');
                if (!selectedReason) {
                    alert('Please select a reason for the urgent request.');
                    return;
                }

                // Submit the form
                const form = document.getElementById('urgentPERequestForm');
                form.action = '@Url.Action("RequestUrgentWithReason", "PlannedEvents")';
                form.submit();
            });

            // Handle form submission from the Task modal
            document.getElementById('confirmTaskUrgentRequest').addEventListener('click', function () {
                // Check if a radio button is selected
                const selectedReason = document.querySelector('#urgentTaskRequestForm input[name="urgentReason"]:checked');
                if (!selectedReason) {
                    alert('Please select a reason for the urgent request.');
                    return;
                }

                // Submit the form
                const form = document.getElementById('urgentTaskRequestForm');
                form.action = '@Url.Action("RequestUrgentWithReason", "PETasks")';
                form.submit();
            });

            // AJAX for Estimated Time Save
            const estimatedTimeForm = document.getElementById('estimatedTimeForm');
            if (estimatedTimeForm) {
                estimatedTimeForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const formData = new FormData(estimatedTimeForm);
                    fetch(estimatedTimeForm.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                        .then(response => {
                            if (response.ok) {
                                // Reload the page after successful save
                                window.location.reload();
                            } else {
                                alert('Failed to save estimated time.');
                            }
                        })
                        .catch(() => alert('Error occurred while saving.'));
                });
            }

            // Set min date for estimatedTime input to today
            var estimatedTimeInput = document.getElementById('estimatedTime');
            if (estimatedTimeInput) {
                var today = new Date();
                var yyyy = today.getFullYear();
                var mm = String(today.getMonth() + 1).padStart(2, '0');
                var dd = String(today.getDate()).padStart(2, '0');
                var minDate = yyyy + '-' + mm + '-' + dd;
                estimatedTimeInput.setAttribute('min', minDate);
            }
        });
        $(document).ready(function () {

            // Get current user info and populate sender fields
            $.get('/SystemUsers/GetCurrentUser', function (user) {
                if (user) {
                    $('#senderName').val(user.name);
                    $('#senderId').val(user.id);
                }
            });

            // Populate receiver dropdown
            $.get('/SystemUsers/GetAll', function (users) {
                users.forEach(function (user) {
                    $('#receiverId').append($('<option>', { value: user.id, text: user.name }));
                });
            });

            // Populate task list dropdown
            $.get('/PETaskLists/GetForPE', { peId: '@Model.Id' }, function (tasks) {
                tasks.forEach(function (task) {
                    $('#taskListId').append($('<option>', { value: task.id, text: task.name }));
                });
            });

            // Populate issue suggestions (existing issues for this PE/tasklist)
            $('#taskListId').on('change', function () {
                var taskListId = $(this).val();
                $('#issueSuggestions').empty();
                if (taskListId) {
                    $.get('/Issues/GetIssueSuggestions', { peId: '@Model.Id', taskListId: taskListId }, function (issues) {
                        issues.forEach(function (issue) {
                            $('#issueSuggestions').append($('<option>', { value: issue.text }));
                        });
                    });
                }
            });
        });
    </script>
}
