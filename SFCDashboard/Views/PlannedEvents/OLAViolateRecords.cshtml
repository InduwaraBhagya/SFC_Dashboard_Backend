@model IEnumerable<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "OLA Violation Records";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">
            <i class="bi bi-exclamation-triangle text-warning me-3"></i>OLA Violation Records
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- Add workgroup filter section here with null check -->
    @if (ViewData["Workgroups"] != null)
    {
        <div class="workgroup-filter-section mb-3">
            <form id="workgroupFilterForm" method="get" asp-action="OLAViolateRecords">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <label for="workgroupFilter" class="form-label mb-0"><i class="bi bi-filter"></i> Filter by Workgroup:</label>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="workgroupFilter" name="workgroupId" onchange="this.form.submit()">
                            <option value="">All Workgroups</option>
                            @foreach (var workgroup in (IEnumerable<WorkGroup>)ViewData["Workgroups"])
                            {
                                <option value="@workgroup.Id" selected="@(ViewData["SelectedWorkgroupId"]?.ToString() == workgroup.Id.ToString())">
                                    @workgroup.Name
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewData["FilteredWorkgroup"] != null)
    {
        <div class="alert alert-info">
            <i class="bi bi-funnel-fill me-2"></i> 
            Filtered by Workgroup: <strong>@ViewData["FilteredWorkgroup"]</strong>
            <a href="@Url.Action("OLAViolateRecords")" class="btn btn-sm btn-outline-secondary ms-3">
                <i class="bi bi-x-circle me-1"></i> Clear Filter
            </a>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Overdue Tasks</h5>
                <span class="badge bg-dark">@Model.Count() Records</span>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>PE Number</th>
                                <th>Customer</th>
                                <th>Current Task</th>
                                <th>Service Type</th>
                                <th>Overdue Tasks</th>
                                <th>Max Days Overdue</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var violations = ViewBag.ViolationDetails[item.PeNumber];
                                
                                <tr>
                                    <td>@item.PeNumber</td>
                                    <td>@item.Customer</td>
                                    <td>@item.TaskName</td>
                                    <td>@item.ServiceType</td>
                                    <td>
                                        <span class="badge bg-danger">@violations.TasksCount tasks</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">@violations.MaxDaysOverdue days</span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" 
                                           class="btn btn-primary btn-sm">
                                            <i class="bi bi-eye"></i> View Details
                                        </a>
                                        <button type="button" class="btn btn-warning btn-sm ms-1"
                                                data-bs-toggle="modal" data-bs-target="#markUrgentModal"
                                                data-pe-id="@item.Id" data-pe-number="@item.PeNumber">
                                            <i class="bi bi-exclamation-circle"></i> Mark Urgent
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i> No OLA violations found.
                </div>
            }
        </div>
    </div>
</div>

<!-- Mark as Urgent Modal -->
<div class="modal fade" id="markUrgentModal" tabindex="-1" aria-labelledby="markUrgentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="markUrgentModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Mark as Urgent
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to mark PE <strong id="modalPeNumber"></strong> as urgent due to OLA violation?</p>
                <p class="text-muted">This will move the record to the urgent list for immediate attention.</p>
                
                <form id="markUrgentForm" asp-action="MarkOLARecordUrgent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="peIdField" name="id" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirmUrgentBtn">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Mark Urgent
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Set up modal data
            $('#markUrgentModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var peId = button.data('pe-id');
                var peNumber = button.data('pe-number');
                
                document.getElementById('modalPeNumber').textContent = peNumber;
                document.getElementById('peIdField').value = peId;
            });
            
            // Handle confirm button click
            document.getElementById('confirmUrgentBtn').addEventListener('click', function() {
                document.getElementById('markUrgentForm').submit();
            });
        });
    </script>
}