@model IEnumerable<SFCDashboard.Models.PlannedEvent>
@{
    ViewData["Title"] = "Urgent Records";
    int rowNumber = 1; // Initialize counter for row numbers
}
<h1>Urgent Records</h1>
<p>Total Urgent Requests: @Model.Count()</p> <!-- Display the total count -->
<table class="table table-striped">
    <thead class="thead-dark">
        <tr>
            <th>#</th> <!-- New column for row numbers -->
            <th>PE Number</th>
            <th>Customer</th>
            <th>Request Reference No</th>
            <th>Region</th>
            <th>Service Required Date</th>
            <th>Priority</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(rowNumber++)</td> <!-- Display and increment row number -->
                <td>@item.PeNumber</td>
                <td>@item.Customer</td>
                <td>@item.RequestReferenceNo</td>
                <td>@item.Region</td>
                <td>@item.ServiceRequiredDate</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.Priority) && item.Priority.Contains("Priority 1"))
                    {
                        <span class="badge bg-danger">Priority 1</span>
                    }
                    else if (!string.IsNullOrEmpty(item.Priority) && item.Priority.Contains("Priority 2"))
                    {
                        <span class="badge bg-warning text-dark">Priority 2</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Standard</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>