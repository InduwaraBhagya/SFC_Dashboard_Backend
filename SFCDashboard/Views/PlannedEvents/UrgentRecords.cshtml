@model IEnumerable<SFCDashboard.Models.PlannedEvent>

@{
    ViewData["Title"] = "Urgent Records";
}

<h1>Urgent Records</h1>

<table class="table table-striped">
    <thead class="thead-dark">
        <tr>
            <th>PE Number</th>
            <th>Customer</th>
            <th>Job Reference</th>
            <th>RTOM</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PeNumber</td>
                <td>@item.Customer</td>
                <td>@item.JobReference</td>
                <td>@item.Rtom</td>
                <td>@item.PEStatus</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Priority) && item.Priority.Contains("Priority 1"))
                    {
                        <span class="badge bg-danger">Priority 1</span>
                    }
                    else if (!string.IsNullOrEmpty(item.Priority) && item.Priority.Contains("Priority 2"))
                    {
                        <span class="badge bg-warning text-dark">Priority 2</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Standard</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
