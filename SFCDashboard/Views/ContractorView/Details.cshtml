@model SFCDashboard.Models.PlannedEvent

@{
    ViewData["Title"] = "Project Details";
    var contractorName = ViewBag.ContractorName;
    var tasks = ViewBag.PETasks as List<SFCDashboard.Models.PETask>;
}

<div class="container-fluid mt-4">
    <!-- Modern Header with Breadcrumb -->
    <div class="contractor-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb" class="mb-2">
                    <ol class="breadcrumb mb-0" style="background: transparent; padding: 0;">
                        <li class="breadcrumb-item"><a href="@ViewBag.ReturnUrl" style="color: rgba(255,255,255,0.8);">Projects</a></li>
                        <li class="breadcrumb-item active" style="color: white;">@Model.PeNumber</li>
                    </ol>
                </nav>
                <h1 class="mb-0">
                    <i class="bi bi-clipboard-data me-3"></i>Project Details
                </h1>
                <p class="mb-0 mt-2" style="color: rgba(255,255,255,0.9); font-size: 1.1rem;">@Model.RtomDescription</p>
            </div>
            <a href="@ViewBag.ReturnUrl" class="btn btn-outline-light no-print">
                <i class="bi bi-arrow-left"></i> Back to Projects
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-hash"></i>
                </div>
                <div class="stat-content">
                    <h3 data-pe-number="@Model.PeNumber">@Model.PeNumber</h3>
                    <p>PE Number</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-building"></i>
                </div>
                <div class="stat-content">
                    <h3>@(Model.Customer?.Length > 15 ? Model.Customer.Substring(0, 15) + "..." : Model.Customer)</h3>
                    <p>Customer</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-tag"></i>
                </div>
                <div class="stat-content">
                    <h3>@Model.CusType</h3>
                    <p>Customer Type</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="stat-card">
                <div class="stat-icon">
                    @if (Model.PEStatus?.ToLower() == "urgent")
                    {
                        <i class="bi bi-exclamation-triangle"></i>
                    }
                    else if (Model.IsHold == true)
                    {
                        <i class="bi bi-pause-circle"></i>
                    }
                    else
                    {
                        <i class="bi bi-play-circle"></i>
                    }
                </div>
                <div class="stat-content">
                    @if (Model.PEStatus?.ToLower() == "urgent")
                    {
                        <h3 class="status-urgent">URGENT</h3>
                    }
                    else if (Model.IsHold == true)
                    {
                        <h3 class="status-hold">ON HOLD</h3>
                    }
                    else
                    {
                        <h3 class="status-ongoing">ONGOING</h3>
                    }
                    <p>Status</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row">
        <!-- Project Information -->
        <div class="col-lg-8 mb-4">
            <div class="contractor-card">
                <div class="contractor-card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Project Information</h5>
                    <span class="badge bg-light text-dark">PE #@Model.PeNumber</span>
                </div>
                <div class="card-body">
                    <div class="project-details-section">
                        <div class="project-info-row">
                            <div class="project-info-label">
                                <i class="bi bi-hash me-2"></i>PE Number:
                            </div>
                            <div class="project-info-value">
                                <strong>@Model.PeNumber</strong>
                            </div>
                        </div>
                        <div class="project-info-row">
                            <div class="project-info-label">
                                <i class="bi bi-file-text me-2"></i>RTOM Description:
                            </div>
                            <div class="project-info-value">@Model.RtomDescription</div>
                        </div>
                        <div class="project-info-row">
                            <div class="project-info-label">
                                <i class="bi bi-bookmark me-2"></i>Job Reference:
                            </div>
                            <div class="project-info-value">
                                <code class="bg-light p-1 rounded">@Model.JobReference</code>
                            </div>
                        </div>
                        <div class="project-info-row">
                            <div class="project-info-label">
                                <i class="bi bi-building me-2"></i>Customer:
                            </div>
                            <div class="project-info-value">
                                <strong>@Model.Customer</strong>
                            </div>
                        </div>
                        <div class="project-info-row">
                            <div class="project-info-label">
                                <i class="bi bi-tag me-2"></i>Customer Type:
                            </div>
                            <div class="project-info-value">
                                <span class="badge bg-secondary">@Model.CusType</span>
                            </div>
                        </div>
                        <div class="project-info-row">
                            <div class="project-info-label">
                                <i class="bi bi-flag me-2"></i>Status:
                            </div>
                            <div class="project-info-value">
                                @if (Model.PEStatus?.ToLower() == "urgent")
                                {
                                    <span class="badge badge-urgent"><i class="bi bi-exclamation-triangle me-1"></i>URGENT</span>
                                }
                                else if (Model.IsHold == true)
                                {
                                    <span class="badge badge-hold"><i class="bi bi-pause-circle me-1"></i>ON HOLD</span>
                                }
                                else
                                {
                                    <span class="badge badge-ongoing"><i class="bi bi-play-circle me-1"></i>ONGOING</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Location Information -->
        <div class="col-lg-4 mb-4">
            <div class="contractor-card">
                <div class="contractor-card-header">
                    <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Project Locations</h5>
                </div>
                <div class="card-body">
                    <div class="project-details-section">
                        <div class="location-card mb-3">
                            <div class="location-header">
                                <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                                <strong>Location A</strong>
                            </div>
                            <div class="location-address">
                                @if (!string.IsNullOrEmpty(Model.LocationAAddress))
                                {
                                    <p class="mb-0">@Model.LocationAAddress</p>
                                    <a href="https://maps.google.com/?q=@Uri.EscapeDataString(Model.LocationAAddress)" target="_blank" class="btn btn-sm btn-outline-primary mt-2">
                                        <i class="bi bi-map me-1"></i>View on Map
                                    </a>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No address provided</p>
                                }
                            </div>
                        </div>
                        
                        <div class="location-card">
                            <div class="location-header">
                                <i class="bi bi-geo-alt-fill text-success me-2"></i>
                                <strong>Location B</strong>
                            </div>
                            <div class="location-address">
                                @if (!string.IsNullOrEmpty(Model.LocationBAddress))
                                {
                                    <p class="mb-0">@Model.LocationBAddress</p>
                                    <a href="https://maps.google.com/?q=@Uri.EscapeDataString((!string.IsNullOrEmpty(Model.Customer) ? Model.Customer + ", " : "") + Model.LocationBAddress)" target="_blank" class="btn btn-sm btn-outline-success mt-2">
                                        <i class="bi bi-map me-1"></i>View on Map
                                    </a>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No address provided</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="contractor-card">
                <div class="card-body text-center">
                    <h6 class="mb-3">Quick Actions</h6>
                    <div class="btn-group-modern">
                        <a href="@Url.Action("Details", "SurveyTasks", new { peNumber = Model.PeNumber })" class="btn btn-primary">
                            <i class="bi bi-clipboard-check me-2"></i>View BOQ Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/contractor.css" />
    <script>
        // Export to PDF functionality
        function exportToPDF() {
            window.print();
        }

        // Copy PE number to clipboard
        function copyPENumber() {
            navigator.clipboard.writeText('@Model.PeNumber').then(function() {
                // Show toast notification
                showToast('PE Number copied to clipboard!');
            });
        }

        // Show toast notification
        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = 'toast-notification';
            toast.textContent = message;
            toast.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: white;
                padding: 12px 20px;
                border-radius: 8px;
                box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
                z-index: 1000;
                animation: slideIn 0.3s ease;
            `;
            
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.animation = 'slideOut 0.3s ease forwards';
                setTimeout(() => document.body.removeChild(toast), 300);
            }, 3000);
        }

        // Add animation styles and enhanced dark theme support
        const style = document.createElement('style');
        style.textContent = `
            /* Enhanced Stat Card Dark Theme Support */
            [data-theme="dark"] .stat-card {
                background: rgba(30, 41, 59, 0.95);
                border: 1px solid rgba(148, 163, 184, 0.1);
                box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
            }

            [data-theme="dark"] .stat-card:hover {
                background: rgba(51, 65, 85, 0.8);
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
                transform: translateY(-2px);
            }

            [data-theme="dark"] .stat-content h3 {
                color: #f1f5f9 !important;
            }

            [data-theme="dark"] .stat-content p {
                color: #94a3b8 !important;
            }

            /* Enhanced stat card interactions */
            .stat-card {
                cursor: pointer;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }

            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
                transition: left 0.6s ease;
            }

            .stat-card:hover::before {
                left: 100%;
            }

            [data-theme="dark"] .stat-card::before {
                background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.1), transparent);
            }

            .stat-card:hover {
                transform: translateY(-4px) scale(1.02);
                box-shadow: 0 8px 24px rgba(102, 126, 234, 0.15);
            }

            /* Status color variables for theme consistency */
            .status-urgent {
                color: #ef4444 !important;
            }

            .status-hold {
                color: #f59e0b !important;
            }

            .status-ongoing {
                color: #10b981 !important;
            }

            [data-theme="dark"] .status-urgent {
                color: #f87171 !important;
            }

            [data-theme="dark"] .status-hold {
                color: #fbbf24 !important;
            }

            [data-theme="dark"] .status-ongoing {
                color: #34d399 !important;
            }

            /* Clickable PE number styling */
            .pe-number-clickable {
                cursor: pointer;
                transition: all 0.2s ease;
                border-radius: 4px;
                padding: 2px 4px;
            }

            .pe-number-clickable:hover {
                background: rgba(102, 126, 234, 0.1);
                color: var(--primary);
            }

            [data-theme="dark"] .pe-number-clickable:hover {
                background: rgba(148, 163, 184, 0.2);
                color: #94a3b8;
            }

            /* Animation keyframes */
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }

            @@keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }

            @@keyframes statCardPulse {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.05); }
            }

            .stat-card-animate {
                animation: statCardPulse 0.6s ease-in-out;
            }

            /* Enhanced responsive behavior */
            @@media (max-width: 768px) {
                .stat-card:hover {
                    transform: translateY(-2px) scale(1.01);
                }
            }

            /* Accessibility improvements */
            @@media (prefers-reduced-motion: reduce) {
                .stat-card {
                    transition: none !important;
                }
                
                .stat-card:hover {
                    transform: none !important;
                }
                
                .stat-card::before {
                    display: none !important;
                }
            }

            /* Dark theme toast notification */
            [data-theme="dark"] .toast-notification {
                background: linear-gradient(135deg, #34d399 0%, #059669 100%) !important;
                box-shadow: 0 4px 16px rgba(52, 211, 153, 0.3) !important;
            }
        `;
        document.head.appendChild(style);

        // Initialize enhanced interactions
        document.addEventListener('DOMContentLoaded', function() {
            // Add click to copy functionality for PE number
            const peNumberElements = document.querySelectorAll('[data-pe-number]');
            peNumberElements.forEach(el => {
                el.addEventListener('click', copyPENumber);
                el.classList.add('pe-number-clickable');
                el.title = 'Click to copy PE number';
            });

            // Enhanced stat card interactions
            const statCards = document.querySelectorAll('.stat-card');
            statCards.forEach((card, index) => {
                // Add entrance animation with delay
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                
                setTimeout(() => {
                    card.style.transition = 'all 0.4s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);

                // Add click animation
                card.addEventListener('click', function() {
                    this.classList.add('stat-card-animate');
                    setTimeout(() => {
                        this.classList.remove('stat-card-animate');
                    }, 600);

                    // Copy value based on card content
                    const h3 = this.querySelector('h3');
                    const p = this.querySelector('p');
                    if (h3 && p) {
                        const value = h3.textContent.trim();
                        const label = p.textContent.trim();
                        
                        navigator.clipboard.writeText(value).then(() => {
                            showToast(`${label} copied: ${value}`);
                        }).catch(() => {
                            showToast(`${label}: ${value}`);
                        });
                    }
                });

                // Add keyboard accessibility
                card.setAttribute('tabindex', '0');
                card.setAttribute('role', 'button');
                card.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        this.click();
                    }
                });
            });

            // Theme detection and dynamic styling
            function updateThemeStyles() {
                const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || 
                             window.matchMedia('(prefers-color-scheme: dark)').matches;
                
                if (isDark) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            }

            // Listen for theme changes
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateThemeStyles);
            updateThemeStyles();

            // Add status-specific click handlers
            const urgentCards = document.querySelectorAll('.stat-card .status-urgent');
            const holdCards = document.querySelectorAll('.stat-card .status-hold');
            const ongoingCards = document.querySelectorAll('.stat-card .status-ongoing');

            urgentCards.forEach(card => {
                card.closest('.stat-card').addEventListener('click', () => {
                    showToast('⚠️ This project requires urgent attention!');
                });
            });

            holdCards.forEach(card => {
                card.closest('.stat-card').addEventListener('click', () => {
                    showToast('⏸️ This project is currently on hold');
                });
            });

            ongoingCards.forEach(card => {
                card.closest('.stat-card').addEventListener('click', () => {
                    showToast('▶️ This project is actively ongoing');
                });
            });
        });
    </script>
}