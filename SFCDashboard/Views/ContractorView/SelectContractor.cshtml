@model List<string>

@{
    ViewData["Title"] = "Select Contractor";
}

<div class="container-fluid mt-4">
    <div class="contractor-header d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 d-flex align-items-center">
            <i class="bi bi-building icon-white icon-lg me-3"></i>
            <span class="contractor-name">Select Contractor</span>
        </h1>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary no-print">
            <i class="bi bi-house"></i> Back to Home
        </a>
    </div>

    <div class="contractor-card">
        <div class="contractor-card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Available Contractors</h5>
                <span class="badge bg-light text-dark">@Model.Count Records</span>
            </div>
        </div>
        <div class="card-body">
            <div class="contractor-list-group">
                @foreach (var contractor in Model)
                {
                    <a href="@Url.Action("ContractorRecords", new { contractorName = contractor })" 
                       class="contractor-list-item d-flex justify-content-between align-items-center">
                        <div class="contractor-item-content d-flex align-items-center">
                            <div class="contractor-icon">
                                <i class="bi bi-building"></i>
                            </div>
                            <div class="contractor-details">
                                <h6 class="contractor-name mb-0">@contractor</h6>
                                <small class="text-muted">Click to view projects</small>
                            </div>
                        </div>
                        <div class="contractor-chevron">
                            <i class="bi bi-chevron-right"></i>
                        </div>
                    </a>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="no-records text-center py-5">
                    <div class="empty-state">
                        <i class="bi bi-building-x display-1 text-muted mb-3"></i>
                        <h5 class="text-muted mb-2">No Contractors Found</h5>
                        <p class="text-muted mb-0">No contractors are currently available in the system.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Add keyboard navigation support
            const contractorItems = document.querySelectorAll('.contractor-list-item');
            let currentIndex = -1;

            // Handle keyboard navigation
            document.addEventListener('keydown', function(e) {
                if (contractorItems.length === 0) return;

                switch(e.key) {
                    case 'ArrowDown':
                        e.preventDefault();
                        currentIndex = Math.min(currentIndex + 1, contractorItems.length - 1);
                        updateFocus();
                        break;
                    case 'ArrowUp':
                        e.preventDefault();
                        currentIndex = Math.max(currentIndex - 1, 0);
                        updateFocus();
                        break;
                    case 'Enter':
                        if (currentIndex >= 0) {
                            e.preventDefault();
                            contractorItems[currentIndex].click();
                        }
                        break;
                    case 'Escape':
                        currentIndex = -1;
                        updateFocus();
                        break;
                }
            });

            function updateFocus() {
                // Remove previous focus
                contractorItems.forEach(item => item.classList.remove('focused'));
                
                // Add focus to current item
                if (currentIndex >= 0) {
                    contractorItems[currentIndex].classList.add('focused');
                    contractorItems[currentIndex].scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'nearest' 
                    });
                }
            }

            // Add click analytics (optional)
            contractorItems.forEach((item, index) => {
                item.addEventListener('click', function() {
                    console.log(`Contractor selected: ${this.querySelector('.contractor-name').textContent.trim()}`);
                });
            });

            // Add loading state for better UX
            contractorItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    // Add loading state
                    const chevron = this.querySelector('.contractor-chevron i');
                    chevron.className = 'bi bi-arrow-clockwise spinning';
                    
                    // Optional: Add slight delay to show loading state
                    // Remove this in production if navigation should be immediate
                    setTimeout(() => {
                        // Navigation will happen automatically via href
                    }, 100);
                });
            });
        });
    </script>
    <style>
        /* Additional inline styles for enhanced interactions */
        .contractor-list-item.focused {
            background: var(--light) !important;
            border-color: var(--primary) !important;
            transform: translateX(4px);
            box-shadow: var(--shadow-md);
        }
        
        [data-theme="dark"] .contractor-list-item.focused {
            background: rgba(51, 65, 85, 0.8) !important;
            border-color: rgba(102, 126, 234, 0.5) !important;
        }
        
        .spinning {
            animation: spin 1s linear infinite;
        }
        
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        /* Smooth entrance animation */
        .contractor-list-item {
            animation: slideInLeft 0.3s ease-out;
            animation-fill-mode: both;
        }
        
        .contractor-list-item:nth-child(1) { animation-delay: 0.1s; }
        .contractor-list-item:nth-child(2) { animation-delay: 0.2s; }
        .contractor-list-item:nth-child(3) { animation-delay: 0.3s; }
        .contractor-list-item:nth-child(4) { animation-delay: 0.4s; }
        .contractor-list-item:nth-child(5) { animation-delay: 0.5s; }
        .contractor-list-item:nth-child(n+6) { animation-delay: 0.6s; }
        
        @@keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        /* Reduce animations for users who prefer reduced motion */
        @@media (prefers-reduced-motion: reduce) {
            .contractor-list-item {
                animation: none !important;
            }
            
            .spinning {
                animation: none !important;
            }
        }
    </style>
    <link rel="stylesheet" href="~/css/contractor.css" />
}