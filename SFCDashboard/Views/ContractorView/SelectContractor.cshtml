@model List<string>

@{
    ViewData["Title"] = "Select Contractor";
}

<div class="container-fluid mt-4">
    <div class="contractor-header mb-4">
        <h1 class="display-5">
            <i class="bi bi-building text-primary me-3"></i>Select Contractor
        </h1>
    </div>

    <div class="contractor-card">
        <div class="contractor-card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Available Contractors</h5>
                <span class="badge bg-light text-dark">@Model.Count Records</span>
            </div>
        </div>
        <div class="card-body">
            <div class="list-group">
                @foreach (var contractor in Model)
                {
                    <a href="@Url.Action("ContractorRecords", new { contractorName = contractor })" 
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-building me-3"></i>
                            @contractor
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="no-records mt-3">
                    <i class="bi bi-info-circle me-2"></i> No contractors found in the system.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/contractor.css" />
}