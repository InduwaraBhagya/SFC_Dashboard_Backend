@model SFCDashboard.Models.UDManagerViewModel
@{
    ViewData["Title"] = "Manage BOQ Database Items";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-database-fill-gear fs-4 me-2"></i>
                    <h5 class="mb-0">Manage BOQ Database Items</h5>
                </div>
                <a href="javascript:history.back()" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>
    </div>
    
    <div class="row">
        <!-- Categories Section -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Categories</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post">
                        @Html.AntiForgeryToken()
                        <div class="input-group mb-3">
                            <input type="text" name="Category" class="form-control" placeholder="New Category" required>
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-plus-circle"></i> Add
                            </button>
                        </div>
                    </form>
                    
                    <div class="list-group mt-3">
                        @foreach (var category in Model.Categories)
                        {
                            <!-- For categories section -->
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>@category.Category</span>
                                <div>
                                    <button class="btn btn-sm btn-primary edit-category" data-id="@category.Id" data-name="@category.Category">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger delete-category" data-id="@category.Id">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        @if (!Model.Categories.Any())
                        {
                            <div class="text-muted text-center py-3">No categories available</div>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <!-- SubCategories Section -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Sub-Categories</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddSubCategory" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <select name="CategoryId" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Category</option>
                                }
                            </select>
                        </div>
                        <div class="input-group mb-3">
                            <input type="text" name="SubCategory" class="form-control" placeholder="New Sub-Category" required>
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-plus-circle"></i> Add
                            </button>
                        </div>
                    </form>
                    
                    <div class="list-group mt-3">
                        @foreach (var subCategory in Model.SubCategories)
                        {
                            <!-- For subcategories section -->
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <div>@subCategory.SubCategory</div>
                                    <small class="text-muted">Category: @subCategory.Category.Category</small>
                                </div>
                                <div>
                                    <button class="btn btn-sm btn-primary edit-subcategory" 
                                            data-id="@subCategory.Id" 
                                            data-name="@subCategory.SubCategory"
                                            data-category-id="@subCategory.CategoryId">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger delete-subcategory" data-id="@subCategory.Id">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        @if (!Model.SubCategories.Any())
                        {
                            <div class="text-muted text-center py-3">No sub-categories available</div>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <!-- UD Names Section -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">UD Names</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddUDName" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <select name="CategoryId" id="udCategorySelect" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Category</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <select name="SubCategoryId" id="udSubCategorySelect" class="form-select" required disabled>
                                <option value="">-- Select Sub-Category --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <input type="text" name="Name" class="form-control" placeholder="UD Name" required>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <input type="text" name="Unit" class="form-control" placeholder="Unit (e.g., meter, each)" required>
                            </div>
                            <div class="col">
                                <input type="number" name="UnitPrice" class="form-control" placeholder="Unit Price" step="0.01" min="0.01" required>
                            </div>
                        </div>
                        <div class="d-grid">
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-plus-circle"></i> Add UD Name
                            </button>
                        </div>
                    </form>
                    
                    <div class="list-group mt-3">
                        @foreach (var udName in Model.UDNames)
                        {
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <div>@udName.Name @Html.Raw(!udName.IsActive ? "<span class=\"badge bg-secondary\">Inactive</span>" : "")</div>                                    <div><small class="text-muted">Category: @udName.Category.Category / Sub: @udName.SubCategory.SubCategory</small></div>
                                    <div><small class="text-muted">Unit: @udName.Unit / Price: @udName.UnitPrice.ToString("N2")</small></div>
                                </div>
                                <div>
                                    <button class="btn btn-sm @(udName.IsActive ? "btn-warning" : "btn-success") toggle-active" 
                                            data-id="@udName.Id" data-active="@udName.IsActive.ToString().ToLower()">
                                        <i class="bi @(udName.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i> 
                                        @(udName.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                    <button class="btn btn-sm btn-primary edit-udname" 
                                            data-id="@udName.Id"
                                            data-name="@udName.Name"
                                            data-unit="@udName.Unit"
                                            data-price="@udName.UnitPrice"
                                            data-category-id="@udName.CategoryId"
                                            data-subcategory-id="@udName.SubCategoryId">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger delete-udname" data-id="@udName.Id">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        @if (!Model.UDNames.Any())
                        {
                            <div class="text-muted text-center py-3">No UD names available</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for editing Category -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editCategoryForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editCategoryId" name="Id" />
                    <div class="form-group mb-3">
                        <label for="editCategoryName" class="form-label">Category Name</label>
                        <input type="text" id="editCategoryName" name="Category" class="form-control" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveCategoryChanges">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for editing Sub-Category -->
<div class="modal fade" id="editSubCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Sub-Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editSubCategoryForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editSubCategoryId" name="Id" />
                    <div class="form-group mb-3">
                        <label for="editSubCategoryCategory" class="form-label">Category</label>
                        <select id="editSubCategoryCategory" name="CategoryId" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.Category</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label for="editSubCategoryName" class="form-label">Sub-Category Name</label>
                        <input type="text" id="editSubCategoryName" name="SubCategory" class="form-control" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveSubCategoryChanges">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for editing UD Name -->
<div class="modal fade" id="editUDNameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit UD Name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editUDNameForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editUDNameId" name="Id" />
                    <div class="form-group mb-3">
                        <label for="editUDNameCategory" class="form-label">Category</label>
                        <select id="editUDNameCategory" name="CategoryId" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.Category</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label for="editUDNameSubCategory" class="form-label">Sub-Category</label>
                        <select id="editUDNameSubCategory" name="SubCategoryId" class="form-select" required>
                            <option value="">-- Select Sub-Category --</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label for="editUDNameName" class="form-label">UD Name</label>
                        <input type="text" id="editUDNameName" name="Name" class="form-control" required />
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label for="editUDNameUnit" class="form-label">Unit</label>
                            <input type="text" id="editUDNameUnit" name="Unit" class="form-control" placeholder="e.g., meter, each" required />
                        </div>
                        <div class="col">
                            <label for="editUDNameUnitPrice" class="form-label">Unit Price</label>
                            <input type="number" id="editUDNameUnitPrice" name="UnitPrice" class="form-control" step="0.01" min="0.01" required />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveUDNameChanges">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Handle category selection for UD Name form
            $('#udCategorySelect').change(function() {
                var categoryId = $(this).val();
                var subCategorySelect = $('#udSubCategorySelect');
                
                if (categoryId) {
                    // Enable dropdown and load subcategories
                    subCategorySelect.prop('disabled', false);
                    subCategorySelect.empty().append('<option value="">-- Select Sub-Category --</option>');
                    
                    $.ajax({
                        url: '@Url.Action("GetSubCategories", "UDManager")',
                        type: 'GET',
                        data: { categoryId: categoryId },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                subCategorySelect.append($('<option>', {
                                    value: item.id,
                                    text: item.name
                                }));
                            });
                        },
                        error: function(error) {
                            console.error("Error loading sub-categories:", error);
                            alert("Failed to load sub-categories. Please try again.");
                        }
                    });
                } else {
                    // Disable dropdown if no category selected
                    subCategorySelect.prop('disabled', true);
                    subCategorySelect.empty().append('<option value="">-- Select Sub-Category --</option>');
                }
            });
            
            // Delete category
            $('.delete-category').click(function() {
                var id = $(this).data('id');
                var listItem = $(this).closest('.list-group-item');
                
                if (confirm('Are you sure you want to delete this category? This will only work if no items are using this category.')) {
                    $.ajax({
                        url: '@Url.Action("DeleteCategory", "UDManager")/' + id,
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(result) {
                            if (result.success) {
                                listItem.fadeOut(function() {
                                    $(this).remove();
                                    if ($('.delete-category').length === 0) {
                                        $('.list-group').eq(0).append('<div class="text-muted text-center py-3">No categories available</div>');
                                    }
                                });
                            } else {
                                alert(result.message);
                            }
                        },
                        error: function() {
                            alert('An error occurred while deleting the category.');
                        }
                    });
                }
            });
            
            // Delete sub-category
            $('.delete-subcategory').click(function() {
                var id = $(this).data('id');
                var listItem = $(this).closest('.list-group-item');
                
                if (confirm('Are you sure you want to delete this sub-category? This will only work if no items are using this sub-category.')) {
                    $.ajax({
                        url: '@Url.Action("DeleteSubCategory", "UDManager")/' + id,
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(result) {
                            if (result.success) {
                                listItem.fadeOut(function() {
                                    $(this).remove();
                                    if ($('.delete-subcategory').length === 0) {
                                        $('.list-group').eq(1).append('<div class="text-muted text-center py-3">No sub-categories available</div>');
                                    }
                                });
                            } else {
                                alert(result.message);
                            }
                        },
                        error: function() {
                            alert('An error occurred while deleting the sub-category.');
                        }
                    });
                }
            });
            
            // Delete UD name
            $('.delete-udname').click(function() {
                var id = $(this).data('id');
                var listItem = $(this).closest('.list-group-item');
                
                if (confirm('Are you sure you want to delete this UD name? This will only work if no BOQ items are using this UD name.')) {
                    $.ajax({
                        url: '@Url.Action("DeleteUDName", "UDManager")/' + id,
                        type: 'POST',
                        data: { 
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(result) {
                            if (result.success) {
                                listItem.fadeOut(function() {
                                    $(this).remove();
                                    if ($('.delete-udname').length === 0) {
                                        $('.list-group').eq(2).append('<div class="text-muted text-center py-3">No UD names available</div>');
                                    }
                                });
                            } else {
                                alert(result.message);
                            }
                        },
                        error: function() {
                            alert('An error occurred while deleting the UD name.');
                        }
                    });
                }
            });
            
            // Toggle UD name active state
            $('.toggle-active').click(function() {
                var button = $(this);
                var id = button.data('id');
                var currentActive = button.data('active') === 'true';
                
                $.ajax({
                    url: '@Url.Action("ToggleUDNameActive", "UDManager")',
                    type: 'POST',
                    data: { 
                        id: id,
                        isActive: !currentActive,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(result) {
                        if (result.success) {
                            // Update UI without page refresh
                            if (currentActive) {
                                // Changing to inactive
                                button.removeClass('btn-warning').addClass('btn-success');
                                button.html('<i class="bi bi-toggle-off"></i> Activate');
                                button.data('active', 'false');
                                button.closest('.list-group-item').find('div:first div:first')
                                    .append($('<span>', {
                                        class: 'badge bg-secondary ms-1',
                                        text: 'Inactive'
                                    }));
                            } else {
                                // Changing to active
                                button.removeClass('btn-success').addClass('btn-warning');
                                button.html('<i class="bi bi-toggle-on"></i> Deactivate');
                                button.data('active', 'true');
                                button.closest('.list-group-item').find('.badge').remove();
                            }
                        } else {
                            alert(result.message || 'Failed to update status.');
                        }
                    },
                    error: function() {
                        alert('An error occurred while updating the status.');
                    }
                });
            });
            
            // Edit category
            $('.edit-category').click(function() {
                var id = $(this).data('id');
                var name = $(this).data('name');
                
                $('#editCategoryId').val(id);
                $('#editCategoryName').val(name);
                
                var modal = new bootstrap.Modal(document.getElementById('editCategoryModal'));
                modal.show();
            });
            
            // Save category changes
            $('#saveCategoryChanges').click(function() {
                var form = $('#editCategoryForm');
                
                // Simple validation
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("EditCategory", "UDManager")',
                    type: 'POST',
                    data: form.serialize(),
                    success: function(result) {
                        if (result.success) {
                            // Close modal and refresh page to show updated data
                            $('#editCategoryModal').modal('hide');
                            location.reload();
                        } else {
                            alert(result.message || 'Failed to update category.');
                        }
                    },
                    error: function() {
                        alert('An error occurred while updating the category.');
                    }
                });
            });
            
            // Edit sub-category
            $('.edit-subcategory').click(function() {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var categoryId = $(this).data('category-id');
                
                $('#editSubCategoryId').val(id);
                $('#editSubCategoryName').val(name);
                $('#editSubCategoryCategory').val(categoryId);
                
                var modal = new bootstrap.Modal(document.getElementById('editSubCategoryModal'));
                modal.show();
            });
            
            // Save sub-category changes
            $('#saveSubCategoryChanges').click(function() {
                var form = $('#editSubCategoryForm');
                
                // Simple validation
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("EditSubCategory", "UDManager")',
                    type: 'POST',
                    data: form.serialize(),
                    success: function(result) {
                        if (result.success) {
                            // Close modal and refresh page to show updated data
                            $('#editSubCategoryModal').modal('hide');
                            location.reload();
                        } else {
                            alert(result.message || 'Failed to update sub-category.');
                        }
                    },
                    error: function() {
                        alert('An error occurred while updating the sub-category.');
                    }
                });
            });
            
            // Edit UD name
            $('.edit-udname').click(function() {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var unit = $(this).data('unit');
                var price = $(this).data('price');
                var categoryId = $(this).data('category-id');
                var subCategoryId = $(this).data('subcategory-id');
                
                $('#editUDNameId').val(id);
                $('#editUDNameName').val(name);
                $('#editUDNameUnit').val(unit);
                $('#editUDNameUnitPrice').val(price);
                $('#editUDNameCategory').val(categoryId);
                
                // Load the subcategories for the selected category
                loadEditUDNameSubCategories(categoryId, subCategoryId);
                
                var modal = new bootstrap.Modal(document.getElementById('editUDNameModal'));
                modal.show();
            });
            
            // Handle category change in UD Name edit modal
            $('#editUDNameCategory').change(function() {
                var categoryId = $(this).val();
                loadEditUDNameSubCategories(categoryId);
            });
            
            // Function to load subcategories for the UD Name edit modal
            function loadEditUDNameSubCategories(categoryId, selectedSubCategoryId) {
                var subCategorySelect = $('#editUDNameSubCategory');
                subCategorySelect.empty().append('<option value="">-- Select Sub-Category --</option>');
                
                if (categoryId) {
                    $.ajax({
                        url: '@Url.Action("GetSubCategories", "UDManager")',
                        type: 'GET',
                        data: { categoryId: categoryId },
                        success: function(data) {
                            $.each(data, function(i, item) {
                                var option = $('<option>', {
                                    value: item.id,
                                    text: item.name
                                });
                                
                                if (item.id == selectedSubCategoryId) {
                                    option.attr('selected', 'selected');
                                }
                                
                                subCategorySelect.append(option);
                            });
                        }
                    });
                }
            }
            
            // Save UD name changes
            $('#saveUDNameChanges').click(function() {
                var form = $('#editUDNameForm');
                
                // Simple validation
                if (!form[0].checkValidity()) {
                    form[0].reportValidity();
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("EditUDName", "UDManager")',
                    type: 'POST',
                    data: form.serialize(),
                    success: function(result) {
                        if (result.success) {
                            // Close modal and refresh page to show updated data
                            $('#editUDNameModal').modal('hide');
                            location.reload();
                        } else {
                            alert(result.message || 'Failed to update UD name.');
                        }
                    },
                    error: function() {
                        alert('An error occurred while updating the UD name.');
                    }
                });
            });
        });
    </script>
}