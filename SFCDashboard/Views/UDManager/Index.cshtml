@model SFCDashboard.Models.UDManagerViewModel
@{
    ViewData["Title"] = "Manage UD Items";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">Manage UD Items</h1>
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <div asp-validation-summary="All" class="mb-0"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <!-- Categories Management -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-folder me-2"></i>Categories</h5>
                    <small class="badge bg-light text-dark">@Model.Categories.Count items</small>
                </div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="NewCategory.Category" class="form-label">New Category</label>
                            <div class="input-group">
                                <input asp-for="NewCategory.Category" class="form-control" required placeholder="Enter category name" />
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i> Add
                                </button>
                            </div>
                            <span asp-validation-for="NewCategory.Category" class="text-danger"></span>
                        </div>
                    </form>
                    
                    <!-- Add scrollable container for categories -->
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>ID</th>
                                    <th>Category Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in Model.Categories)
                                {
                                    <tr>
                                        <td>@category.Id</td>
                                        <td>@category.Category</td>
                                    </tr>
                                }
                                @if (!Model.Categories.Any())
                                {
                                    <tr>
                                        <td colspan="2" class="text-center py-3 text-muted">
                                            <i class="bi bi-info-circle me-2"></i>No categories found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Sub-Categories Management -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Sub-Categories</h5>
                    <small class="badge bg-light text-dark">@Model.SubCategories.Count items</small>
                </div>
                <div class="card-body">
                    <form asp-action="AddSubCategory" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="NewSubCategory.CategoryId" class="form-label">Select Category</label>
                            <select asp-for="NewSubCategory.CategoryId" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Category</option>
                                }
                            </select>
                            <span asp-validation-for="NewSubCategory.CategoryId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewSubCategory.SubCategory" class="form-label">New Sub-Category</label>
                            <div class="input-group">
                                <input asp-for="NewSubCategory.SubCategory" class="form-control" required placeholder="Enter sub-category name" />
                                <button type="submit" class="btn btn-info">
                                    <i class="bi bi-plus-circle me-1"></i> Add
                                </button>
                            </div>
                            <span asp-validation-for="NewSubCategory.SubCategory" class="text-danger"></span>
                        </div>
                    </form>
                    
                    <!-- Add scrollable container for subcategories -->
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>ID</th>
                                    <th>Sub-Category</th>
                                    <th>Parent Category</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subCategory in Model.SubCategories)
                                {
                                    <tr>
                                        <td>@subCategory.Id</td>
                                        <td>@subCategory.SubCategory</td>
                                        <td>@subCategory.Category.Category</td>
                                    </tr>
                                }
                                @if (!Model.SubCategories.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-3 text-muted">
                                            <i class="bi bi-info-circle me-2"></i>No sub-categories found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <!-- UD Names Management -->
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <h5 class="mb-0 me-3"><i class="bi bi-tags me-2"></i>UD Names</h5>
                            <small class="badge bg-light text-dark">@Model.UDNames.Count items</small>
                        </div>
                        <div>
                            <form asp-action="Index" method="get" class="d-flex">
                                <div class="input-group">
                                    <input type="text" name="searchTerm" class="form-control" placeholder="Search UD items..." value="@ViewBag.SearchTerm">
                                    <button class="btn btn-outline-light" type="submit">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="AddUDName" method="post" class="mb-4 border-bottom pb-4">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NewUDName.CategoryId" class="form-label">Category</label>
                                <select asp-for="NewUDName.CategoryId" id="udNameCategorySelect" class="form-select" required>
                                    <option value="">-- Select Category --</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.Id">@category.Category</option>
                                    }
                                </select>
                                <span asp-validation-for="NewUDName.CategoryId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewUDName.SubCategoryId" class="form-label">Sub-Category</label>
                                <select asp-for="NewUDName.SubCategoryId" id="udNameSubCategorySelect" class="form-select" required>
                                    <option value="">-- Select Sub-Category --</option>
                                </select>
                                <span asp-validation-for="NewUDName.SubCategoryId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewUDName.Name" class="form-label">Name</label>
                                <input asp-for="NewUDName.Name" class="form-control" required placeholder="Enter UD name" />
                                <span asp-validation-for="NewUDName.Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="NewUDName.Unit" class="form-label">Unit</label>
                                <input asp-for="NewUDName.Unit" class="form-control" required placeholder="e.g., each, meter" />
                                <span asp-validation-for="NewUDName.Unit" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="NewUDName.UnitPrice" class="form-label">Unit Price</label>
                                <input asp-for="NewUDName.UnitPrice" type="number" step="0.01" min="0" class="form-control" required placeholder="0.00" />
                                <span asp-validation-for="NewUDName.UnitPrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-12">
                                <div class="form-check">
                                    <input asp-for="NewUDName.IsActive" class="form-check-input" checked />
                                    <label asp-for="NewUDName.IsActive" class="form-check-label">Is Active</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-plus-circle me-1"></i> Add UD Name
                                </button>
                            </div>
                        </div>
                    </form>
                    
                    <!-- Add scrollable container for UD names -->
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-hover mb-0" id="udNamesTable">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Sub-Category</th>
                                    <th>Unit</th>
                                    <th>Unit Price</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var udName in Model.UDNames)
                                {
                                    <tr data-id="@udName.Id" class="@(udName.IsActive ? "" : "text-muted")">
                                        <td>@udName.Name</td>
                                        <td>@udName.Category.Category</td>
                                        <td>@udName.SubCategory.SubCategory</td>
                                        <td>@udName.Unit</td>
                                        <td>@udName.UnitPrice.ToString("N2")</td>
                                        <td>
                                            <span class="badge @(udName.IsActive ? "bg-success" : "bg-secondary")">
                                                @(udName.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-primary edit-ud-name" data-id="@udName.Id">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </button>
                                                <button type="button" class="btn @(udName.IsActive ? "btn-warning" : "btn-success") toggle-status" 
                                                        data-id="@udName.Id" data-status="@udName.IsActive.ToString().ToLower()">
                                                    <i class="bi @(udName.IsActive ? "bi-x-circle" : "bi-check-circle")"></i>
                                                    @(udName.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.UDNames.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4">
                                            <i class="bi bi-info-circle me-2"></i>No UD Names found
                                            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                                            {
                                                <span>matching "@ViewBag.SearchTerm"</span>
                                                <div class="mt-2">
                                                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                                        <i class="bi bi-x-circle me-1"></i>Clear Search
                                                    </a>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editUDNameModal" tabindex="-1" aria-labelledby="editUDNameModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editUDNameModalLabel">Edit UD Name</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editUDNameForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="edit_id" name="Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="edit_categoryId" class="form-label">Category</label>
                            <select id="edit_categoryId" name="CategoryId" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Category</option>
                                }
                            </select>
                            <div class="invalid-feedback" id="edit_categoryId_error"></div>
                        </div>
                        <div class="col-md-6">
                            <label for="edit_subCategoryId" class="form-label">Sub-Category</label>
                            <select id="edit_subCategoryId" name="SubCategoryId" class="form-select" required>
                                <option value="">-- Select Sub-Category --</option>
                            </select>
                            <div class="invalid-feedback" id="edit_subCategoryId_error"></div>
                        </div>
                        <div class="col-md-6">
                            <label for="edit_name" class="form-label">Name</label>
                            <input id="edit_name" name="Name" class="form-control" required placeholder="Enter UD name" />
                            <div class="invalid-feedback" id="edit_name_error"></div>
                        </div>
                        <div class="col-md-3">
                            <label for="edit_unit" class="form-label">Unit</label>
                            <input id="edit_unit" name="Unit" class="form-control" required placeholder="e.g., each, meter" />
                            <div class="invalid-feedback" id="edit_unit_error"></div>
                        </div>
                        <div class="col-md-3">
                            <label for="edit_unitPrice" class="form-label">Unit Price</label>
                            <input id="edit_unitPrice" name="UnitPrice" type="number" step="0.01" min="0" class="form-control" required placeholder="0.00" />
                            <div class="invalid-feedback" id="edit_unitPrice_error"></div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check">
                                <input id="edit_isActive" name="IsActive" class="form-check-input" type="checkbox" />
                                <label for="edit_isActive" class="form-check-label">Is Active</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveUDNameChanges">
                    <i class="bi bi-save me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            console.log("UDManager page loaded");
            
            // Debug form submissions
            $('form').on('submit', function() {
                console.log("Form submitted:", $(this).attr('action'));
                console.log("Form data:", $(this).serialize());
            });

            // Handle category change for sub-category loading in new UD name form
            $('#udNameCategorySelect').on('change', function() {
                loadSubCategories($(this).val(), $('#udNameSubCategorySelect'));
            });
            
            // Handle category change for sub-category loading in edit form
            $('#edit_categoryId').on('change', function() {
                loadSubCategories($(this).val(), $('#edit_subCategoryId'));
            });
            
            function loadSubCategories(categoryId, targetSelect) {
                console.log("Category changed to:", categoryId);
                
                if (categoryId) {
                    // Get sub-categories for the selected category
                    $.ajax({
                        url: '@Url.Action("GetSubCategories", "UDManager")',
                        type: 'GET',
                        data: { categoryId: categoryId },
                        success: function(data) {
                            console.log("Subcategories loaded:", data);
                            targetSelect.empty().append('<option value="">-- Select Sub-Category --</option>');
                            $.each(data, function(i, item) {
                                targetSelect.append($('<option>', {
                                    value: item.id,
                                    text: item.name
                                }));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("Error loading subcategories:", error);
                            console.log("Response:", xhr.responseText);
                            alert('An error occurred while loading subcategories.');
                        }
                    });
                } else {
                    // Reset subcategory dropdown
                    targetSelect.empty().append('<option value="">-- Select Sub-Category --</option>');
                }
            }
            
            // Handle edit button click
            $('.edit-ud-name').on('click', function() {
                var id = $(this).data('id');
                console.log("Edit button clicked for ID:", id);
                
                // Clear previous form errors
                $('.invalid-feedback').empty();
                $('.is-invalid').removeClass('is-invalid');
                
                // Get UD name details
                $.ajax({
                    url: '@Url.Action("GetUDNameDetails", "UDManager")',
                    type: 'GET',
                    data: { id: id },
                    success: function(data) {
                        console.log("UD name details:", data);
                        
                        // Populate the edit form
                        $('#edit_id').val(data.id);
                        $('#edit_categoryId').val(data.categoryId);
                        $('#edit_name').val(data.name);
                        $('#edit_unit').val(data.unit);
                        $('#edit_unitPrice').val(data.unitPrice);
                        $('#edit_isActive').prop('checked', data.isActive);
                        
                        // Load subcategories and set the selected one
                        loadSubCategories(data.categoryId, $('#edit_subCategoryId'));
                        
                        // Set the subcategory after a short delay to ensure dropdown is populated
                        setTimeout(function() {
                            $('#edit_subCategoryId').val(data.subCategoryId);
                        }, 500);
                        
                        // Show the modal
                        $('#editUDNameModal').modal('show');
                    },
                    error: function(xhr, status, error) {
                        console.error("Error loading UD name details:", error);
                        console.log("Response:", xhr.responseText);
                        alert('An error occurred while loading UD name details.');
                    }
                });
            });
            
            // Handle save changes button click
            $('#saveUDNameChanges').on('click', function() {
                // Get form data
                var formData = {
                    Id: $('#edit_id').val(),
                    CategoryId: $('#edit_categoryId').val(),
                    SubCategoryId: $('#edit_subCategoryId').val(),
                    Name: $('#edit_name').val(),
                    Unit: $('#edit_unit').val(),
                    UnitPrice: $('#edit_unitPrice').val(),
                    IsActive: $('#edit_isActive').is(':checked'),
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                };
                
                console.log("Saving changes:", formData);
                
                // Clear previous form errors
                $('.invalid-feedback').empty();
                $('.is-invalid').removeClass('is-invalid');
                
                // Send update request - CHANGE THIS URL to the correct endpoint
                $.ajax({
                    url: '@Url.Action("UpdateUDName", "UDManager")', // Changed from EditUDName to UpdateUDName
                    type: 'POST',
                    data: formData,
                    success: function(result) {
                        console.log("Update result:", result);
                        
                        if (result.success) {
                            // Show success message
                            $('#editUDNameModal').modal('hide');
                            
                            // Reload the page to show updated data
                            window.location.reload();
                        } else {
                            // Show validation errors
                            if (result.errors) {
                                $.each(result.errors, function(i, error) {
                                    $('#edit_' + error.field + '_error').text(error.message);
                                    $('#edit_' + error.field).addClass('is-invalid');
                                });
                            } else {
                                alert(result.message || 'An error occurred while updating the UD name.');
                            }
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("AJAX Error:", error);
                        console.log("Response:", xhr.responseText);
                        alert('An error occurred while updating the UD name.');
                    }
                });
            });
            
            // Handle toggle status button
            $('.toggle-status').on('click', function() {
                var btn = $(this);
                var id = btn.data('id');
                var isActive = btn.data('status') === 'true';
                var row = btn.closest('tr');
                
                console.log("Toggle status button clicked:", { id: id, isActive: isActive });
                
                if (confirm('Are you sure you want to ' + (isActive ? 'deactivate' : 'activate') + ' this UD name?')) {
                    $.ajax({
                        url: '@Url.Action("ToggleStatus", "UDManager")',
                        type: 'POST',
                        data: {
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                        },
                        success: function(result) {
                            console.log("Toggle status result:", result);
                            
                            if (result.success) {
                                // Update button and row
                                if (result.isActive) {
                                    btn.removeClass('btn-success').addClass('btn-warning');
                                    btn.html('<i class="bi bi-x-circle"></i> Deactivate');
                                    row.removeClass('text-muted');
                                    row.find('.badge').removeClass('bg-secondary').addClass('bg-success').text('Active');
                                } else {
                                    btn.removeClass('btn-warning').addClass('btn-success');
                                    btn.html('<i class="bi bi-check-circle"></i> Activate');
                                    row.addClass('text-muted');
                                    row.find('.badge').removeClass('bg-success').addClass('bg-secondary').text('Inactive');
                                }
                                
                                btn.data('status', result.isActive.toString());
                            } else {
                                alert('Error toggling status: ' + (result.message || 'Unknown error'));
                            }
                        },
                        error: function(xhr, status, error) {
                            console.error("AJAX Error:", error);
                            console.log("Response:", xhr.responseText);
                            alert('An error occurred while updating status.');
                        }
                    });
                }
            });

            // Initialize search highlighting if there's a search term
            var searchTerm = '@ViewBag.SearchTerm';
            if (searchTerm && searchTerm.length > 0) {
                highlightSearchTerm(searchTerm);
            }

            function highlightSearchTerm(term) {
                if (!term) return;
                
                // Create a case-insensitive regex for the search term
                var regex = new RegExp('(' + term + ')', 'gi');
                
                // Function to highlight text in a cell
                function highlightText(i, cell) {
                    var content = $(cell).html();
                    if (content) {
                        // Replace matches with highlighted span
                        var highlighted = content.replace(regex, '<span class="bg-warning">$1</span>');
                        $(cell).html(highlighted);
                    }
                }
                
                // Apply highlighting to all table cells except the last one (actions)
                $('#udNamesTable tbody tr').each(function() {
                    $(this).find('td:not(:last-child)').each(highlightText);
                });
            }

            // Handle edit button click
            $('.edit-ud-name').on('click', function() {
                var btn = $(this);
                var id = btn.data('id');
                var name = btn.data('name');
                var unit = btn.data('unit');
                var unitPrice = btn.data('unitprice');
                var categoryId = btn.data('categoryid');
                var subCategoryId = btn.data('subcategoryid');
                var isActive = btn.data('isactive');

                console.log("Edit button clicked:", { id: id, name: name, unit: unit, unitPrice: unitPrice, categoryId: categoryId, subCategoryId: subCategoryId, isActive: isActive });

                // Set modal fields
                $('#edit_id').val(id);
                $('#edit_name').val(name);
                $('#edit_unit').val(unit);
                $('#edit_unitPrice').val(unitPrice);
                $('#edit_categoryId').val(categoryId);
                $('#edit_subCategoryId').val(subCategoryId);
                $('#edit_isActive').prop('checked', isActive);

                // Load sub-categories for the selected category in the modal
                $('#edit_categoryId').trigger('change');
            });

            // Handle category change in edit modal for sub-category loading
            $('#edit_categoryId').on('change', function() {
                var categoryId = $(this).val();
                console.log("Edit modal category changed to:", categoryId);
                
                if (categoryId) {
                    // Get sub-categories for the selected category
                    $.ajax({
                        url: '@Url.Action("GetSubCategories", "UDManager")',
                        type: 'GET',
                        data: { categoryId: categoryId },
                        success: function(data) {
                            console.log("Subcategories loaded for edit modal:", data);
                            $('#edit_subCategoryId').empty().append('<option value="">-- Select Sub-Category --</option>');
                            $.each(data, function(i, item) {
                                $('#edit_subCategoryId').append($('<option>', {
                                    value: item.id,
                                    text: item.name
                                }));
                            });
                        },
                        error: function(xhr, status, error) {
                            console.error("Error loading subcategories for edit modal:", error);
                            console.log("Response:", xhr.responseText);
                            alert('An error occurred while loading subcategories.');
                        }
                    });
                } else {
                    // Reset subcategory dropdown
                    $('#edit_subCategoryId').empty().append('<option value="">-- Select Sub-Category --</option>');
                }
            });

            // Handle save changes button in edit modal
            $('#saveUDNameChanges').on('click', function() {
                var form = $('#editUDNameForm');
                
                // Validate form
                if (form[0].checkValidity() === false) {
                    event.preventDefault();
                    event.stopPropagation();
                } else {
                    // Submit form via AJAX
                    $.ajax({
                        url: '@Url.Action("EditUDName", "UDManager")',
                        type: 'POST',
                        data: form.serialize(),
                        success: function(result) {
                            console.log("Edit UD Name result:", result);
                            
                            if (result.success) {
                                // Update row in table
                                var row = $('#udNamesTable tbody tr[data-id="' + result.udName.Id + '"]');
                                row.find('td:eq(0)').text(result.udName.Name);
                                row.find('td:eq(1)').text(result.udName.Category.Category);
                                row.find('td:eq(2)').text(result.udName.SubCategory.SubCategory);
                                row.find('td:eq(3)').text(result.udName.Unit);
                                row.find('td:eq(4)').text(result.udName.UnitPrice.toFixed(2));
                                
                                // Update status badge
                                var badge = row.find('.badge');
                                if (result.udName.IsActive) {
                                    badge.removeClass('bg-secondary').addClass('bg-success').text('Active');
                                    row.removeClass('text-muted');
                                } else {
                                    badge.removeClass('bg-success').addClass('bg-secondary').text('Inactive');
                                    row.addClass('text-muted');
                                }
                                
                                // Close modal
                                $('#editUDNameModal').modal('hide');
                            } else {
                                alert('Error editing UD Name: ' + (result.message || 'Unknown error'));
                            }
                        },
                        @* error: function(xhr, status, error) {
                            console.error("AJAX Error:", error);
                            console.log("Response:", xhr.responseText);
                            alert('An error occurred while editing UD Name.');
                        } *@
                    });
                }

                form.addClass('was-validated');
            });
            
            // Add scroll to top buttons for each scrollable section
            $('.table-responsive').each(function() {
                var container = $(this);
                var scrollToTopBtn = $('<button class="btn btn-sm btn-outline-secondary scroll-to-top-btn" style="position: absolute; right: 10px; bottom: 10px; display: none; z-index: 20;"><i class="bi bi-arrow-up"></i></button>');
                
                container.parent().css('position', 'relative').append(scrollToTopBtn);
                
                // Show/hide scroll to top button
                container.on('scroll', function() {
                    if (container.scrollTop() > 100) {
                        scrollToTopBtn.fadeIn();
                    } else {
                        scrollToTopBtn.fadeOut();
                    }
                });
                
                // Scroll to top functionality
                scrollToTopBtn.on('click', function() {
                    container.animate({scrollTop: 0}, 300);
                });
            });
            
            // Add keyboard navigation for scrollable tables
            $('.table-responsive').on('keydown', function(e) {
                var container = $(this);
                var scrollAmount = 50;
                
                switch(e.key) {
                    case 'ArrowUp':
                        if (e.ctrlKey) {
                            e.preventDefault();
                            container.scrollTop(container.scrollTop() - scrollAmount);
                        }
                        break;
                    case 'ArrowDown':
                        if (e.ctrlKey) {
                            e.preventDefault();
                            container.scrollTop(container.scrollTop() + scrollAmount);
                        }
                        break;
                    case 'Home':
                        if (e.ctrlKey) {
                            e.preventDefault();
                            container.scrollTop(0);
                        }
                        break;
                    case 'End':
                        if (e.ctrlKey) {
                            e.preventDefault();
                            container.scrollTop(container[0].scrollHeight);
                        }
                        break;
                }
            });
            
            // Add smooth scrolling when jumping to specific items
            function scrollToItem(tableId, itemId) {
                var table = $('#' + tableId);
                var row = table.find('tr[data-id="' + itemId + '"]');
                
                if (row.length) {
                    var container = table.closest('.table-responsive');
                    var rowTop = row.position().top;
                    var containerHeight = container.height();
                    var scrollTop = container.scrollTop();
                    
                    // Calculate target scroll position to center the row
                    var targetScroll = scrollTop + rowTop - (containerHeight / 2);
                    
                    container.animate({
                        scrollTop: targetScroll
                    }, 500);
                    
                    // Highlight the row briefly
                    row.addClass('table-warning');
                    setTimeout(function() {
                        row.removeClass('table-warning');
                    }, 2000);
                }
            }
            
            // Your existing JavaScript code goes here...
        });
    </script>
}

