@model SFCDashboard.Models.PETaskList

@{
    ViewData["Title"] = "Task Details";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center">
                <i class="bi bi-info-circle fs-4 me-2"></i>
                <h5 class="mb-0">Task Details</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">Task Information</h6>
                            <dl class="row mb-0">
                                <dt class="col-sm-3">
                                    <i class="bi bi-123 me-2"></i>
                                    @Html.DisplayNameFor(model => model.TaskSeq)
                                </dt>
                                <dd class="col-sm-9">
                                    @Html.DisplayFor(model => model.TaskSeq)
                                </dd>

                                <dt class="col-sm-3">
                                    <i class="bi bi-card-text me-2"></i>
                                    @Html.DisplayNameFor(model => model.Name)
                                </dt>
                                <dd class="col-sm-9 fw-medium">
                                    @Html.DisplayFor(model => model.Name)
                                </dd>

                                <dt class="col-sm-3">
                                    <i class="bi bi-gear me-2"></i>
                                    @Html.DisplayNameFor(model => model.OLA_Parameters)
                                </dt>
                                <dd class="col-sm-9 text-muted">
                                    @Html.DisplayFor(model => model.OLA_Parameters)
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-pencil me-2"></i>Edit
                </a>
                <a asp-action="Index" class="btn btn-light btn-lg px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>