@model IEnumerable<SFCDashboard.Models.PETaskList>

@{
    ViewData["Title"] = "Task Lists";
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold mb-1">Task Lists</h1>
                    <p class="text-muted mb-0">Manage planned event task lists</p>
                </div>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>Create New
                </a>
            </div>
            <hr class="my-4" />
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-123 me-2"></i>
                                @Html.DisplayNameFor(model => model.TaskSeq)
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-card-text me-2"></i>
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th scope="col" class="px-4 py-3">
                                <i class="bi bi-gear me-2"></i>
                                @Html.DisplayNameFor(model => model.OLA_Parameters)
                            </th>
                            <th scope="col" class="px-4 py-3 text-center" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr class="align-middle">
                                <td class="px-4 py-3">@Html.DisplayFor(modelItem => item.TaskSeq)</td>
                                <td class="px-4 py-3">
                                    <span class="fw-medium">@Html.DisplayFor(modelItem => item.Name)</span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="text-muted">@Html.DisplayFor(modelItem => item.OLA_Parameters)</span>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" 
                                           class="btn btn-outline-primary btn-sm"
                                           data-bs-toggle="tooltip" title="Edit Task">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" 
                                           class="btn btn-outline-info btn-sm"
                                           data-bs-toggle="tooltip" title="View Details">
                                            <i class="bi bi-info-circle"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" 
                                           class="btn btn-outline-danger btn-sm"
                                           data-bs-toggle="tooltip" title="Delete Task">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Animate table rows
            $('tbody tr').each(function(i) {
                $(this).css('animation-delay', (i * 0.1) + 's');
                $(this).addClass('animate__animated animate__fadeIn');
            });
        });
    </script>
}