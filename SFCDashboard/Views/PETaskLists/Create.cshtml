@model SFCDashboard.Models.PETaskList

@{
    ViewData["Title"] = "Create Task List";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center">
                <i class="bi bi-list-check fs-4 me-2"></i>
                <h5 class="mb-0">Create New Task List</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="row g-4">
                    <div class="col-md-4">
                        <label asp-for="TaskSeq" class="form-label fw-semibold">Task Sequence</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-123"></i></span>
                            <input asp-for="TaskSeq" class="form-control form-control-lg" required />
                        </div>
                        <span asp-validation-for="TaskSeq" class="text-danger"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold">Task Name</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                            <input asp-for="Name" class="form-control form-control-lg" required />
                        </div>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="OLA_Parameters" class="form-label fw-semibold">OLA Parameters</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-gear"></i></span>
                            <input asp-for="OLA_Parameters" class="form-control form-control-lg" />
                        </div>
                        <span asp-validation-for="OLA_Parameters" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-plus-circle me-2"></i>Create
                    </button>
                    <a asp-action="Index" class="btn btn-light btn-lg px-4">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}