@using SFCDashboard.Models
@model SFCDashboard.Models.UserRole

@{
    ViewData["Title"] = "Create Role";
    var permissions = (IEnumerable<Permission>)ViewData["Permissions"] ?? Enumerable.Empty<Permission>();
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-gradient text-white" style="background-color: #4361ee;">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-lock fs-4 me-2"></i>
                <h5 class="mb-0">Create New Role</h5>
            </div>
        </div>
        <div class="card-body p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger shadow-sm border-0 rounded-3">
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <form asp-controller="UserRoles" asp-action="Create" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger"></div>
                
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold">Role Name</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                        <input asp-for="Name" class="form-control form-control-lg" required placeholder="Enter role name" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Permissions</label>
                    <div class="border rounded-3 p-4 bg-light">
                        @if (!permissions.Any())
                        {
                            <div class="alert alert-warning border-0 shadow-sm">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                No permissions available
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                            @foreach (var permission in permissions)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body">
                                            <div class="form-check">
                                                <input type="checkbox" 
                                                       name="selectedPermissions" 
                                                       value="@permission.Id" 
                                                       class="form-check-input" 
                                                       id="perm_@permission.Id" />
                                                <label class="form-check-label fw-medium" for="perm_@permission.Id">
                                                    @permission.Name
                                                </label>
                                                @if (!string.IsNullOrEmpty(permission.Description))
                                                {
                                                    <small class="text-muted d-block mt-1">@permission.Description</small>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-plus-circle me-2"></i> Create Role
                    </button>
                    <a asp-action="Index" class="btn btn-light btn-lg px-4">
                        <i class="bi bi-arrow-left me-2"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Modern form validation
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        });
    </script>
}
