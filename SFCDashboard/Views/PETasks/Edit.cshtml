@model SFCDashboard.Models.PETask

@{
    ViewData["Title"] = "Edit PETask";
}

<h2>Edit PETask</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <!-- Add your other fields here -->

    <div class="form-group mb-3">
        <label asp-for="EstimatedTime" class="control-label">Estimated Date</label>
        <input asp-for="EstimatedTime" class="form-control" type="date" />
        <span asp-validation-for="EstimatedTime" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>