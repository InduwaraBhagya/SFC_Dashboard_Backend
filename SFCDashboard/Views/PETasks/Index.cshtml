@model IEnumerable<SFCDashboard.Models.PETask>
@{
    ViewData["Title"] = "Tasks";
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-4">Tasks</h1>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Create New Task
                </a>
            </div>
            <hr class="bg-secondary" />
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="thead-dark bg-dark text-light">
                        <tr>
                            <th scope="col" class="p-3">
                                @Html.DisplayNameFor(model => model.TaskSeq)
                            </th>
                            <th scope="col" class="p-3">
                                @Html.DisplayNameFor(model => model.PlannedEvent)
                            </th>
                            <th scope="col" class="p-3">
                                @Html.DisplayNameFor(model => model.OLA_Parameters)
                            </th>
                            <th scope="col" class="p-3 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="p-3 align-middle">
                                    <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.TaskSeq)</span>
                                </td>
                                <td class="p-3 align-middle">
                                    <span class="fw-bold">@Html.DisplayFor(modelItem => item.PlannedEvent)</span>
                                </td>
                                <td class="p-3 align-middle">
                                    @Html.DisplayFor(modelItem => item.OLA_Parameters)
                                </td>
                                <td class="p-3 text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm mx-2">
                                            <i class="bi bi-info-circle me-1"></i>Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add animation to rows
        $(document).ready(function () {
            $('tbody tr').each(function(i) {
                $(this).css('animation-delay', (i * 0.1) + 's');
                $(this).addClass('animate__animated animate__fadeIn');
            });
        });
    </script>
}