@model SFCDashboard.Models.PETask

@{
    ViewData["Title"] = "Confirm Task Urgency";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-warning text-dark">
            <h3>Task Urgency Request</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <h4>Task Details</h4>
                <dl class="row">
                    <dt class="col-sm-3">PE Number:</dt>
                    <dd class="col-sm-9">@Model.PENumber</dd>
                    
                    <dt class="col-sm-3">Task:</dt>
                    <dd class="col-sm-9">@Model.Task</dd>
                    
                    <dt class="col-sm-3">Task Status:</dt>
                    <dd class="col-sm-9">@Model.TaskStatus</dd>
                    
                    <dt class="col-sm-3">Workgroup:</dt>
                    <dd class="col-sm-9">@Model.TaskWorkGroup</dd>
                    
                    <dt class="col-sm-3">Created Date:</dt>
                    <dd class="col-sm-9">@Model.TaskCreatedDate.ToString("yyyy-MM-dd")</dd>
                    
                    <dt class="col-sm-3">Target Date:</dt>
                    <dd class="col-sm-9">@Model.TaskCompleteDate.ToString("yyyy-MM-dd")</dd>
                </dl>
            </div>
            
            <form asp-action="ProcessUrgentRequest" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="form-group mb-3">
                    <label class="form-label">Select Urgency Reason:</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="urgentReason" id="openingCeremony" value="OpeningCeremony">
                        <label class="form-check-label" for="openingCeremony">
                            Opening Ceremony (Priority 1)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="urgentReason" id="criticalCustomer" value="CriticalCustomer">
                        <label class="form-check-label" for="criticalCustomer">
                            Critical Customer (Priority 2)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="urgentReason" id="networkOutage" value="NetworkOutage">
                        <label class="form-check-label" for="networkOutage">
                            Network Outage (Priority 0)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="urgentReason" id="reject" value="Reject">
                        <label class="form-check-label" for="reject">
                            Reject Request
                        </label>
                    </div>
                </div>
                
                <div class="d-flex justify-content-between">
                    <a asp-action="UrgentRequestsList" class="btn btn-secondary">Back to List</a>
                    <button type="submit" class="btn btn-warning">Process Request</button>
                </div>
            </form>
        </div>
    </div>
</div>